LIGHTCONTENT=#FFFFFF;
DARKCONTENT=#000000;

PRIMARY=#BDBDBD;
PRIMARYLIGHT=#EFEFEF;
PRIMARYDARK=#8D8D8D;
SECONDARY=#2196F3;
SECONDARYLIGHT=#6EC6FF;
SECONDARYDARK=#0069C0;
BACKGROUND=#FAFAFA;
SURFACE=#FAFAFA;
SUCCESS=#00B020;
ERROR=#B00020;

ONPRIMARY=$DARKCONTENT;
ONPRIMARYLIGHT=$DARKCONTENT;
ONPRIMARYDARK=$DARKCONTENT;
ONSECONDARY=$DARKCONTENT;
ONSECONDARYLIGHT=$DARKCONTENT;
ONSECONDARYDARK=$LIGHTCONTENT;
ONBACKGROUND=$DARKCONTENT;
ONSURFACE=$DARKCONTENT;

# General
CONTAINER=$PRIMARYDARK;
PANEL=$PRIMARY;
PANELCONTENT=$ONPRIMARY;
PANELDISABLEDCONTENT=$PANELCONTENT@40;
PANELBREAK=$ONPRIMARY@15;
DIVIDER=$PRIMARYLIGHT;
HEADER=$PRIMARY;
HEADERCONTENT=$ONPRIMARY;
HEADERHELPERCONTENT=$HEADERCONTENT@60;
HEADERDISABLEDCONTENT=$HEADERCONTENT@40;
SUBHEADER=$PRIMARY;
SUBHEADERCONTENT=$ONPRIMARY;
SUBHEADERHELPERCONTENT=$SUBHEADERCONTENT@60;
SUBHEADERDISABLEDCONTENT=$SUBHEADERCONTENT@40;
FOOTER=$PRIMARY;
FOOTERCONTENT=$ONPRIMARY;
FOOTERHELPERCONTENT=$FOOTERCONTENT@60;
FOOTERDISABLEDCONTENT=$FOOTERCONTENT@40;
GROUP=$PRIMARYLIGHT;
GROUPCONTENT=$ONPRIMARYLIGHT;
GROUPHELPERCONTENT=$GROUPCONTENT@60;
GROUPDISABLEDCONTENT=$GROUPCONTENT@40;
POPUP=$PRIMARY;
POPUPBORDER=$ONPRIMARY@30;
POPUPCONTENT=$ONPRIMARY;
POPUPHELPERCONTENT=$POPUPCONTENT@60;
POPUPDISABLEDCONTENT=$POPUPCONTENT@40;

# Button, Toggle Button, Repeat Button
BUTTON=$PRIMARYLIGHT;
BUTTONBORDER=$ONPRIMARYLIGHT@30;
BUTTONCONTENT=$ONPRIMARYLIGHT;
BUTTONDISABLED=$BUTTON@40;
BUTTONDISABLEDBORDER=$BUTTONBORDER@40;
BUTTONDISABLEDCONTENT=$BUTTONCONTENT@40;
BUTTONCHECKED=$BUTTON+$SECONDARYDARK@45;
BUTTONCHECKEDBORDER=$BUTTONBORDER+$SECONDARYDARK@45;
BUTTONCHECKEDCONTENT=$BUTTONCONTENT;
BUTTONHOVER=$BUTTON+$SECONDARY@45;
BUTTONHOVERBORDER=$BUTTONBORDER+$SECONDARY@45;
BUTTONHOVERCONTENT=$BUTTONCONTENT;
BUTTONPRESSED=$BUTTON+$SECONDARYLIGHT@45;
BUTTONPRESSEDBORDER=$BUTTONBORDER+$SECONDARYLIGHT@45;
BUTTONPRESSEDCONTENT=$BUTTONCONTENT;

# Textbox
TEXTBOX=$SURFACE;
TEXTBOXBORDER=$ONSURFACE@30;
TEXTBOXCONTENT=$ONSURFACE;
TEXTBOXSELECTION=$SECONDARYLIGHT@40;
TEXTBOXHELPERCONTENT=$ONSURFACE@60;
TEXTBOXDISABLED=$TEXTBOX@40;
TEXTBOXDISABLEDBORDER=$TEXTBOXBORDER@40;
TEXTBOXDISABLEDCONTENT=$TEXTBOXCONTENT@40;
TEXTBOXDISABLEDSELECTION=$TEXTBOXSELECTION@40;
TEXTBOXHOVER=$TEXTBOX;
TEXTBOXHOVERBORDER=$TEXTBOXBORDER+$SECONDARY@45;
TEXTBOXHOVERCONTENT=$TEXTBOXCONTENT;
TEXTBOXHOVERSELECTION=$TEXTBOXSELECTION;
TEXTBOXFOCUSED=$TEXTBOX;
TEXTBOXFOCUSEDBORDER=$TEXTBOXBORDER+$SECONDARYLIGHT@45;
TEXTBOXFOCUSEDCONTENT=$TEXTBOXCONTENT;
TEXTBOXFOCUSEDSELECTION=$SECONDARY@40;

# Checkbox
CHECKBOX=$SURFACE;
CHECKBOXBORDER=$ONSURFACE@30;
CHECKBOXFILL=$ONSURFACE;
CHECKBOXDISABLED=$CHECKBOX@40;
CHECKBOXDISABLEDBORDER=$CHECKBOXBORDER@40;
CHECKBOXDISABLEDFILL=$CHECKBOXFILL@40;
CHECKBOXCHECKED=$CHECKBOX;
CHECKBOXCHECKEDBORDER=$CHECKBOXBORDER;
CHECKBOXCHECKEDFILL=$CHECKBOXFILL;
CHECKBOXHOVER=$CHECKBOX+$SECONDARY@45;
CHECKBOXHOVERBORDER=$CHECKBOXBORDER+$SECONDARY@45;
CHECKBOXHOVERFILL=$CHECKBOXFILL+$SECONDARY@45;
CHECKBOXPRESSED=$CHECKBOX+$SECONDARYLIGHT@45;
CHECKBOXPRESSEDBORDER=$CHECKBOXBORDER+$SECONDARYLIGHT@45;
CHECKBOXPRESSEDFILL=$CHECKBOXFILL+$SECONDARYLIGHT@45;

# Radio Button
RADIO=$SURFACE;
RADIOBORDER=$ONSURFACE@30;
RADIOFILL=$ONSURFACE;
RADIODISABLED=$RADIO@40;
RADIODISABLEDBORDER=$RADIOBORDER@40;
RADIODISABLEDFILL=$RADIOFILL@40;
RADIOCHECKED=$RADIO;
RADIOCHECKEDBORDER=$RADIOBORDER;
RADIOCHECKEDFILL=$RADIOFILL;
RADIOHOVER=$RADIO+$SECONDARY@45;
RADIOHOVERBORDER=$RADIOBORDER+$SECONDARY@45;
RADIOHOVERFILL=$RADIOFILL+$SECONDARY@45;
RADIOPRESSED=$RADIO+$SECONDARYLIGHT@45;
RADIOPRESSEDBORDER=$RADIOBORDER+$SECONDARYLIGHT@45;
RADIOPRESSEDFILL=$RADIOFILL+$SECONDARYLIGHT@45;

# List
LIST=$BACKGROUND;
LISTBORDER=$LIST;
LISTITEMCONTENT=$ONBACKGROUND;
LISTDISABLED=$LIST@40;
LISTDISABLEDBORDER=$LISTDISABLED;
LISTDISABLEDITEMCONTENT=$LISTITEMCONTENT@40;
LISTITEMSELECTED=$SECONDARYDARK@45;
LISTITEMSELECTEDBORDER=$LISTITEMSELECTED;
LISTITEMSELECTEDCONTENT=$LISTITEMCONTENT;
LISTITEMINACTIVESELECTED=$SECONDARYLIGHT@45;
LISTITEMINACTIVESELECTEDBORDER=$LISTITEMINACTIVESELECTED;
LISTITEMINACTIVESELECTEDCONTENT=$LISTITEMCONTENT;
LISTITEMHOVER=$SECONDARY@45;
LISTITEMHOVERBORDER=$LISTITEMHOVER;
LISTITEMHOVERCONTENT=$LISTITEMCONTENT;

# Menu, Context Menu
MENU=$PRIMARYLIGHT;
MENUBORDER=$ONPRIMARYLIGHT@30;
MENUBREAK=$ONPRIMARYLIGHT@15;
MENUCONTENT=$ONPRIMARYLIGHT;
MENUHELPERCONTENT=$MENUCONTENT@60;
MENUDISABLEDCONTENT=$MENUCONTENT@40;
MENUHOVER=$SECONDARY@45;
MENUHOVERBORDER=$MENUHOVER;
MENUCHECKED=$SECONDARYDARK@45;
MENUCHECKEDBORDER=$MENUCHECKED;
MENUDISABLEDCHECKED=$SECONDARYLIGHT@45;
MENUDISABLEDCHECKEDBORDER=$MENUDISABLEDCHECKED;

# Toolbar
TOOLBAR=$PRIMARYLIGHT;
TOOLBARCONTENT=$ONPRIMARYLIGHT;
TOOLBARPOPUPBORDER=$ONPRIMARYLIGHT@30;
TOOLBARDISABLED=$TOOLBAR;
TOOLBARDISABLEDCONTENT=$TOOLBARCONTENT@40;
TOOLBARHOVER=$TOOLBAR;
TOOLBARHOVERCONTENT=$TOOLBARCONTENT+$SECONDARY@45;
TOOLBARPRESSED=$TOOLBAR;
TOOLBARPRESSEDCONTENT=$TOOLBARCONTENT+$SECONDARYLIGHT@45;

# Tab Item
TABITEM=$PRIMARYLIGHT;
TABITEMBORDER=$ONPRIMARYLIGHT@30;
TABITEMCONTENT=$ONPRIMARYLIGHT;
TABITEMDISABLED=$TABITEM@40;
TABITEMDISABLEDBORDER=$TABITEMBORDER@40;
TABITEMDISABLEDCONTENT=$TABITEMCONTENT@40;
TABITEMACTIVE=$TABITEM+$SECONDARY@45;
TABITEMACTIVEBORDER=$TABITEMBORDER+$SECONDARY@45;
TABITEMACTIVECONTENT=$TABITEMCONTENT;
TABITEMHOVER=$TABITEM+$SECONDARYLIGHT@45;
TABITEMHOVERBORDER=$TABITEMBORDER+$SECONDARYLIGHT@45;
TABITEMHOVERCONTENT=$TABITEMCONTENT;

# Scrollbar
SCROLLBAR=$PRIMARYLIGHT;
SCROLLBARTHUMB=$PRIMARY;
SCROLLBARTHUMBHOVER=$SCROLLBARTHUMB+$SECONDARY@45;
SCROLLBARTHUMBDRAG=$SCROLLBARTHUMB+$SECONDARYLIGHT@45;
SCROLLBARARROW=$SCROLLBAR;
SCROLLBARARROWFILL=$SCROLLBARTHUMB;
SCROLLBARARROWDISABLED=$SCROLLBARARROW;
SCROLLBARARROWDISABLEDFILL=$SCROLLBARARROWFILL@40;
SCROLLBARARROWHOVER=$SCROLLBARARROW;
SCROLLBARARROWHOVERFILL=$SCROLLBARTHUMBHOVER;
SCROLLBARARROWPRESSED=$SCROLLBARARROW;
SCROLLBARARROWPRESSEDFILL=$SCROLLBARTHUMBDRAG;

# Slider
SLIDERTICK=$ONPRIMARY@60;
SLIDERTICKDISABLED=$ONPRIMARY@40;
SLIDERTRACK=$PRIMARYLIGHT;
SLIDERTRACKBORDER=$PRIMARY@30;
SLIDERTHUMB=$PRIMARYLIGHT;
SLIDERTHUMBBORDER=$ONPRIMARYLIGHT@30;
SLIDERTHUMBDISABLED=$SLIDERTHUMB;
SLIDERTHUMBDISABLEDBORDER=$SLIDERTHUMBBORDER@40;
SLIDERTHUMBHOVER=$SLIDERTHUMB+$SECONDARY@45;
SLIDERTHUMBHOVERBORDER=$SLIDERTHUMBBORDER+$SECONDARY@45;
SLIDERTHUMBDRAG=$SLIDERTHUMB+$SECONDARYLIGHT@45;
SLIDERTHUMBDRAGBORDER=$SLIDERTHUMBBORDER+$SECONDARYLIGHT@45;

# Progress Bar
PROGRESSBAR=$SURFACE;
PROGRESSBARBORDER=$ONSURFACE@30;
PROGRESSBARFILL=$SUCCESS;

# Data Grid
DATAGRID=$PRIMARYDARK;
DATAGRIDBORDER=$DATAGRID;
DATAGRIDDIVIDER=$ONSURFACE@30;

# Data Grid Header
DATAGRIDHEADER=$PRIMARYLIGHT;
DATAGRIDHEADERBORDER=$ONPRIMARYLIGHT@30;
DATAGRIDHEADERCONTENT=$ONPRIMARYLIGHT;
DATAGRIDHEADERDISABLED=$DATAGRIDHEADER@40;
DATAGRIDHEADERDISABLEDCONTENT=$DATAGRIDHEADERCONTENT@40;
DATAGRIDHEADERACTIVE=$DATAGRIDHEADER+$SECONDARYDARK@45;
DATAGRIDHEADERACTIVECONTENT=$DATAGRIDHEADERCONTENT;
DATAGRIDHEADERHOVER=$DATAGRIDHEADER+$SECONDARY@45;
DATAGRIDHEADERHOVERCONTENT=$DATAGRIDHEADERCONTENT;
DATAGRIDHEADERPRESSED=$DATAGRIDHEADER+$SECONDARYLIGHT@45;
DATAGRIDHEADERPRESSEDCONTENT=$DATAGRIDHEADERCONTENT;

# Data Grid Row
DATAGRIDROW=$SURFACE;
DATAGRIDROWCONTENT=$ONSURFACE;
DATAGRIDROWALTERNATION=$PRIMARY;

# Data Grid Cell
DATAGRIDCELL=$DATAGRIDROW;
DATAGRIDCELLCONTENT=$DATAGRIDROWCONTENT;
DATAGRIDCELLINACTIVESELECTED=$DATAGRIDROW+$SECONDARYLIGHT@45;
DATAGRIDCELLINACTIVESELECTEDCONTENT=$DATAGRIDROWCONTENT;
DATAGRIDCELLSELECTED=$DATAGRIDROW+$SECONDARY@45;
DATAGRIDCELLSELECTEDCONTENT=$DATAGRIDROWCONTENT;

# Calendar
CALENDAR=$SURFACE;
CALENDARDISABLED=$CALENDAR@40;
CALENDARBORDER=$CALENDAR@30;
CALENDARCONTENT=$ONPRIMARYLIGHT;
CALENDARDISABLEDCONTENT=$CALENDARCONTENT@40;
CALENDARHELPER=$CALENDARCONTENT@60;
CALENDARHELPERBORDER=$CALENDARHELPER;
CALENDARHELPERCONTENT=$CALENDARCONTENT;
CALENDARSELECTED=$SECONDARYDARK@45;
CALENDARSELECTEDBORDER=$CALENDARSELECTED;
CALENDARSELECTEDCONTENT=$CALENDARCONTENT;
CALENDARHOVER=$SECONDARY@45;
CALENDARHOVERBORDER=$CALENDARHOVER;
CALENDARHOVERCONTENT=$CALENDARCONTENT;
CALENDARPRESSED=$CALENDAR+$SECONDARYLIGHT@45;
CALENDARPRESSEDBORDER=$CALENDARPRESSED;
CALENDARPRESSEDCONTENT=$CALENDARCONTENT;

# Canvas
CANVAS=$BACKGROUND;

# Presentation View
PRESENTATIONVIEW=$CONTAINER;
PRESENTATIONVIEWACTIVEITEM=$PRESENTATIONVIEW+$SECONDARY@45;

# Thumbnail Panel
THUMBNAILPANEL=$CONTAINER;

# Playlist Item
HEADERPLAYLISTITEM=$ONPRIMARYLIGHT@30;
HEADERITEMDIVIDER=$ONPRIMARYLIGHT@80;

# TODO Thumbnail
THUMBNAILGRADIENTSTART=#D3D3D3;
THUMBNAILGRADIENTEND=#707070;
THUMBNAILPRESENTATION=#FFA500;
THUMBNAILANNOUNCEMENT=#00FF00;
THUMBNAILBUBBLEDEFAULTFILL=$PANEL;
THUMBNAILBUBBLEACTIVEFILL=#33FD00;

# Reflow
REFLOWTEXT=#515151;
REFLOWBACKGROUND=#D6D6D6;

# Ruler
RULERBACKGROUND=$BACKGROUND;
RULERBRUSH=$ONPRIMARY;
MOUSETRACKER=$ONPRIMARY;
OBJECTBOUNDS=$ONPRIMARY;

# TODO token
TOKENDEFAULT=#D3D3D3;
TOKENHOVER=#E4E4E4;
TOKENARRANGEMENT=#D3D3D3;
TOKENARRANGEMENTHOVER=#E4E4E4;
TOKENSELECTED=#1F90FF;

CHECKERBOARDPRIMARY=#0A0A0A;
CHECKERBOARDSECONDARY=#1A1A1A;

CLEARALLBUTTON=$ERROR;
CLEARALLBUTTONBORDER=$CLEARALLBUTTON;
CLEARALLBUTTONHOVER=$CLEARALLBUTTON+$SECONDARY@45;
CLEARALLBUTTONHOVERBORDER=$CLEARALLBUTTONBORDER+$SECONDARY@45;
CLEARALLBUTTONHOVERCONTENT=$BUTTONCONTENT;
CLEARALLBUTTONPRESSED=$CLEARALLBUTTON+$SECONDARYLIGHT@45;
CLEARALLBUTTONPRESSEDBORDER=$CLEARALLBUTTONBORDER+$SECONDARYLIGHT@45;
CLEARALLBUTTONPRESSEDCONTENT=$BUTTONCONTENT;
CLEARALLBUTTONDISABLED=$CLEARALLBUTTON@40;
