<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.DocumentAlignmentSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls" xmlns:commonConverters="clr-namespace:Pro.UI.Converters" xmlns:text="clr-namespace:Pro.Text;assembly=Pro.Text" x:Name="self">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <Style x:Key="{x:Type commonControls:RadioToggleButton}" BasedOn="{StaticResource {x:Type commonControls:RadioToggleButton}}" TargetType="{x:Type commonControls:RadioToggleButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type commonControls:ImageMask}" TargetType="{x:Type commonControls:ImageMask}">
        <Setter Property="commonControls:ImageMask.Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:RadioToggleButton}}" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Width" Value="16" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <commonControls:RadioToggleButton Click="DocumentAlignmentRadioButtonClick" Grid.Column="0" IsChecked="{Binding SelectedAlignment, ElementName=self, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static text:DocumentAlignment.Top}}">
      <commonControls:PathControl Height="13" PathType="TopAlignment" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:RadioToggleButton}}" />
    </commonControls:RadioToggleButton>
    <commonControls:RadioToggleButton Click="DocumentAlignmentRadioButtonClick" Grid.Column="1" IsChecked="{Binding SelectedAlignment, ElementName=self, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static text:DocumentAlignment.Middle}}">
      <commonControls:PathControl Height="13" PathType="MiddleAlignment" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:RadioToggleButton}}" />
    </commonControls:RadioToggleButton>
    <commonControls:RadioToggleButton Click="DocumentAlignmentRadioButtonClick" Grid.Column="2" HorizontalAlignment="Stretch" IsChecked="{Binding SelectedAlignment, ElementName=self, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static text:DocumentAlignment.Bottom}}">
      <commonControls:PathControl Height="13" PathType="BottomAlignment" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:RadioToggleButton}}" />
    </commonControls:RadioToggleButton>
  </Grid>
</UserControl>