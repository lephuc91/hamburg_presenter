<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.PdfViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonResources="clr-namespace:Pro.UI.Resources" xmlns:local="clr-namespace:Pro.UI.Controls" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions" x:Name="self" MinWidth="400" MinHeight="600">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ArrowControlStyle" TargetType="{x:Type local:PathControl}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Width" Value="10" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="50" />
    </Grid.RowDefinitions>
    <Grid Row="0" Background="#FF808080">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="8*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Margin="5" RenderOptions.BitmapScalingMode="Fant" Source="{Binding SelectedPage.PreviewImage, ElementName=self}">
        <UIElement.Effect>
          <DropShadowEffect Color="Gray" />
        </UIElement.Effect>
      </Image>
      <GridSplitter Grid.Column="1" Width="{x:Static commonResources:LayoutConstants.GridSplitterThickness}" />
      <ListBox Name="PagesListBox" Grid.Column="2" HorizontalContentAlignment="Stretch" Background="#FF808080" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Pages, ElementName=self}" SelectedItem="{Binding SelectedPage, ElementName=self}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Image Grid.Row="0" Margin="0,10,0,0" RenderOptions.BitmapScalingMode="Fant" Source="{Binding PreviewImage}" />
              <TextBlock Grid.Row="1" Margin="3,0,0,10" HorizontalAlignment="Center" Text="{Binding PageNumber}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </Grid>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Stretch" Orientation="Horizontal">
        <Button Height="22" MinWidth="40" Margin="5,0" VerticalAlignment="Center" Command="{Binding PreviousPageCommand, ElementName=self}">
          <ContentControl.Content>
            <local:PathControl PathType="LeftArrow" Style="{StaticResource ArrowControlStyle}" />
          </ContentControl.Content>
        </Button>
        <Button Height="22" MinWidth="40" Margin="5,0" VerticalAlignment="Center" Command="{Binding NextPageCommand, ElementName=self}">
          <ContentControl.Content>
            <local:PathControl PathType="RightArrow" Style="{StaticResource ArrowControlStyle}" />
          </ContentControl.Content>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Stretch" Orientation="Horizontal">
        <Button Height="22" MinWidth="100" Margin="5,0" VerticalAlignment="Center" IsDefault="True" Command="{Binding AcceptCommand, ElementName=self}" Content="{mex:Localized GLOBAL_OK_BUTTON_title}" />
        <Button Height="22" MinWidth="100" Margin="5,0" VerticalAlignment="Center" IsCancel="True" Command="{Binding CancelCommand, ElementName=self}" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>