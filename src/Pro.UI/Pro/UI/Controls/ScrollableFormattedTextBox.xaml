<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.ScrollableFormattedTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pro.UI.Controls" x:Name="Self">
  <ScrollViewer Name="Scroller" Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <local:FormattedTextBox x:Name="CustomTextBox" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoSizeHeight="True" ActiveRunSettings="{Binding ActiveRunSettings, ElementName=Self, Mode=TwoWay}" CaretIndex="{Binding CaretIndex, ElementName=Self, Mode=TwoWay}" DefaultRunSettings="{Binding DefaultRunSettings, ElementName=Self, Mode=TwoWay}" Document="{Binding Document, ElementName=Self}" SelectionRanges="{Binding SelectionRanges, ElementName=Self, Mode=TwoWay}" SpellCheckEnable="{Binding SpellCheckEnable, ElementName=Self}" />
  </ScrollViewer>
</UserControl>