<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.DragCountIndicator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pro.UI.Controls" x:Name="this">
  <Grid>
    <Border Width="18" Height="18" Background="#FF00FFFF" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="50">
      <TextBlock TextAlignment="Center" Text="{Binding Count, ElementName=this}" />
    </Border>
  </Grid>
</UserControl>