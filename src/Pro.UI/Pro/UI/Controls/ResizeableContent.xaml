<?xml version="1.0" encoding="utf-8"?>
<ContentControl x:Class="Pro.UI.Controls.ResizeableContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="self" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ResizeGrip}" TargetType="{x:Type ResizeGrip}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ResizeGrip}">
              <Border Width="10" Height="10" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <Rectangle Width="10" Height="10" VerticalAlignment="Top" Fill="{TemplateBinding Control.Foreground}" Stretch="Fill" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate>
      <Border Padding="0,0,5,5" Effect="{StaticResource ControlDropShadowEffect}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ContentPresenter Grid.Row="0" Content="{Binding Content, ElementName=self}" />
          <Thumb Grid.Row="1" Margin="0,-17,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" DragDelta="OnDragged">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Thumb}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate>
                      <ResizeGrip Foreground="#00FFFFFF" />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="FrameworkElement.Cursor" Value="SizeNWSE" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Thumb>
        </Grid>
      </Border>
    </ControlTemplate>
  </Control.Template>
</ContentControl>