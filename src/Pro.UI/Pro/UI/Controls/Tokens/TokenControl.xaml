<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.Tokens.TokenControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="self" xmlns:tokens="clr-namespace:Pro.UI.Controls.Tokens;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding ElementName=self}" />
      <TextBlock x:Key="DefaultContent" TextTrimming="CharacterEllipsis" Text="{Binding Data.Token.Content, Source={StaticResource proxy}}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="1,0" Padding="5,1" CornerRadius="5" Background="{Binding TokenBackground, ElementName=self}">
    <ContentPresenter Content="{Binding ContentControl, ElementName=self}" TextElement.Foreground="{Binding TokenForeground, ElementName=self}" />
  </Border>
</UserControl>