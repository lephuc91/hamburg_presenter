<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.GroupedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:uiComponents="clr-namespace:Pro.UI.Components" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="groupedControl" xmlns:controls="clr-namespace:Pro.UI.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="groupedControlProxy" Data="{Binding ElementName=groupedControl}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="4" Background="{Binding ElementName=groupedControl, Path=GroupBackground}">
    <ItemsControl AlternationCount="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}">
      <ItemsControl.ItemsSource>
        <uiComponents:FrameworkCollection>
          <uiComponents:FrameworkCollectionWrapper BoundCollection="{Binding Data.Collection, Source={StaticResource groupedControlProxy}}">
            <uiComponents:FrameworkCollectionWrapper.BoundDataTemplate>
              <DataTemplate>
                <Grid Name="elementGrid">
                  <UIElement.Visibility>
                    <PriorityBinding>
                      <Binding Path="Visibility" />
                    </PriorityBinding>
                  </UIElement.Visibility>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Separator Grid.Row="0" Background="{Binding Data.SeparatorBackground, Source={StaticResource groupedControlProxy}}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource {x:Type Separator}}" TargetType="{x:Type Separator}">
                        <Style.Triggers>
                          <DataTrigger Value="0" Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type Grid}}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Separator>
                  <ContentControl Grid.Row="1" Margin="{Binding Data.ContentMargin, Source={StaticResource groupedControlProxy}}" Content="{Binding}" ContentTemplate="{Binding Data.ItemContentTemplate, Source={StaticResource groupedControlProxy}}" />
                </Grid>
              </DataTemplate>
            </uiComponents:FrameworkCollectionWrapper.BoundDataTemplate>
          </uiComponents:FrameworkCollectionWrapper>
        </uiComponents:FrameworkCollection>
      </ItemsControl.ItemsSource>
    </ItemsControl>
  </Border>
</UserControl>