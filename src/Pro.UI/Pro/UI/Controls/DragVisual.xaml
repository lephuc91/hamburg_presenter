<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.DragVisual" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters" xmlns:local="clr-namespace:Pro.UI.Controls" x:Name="Self">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="ContentGrid">
    <local:DragCountIndicator HorizontalAlignment="Right" VerticalAlignment="Bottom" Count="{Binding Count, ElementName=Self}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type local:DragCountIndicator}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="1" Binding="{Binding Count, ElementName=Self}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </local:DragCountIndicator>
  </Grid>
</UserControl>