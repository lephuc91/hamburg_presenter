<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.DownloadInProgressIndicator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Pro.UI.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:theming="clr-namespace:Pro.UI.Theming" xmlns:uiThemes="clr-namespace:Pro.UI.Themes" x:Name="Self">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="AnimatedInProgressEllipse" TargetType="{x:Type Ellipse}">
        <Setter Property="RenderTransform">
          <Setter.Value>
            <RotateTransform />
          </Setter.Value>
        </Setter>
        <Setter Property="UIElement.RenderTransformOrigin" Value="0.5, 0.5" />
        <Setter Property="Stroke" Value="{StaticResource CommonBrush_LightContent}" />
        <Setter Property="Shape.StrokeDashCap" Value="Round" />
        <Style.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation RepeatBehavior="Forever" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="360" Duration="0:0:5" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="LargeAnimatedInProgressEllipse" BasedOn="{StaticResource AnimatedInProgressEllipse}" TargetType="{x:Type Ellipse}">
        <Setter Property="Shape.StrokeDashArray" Value="2,3" />
        <Setter Property="StrokeThickness" Value="2" />
      </Style>
      <Style x:Key="SmallAnimatedInProgressEllipse" BasedOn="{StaticResource AnimatedInProgressEllipse}" TargetType="{x:Type Ellipse}">
        <Setter Property="Shape.StrokeDashArray" Value="3,4" />
        <Setter Property="StrokeThickness" Value="3" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Template>
    <ControlTemplate TargetType="{x:Type local:DownloadInProgressIndicator}">
      <Viewbox>
        <Grid Margin="{TemplateBinding local:DownloadInProgressIndicator.ContentMargin}">
          <Ellipse Name="EllipseIndicator" />
          <Image Name="DownloadArrow" Source="{StaticResource {x:Static uiThemes:Icons.DownloadArrow}}" />
        </Grid>
      </Viewbox>
      <ControlTemplate.Triggers>
        <DataTrigger Value="True" Binding="{Binding UseSmallRing, RelativeSource={RelativeSource Self}}">
          <Setter TargetName="DownloadArrow" Property="FrameworkElement.Margin" Value="8" />
          <Setter TargetName="EllipseIndicator" Value="{StaticResource SmallAnimatedInProgressEllipse}" Property="FrameworkElement.Style" />
        </DataTrigger>
        <DataTrigger Value="False" Binding="{Binding UseSmallRing, RelativeSource={RelativeSource Self}}">
          <Setter TargetName="DownloadArrow" Property="FrameworkElement.Margin" Value="10" />
          <Setter TargetName="EllipseIndicator" Value="{StaticResource LargeAnimatedInProgressEllipse}" Property="FrameworkElement.Style" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</UserControl>