<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.BubbleColorPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:Pro.UI.Converters" xmlns:local="clr-namespace:Pro.UI.Controls" xmlns:math="http://hexinnovation.com/math" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" x:Name="bubbleColorPicker">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="bubblePickerProxy" Data="{Binding ElementName=bubbleColorPicker}" />
      <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <converters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <DropShadowEffect x:Key="Shadow" BlurRadius="8" Direction="270" Opacity="0.7" ShadowDepth="1" Color="{StaticResource {x:Static themesUI:Colors.Shadow}}" />
      <Style x:Key="SelectedColor_Ellipse_Style" TargetType="{x:Type Ellipse}">
        <Setter Property="UIElement.Effect" Value="{StaticResource Shadow}" />
        <Setter Property="Fill" Value="#FFFFFFFF" />
        <Setter Property="Height">
          <Setter.Value>
            <ConvertExtension p14:ConvertExtension.x="{Binding Data.BubbleHeight, Source={StaticResource bubblePickerProxy}}" xmlns:p14="clr-namespace:HexInnovation;assembly=MathConverter" xmlns="clr-namespace:HexInnovation;assembly=MathConverter">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">x-8</Ctor>
            </ConvertExtension>
          </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width">
          <Setter.Value>
            <ConvertExtension p14:ConvertExtension.x="{Binding Data.BubbleWidth, Source={StaticResource bubblePickerProxy}}" xmlns:p14="clr-namespace:HexInnovation;assembly=MathConverter" xmlns="clr-namespace:HexInnovation;assembly=MathConverter">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">x-8</Ctor>
            </ConvertExtension>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ItemsControl>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <DataTemplate x:Key="{DataTemplateKey {x:Type Color}}" DataType="{x:Type Color}">
          <local:BorderlessButton Click="DefaultColor_Click">
            <Grid>
              <Ellipse StrokeThickness="0.5" Width="{Binding Data.BubbleWidth, Source={StaticResource bubblePickerProxy}}" Height="{Binding Data.BubbleHeight, Source={StaticResource bubblePickerProxy}}" Fill="{Binding Converter={StaticResource ColorToBrushConverter}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:BorderlessButton}}}" />
              <Ellipse>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource SelectedColor_Ellipse_Style}" TargetType="{x:Type Ellipse}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding>
                          <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                            <Binding />
                            <Binding Path="Data.SelectedColor" Source="{StaticResource bubblePickerProxy}" />
                          </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Ellipse>
            </Grid>
          </local:BorderlessButton>
        </DataTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemsSource>
      <CompositeCollection>
        <CollectionContainer Collection="{Binding Data.DefaultColors, Source={StaticResource bubblePickerProxy}}" />
        <local:ColorPicker Margin="2,0,0,0" FocusVisualStyle="{x:Null}" SelectedColor="{Binding ElementName=bubbleColorPicker, Path=SelectedColor, Mode=TwoWay}" UsingAlphaChannel="{Binding ElementName=bubbleColorPicker, Path=AllowAlpha}" Visibility="{Binding ElementName=bubbleColorPicker, Path=ShowMoreColors, Converter={StaticResource ValueToVisibilityConverter}}">
          <ColorPicker.ButtonStyle xmlns="http://schemas.xceed.com/wpf/xaml/toolkit">
            <Style TargetType="{x:Type ToggleButton}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate>
                    <Grid>
                      <Image RenderOptions.BitmapScalingMode="Fant" Source="/Pro.UI;component/Resources/Icons/Rainbow.png" Stretch="Uniform" Width="{Binding Data.BubbleWidth, Source={StaticResource bubblePickerProxy}}" Height="{Binding Data.BubbleHeight, Source={StaticResource bubblePickerProxy}}" />
                      <Ellipse Style="{StaticResource SelectedColor_Ellipse_Style}" Visibility="{Binding Data.IsCustomColor, Source={StaticResource bubblePickerProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ColorPicker.ButtonStyle>
        </local:ColorPicker>
      </CompositeCollection>
    </ItemsControl.ItemsSource>
  </ItemsControl>
</UserControl>