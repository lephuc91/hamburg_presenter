<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.ContentHeader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pro.UI.Controls" x:Name="self">
  <DockPanel>
    <TextBlock FontWeight="Bold" Foreground="{Binding Foreground, ElementName=self}" Text="{Binding HeaderText, ElementName=self}" />
    <Rectangle Height="1" Margin="5,0,0,0" SnapsToDevicePixels="True" Fill="{Binding DividerColor, ElementName=self}" />
  </DockPanel>
</UserControl>