<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.Bubble" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="self" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI">
  <Ellipse Name="Ellipse" StrokeThickness="1" Width="{Binding BubbleSize}" Height="{Binding BubbleSize}" Stroke="{Binding Stroke}">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Ellipse}">
        <Setter Property="Fill" Value="{Binding DefaultFill}" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsActive, ElementName=self}">
            <Setter Property="Fill" Value="{Binding ActiveFill}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
  </Ellipse>
</UserControl>