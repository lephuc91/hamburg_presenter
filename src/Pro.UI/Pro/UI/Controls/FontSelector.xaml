<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.FontSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls" xmlns:commonConverters="clr-namespace:Pro.UI.Converters" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="fontSelector">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="fontSelectorProxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type commonControls:FontSelector}}}" />
      <commonConverters:FontInfoToFontConverter x:Key="FontInfoToFontConverter" />
      <commonConverters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverter" />
      <commonConverters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverterInverted" IsInverted="True" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:SafeFirstFontConverter x:Key="SafeFirstFontConverter" />
      <DataTemplate x:Key="FontOptionTemplate">
        <Grid>
          <TextBlock VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="{Binding DisplayName}" Visibility="{Binding FontInfo, Converter={StaticResource IsNotNullToVisibilityConverter}}" FontFamily="{Binding Path=FontInfo.SystemFamilyName}" />
          <TextBlock VerticalAlignment="Center" FontStyle="Italic" Foreground="#FFFFFFFF" Text="{Binding DisplayName}" Visibility="{Binding FontInfo, Converter={StaticResource IsNotNullToVisibilityConverterInverted}}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="EnhancedFontGroupTemplate">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <commonControls:FormattedTextBlock Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" EnsureUnicodeDisplay="True" FontBrush="{Binding (TextElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}" FontSelection="{Binding Fonts, Mode=OneTime, Converter={StaticResource SafeFirstFontConverter}}" FormattedText="{Binding DisplayName, Mode=OneTime}" UnicodeFont="{Binding Data.UnicodeCapableFont.Info, Mode=OneTime, Source={StaticResource fontSelectorProxy}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type commonControls:FormattedTextBlock}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsMissing}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Fonts}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="0" Binding="{Binding Fonts.Length}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </commonControls:FormattedTextBlock>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding DisplayName}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontStyle" Value="Normal" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsMissing}">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Value="False" Binding="{Binding IsMissing}" />
                      <Condition Binding="{Binding Fonts}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Value="False" Binding="{Binding IsMissing}" />
                      <Condition Value="0" Binding="{Binding Fonts.Length}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <Border Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsMissing, ConverterParameter=True, Converter={StaticResource ValueToVisibilityConverter}}">
            <Image Width="12" Height="12" Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/WarningIcon.png" StretchDirection="DownOnly" />
          </Border>
        </Grid>
      </DataTemplate>
      <ControlTemplate x:Key="CustomComboBoxTemplate" TargetType="{x:Type ComboBox}">
        <Grid Name="templateRoot" SnapsToDevicePixels="true">
          <Border Name="backgroundBorder" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="true" Background="{Binding DropdownBackground, ElementName=fontSelector}" />
          <Popup Name="PART_Popup" Margin="1" Placement="Bottom" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Name="dropDownBorder" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" BorderBrush="#FF999999" BorderThickness="1" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" Background="{Binding DropdownBackground, ElementName=fontSelector}">
              <ScrollViewer Name="DropDownScrollViewer">
                <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </ScrollViewer>
            </Border>
          </Popup>
          <ToggleButton Name="toggleButton" Background="#00FFFFFF" BorderThickness="0" Focusable="false" IsTabStop="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
          <Border Width="20" HorizontalAlignment="Right" IsHitTestVisible="False">
            <Path Name="arrow" Margin="0,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" Fill="#FFFFFFFF" />
          </Border>
          <ContentPresenter Name="contentPresenter" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" IsHitTestVisible="false" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" TextElement.Foreground="#FFFFFFFF" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="true">
            <Setter TargetName="backgroundBorder" Property="Border.BorderBrush" Value="#FF569DE5" />
          </Trigger>
          <Trigger Property="ComboBox.IsDropDownOpen" Value="true">
            <Setter TargetName="backgroundBorder" Property="Border.BorderBrush" Value="#FF569DE5" />
          </Trigger>
          <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="true">
            <Setter TargetName="dropDownBorder" Property="FrameworkElement.Margin" Value="0,2,0,0" />
          </Trigger>
          <Trigger Property="ItemsControl.HasItems" Value="false">
            <Setter TargetName="dropDownBorder" Property="FrameworkElement.Height" Value="95" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="false">
            <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Control.Foreground" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="CustomFontOptionsStyle" BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Template" Value="{StaticResource CustomComboBoxTemplate}" />
      </Style>
      <Style x:Key="CustomComboBoxItemStyle" BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Padding" Value="4,2" />
        <Style.Triggers>
          <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
            <Setter Property="Background" Value="#FF3E3E3E" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
          </Trigger>
          <Trigger Property="ListBoxItem.IsSelected" Value="True">
            <Setter Property="Background" Value="#FF569DE5" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <ComboBox Name="fontFamily" Height="22" Margin="0,0,0,0" ItemsSource="{Binding Path=EnhancedFontGroups, ElementName=fontSelector}" SelectedItem="{Binding Path=SelectedFontGroup, ElementName=fontSelector}" Visibility="{Binding Path=CustomFontOptions, ElementName=fontSelector, Converter={StaticResource IsNotNullToVisibilityConverterInverted}}" ItemTemplate="{StaticResource ResourceKey=EnhancedFontGroupTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Width" Value="{Binding ElementName=fontFamily, Path=ActualWidth}" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsMissing}">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="UIElement.Opacity" Value="0.7" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ComboBox>
      <ComboBox Name="customFontOptions" Grid.Row="0" Height="22" Margin="0,0,0,0" ItemTemplate="{StaticResource FontOptionTemplate}" Style="{StaticResource CustomFontOptionsStyle}" ItemsSource="{Binding Path=CustomFontOptions, ElementName=fontSelector}" SelectedItem="{Binding Path=SelectedCustomOption, ElementName=fontSelector, Mode=TwoWay}" Visibility="{Binding Path=CustomFontOptions, ElementName=fontSelector, Converter={StaticResource IsNotNullToVisibilityConverter}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource CustomComboBoxItemStyle}" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Width" Value="{Binding ElementName=customFontOptions, Path=ActualWidth}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ComboBox>
      <Grid Row="0" Height="22" Margin="0,0,14,0" IsHitTestVisible="False">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Path=CustomFontOptions, ElementName=fontSelector}" Value="{x:Null}" />
                  <Condition Binding="{Binding Path=SelectedFontGroup, ElementName=fontSelector}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="4,2,4,2" VerticalAlignment="Center">
          <Image Width="12" Height="12" Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/WarningIcon.png" StretchDirection="DownOnly" />
        </Border>
        <TextBlock Grid.Column="1" Padding="0,2,0,0" VerticalAlignment="Center" FontStyle="Italic" Text="{Binding MissingFont, ElementName=fontSelector, Mode=OneWay}" />
      </Grid>
      <Grid Row="1" Margin="0,7,0,0" Visibility="{Binding ElementName=fontSelector, Path=CanChangeCharacterSize, Converter={StaticResource ValueToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox Grid.Column="0" Height="22" IsEnabled="{Binding ElementName=fontSelector, Path=SelectedFontGroup, Converter={StaticResource IsNotNullToBoolConverter}, Mode=OneWay}" ItemsSource="{Binding SelectedItem.Fonts, ElementName=fontFamily}" SelectedItem="{Binding SelectedFontInfo, ElementName=fontSelector, Mode=TwoWay, Converter={StaticResource FontInfoToFontConverter}}" Visibility="{Binding Path=CustomFontOptions, ElementName=fontSelector, Converter={StaticResource IsNotNullToVisibilityConverterInverted}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <commonControls:FormattedTextBlock VerticalAlignment="Center" EnsureUnicodeDisplay="True" FontBrush="{Binding (TextElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}" FontSelection="{Binding Info, Mode=OneTime}" FormattedText="{Binding Info.DisplayFaceName, Mode=OneTime}" UnicodeFont="{Binding Data.UnicodeCapableFont.Info, Mode=OneTime, Source={StaticResource fontSelectorProxy}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="1" Binding="{Binding SelectedItem.Fonts.Count, ElementName=fontFamily}">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ComboBox>
        <commonControls:IntegerUpDown x:Name="characterSizeUpDown" Grid.Column="1" Margin="7,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Maximum="1000" Minimum="1" Style="{DynamicResource IntegerUpdownControlStyle}" IsEnabled="{Binding CharacterSizeEnabled, ElementName=fontSelector}" Value="{Binding SelectedCharacterSize, ElementName=fontSelector}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>