<?xml version="1.0" encoding="utf-8"?>
<ToggleButton x:Class="Pro.UI.Controls.ToggleSwitch" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="34" Height="20" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI">
  <Control.Template>
    <ControlTemplate TargetType="{x:Type ToggleButton}">
      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Ellipse Name="toggleEllipse" Width="17" Height="17" Margin="1,0,1,0" VerticalAlignment="Center" Fill="{TemplateBinding Control.Foreground}" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="ToggleButton.IsChecked" Value="True">
          <Setter TargetName="toggleEllipse" Property="FrameworkElement.HorizontalAlignment" Value="Right" />
        </Trigger>
        <Trigger Property="ToggleButton.IsChecked" Value="False">
          <Setter TargetName="toggleEllipse" Property="FrameworkElement.HorizontalAlignment" Value="Left" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
</ToggleButton>