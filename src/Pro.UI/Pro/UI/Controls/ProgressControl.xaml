<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.ProgressControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pro.UI.Controls" x:Name="progressControl">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ProgressBar Grid.Column="0" Margin="0,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Maximum="1" Minimum="0" Value="{Binding Progress, Mode=OneWay, ElementName=progressControl}" />
    <local:CloseButton Grid.Column="1" Width="12" Height="12" Margin="0,0,10,0" Command="{Binding CancelCommand, ElementName=progressControl}" />
  </Grid>
</UserControl>