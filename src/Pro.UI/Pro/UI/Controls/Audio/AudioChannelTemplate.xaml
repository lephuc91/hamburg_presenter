<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.Audio.AudioChannelTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls" xmlns:commonConverters="clr-namespace:Pro.UI.Converters" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions" x:Name="self" xmlns:audio="clr-namespace:Pro.UI.Controls.Audio">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:IndexToItemNumberConverter x:Key="IndexToItemNumberConverter" />
      <Style x:Key="OrientationStyle" TargetType="{x:Type FrameworkElement}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
          <DataTrigger Value="Column" Binding="{Binding Orientation, ElementName=self}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="RotationOrientationStyle" BasedOn="{StaticResource OrientationStyle}" TargetType="{x:Type FrameworkElement}">
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsNameVertical, ElementName=self}">
            <Setter Property="FrameworkElement.LayoutTransform">
              <Setter.Value>
                <RotateTransform Angle="-90" />
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <commonControls:EditableTextBlock x:Name="EditableNameText" HorizontalContentAlignment="Right" Style="{StaticResource RotationOrientationStyle}" Text="{Binding AudioChannel.Name, ElementName=self, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowChannelIndex, ElementName=self, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
    <TextBlock Style="{StaticResource RotationOrientationStyle}" Text="{Binding AudioChannel.Index, ElementName=self, Converter={StaticResource IndexToItemNumberConverter}}" ToolTip="{Binding AudioChannel.Name, ElementName=self}" Visibility="{Binding ShowChannelIndex, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}}" />
    <StackPanel Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal" Style="{StaticResource OrientationStyle}" Visibility="{Binding ShowAudioChannelControls, Converter={StaticResource ValueToVisibilityConverter}, ElementName=self}">
      <ToggleButton Width="17" Height="20" BorderThickness="1" Content="{mex:Localized AUDIO_PREFERENCES_MUTE_BUTTON_title}" IsChecked="{Binding AudioChannel.MuteActive, ElementName=self, Mode=TwoWay}" ToolTip="{mex:Localized AUDIO_PREFERENCES_MUTE_BUTTON_tooltip}" Visibility="{Binding ShowMuteControls, Converter={StaticResource ValueToVisibilityConverter}, ElementName=self}" />
      <ToggleButton Width="17" Height="20" BorderThickness="0,1,1,1" Content="{mex:Localized AUDIO_PREFERENCES_SOLO_BUTTON_title}" IsChecked="{Binding AudioChannel.SoloActive, ElementName=self, Mode=TwoWay}" ToolTip="{mex:Localized AUDIO_PREFERENCES_SOLO_BUTTON_tooltip}" Visibility="{Binding ShowSoloControls, Converter={StaticResource ValueToVisibilityConverter}, ElementName=self}" />
      <ToggleButton Width="17" Height="20" BorderThickness="0,1,1,1" Content="{mex:Localized AUDIO_PREFERENCES_TEST_TONE_BUTTON_title}" IsChecked="{Binding AudioChannel.TestActive, ElementName=self, Mode=TwoWay}" ToolTip="{mex:Localized AUDIO_PREFERENCES_TEST_TONE_BUTTON_tooltip}" Visibility="{Binding ShowTestControls, Converter={StaticResource ValueToVisibilityConverter}, ElementName=self}" />
    </StackPanel>
  </Grid>
</UserControl>