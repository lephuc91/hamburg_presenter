<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Pro.UI.Controls.Audio.RouterMasterControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls" xmlns:commonConverters="clr-namespace:Pro.UI.Converters" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions" xmlns:uiUtility="clr-namespace:Pro.UI.Utility" x:Name="self" Width="120" Height="60" xmlns:audio="clr-namespace:Pro.UI.Controls.Audio">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <Style x:Key="buttonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="uiUtility:ContextMenuHelper.OpenOnLeftClick" Value="True" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button Style="{StaticResource buttonStyle}" Visibility="{Binding AutoOnly, ElementName=self, Converter={StaticResource InvertedValueToVisibilityConverter}}">
      <FrameworkElement.ContextMenu>
        <ContextMenu HasDropShadow="False" Placement="Bottom">
          <MenuItem Header="{mex:Localized AUDIO_PREFERENCES_CHANNEL_AUTO_MAP_BUTTON_title}" Click="AutoMapClicked" />
          <MenuItem Header="{mex:Localized AUDIO_PREFERENCES_CHANNEL_CLEAR_MAP_BUTTON_title}" Click="ClearMapClicked" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="tbMapping" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized AUDIO_PREFERENCES_CHANNEL_MAPPING_BUTTON_title}" />
        <commonControls:PathControl Grid.Column="1" Width="6" Height="5" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" PathType="DownArrow" Fill="{Binding Foreground, ElementName=tbMapping}" Stroke="{Binding Foreground, ElementName=tbMapping}" />
      </Grid>
    </Button>
    <Button Style="{StaticResource buttonStyle}" Content="{mex:Localized AUDIO_PREFERENCES_CHANNEL_AUTO_MAP_BUTTON_title}" Visibility="{Binding AutoOnly, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}}" Click="AutoMapClicked" />
    <StackPanel Margin="0,5,0,0" Orientation="Horizontal" Visibility="{Binding ShowMuteAndSoloButtons, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}}">
      <ToggleButton Padding="3,0" Content="{mex:Localized AUDIO_PREFERENCES_MUTE_BUTTON_title}" IsChecked="{Binding Muted, ElementName=self}" ToolTip="{mex:Localized AUDIO_PREFERENCES_MUTE_BUTTON_tooltip}" />
      <ToggleButton Padding="3,0" BorderThickness="0,1,1,1" Content="{mex:Localized AUDIO_PREFERENCES_SOLO_BUTTON_title}" IsChecked="{Binding SoloActive, ElementName=self}" ToolTip="{mex:Localized AUDIO_PREFERENCES_SOLO_BUTTON_tooltip}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
            <Style.Triggers>
              <Trigger Property="ToggleButton.IsChecked" Value="False">
                <Setter Property="IsEnabled" Value="False" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ToggleButton>
    </StackPanel>
  </StackPanel>
</UserControl>