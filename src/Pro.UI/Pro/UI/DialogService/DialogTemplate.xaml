<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="Pro.UI.DialogService.DialogTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Pro.UI.Converters" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing" x:Name="self" KeyDown="Dialog_KeyDown" PreviewKeyDown="Dialog_PreviewKeyDown" Title="DialogTemplate" MaxWidth="500" uiUtility:WindowHelper.ChildOf="ActiveWindow" uiUtility:WindowHelper.UseGlobalStyle="True" CanClose="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:dialogservice="clr-namespace:Pro.UI.DialogService" Resources="{converters:BooleanToVisibilityConverter Key=InvertedBooleanToVisibilityConverter, Invert=True}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="60" Height="60" Margin="0,0,10,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="Fant" Stretch="Uniform" Visibility="{Binding HideIcon, ElementName=self, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Image}">
            <Setter Property="Source" Value="{Binding DialogIcon, ElementName=self}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding DialogIcon, ElementName=self}" Value="{x:Null}">
                <Setter Property="Source" Value="{StaticResource {x:Static themesUI:Icons.AppIcon}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Image>
      <ContentControl Name="CustomContent" Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{Binding Foreground, ElementName=self}" />
    </Grid>
    <WrapPanel Name="ButtonsPanel" Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" />
  </Grid>
</windowing:ChromedWindow>