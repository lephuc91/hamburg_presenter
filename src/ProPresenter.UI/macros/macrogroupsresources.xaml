<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI">
  <ContextMenu x:Key="CollectionContextMenu">
    <MenuItem IsEnabled="False" Header="{mex:Localized GLOBAL_RENAME_MENU_ITEM_title}" />
    <MenuItem IsEnabled="False" Header="{mex:Localized MACROS_CONTEXTUAL_MENU_COLOR_label}" />
    <MenuItem IsEnabled="False" Header="{mex:Localized MACROS_CONTEXTUAL_MENU_ICON_label}" />
    <MenuItem IsEnabled="False" Header="{mex:Localized MACROS_CONTEXTUAL_MENU_TRIGGER_ON_STARTUP_label}" />
    <Separator />
    <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.CutCommand}" />
    <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Copy}" />
    <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Paste}" />
    <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Duplicate}" />
    <Separator />
    <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" />
  </ContextMenu>
</ResourceDictionary>