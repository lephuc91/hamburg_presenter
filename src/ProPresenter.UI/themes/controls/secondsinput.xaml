<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:ProPresenter.UI.Controls" xmlns:themes="clr-namespace:ProPresenter.UI.Themes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Pro.UI;component/Themes/Brushes.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static themes:Styles.SecondsInput}" TargetType="{x:Type c:SecondsInput}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:SecondsInput}">
          <TextBox Name="PART_Input" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>