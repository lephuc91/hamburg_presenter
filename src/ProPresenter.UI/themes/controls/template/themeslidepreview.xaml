<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:themes="clr-namespace:ProPresenter.UI.Themes" xmlns:theming="clr-namespace:ProPresenter.UI.Theming">
  <Style x:Key="{x:Static themes:Styles.ThemeSlidePreview}" TargetType="{x:Type ContentControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Border Name="PART_ThumbnailBorder" Width="92" Height="52" Background="#00FFFFFF">
              <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
                <Grid>
                  <commonControls:Checkerboard Width="{Binding ActualWidth, ElementName=PART_Thumbnail}" Height="{Binding ActualHeight, ElementName=PART_Thumbnail}" PrimaryBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" SecondaryBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" />
                  <Image Name="PART_Thumbnail" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" Stretch="Uniform" />
                </Grid>
              </Border>
            </Border>
            <commonControls:EditableTextBlock Name="PART_Name" Grid.Row="1" CanEdit="False" Visibility="Collapsed" />
            <Border Name="PART_SelectionBorder" Visibility="Collapsed" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>