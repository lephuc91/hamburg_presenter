<?xml version="1.0" encoding="utf-8"?>
<ui:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cues="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:doActions="clr-namespace:ProPresenter.DO.Actions;assembly=ProPresenter.DO" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:pcoDO="clr-namespace:ProPresenter.DO.PCO;assembly=ProPresenter.DO" xmlns:presenation="clr-namespace:ProPresenter.DO.Presentation;assembly=ProPresenter.DO" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI">
  <Style x:Key="CueIconStyle" TargetType="{x:Type Image}">
    <Style.Triggers>
      <DataTrigger Value="{x:Static cues:CueType.Header}" Binding="{Binding Type}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="{x:Static pcoDO:PCOItemType.Header}" Binding="{Binding PCOItemType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Collapsed" />
      </MultiDataTrigger>
      <DataTrigger Value="{x:Static cues:CueType.Document}" Binding="{Binding Type}">
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.PresentationIcon}}" />
      </DataTrigger>
      <DataTrigger Value="{x:Static cues:CueType.Placeholder}" Binding="{Binding Type}">
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.PlaceholderIcon}}" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Document}" Binding="{Binding Type}" />
          <Condition Value="{x:Static presenation:PresentationType.MultiTracks}" Binding="{Binding DocumentAction.PresentationType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.MultiTracksIcon}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Media}" Binding="{Binding Type}" />
          <Condition Value="{x:Static media:MediaType.Image}" Binding="{Binding MediaAction.Media.MediaType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/Outline/MediaItem.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Media}" Binding="{Binding Type}" />
          <Condition Value="{x:Static media:MediaType.Video}" Binding="{Binding MediaAction.Media.MediaType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/Outline/MediaItem.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Media}" Binding="{Binding Type}" />
          <Condition Value="{x:Static media:MediaType.Audio}" Binding="{Binding MediaAction.Media.MediaType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/Outline/AudioItem.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Media}" Binding="{Binding Type}" />
          <Condition Value="{x:Static media:MediaType.LiveVideo}" Binding="{Binding MediaAction.Media.MediaType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/SlideElements/slideElementVideoInput.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Media}" Binding="{Binding Type}" />
          <Condition Value="{x:Static media:MediaType.Web}" Binding="{Binding MediaAction.Media.MediaType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/SlideElements/slideElementWeb.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Placeholder}" Binding="{Binding Type}" />
          <Condition Value="{x:Static doActions:LinkState.Unlinked}" Binding="{Binding PlaceholderAction.State}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.PlaceholderIcon}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Placeholder}" Binding="{Binding Type}" />
          <Condition Value="{x:Static doActions:LinkState.DocumentLinked}" Binding="{Binding PlaceholderAction.State}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.PresentationIcon}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Placeholder}" Binding="{Binding Type}" />
          <Condition Value="{x:Static doActions:LinkState.DocumentLinked}" Binding="{Binding PlaceholderAction.State}" />
          <Condition Value="{x:Static presenation:PresentationType.MultiTracks}" Binding="{Binding DocumentAction.PresentationType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.MultiTracksIcon}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.Placeholder}" Binding="{Binding Type}" />
          <Condition Value="{x:Static doActions:LinkState.MediaLinked}" Binding="{Binding PlaceholderAction.State}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/Outline/MediaItem.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="{x:Static pcoDO:PCOItemType.Song}" Binding="{Binding PCOItemType}" />
          <Condition Value="Unlinked" Binding="{Binding PCOAction.LinkedObjectType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.PCOSong}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="DocumentLinked" Binding="{Binding PCOAction.LinkedObjectType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.PresentationIcon}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="DocumentLinked" Binding="{Binding PCOAction.LinkedObjectType}" />
          <Condition Value="{x:Static presenation:PresentationType.MultiTracks}" Binding="{Binding DocumentAction.PresentationType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.MultiTracksIcon}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="{x:Static pcoDO:PCOItemType.Song}" Binding="{Binding PCOItemType}" />
          <Condition Value="MediaLinked" Binding="{Binding PCOAction.LinkedObjectType}" />
          <Condition Value="Image" Binding="{Binding PCOAction.MediaAction.Media.MediaType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/Outline/MediaItem.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="MediaLinked" Binding="{Binding PCOAction.LinkedObjectType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/Outline/MediaItem.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="{x:Static pcoDO:PCOItemType.Media}" Binding="{Binding PCOItemType}" />
          <Condition Value="Unlinked" Binding="{Binding PCOAction.LinkedObjectType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/PCO/pcoMediaItem.png" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
          <Condition Value="{x:Static pcoDO:PCOItemType.Plan}" Binding="{Binding PCOItemType}" />
          <Condition Value="Unlinked" Binding="{Binding PCOAction.LinkedObjectType}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Source" Value="Resources/Icons/PCO/pcoItem.png" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ui:SharedResourceDictionary>