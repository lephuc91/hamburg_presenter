<?xml version="1.0" encoding="utf-8"?>
<ui:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.PCOLive" xmlns:pco="clr-namespace:ProPresenter.DO.PCO;assembly=ProPresenter.DO" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI">
  <ResourceDictionary.MergedDictionaries>
    <ui:SharedResourceDictionary Source="../SourceDetailListResources.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <local:FlattenPCOFolderConverter x:Key="FlattenPCOFolderConverter" />
  <Style x:Key="IconBaseStyle" TargetType="{x:Type FrameworkElement}">
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="16" />
  </Style>
  <Style x:Key="PCOFolderItemIcon" BasedOn="{StaticResource IconBaseStyle}" TargetType="{x:Type Rectangle}">
    <Setter Property="Fill" Value="{Binding LISTITEM_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}" />
    <Setter Property="UIElement.OpacityMask">
      <Setter.Value>
        <ImageBrush ImageSource="/ProPresenter.UI;component/Resources/Icons/PCO/pcoFolder.png" RenderOptions.BitmapScalingMode="Fant" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PCOItemIcon" BasedOn="{StaticResource PCOFolderItemIcon}" TargetType="{x:Type Rectangle}">
    <Setter Property="UIElement.OpacityMask">
      <Setter.Value>
        <ImageBrush ImageSource="/ProPresenter.UI;component/Resources/Icons/PCO/pcoServiceItem.png" RenderOptions.BitmapScalingMode="Fant" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ServiceTypeIconStyle" TargetType="{x:Type ContentControl}">
    <Setter Property="Content">
      <Setter.Value>
        <Rectangle Style="{StaticResource PCOFolderItemIcon}" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding IsLoading}">
        <Setter Property="Content">
          <Setter.Value>
            <commonControls:LoadingIndicator DisplayMode="Spinner" Style="{StaticResource IconBaseStyle}" />
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TextStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{Binding LISTITEM_CONTENT, Source={x:Static theming:AppTheme.Active}}" />
    <Setter Property="Margin" Value="5,0,0,0" />
    <Setter Property="Text" Value="{Binding Name}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type pco:PCOFolder}}" DataType="{x:Type pco:PCOFolder}" ItemsSource="{Binding Converter={StaticResource FlattenPCOFolderConverter}}">
    <StackPanel Margin="3" Orientation="Horizontal">
      <Rectangle Style="{StaticResource PCOFolderItemIcon}" />
      <TextBlock Style="{StaticResource TextStyle}" />
    </StackPanel>
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type pco:PCOServiceType}}" DataType="{x:Type pco:PCOServiceType}" ItemsSource="{Binding Plans}">
    <StackPanel Margin="3" Orientation="Horizontal">
      <ContentControl Style="{StaticResource ServiceTypeIconStyle}" />
      <TextBlock Style="{StaticResource TextStyle}" />
    </StackPanel>
  </HierarchicalDataTemplate>
  <DataTemplate x:Key="{DataTemplateKey {x:Type pco:PCOPlan}}" DataType="{x:Type pco:PCOPlan}">
    <StackPanel Margin="3" Orientation="Horizontal">
      <Rectangle Style="{StaticResource PCOItemIcon}" />
      <TextBlock Style="{StaticResource TextStyle}" />
    </StackPanel>
  </DataTemplate>
</ui:SharedResourceDictionary>