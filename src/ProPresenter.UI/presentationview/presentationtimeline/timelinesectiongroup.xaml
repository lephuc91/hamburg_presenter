<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.PresentationView.PresentationTimeline" xmlns:themes="clr-namespace:ProPresenter.UI.Themes">
  <Style x:Key="{x:Static themes:Styles.TimelineSectionGroup}" TargetType="{x:Type local:TimelineSectionGroup}">
    <Setter Property="BorderBrush" Value="#FF000000" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="local:TimelineSection.CornerRadius" Value="2" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimelineSectionGroup}">
          <Border Padding="{TemplateBinding Control.Padding}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding local:TimelineSection.CornerRadius}">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontWeight="Bold" Text="{TemplateBinding local:TimelineSection.Label}" TextTrimming="CharacterEllipsis" Foreground="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}, Converter={converters:ColorInverterConverter}}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>