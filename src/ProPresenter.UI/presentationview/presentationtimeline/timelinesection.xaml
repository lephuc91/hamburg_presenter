<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.PresentationView.PresentationTimeline" xmlns:math="http://hexinnovation.com/math" xmlns:themes="clr-namespace:ProPresenter.UI.Themes" xmlns:themes1="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming;assembly=ProPresenter.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common">
  <Style x:Key="{x:Static themes:Styles.TimelineSection}" TargetType="{x:Type local:TimelineSection}">
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static themes1:Brushes.TimelineSectionBorder}}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="local:TimelineSection.CornerRadius" Value="2" />
    <Setter Property="Height">
      <Setter.Value>
        <PriorityBinding>
          <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType={x:Type local:TimelineRow}}" />
        </PriorityBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimelineSection}">
          <Grid>
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <utility:BindingProxy x:Key="BindingProxy_TimelineSection" Data="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}}" />
                <converters:ValueToVisibilityConverter x:Key="Converter_ValueToVisibility" />
                <converters:MultiBindingEqualityConverter x:Key="Converter_MultiBindingEquality" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <Border Name="PART_Border" Padding="4" Background="{TemplateBinding Control.Background}" CornerRadius="{TemplateBinding local:TimelineSection.CornerRadius}">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{Binding Item.Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}, Converter={converters:ColorInverterConverter}}" Text="{Binding Label, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}}" />
            </Border>
            <Border VerticalAlignment="Bottom" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1,0,0,0">
              <FrameworkElement.Height>
                <ConvertExtension p18:ConvertExtension.x="{Binding ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}}" xmlns:p18="clr-namespace:HexInnovation;assembly=MathConverter" xmlns="clr-namespace:HexInnovation;assembly=MathConverter">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">x/2</Ctor>
                </ConvertExtension>
              </FrameworkElement.Height>
              <UIElement.Visibility>
                <ConvertExtension p18:ConvertExtension.x="{Binding Index, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}}" p18:ConvertExtension.y="{Binding HasGroups, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineRow}}}" xmlns:p18="clr-namespace:HexInnovation;assembly=MathConverter" xmlns="clr-namespace:HexInnovation;assembly=MathConverter">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">And(x&gt;0,y) ? `Visible` : `Collapsed`</Ctor>
                </ConvertExtension>
              </UIElement.Visibility>
            </Border>
            <Border Name="PART_Overlay" BorderThickness="1" Background="{StaticResource {x:Static themes1:Brushes.ControlOverlay}}" BorderBrush="{Binding SECONDARY, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}, Converter={StaticResource Converter_ValueToVisibility}}" />
            <Popup Name="PART_CurrentTimeToolTip" AllowsTransparency="True" Placement="Relative" StaysOpen="True" PlacementTarget="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineSection}}}">
              <Border Style="{StaticResource {x:Static themes1:Styles.PopupBorder}}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Data.StartTime, Source={StaticResource BindingProxy_TimelineSection}, Converter={converters:FormattedTimeSliceConverter}}" />
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
          <Condition Value="True" Binding="{Binding AllowMove, RelativeSource={RelativeSource Self}}" />
          <Condition Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="FrameworkElement.Cursor" Value="ScrollWE" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>