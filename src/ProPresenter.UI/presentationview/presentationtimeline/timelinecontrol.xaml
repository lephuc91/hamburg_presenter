<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls1="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.PresentationView.PresentationTimeline" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:themes1="clr-namespace:ProPresenter.UI.Themes" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Pro.UI;component/Themes/Brushes.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static themes1:Styles.TimelineControl}" TargetType="{x:Type local:TimelineControl}">
    <Setter Property="Background" Value="{StaticResource {x:Static themes:Brushes.ControlBackground}}" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static themes:Brushes.ControlBorder}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimelineControl}">
          <Border Margin="{TemplateBinding FrameworkElement.Margin}" Padding="{TemplateBinding Control.Padding}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
            <Grid Background="{TemplateBinding Control.Background}">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <utility:BindingProxy x:Key="BindingProxy_TimelineControl" Data="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineControl}}}" />
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <local:TimelineRowItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{TemplateBinding local:TimelineControl.Rows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:Key="{DataTemplateKey {x:Type local:TimelineRow}}" DataType="{x:Type local:TimelineRow}">
                    <Border Height="{Binding ActualHeight}">
                      <controls1:Icon Margin="6,0,11,0" HorizontalAlignment="Center" VerticalAlignment="Center" IconSize="MediumSmall" Source="{Binding Icon}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </local:TimelineRowItemsControl>
              <Grid Row="0" Column="1">
                <local:TimelineDurationBar x:Name="PART_TimelineDurationBar" AllowDrawPastBounds="True" Background="{TemplateBinding Control.Background}" ItemsSource="{Binding TimeBarSections, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineControl}}}" />
                <Popup Name="PART_CurrentTimeToolTip" AllowsTransparency="True" Placement="Relative" StaysOpen="True" PlacementTarget="{Binding ElementName=PART_TimelineDurationBar}">
                  <Border Style="{StaticResource {x:Static themes:Styles.PopupBorder}}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Data.CurrentMouseOverTime, Source={StaticResource BindingProxy_TimelineControl}, Converter={converters:FormattedTimeSliceConverter}}" />
                  </Border>
                </Popup>
              </Grid>
              <ItemsControl Name="PART_TimelineItemsControl" Grid.Row="1" Grid.Column="1" ItemsSource="{TemplateBinding local:TimelineControl.Rows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <local:TimelineReserveTimeOverlay x:Name="PART_ReserveTimeOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ActualDuration="{Binding ActualDuration, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineControl}}}" VisibleDuration="{Binding VisibleDuration, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineControl}}}" VisibleDurationStart="{Binding VisibleDurationStart, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineControl}}}" Duration="{Binding Duration, Mode=TwoWay, Delay=100, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineControl}}}" />
              <local:TimelineScrollBar x:Name="PART_ScrollBar" Grid.Row="2" Grid.Column="1" />
              <Canvas Name="PART_PlayheadCanvas" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ClipToBounds="True">
                <Rectangle Name="PART_PlayheadMarker" Width="1" VerticalAlignment="Top" Panel.ZIndex="1" IsHitTestVisible="False" Fill="{StaticResource {x:Static themes:Brushes.TimelinePlayheadMarker}}" />
              </Canvas>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>