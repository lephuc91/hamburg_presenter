<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.PresentationView.PresentationTimeline" xmlns:themes1="clr-namespace:ProPresenter.UI.Themes">
  <Style x:Key="{x:Static themes1:Styles.TimelineScrollBar}" TargetType="{x:Type local:TimelineScrollBar}">
    <Setter Property="Background" Value="#6D6D6D" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimelineScrollBar}">
          <Grid Name="PART_RootPanel" Background="{TemplateBinding Control.Background}">
            <Canvas Name="PART_Track" Margin="4" Background="#00FFFFFF">
              <Border Name="PART_Thumb" Background="#424242" CornerRadius="2" Height="{Binding ActualHeight, ElementName=PART_Track}" />
            </Canvas>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="local:TimelineScrollBar.IsMouseOverThumb" Value="True">
              <Setter TargetName="PART_Thumb" Property="Border.Background" Value="#3C73AE" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>