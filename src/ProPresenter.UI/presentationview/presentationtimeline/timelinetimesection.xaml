<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.PresentationView.PresentationTimeline" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:themes1="clr-namespace:ProPresenter.UI.Themes">
  <Style x:Key="{x:Static themes1:Styles.TimelineTimeSection}" TargetType="{x:Type local:TimelineTimeSection}">
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static themes:Brushes.TimelineTickMark}}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimelineTimeSection}">
          <Border MinHeight="20" Margin="0,0,0,10" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
              <UniformGrid Name="PART_SubTicksPanel" Rows="3" Columns="{Binding SubTickCount, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TimelineTimeSection}}}" />
              <TextBlock Margin="2,0,0,0" VerticalAlignment="Bottom" FontSize="10" Foreground="{TemplateBinding Control.BorderBrush}" Text="{Binding Label}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>