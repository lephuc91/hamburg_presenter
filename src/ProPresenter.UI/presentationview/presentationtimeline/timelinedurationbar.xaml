<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.PresentationView.PresentationTimeline" xmlns:themes1="clr-namespace:ProPresenter.UI.Themes">
  <Style x:Key="{x:Static themes1:Styles.TimelineDurationBar}" TargetType="{x:Type local:TimelineDurationBar}">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Height" Value="30" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsSource" Value="{Binding Items, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimelineDurationBar}">
          <Grid Name="PART_RootPanel" Height="{TemplateBinding FrameworkElement.Height}" Background="{TemplateBinding Control.Background}">
            <ItemsPresenter Name="PART_Sections" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>