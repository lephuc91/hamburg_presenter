<?xml version="1.0" encoding="utf-8"?>
<ui:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <ResourceDictionary.MergedDictionaries>
    <ui:SharedResourceDictionary Source="Playlist/PlaylistTreeViewStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type commonControls:ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="commonControls:ListBoxItem.IsActive" Value="True" />
          <Condition Property="ListBoxItem.IsSelected" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="uiUtility:UIElementHelper.CornerRadius" Value="2" />
      </MultiTrigger>
      <Trigger Property="commonControls:ListBoxItem.IsActive" Value="True">
        <Setter Property="Background">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).InactiveSelected.Background" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).InactiveSelected.Border" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).InactiveSelected.Content" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="ListBoxItem.IsSelected" Value="True">
        <Setter Property="Background">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).Selected.Background" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).Selected.Border" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).Selected.Content" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type commonControls:TreeViewItem}" BasedOn="{StaticResource PlaylistTreeViewItemStyle}" TargetType="{x:Type commonControls:TreeViewItem}">
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="commonControls:TreeViewItem.IsActive" Value="True" />
          <Condition Property="TreeViewItem.IsSelected" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="uiUtility:UIElementHelper.CornerRadius" Value="2" />
      </MultiTrigger>
      <Trigger Property="commonControls:TreeViewItem.IsActive" Value="True">
        <Setter Property="Background">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).InactiveSelected.Background" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).InactiveSelected.Border" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).InactiveSelected.Content" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="TreeViewItem.IsSelected" Value="True">
        <Setter Property="Background">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).Selected.Background" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).Selected.Border" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
          <Setter.Value>
            <PriorityBinding>
              <Binding Path="(uiUtility:UIElementHelper.Palette).Selected.Content" RelativeSource="{RelativeSource Self}" />
            </PriorityBinding>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ui:SharedResourceDictionary>