            <Binding Path="TotalSize.Y" />
            <Binding Path="Y" />
          </PriorityBinding>
        </TextBlock.Text>
      </TextBlock>
    </StackPanel>
  </DataTemplate>
  <Style x:Key="{x:Type handles:TextOverflowHandle}" TargetType="{x:Type handles:TextOverflowHandle}">
    <Setter Property="FrameworkElement.ContextMenu">
      <Setter.Value>
        <ContextMenu Placement="Bottom">
          <MenuItem Command="{Binding EditorMenu.FitToText.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding}" />
          <MenuItem Command="{Binding EditorMenu.OverlayEdit.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding}" />
        </ContextMenu>
      </Setter.Value>
    </Setter>
    <Setter Property="uiUtility:ContextMenuHelper.OpenOnLeftClick" Value="True" />
  </Style>
  <Style x:Key="EyeCatcher_Border" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{Binding EYECATCHER_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" />
    <Setter Property="Border.CornerRadius" Value="8" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Border.Padding" Value="6,2" />
    <Setter Property="TextElement.Foreground" Value="{Binding EYECATCHER_FOREGROUND, Source={x:Static theming:AppTheme.Active}}" />
  </Style>
</ui:SharedResourceDictionary>