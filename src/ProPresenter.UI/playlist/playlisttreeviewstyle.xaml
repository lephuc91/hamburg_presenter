<?xml version="1.0" encoding="utf-8"?>
<ui:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Playlist" xmlns:media="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:mediaDo="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
  <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
  <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
  <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
  <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
  <media:CheckHotFolderBehaviorConverter x:Key="CheckHotFolderBehaviorConverter" />
  <ObjectDataProvider x:Key="Layer" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
    <ObjectDataProvider.MethodParameters>
      <x:TypeExtension Type="{x:Type mediaDo:ImportLayer}" />
    </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>
  <Style x:Key="TreeViewItemFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border>
            <Rectangle Opacity="0" Stroke="#FF000000" StrokeDashArray="1 2" StrokeThickness="5" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PlaylistTreeViewItemStyle" BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="{x:Type TreeViewItem}">
    <Setter Property="TreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding SOURCELISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
  </Style>
  <Style x:Key="PlaylistTreeViewStyle" BasedOn="{StaticResource {x:Type TreeView}}" TargetType="{x:Type TreeView}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource PlaylistTreeViewItemStyle}" />
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
          <local:PlaylistTreeViewItemContent />
        </HierarchicalDataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
  </Style>
</ui:SharedResourceDictionary>