    <ui:SharedResourceDictionary Source="pack://application:,,,/ProPresenter.UI;component/Resources/Paths/Paths.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <x:StaticExtension x:Key="Toolbar" Member="enum:InsertEditorObjectSourceType.EditorToolbar" />
  <converters:AddElementCommandParameterConverter x:Key="AddElementCommandParametersConverter" />
  <CompositeCollection x:Key="Source">
    <MenuItem FontStyle="Italic" IsEnabled="False" Header="{markupExtensions:Localized TOOLBAR_EDITOR_MENU_INSERT_SHAPE_title}" />
    <commonControls:RoutedMenuItem Command="{Binding EditorMenu.InsertShapeRoundedRectangle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}">
      <MenuItem.Icon>
        <Path Fill="{Binding MENU_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}">
          <Path.Data>
            <RectangleGeometry RadiusX="3" RadiusY="3" Rect="2 2 14 14" />
          </Path.Data>
        </Path>
      </MenuItem.Icon>
      <MenuItem.CommandParameter>
        <MultiBinding Converter="{StaticResource AddElementCommandParametersConverter}">
          <Binding Source="{x:Static shapes:ShapeType.RoundedRectangle}" />
          <Binding Source="{StaticResource Toolbar}" />
        </MultiBinding>
      </MenuItem.CommandParameter>
    </commonControls:RoutedMenuItem>
