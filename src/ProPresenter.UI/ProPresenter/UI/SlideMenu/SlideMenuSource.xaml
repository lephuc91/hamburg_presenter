<?xml version="1.0" encoding="utf-8"?>
<commonComponents:FrameworkCollection x:Class="ProPresenter.UI.SlideMenu.SlideMenuSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:actionsMenu="clr-namespace:ProPresenter.UI.ActionsMenu" xmlns:commands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonComponents="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverter="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:doLabel="clr-namespace:Pro.DO.Label;assembly=Pro.DO" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:templateSlideMenu="clr-namespace:ProPresenter.UI.Templates.SlideMenu" xmlns:templates="clr-namespace:ProPresenter.UI.Templates" x:Name="slideMenuSource" xmlns:slidemenu="clr-namespace:ProPresenter.UI.SlideMenu">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="slideMenuSourceProxy" Data="{Binding ElementName=slideMenuSource}" />
      <commonUtility:BindingProxy x:Key="slideMenuSourceVMProxy" Data="{Binding}" />
      <commonConverter:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverter:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <Border x:Key="ColorBox" BorderBrush="#FF000000" BorderThickness="1">
        <Grid Width="13" Height="13">
          <Rectangle Fill="#FF000000" />
          <Path Data="M13,0 L0,13 L13,13" Fill="#FFFFFFFF" />
          <Rectangle Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" />
        </Grid>
      </Border>
      <CollectionViewSource x:Key="GroupLabels" Source="{Binding Data.GroupLabels, Source={StaticResource slideMenuSourceVMProxy}}" />
      <CollectionViewSource x:Key="SlideLabels" Source="{Binding Data.SlideLabels, Source={StaticResource slideMenuSourceVMProxy}}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <MenuItem Command="{Binding ShowQuickEditCommand}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_QUICK_EDIT_title}" Visibility="{Binding Data.ShowQuickEdit, Source={StaticResource slideMenuSourceProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
  <MenuItem Command="{Binding EditSlideCommand}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_EDIT_SLIDE_title}" />
  <Separator />
  <MenuItem Command="{Binding ToggleEnabledCommand}" Header="{Binding ToggleEnabledHeader}" />
  <Separator />
  <templateSlideMenu:ThemeSlideMenuItem ContextGroup="{Binding Data.ThemeContextGroup, Source={StaticResource slideMenuSourceProxy}}" SelectTemplateCommand="{Binding Data.SelectTemplateCommand, Source={StaticResource slideMenuSourceVMProxy}}" />
  <MenuItem Command="{Binding OpenTranstionsCommand}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_TRANSITIONS_title}" />
  <MenuItem Command="{Binding ShowHotkeyDialogCommand}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_HOTKEY_title}" />
  <MenuItem Command="{Binding EditGoToNextCommand}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_GO_TO_NEXT_TIMER_title}" />
  <MenuItem Command="{Binding RemoveGotoNextTimerCommand}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_REMOVE_GO_TO_NEXT_TIMER_title}" Visibility="{Binding HasGotoNextAction, Converter={StaticResource ValueToVisibilityConverter}}" />
  <Separator />
  <actionsMenu:AddEditActionMenuSource DataContext="{Binding ActionsMenuVM}" />
  <Separator />
  <MenuItem UsesItemContainerTemplate="True" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_GROUP_title}" IsEnabled="{Binding Data.IsGroupingEnabled, Source={StaticResource slideMenuSourceVMProxy}}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type doLabel:GroupLabel}}">
          <MenuItem Icon="{StaticResource ColorBox}" Command="{Binding Data.AssignGroupLabelCommand, Source={StaticResource slideMenuSourceVMProxy}}" CommandParameter="{Binding}" Header="{Binding Text}" />
        </ItemContainerTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ItemsControl.ItemsSource>
      <CompositeCollection>
        <MenuItem Command="{Binding Data.NewGroupLabelCommand, Source={StaticResource slideMenuSourceVMProxy}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_EDIT_title}" />
        <Separator />
        <MenuItem Command="{Binding Data.UngroupCommand, Source={StaticResource slideMenuSourceVMProxy}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_UNGROUP_title}" Visibility="{Binding Data.CanUngroup, Source={StaticResource slideMenuSourceVMProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
        <Separator Visibility="{Binding Data.CanUngroup, Source={StaticResource slideMenuSourceVMProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
        <CollectionContainer Collection="{Binding Source={StaticResource GroupLabels}}" />
        <Separator />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Groups.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized PREFERENCES_WINDOW_title}" />
      </CompositeCollection>
    </ItemsControl.ItemsSource>
  </MenuItem>
  <MenuItem UsesItemContainerTemplate="True" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_LABEL_title}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type doLabel:ActionLabel}}">
          <MenuItem Icon="{StaticResource ColorBox}" Command="{Binding Data.AssignSlideLabelCommand, Source={StaticResource slideMenuSourceVMProxy}}" CommandParameter="{Binding}" Header="{Binding Text}" />
        </ItemContainerTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ItemsControl.ItemsSource>
      <CompositeCollection>
        <MenuItem Command="{Binding Data.NewSlideLabelCommand, Source={StaticResource slideMenuSourceVMProxy}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_EDIT_title}" />
        <Separator />
        <MenuItem Command="{Binding Data.AssignSlideLabelCommand, Source={StaticResource slideMenuSourceVMProxy}}" Header="{mex:Localized GLOBAL_NONE}" />
        <Separator />
        <CollectionContainer Collection="{Binding Source={StaticResource SlideLabels}}" />
        <Separator />
        <MenuItem Command="{Binding ProMenu.SlideLabels.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized PREFERENCES_WINDOW_title}" />
      </CompositeCollection>
    </ItemsControl.ItemsSource>
  </MenuItem>
  <Separator />
  <MenuItem Command="{Binding EditMenu.CopyTextStyle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
  <MenuItem Command="{Binding EditMenu.PasteTextStyle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
  <Separator />
  <MenuItem Command="{x:Static commands:CommonApplicationCommands.CutCommand}" />
  <MenuItem Command="{x:Static commands:CommonApplicationCommands.Copy}" />
  <MenuItem Command="{x:Static commands:CommonApplicationCommands.Paste}" />
  <MenuItem Command="{x:Static commands:CommonApplicationCommands.Delete}" />
</commonComponents:FrameworkCollection>