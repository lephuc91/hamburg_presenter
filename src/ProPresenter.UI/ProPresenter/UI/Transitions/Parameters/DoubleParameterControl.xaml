<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Transitions.Parameters.DoubleParameterControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" x:Name="doubleParamControlSelf" xmlns:parameters="clr-namespace:ProPresenter.UI.Transitions.Parameters;assembly=ProPresenter.UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Margin="5,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Label}" />
    <Slider Name="doubleParamSlider" Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center" TickFrequency="0.1" Maximum="{Binding MaxValue}" Minimum="{Binding MinValue}" Value="{Binding Value, Mode=TwoWay, ElementName=doubleParamControlSelf}" />
    <commonControls:DoubleUpDown Grid.Column="2" Width="50" Height="22" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FormatString="F1" Increment="0.1" ShowButtonSpinner="True" Maximum="{Binding MaxValue}" Minimum="{Binding MinValue}" Value="{Binding Value, Mode=TwoWay, ElementName=doubleParamControlSelf}" />
  </Grid>
</UserControl>