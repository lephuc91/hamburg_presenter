<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Transitions.ExtendedSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Transitions" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:validation="clr-namespace:ProPresenter.UI.Validation" x:Name="extendedSelectorSelf" Width="860" Height="340" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding DETAILLIST_CONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderThickness="1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="520" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <local:SelectorControl Grid.Column="0" IsGlobalAllowed="{Binding IsGlobalAllowed, ElementName=extendedSelectorSelf}" OutputController="{Binding OutputController, ElementName=extendedSelectorSelf}" TransitionHandler="{Binding TransitionHandler, ElementName=extendedSelectorSelf}" />
      <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Visibility="{Binding TransitionHandler.IsActive, ElementName=extendedSelectorSelf, Converter={StaticResource InvertedValueToVisibilityConverter}}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Text" Value="{mex:Localized GLOBAL_DEFAULT}" />
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <commonControls:EditableTextBlock Name="FavoriteTransitionNameEdit" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding TransitionHandler.ActiveParameters.Name, ElementName=extendedSelectorSelf, Mode=TwoWay}" Visibility="{Binding TransitionHandler.IsActive, ElementName=extendedSelectorSelf, Converter={StaticResource ValueToVisibilityConverter}}" PreviewMouseDown="FavoriteTransitionNameEdit_PreviewMouseDown">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type commonControls:EditableTextBlock}">
                  <Setter Property="commonControls:EditableTextBlock.ValidationRule">
                    <Setter.Value>
                      <validation:TransitionPresetNameValidationRule />
                    </Setter.Value>
                  </Setter>
                </Style>
              </FrameworkElement.Style>
            </commonControls:EditableTextBlock>
            <local:FavoriteButton x:Name="FavoriteButton" Click="AddToFavorite_Click" FavoriteCreatedFromSaveAs="FavoriteCreatedFromSaveAs" Width="30" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" TransitionHandler="{Binding TransitionHandler, ElementName=extendedSelectorSelf}" />
          </Grid>
          <local:PreviewControl Grid.Row="1" PreviewHeight="150" PreviewWidth="270" OutputController="{Binding OutputController, ElementName=extendedSelectorSelf}" TransitionHandler="{Binding TransitionHandler, ElementName=extendedSelectorSelf}" />
          <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
            <local:ParameterControl Grid.Row="2" TransitionHandler="{Binding TransitionHandler, ElementName=extendedSelectorSelf}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type local:ParameterControl}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding TransitionHandler.ActiveParameters, ElementName=extendedSelectorSelf, Converter={StaticResource IsNotNullToBoolConverter}}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </local:ParameterControl>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>