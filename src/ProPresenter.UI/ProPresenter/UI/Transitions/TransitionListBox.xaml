<?xml version="1.0" encoding="utf-8"?>
<ListBox x:Class="ProPresenter.UI.Transitions.TransitionListBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Transitions" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:transitions="clr-namespace:Pro.DO.Transitions;assembly=Pro.DO" x:Name="selfTransitionListBox" HorizontalContentAlignment="Center" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
  <ItemsControl.ItemContainerStyle>
    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
      <Style.Triggers>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="UIElement.IsMouseOver" Value="True" />
            <Condition Property="ListBoxItem.IsSelected" Value="False" />
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="BorderBrush" Value="#00FFFFFF" />
        </MultiTrigger>
      </Style.Triggers>
    </Style>
  </ItemsControl.ItemContainerStyle>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <DataTemplate x:Key="{DataTemplateKey {x:Type system1:String}}" xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib" DataType="{x:Type system1:String}">
        <Grid Margin="0,10">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Text="{Binding NoResultsText, RelativeSource={RelativeSource AncestorType={x:Type local:TransitionListBox}}}" />
          <TextBlock Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="{mex:Localized TRANSITIONS_NONE_AVAILABLE_SUBTITLE_label}" Visibility="{Binding IsInstructionVisible, RelativeSource={RelativeSource AncestorType={x:Type local:TransitionListBox}}, Converter={StaticResource ValueToVisibilityConverter}}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type transitions:TransitionBase}}" DataType="{x:Type transitions:TransitionBase}">
        <local:ItemPreview Margin="5" OutputController="{Binding OutputController, RelativeSource={RelativeSource AncestorType={x:Type local:TransitionListBox}}}" Transition="{Binding}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
</ListBox>