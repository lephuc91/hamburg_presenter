<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Transitions.PreviewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Transitions" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="self" Background="#00FFFFFF" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:PreviewDisplay x:Name="TransitionPreview" HorizontalAlignment="Center" VerticalAlignment="Center" AutoPlayTransition="True" HideSubtitle="True" Width="{Binding ElementName=self, Path=PreviewWidth}" Height="{Binding ElementName=self, Path=PreviewHeight}" Visibility="{Binding TransitionHandler.IsActive, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF000000" Width="{Binding ElementName=self, Path=PreviewWidth}" Height="{Binding ElementName=self, Path=PreviewHeight}" Visibility="{Binding TransitionHandler.IsActive, ElementName=self, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
  </Grid>
</UserControl>