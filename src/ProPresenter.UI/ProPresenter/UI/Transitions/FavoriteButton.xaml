<?xml version="1.0" encoding="utf-8"?>
<commonControls:BorderlessButton x:Class="ProPresenter.UI.Transitions.FavoriteButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="favoriteButton" Height="22" xmlns:transitions="clr-namespace:ProPresenter.UI.Transitions;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonUtility:BindingProxy x:Key="favoriteSelfProxy" Data="{Binding ElementName=favoriteButton}" />
      <ContextMenu x:Key="FavoriteButtonContextMenu">
        <MenuItem Header="{mex:Localized GLOBAL_SAVE}" Visibility="{Binding Data.TransitionHandler.IsTransitionModified, Source={StaticResource favoriteSelfProxy}, Converter={StaticResource ValueToVisibilityConverter}}" Click="Save_Click" />
        <MenuItem Header="{mex:Localized TRANISTIONS_SAVE_AS_title}" Click="SaveAs_Click" />
        <MenuItem Header="{mex:Localized GLOBAL_REMOVE_title}" Click="Remove_Click" />
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ContentControl.Content>
    <commonControls:ImageMask Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type commonControls:ImageMask}">
          <Setter Property="commonControls:ImageMask.ImageSource" Value="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/Transitions/favoriteOff.png" />
          <Style.Triggers>
            <DataTrigger Value="Favorite" Binding="{Binding Data.TransitionHandler.ActiveTransition.TransitionType, Source={StaticResource favoriteSelfProxy}}">
              <Setter Property="commonControls:ImageMask.ImageSource" Value="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/Transitions/favoriteOn.png" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Data.TransitionHandler.IsTransitionModified, Source={StaticResource favoriteSelfProxy}}" />
                <Condition Value="Favorite" Binding="{Binding Data.TransitionHandler.ActiveTransition.TransitionType, Source={StaticResource favoriteSelfProxy}}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="commonControls:ImageMask.ImageSource" Value="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/Transitions/favoriteMixed.png" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </commonControls:ImageMask>
  </ContentControl.Content>
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
      <Style.Triggers>
        <DataTrigger Value="False" Binding="{Binding Data.TransitionHandler.IsActive, Source={StaticResource favoriteSelfProxy}}">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
        <DataTrigger Value="Favorite" Binding="{Binding Data.TransitionHandler.ActiveTransition.TransitionType, Source={StaticResource favoriteSelfProxy}}">
          <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource FavoriteButtonContextMenu}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
</commonControls:BorderlessButton>