<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Transitions.ScrimControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControl="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="this" xmlns:transitions="clr-namespace:ProPresenter.UI.Transitions">
  <Grid>
    <Border Margin="6,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="3" ToolTip="{Binding Transition.TransitionDescription.DisplayName, ElementName=this}">
      <commonControl:ImageMask Width="15" Height="15">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type commonControl:ImageMask}">
            <Setter Property="commonControl:ImageMask.Fill" Value="{Binding Fill, ElementName=this}" />
            <Setter Property="commonControl:ImageMask.ImageSource" Value="..\Resources\Icons\Transitions\Advanced.png" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding Path=IsMediaTransition, ElementName=this}">
                <Setter Property="commonControl:ImageMask.Fill" Value="{Binding TRANSITIONBACKGROUND_PALETTE.Checked.Content, Source={x:Static theming:AppTheme.Active}}" />
              </DataTrigger>
              <DataTrigger Value="Cut" Binding="{Binding Transition.TransitionDescription.Name, ElementName=this}">
                <Setter Property="commonControl:ImageMask.ImageSource" Value="..\Resources\Icons\Transitions\Cut.png" />
              </DataTrigger>
              <DataTrigger Value="Dissolve" Binding="{Binding Transition.TransitionDescription.Name, ElementName=this}">
                <Setter Property="commonControl:ImageMask.ImageSource" Value="..\Resources\Icons\Transitions\Dissolve.png" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControl:ImageMask>
    </Border>
  </Grid>
</UserControl>