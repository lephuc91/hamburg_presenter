<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Transitions.SlimSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Transitions" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="inlineSelectorSelf" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <local:ButtonSelector Grid.Row="0" Height="22" VerticalAlignment="Center" PopupPlacement="Bottom" SelectorButtonContentType="DefaultAndName" SelectorButtonSelectorStyle="Compact" IsGlobalAllowed="{Binding ElementName=inlineSelectorSelf, Path=IsGlobalAllowed}" OutputController="{Binding ElementName=inlineSelectorSelf, Path=OutputController}" SelectedTransition="{Binding ElementName=inlineSelectorSelf, Path=SelectedTransition}" TransitionHandler="{Binding ElementName=inlineSelectorSelf, Path=TransitionHandler}" />
    <Grid Row="1" Margin="0,5,0,0" Visibility="{Binding TransitionHandler.IsActive, ElementName=inlineSelectorSelf, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <local:PreviewControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="2,0,0,0" HorizontalAlignment="Left" PreviewHeight="105" PreviewWidth="180" OutputController="{Binding OutputController, ElementName=inlineSelectorSelf}" TransitionHandler="{Binding TransitionHandler, ElementName=inlineSelectorSelf}" />
      <local:FavoriteButton x:Name="FavoriteButton" Click="FavoriteButton_Click" FavoriteCreatedFromSaveAs="FavoriteCreatedFromSaveAs" Grid.Row="0" Grid.Column="1" Margin="0,0,2,0" VerticalAlignment="Top" AutoCreateFavorite="False" TransitionHandler="{Binding TransitionHandler, ElementName=inlineSelectorSelf}" />
      <commonControls:BorderlessButton Name="RemoveButton" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,2,0" VerticalAlignment="Bottom" Click="RemoveButton_Click">
        <commonControls:ImageMask ImageSource="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/Transitions/trash.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
      </commonControls:BorderlessButton>
    </Grid>
  </Grid>
</UserControl>