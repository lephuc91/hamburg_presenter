<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Timecode.TimecodeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:playlists="clr-namespace:ProPresenter.DO.Playlists;assembly=ProPresenter.DO" xmlns:themes1="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="timecodeWindow" Width="400" Height="500" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.SendKeyEventsToMainWindow="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:timecode="clr-namespace:ProPresenter.UI.Timecode" Title="{mex:Localized TIMECODE_WINDOW_title}" Background="{Binding BACKGROUND, Source={x:Static theming:AppTheme.Active}}" DataContext="{di:DIMarkup {x:Type viewModels:ITimecodeVM}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="timecodeWindowProxy" Data="{Binding ElementName=timecodeWindow}" />
      <commonUtility:BindingProxy x:Key="timecodeVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="Converter_ValueToVisibility" IsCollapsing="True" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="False" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <Style x:Key="PlaylistStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SelectPlaylistCommand, Source={StaticResource timecodeVMProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding />
              <Binding Path="Data.SelectedPlaylist" Source="{StaticResource timecodeVMProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
      <ContextMenu x:Key="PlaylistsContextMenu" Placement="Bottom" UsesItemContainerTemplate="True" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type playlists:GeneralPlaylist}}">
              <MenuItem Style="{StaticResource PlaylistStyle}" Header="{Binding Name}">
                <MenuItem.Icon>
                  <Image Source="{StaticResource {x:Static themes1:Icons.LibraryPlaylist}}" />
                </MenuItem.Icon>
              </MenuItem>
            </ItemContainerTemplate>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type playlists:PCOPlaylist}}">
              <MenuItem Style="{StaticResource PlaylistStyle}" Header="{Binding Name}">
                <MenuItem.Icon>
                  <Image Source="{StaticResource {x:Static themes1:Icons.PCOPlaylist}}" />
                </MenuItem.Icon>
              </MenuItem>
            </ItemContainerTemplate>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type playlists:GeneralGroupPlaylist}}">
              <MenuItem UsesItemContainerTemplate="True" Header="{Binding Name}" ItemsSource="{Binding Children}">
                <MenuItem.Icon>
                  <Image Source="{StaticResource {x:Static themes1:Icons.PlaylistFolder}}" />
                </MenuItem.Icon>
              </MenuItem>
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem Command="{Binding Data.SelectPlaylistCommand, Source={StaticResource timecodeVMProxy}}" CommandParameter="{x:Null}" Header="{mex:Localized TIMECODE_WINDOW_NO_PLAYLIST_MENU_ITEM_title}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                  <Setter Property="MenuItem.IsChecked" Value="False" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Data.SelectedPlaylist, Source={StaticResource timecodeVMProxy}}" Value="{x:Null}">
                      <Setter Property="MenuItem.IsChecked" Value="True" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </MenuItem>
            <Separator />
            <CollectionContainer Collection="{Binding Data.Playlists, Source={StaticResource timecodeVMProxy}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
      <ContextMenu x:Key="DeviceContextMenu" Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectDeviceCommand, Source={StaticResource timecodeVMProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding />
                  <Binding Path="Data.SelectedDevice" Source="{StaticResource timecodeVMProxy}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem Command="{Binding Data.SelectDeviceCommand, Source={StaticResource timecodeVMProxy}}" CommandParameter="{x:Null}" Header="{mex:Localized TIMECODE_POPUP_NODEVICE_title}" />
            <CollectionContainer Collection="{Binding Data.Devices, Source={StaticResource timecodeVMProxy}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
      <ContextMenu x:Key="ChannelContextMenu" Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Data.Channels, Source={StaticResource timecodeVMProxy}}">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectChannelCommand, Source={StaticResource timecodeVMProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="Header" Value="{Binding ConverterParameter=TIMECODE_WINDOW_CHANNEL_MENU_ITEM_title, Converter={StaticResource FormattedLocalizedStringConverter}}" />
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding />
                  <Binding Path="Data.Channel" Source="{StaticResource timecodeVMProxy}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
      <ContextMenu x:Key="FormatContextMenu" Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Data.Formats, Source={StaticResource timecodeVMProxy}}">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectFormatCommand, Source={StaticResource timecodeVMProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="Header" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding />
                  <Binding Path="Data.Format" Source="{StaticResource timecodeVMProxy}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <commonControls:BorderlessButton Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Command="{Binding ToggleTimecodeCommand}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Ellipse Width="16" Height="16" Visibility="{Binding IsActive, Converter={StaticResource ValueToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Ellipse}">
                <Style.Triggers>
                  <DataTrigger Value="Playing" Binding="{Binding State}">
                    <Setter Property="Fill" Value="#FF008000" />
                  </DataTrigger>
                  <DataTrigger Value="Stopped" Binding="{Binding State}">
                    <Setter Property="Fill" Value="#FFFFFF00" />
                  </DataTrigger>
                  <DataTrigger Value="Error" Binding="{Binding State}">
                    <Setter Property="Fill" Value="#FFFF0000" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Ellipse>
          <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Text="{Binding TimecodeTimeStr}" />
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" FontSize="15" Visibility="{Binding IsActive, Converter={StaticResource ValueToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="{mex:Localized TIMECODE_WINDOW_STATE_STOPPED_title}" />
                <Style.Triggers>
                  <DataTrigger Value="Playing" Binding="{Binding State}">
                    <Setter Property="Text" Value="{mex:Localized TIMECODE_WINDOW_STATE_PLAYING_title}" />
                  </DataTrigger>
                  <DataTrigger Value="Error" Binding="{Binding State}">
                    <Setter Property="Text" Value="{mex:Localized TIMECODE_WINDOW_STATE_ERROR_title}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" FontSize="15" Text="{mex:Localized TIMECODE_WINDOW_STATE_NOT_ENGAGED_title}" Visibility="{Binding IsActive, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        </Grid>
      </commonControls:BorderlessButton>
      <commonControls:BorderlessToggleButton Name="SettingsButton" Grid.Row="0" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsChecked="{Binding IsPopupOpen, Mode=TwoWay}">
        <commonControls:Icon IconSize="Small" Source="{StaticResource {x:Static themes1:Icons.ActionTrack}}" />
      </commonControls:BorderlessToggleButton>
    </Grid>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <commonControls:DropDownButton Grid.Column="0" Height="22" Margin="0,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" CustomContextMenu="{StaticResource PlaylistsContextMenu}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type commonControls:DropDownButton}">
            <Setter Property="commonControls:DropDownButton.CustomContent" Value="{Binding SelectedPlaylist.Name}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPlaylist}" Value="{x:Null}">
                <Setter Property="commonControls:DropDownButton.CustomContent" Value="{mex:Localized TIMECODE_WINDOW_NO_PLAYLIST_MENU_ITEM_title}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:DropDownButton>
      <commonControls:BorderlessToggleButton Name="Expander_TimelineItems" Grid.Column="1" Width="26" Height="26">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessToggleButton}}" TargetType="{x:Type commonControls:BorderlessToggleButton}">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                <Setter Property="Background" Value="{Binding BUTTON_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <commonControls:Icon IconSize="Small" Source="{StaticResource {x:Static themes1:Icons.List}}" />
      </commonControls:BorderlessToggleButton>
    </Grid>
    <Grid Row="4">
      <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}" Visibility="{Binding IsChecked, ElementName=Expander_TimelineItems, Converter={StaticResource Converter_ValueToVisibility}}">
        <ItemsControl ItemsSource="{Binding Data.Items, Source={StaticResource timecodeVMProxy}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Name}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TimeStr}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,5,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="1" Margin="0,2" BorderBrush="{StaticResource {x:Static themes1:Brushes.DottedLine}}" BorderThickness="1">
                  <UIElement.Visibility>
                    <MultiBinding Converter="{converters:IsLastItemToVisibilityConverter}">
                      <Binding />
                      <Binding Path="ItemsSource" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                      <Binding Path="TimeStr" />
                    </MultiBinding>
                  </UIElement.Visibility>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <commonControls:AnchoredPopup Grid.Row="5" Width="300" VerticalAlignment="Center" AllowsTransparency="True" HorizontalOffset="8" Placement="Right" StaysOpen="False" IsOpen="{Binding Path=IsPopupOpen}" PlacementTarget="{Binding ElementName=SettingsButton}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Row="1" Column="0" Width="20" Margin="0,0,-6,0" Background="#00FFFFFF">
          <commonControls:PathControl Width="30" Height="30" HorizontalAlignment="Center" PathType="UpArrow" Fill="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" Stroke="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}">
            <FrameworkElement.LayoutTransform>
              <RotateTransform Angle="270" CenterX="0.5" CenterY="0.5" />
            </FrameworkElement.LayoutTransform>
          </commonControls:PathControl>
        </Grid>
        <Border Grid.Column="1" Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}">
          <Grid Margin="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,5,8" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMECODE_POPUP_DEVICE_label}" />
            <commonControls:DropDownButton Grid.Row="0" Grid.Column="1" Height="22" Margin="0,0,0,8" CustomContextMenu="{StaticResource DeviceContextMenu}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type commonControls:DropDownButton}">
                  <Setter Property="commonControls:DropDownButton.CustomContent" Value="{Binding Data.SelectedDevice.Name, Source={StaticResource timecodeVMProxy}}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Data.SelectedDevice, Source={StaticResource timecodeVMProxy}}" Value="{x:Null}">
                      <Setter Property="commonControls:DropDownButton.CustomContent" Value="{mex:Localized TIMECODE_POPUP_NODEVICE_title}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </commonControls:DropDownButton>
            <commonControls:BorderlessButton Grid.Row="0" Grid.Column="2" Width="24" Height="24" Margin="5,0,0,8" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewMouseLeftButtonDown="Monitor_PreviewMouseDown" PreviewMouseLeftButtonUp="Monitor_PreviewMouseUp">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
                  <Setter Property="Foreground" Value="{Binding BORDERLESSBUTTON_CONTENT, Source={x:Static theming:AppTheme.Active}}" />
                  <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Foreground" Value="#FF6969" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <commonControls:ImageMask ImageSource="../Resources/Icons/Preferences/Input/InputListen@2x.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
            </commonControls:BorderlessButton>
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,5,8" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMECODE_POPUP_CHANNEL_label}" />
            <commonControls:DropDownButton Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,0,8" CustomContextMenu="{StaticResource ChannelContextMenu}" CustomContent="{Binding Data.Channel, Source={StaticResource timecodeVMProxy}, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=TIMECODE_WINDOW_CHANNEL_MENU_ITEM_title}" IsEnabled="{Binding Data.SelectedDevice, Source={StaticResource timecodeVMProxy}, Converter={StaticResource IsNotNullToBoolConverter}}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,5,8" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMECODE_POPUP_FORMAT_label}" />
            <commonControls:DropDownButton Grid.Row="2" Grid.Column="1" Height="22" Margin="0,0,0,8" CustomContextMenu="{StaticResource FormatContextMenu}" CustomContent="{Binding Data.Format, Source={StaticResource timecodeVMProxy}, Converter={StaticResource EnumToContentConverter}}" IsEnabled="{Binding Data.SelectedDevice, Source={StaticResource timecodeVMProxy}, Converter={StaticResource IsNotNullToBoolConverter}}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMECODE_POPUP_OFFSET_label}" />
            <commonControls:DoubleUpDown Grid.Row="3" Grid.Column="1" Height="22" FormatString="{}{0}s" Minimum="0" ShowButtonSpinner="False" IsEnabled="{Binding Data.SelectedDevice, Source={StaticResource timecodeVMProxy}, Converter={StaticResource IsNotNullToBoolConverter}}" Value="{Binding Data.Offset, Source={StaticResource timecodeVMProxy}, Mode=TwoWay}" />
          </Grid>
        </Border>
      </Grid>
    </commonControls:AnchoredPopup>
  </Grid>
</windowing:ChromedWindow>