<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.KeyMapping.InputActionGroupTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.KeyMapping" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="inputActionGroupTemplate">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="inputActionGroupTemplateProxy" Data="{Binding ElementName=inputActionGroupTemplate}" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToBoolConverter x:Key="NotEmptyConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{Binding OUTLINEDETAIL, Source={x:Static theming:AppTheme.Active}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="{Binding FilteredInputActions.Count, Converter={StaticResource CountToVisibilityConverter}}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding Children, Converter={StaticResource NotEmptyConverter}}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid Margin="32,5,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <commonControls:ExpanderToggleButton Grid.Column="0" Margin="0,0,2,0" CollapsedPathType="VRightArrow" ExpandedPathType="VDownArrow" ShouldFill="False" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Label}" />
      </Grid>
    </Border>
    <local:InputActionList Grid.Row="1" AlternationCount="2" SelectionMode="Single" ItemsSource="{Binding FilteredInputActions}" SelectedListItem="{Binding ElementName=inputActionGroupTemplate, Path=KeyMappingVM.SelectedItem, Mode=TwoWay}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type local:InputActionList}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding IsExpanded}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <local:InputActionItemTemplate Height="22" Margin="60,0,0,0" ShowConflictsCommand="{Binding Data.KeyMappingVM.ShowConflictsCommand, Source={StaticResource inputActionGroupTemplateProxy}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
          <Setter Property="commonControls:ListBoxItem.FocusOnContextMenuClose" Value="False" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding DETAILLISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
    </local:InputActionList>
  </Grid>
</UserControl>