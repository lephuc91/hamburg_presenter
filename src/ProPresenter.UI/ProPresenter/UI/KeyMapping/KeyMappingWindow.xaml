<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.KeyMapping.KeyMappingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:floatingHeaders="clr-namespace:ProPresenter.UI.FloatingHeaders" xmlns:inputActionDO="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.KeyMapping" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proUI="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.KeyMapping" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Width="891" Height="545" MinWidth="891" MinHeight="545" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.SendKeyEventsToMainWindow="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanClose="True" CanMaximize="False" CanMinimize="False" ResizeMode="CanResizeWithGrip" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" Title="{mex:Localized KEYMAPPING_PREFERENCES_WINDOW_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="keyMappingVMProxy" Data="{Binding}" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToBoolConverter x:Key="NotEmptyConverter" />
      <Style x:Key="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding TOOLBAR_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="20,20,20,5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <commonControls:BorderlessButton Grid.Row="0" Grid.Column="0" Height="22" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" uiUtility:ContextMenuHelper.CenterMenu="False" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
      <FrameworkElement.ContextMenu>
        <ContextMenu Placement="Bottom">
          <MenuItem Command="{Binding Data.ResetAllCommand, Source={StaticResource keyMappingVMProxy}}" Header="{mex:Localized KEYMAPPING_PREFERENCES_CONFIGURATION_RESET_title}" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <commonControls:ImageMask ImageSource="../Resources/Icons/GearIcon.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
    </commonControls:BorderlessButton>
    <Grid Row="0" Column="1" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <ToggleButton uiUtility:UIElementHelper.CornerRadius="2 0 0 2" BorderThickness="0,0,1,0" CommandParameter="{x:Static inputActionDO:FilterType.All}" Command="{Binding SetFilterTypeCommand}" Content="{mex:Localized KEYMAPPING_PREFERENCES_FILTER_ALL_title}" IsChecked="{Binding FilterType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static inputActionDO:FilterType.All}, Mode=OneWay}" Unchecked="FilterType_Unchecked" />
        <ToggleButton BorderThickness="0,0,1,0" CommandParameter="{x:Static inputActionDO:FilterType.Menu}" Command="{Binding SetFilterTypeCommand}" Content="{mex:Localized KEYMAPPING_PREFERENCES_FILTER_MENU_title}" IsChecked="{Binding FilterType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static inputActionDO:FilterType.Menu}, Mode=OneWay}" Unchecked="FilterType_Unchecked" />
        <ToggleButton BorderThickness="0,0,1,0" CommandParameter="{x:Static inputActionDO:FilterType.Show}" Command="{Binding SetFilterTypeCommand}" Content="{mex:Localized KEYMAPPING_PREFERENCES_FILTER_SHOW_title}" IsChecked="{Binding FilterType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static inputActionDO:FilterType.Show}, Mode=OneWay}" Unchecked="FilterType_Unchecked" />
        <ToggleButton uiUtility:UIElementHelper.CornerRadius="0 2 2 0" BorderThickness="0" CommandParameter="{x:Static inputActionDO:FilterType.Unused}" Command="{Binding SetFilterTypeCommand}" Content="{mex:Localized KEYMAPPING_PREFERENCES_FILTER_UNUSED_title}" IsChecked="{Binding FilterType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static inputActionDO:FilterType.Unused}, Mode=OneWay}" Unchecked="FilterType_Unchecked" />
      </StackPanel>
      <ToggleButton Grid.Column="1" MinWidth="80" Margin="10,0" uiUtility:UIElementHelper.CornerRadius="2" BorderThickness="0" Content="{mex:Localized KEYMAPPING_PREFERENCES_FILTER_CUSTOMIZED_title}" IsChecked="{Binding FilterCustomized, Mode=TwoWay}" />
      <ToggleButton Grid.Column="2" MinWidth="80" uiUtility:UIElementHelper.CornerRadius="2" BorderThickness="0" Content="{Binding ConflictButtonContent}" IsChecked="{Binding FilterConflicts, Mode=TwoWay}" />
    </Grid>
    <commonControls:FilterBox Grid.Row="0" Grid.Column="2" Width="200" Height="22" HorizontalAlignment="Right" TextContentHorizontalAlignment="Left" TextContentVerticalAlignment="Center" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" PlaceholderText="{mex:Localized GLOBAL_FILTER_FIELD_placeholder}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0" BorderThickness="1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="20,5,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized KEYMAPPING_PREFERENCES_COLUMN_COMMAND_title}" />
            <Border Grid.Column="1" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" BorderThickness="1,0,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
              <TextBlock Grid.Column="0" Margin="0,5" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{mex:Localized KEYMAPPING_PREFERENCES_COLUMN_KEY_title}" />
            </Border>
            <Border Grid.Column="2" Width="50" HorizontalAlignment="Right" VerticalAlignment="Stretch" BorderThickness="1,0,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" />
          </Grid>
        </Border>
        <floatingHeaders:KeyMappingFloatingHeaderControl x:Name="commandsTable" Grid.Row="1" HorizontalAlignment="Center" Items="{Binding InputActionGroups}">
          <commonControls:FloatingHeaderControl.HeaderTemplates>
            <DataTemplate>
              <Border Background="{Binding OUTLINEDETAIL, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding HasFilteredActions, Converter={StaticResource ValueToVisibilityConverter}}">
                <Grid Margin="2,5,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <commonControls:ExpanderToggleButton Grid.Column="0" Margin="0,0,2,0" CollapsedPathType="VRightArrow" ExpandedPathType="VDownArrow" ShouldFill="False" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                  <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Label}" />
                </Grid>
              </Border>
            </DataTemplate>
          </commonControls:FloatingHeaderControl.HeaderTemplates>
          <commonControls:FloatingHeaderControl.ItemTemplates>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <local:InputActionList Grid.Row="0" AlternationCount="2" SelectionMode="Single" ItemsSource="{Binding FilteredInputActions}" SelectedListItem="{Binding Data.SelectedItem, Source={StaticResource keyMappingVMProxy}, Mode=TwoWay}">
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type local:InputActionList}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Value="False" Binding="{Binding IsExpanded}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Value="0" Binding="{Binding FilteredInputActions.Count}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <local:InputActionItemTemplate Height="22" Margin="30,0,0,0" ShowConflictsCommand="{Binding Data.ShowConflictsCommand, Source={StaticResource keyMappingVMProxy}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  <ItemsControl.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
                      <Setter Property="commonControls:ListBoxItem.FocusOnContextMenuClose" Value="False" />
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding DETAILLISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </local:InputActionList>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Children}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type ItemsControl}">
                      <Setter Property="Visibility" Value="{Binding IsExpanded, Converter={StaticResource ValueToVisibilityConverter}}" />
                      <Style.Triggers>
                        <DataTrigger Value="False" Binding="{Binding HasFilteredActions}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <ItemsControl.ItemTemplateSelector>
                    <proUI:InterfaceDataTemplateSelector>
                      <proUI:InterfaceDataTemplateSelector.TemplateDictionary>
                        <ResourceDictionary>
                          <DataTemplate x:Key="{DataTemplateKey {x:Type vm:IInputActionGroupVM}}" DataType="{x:Type vm:IInputActionGroupVM}">
                            <local:InputActionGroupTemplate KeyMappingVM="{Binding Data, Source={StaticResource keyMappingVMProxy}}" />
                          </DataTemplate>
                        </ResourceDictionary>
                      </proUI:InterfaceDataTemplateSelector.TemplateDictionary>
                    </proUI:InterfaceDataTemplateSelector>
                  </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </commonControls:FloatingHeaderControl.ItemTemplates>
        </floatingHeaders:KeyMappingFloatingHeaderControl>
      </Grid>
    </Border>
    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedItem.DetailText}" ToolTip="{Binding SelectedItem.DetailText}" />
  </Grid>
</windowing:ChromedWindow>