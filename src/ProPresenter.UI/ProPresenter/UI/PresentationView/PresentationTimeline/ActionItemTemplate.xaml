<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PresentationView.PresentationTimeline.ActionItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="actionItemTemplate" xmlns:presentationtimeline="clr-namespace:ProPresenter.UI.PresentationView.PresentationTimeline;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../../Thumbnails/ScrimTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style TargetType="{x:Type UserControl}">
      <Setter Property="UIElement.Opacity" Value="0.6" />
      <Style.Triggers>
        <DataTrigger Value="True" Binding="{Binding IsSelected, ElementName=actionItemTemplate}">
          <Setter Property="UIElement.Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
  <Grid Margin="-8,0,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Rectangle Grid.Row="0" Width="2" Height="5" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="{Binding Foreground, ElementName=actionItemTemplate}" />
    <ContentControl Grid.Row="1" Content="{Binding Item.Item}" />
    <Rectangle Grid.Row="2" Width="2" Height="5" Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="{Binding Foreground, ElementName=actionItemTemplate}" />
  </Grid>
</UserControl>