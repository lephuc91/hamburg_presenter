<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PresentationView.PresentationViewHeaderBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:presentation="clr-namespace:ProPresenter.DO.Presentation;assembly=ProPresenter.DO" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="self" AllowDrop="True" xmlns:presentationview="clr-namespace:ProPresenter.UI.PresentationView" Background="{Binding HEADER, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderThickness="0,0,0,1" BorderBrush="{Binding HEADERDIVIDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid DataContext="{Binding PresentationHeaderVM, ElementName=self}">
      <Grid.RowDefinitions>
        <RowDefinition Height="27" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <ContentPresenter Name="HeaderContentPresenter" />
      <Grid Row="1" Visibility="{Binding ElementName=self, Path=IsHeaderContentEnabled, Converter={StaticResource ValueToVisibilityConverter}}">
        <ContentPresenter Name="ArrangementContentPresenter" Visibility="{Binding ActiveHeaderView, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static presentation:PresentationHeaderViewType.Arrangements}}" />
        <ContentPresenter Name="TimelineContentPresenter" Visibility="{Binding ActiveHeaderView, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static presentation:PresentationHeaderViewType.Timeline}}" />
        <ContentPresenter Name="NotesContentPresenter" Visibility="{Binding ActiveHeaderView, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static presentation:PresentationHeaderViewType.Notes}}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>