<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PresentationView.GoToNext.SlideTimerCueDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="gtntSelf" MaxWidth="400" xmlns:gotonext="clr-namespace:ProPresenter.UI.PresentationView.GoToNext;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <Style x:Key="TextBlockStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <TextBlock Style="{StaticResource TextBlockStyle}" Text="{mex:Localized ACTION_PALETTE_GO_TO_NEXT_TIMER_SET_TIME_DEFINITION_label}" />
    <TextBlock FontSize="11" Style="{StaticResource TextBlockStyle}" Text="{mex:Localized ACTION_PALETTE_GO_TO_NEXT_TIMER_FOREGROUND_MEDIA_EXPLANATION_label}" />
    <StackPanel Margin="0,5" HorizontalAlignment="Left" Orientation="Horizontal">
      <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="{mex:Localized ACTION_PALETTE_GO_TO_NEXT_TIMER_DURATION_title}" />
      <commonControls:DoubleUpDown Name="TimerDuration" FormatString="{}{0:#,#.0}s" Increment="0.5" Minimum="0" Value="{Binding Duration, ElementName=gtntSelf}" />
      <CheckBox Margin="10,0,0,0" VerticalAlignment="Center" Content="{mex:Localized ACTION_PALETTE_GO_TO_NEXT_TIMER_LOOP_TO_BEGINNING_CHECKBOX_title}" IsChecked="{Binding LoopToBeginning, ElementName=gtntSelf}" Visibility="{Binding ElementName=gtntSelf, Path=LoopToBeginningAvailable, Converter={StaticResource ValueToVisibilityConverter}}" />
    </StackPanel>
  </StackPanel>
</UserControl>