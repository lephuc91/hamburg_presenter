<?xml version="1.0" encoding="utf-8"?>
<commonControls:BorderlessButton x:Class="ProPresenter.UI.PresentationView.LinkedItemButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:pcoDO="clr-namespace:ProPresenter.DO.PCO;assembly=ProPresenter.DO" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="self" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Style="{StaticResource {x:Type commonControls:BorderlessButton}}" xmlns:presentationview="clr-namespace:ProPresenter.UI.PresentationView;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="LinkedItemButtonSelfProxy" Data="{Binding ElementName=self}" />
      <commonUtility:BindingProxy x:Key="LinkedItemButtonBindingProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.ContextMenu>
    <ContextMenu>
      <MenuItem Command="{Binding Data.UploadCommand, Source={StaticResource LinkedItemButtonSelfProxy}}" CommandParameter="{Binding Data, Source={StaticResource LinkedItemButtonBindingProxy}}" Header="{mex:Localized PLANNING_CENTER_ITEMS_HEADER_UPLOAD_title}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Data.UploadCommand, Source={StaticResource LinkedItemButtonSelfProxy}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </MenuItem>
      <MenuItem Command="{Binding Data.UnlinkCommand, Source={StaticResource LinkedItemButtonSelfProxy}}" CommandParameter="{Binding Data, Source={StaticResource LinkedItemButtonBindingProxy}}" Header="{mex:Localized PLACEHOLDER_ITEMS_HEADER_UNLINK_title}" />
    </ContextMenu>
  </FrameworkElement.ContextMenu>
  <StackPanel Orientation="Horizontal">
    <Image Width="20" Height="20" Margin="0,0,4,0" VerticalAlignment="Center">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Image}">
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="PCO" Binding="{Binding Type}" />
                <Condition Value="{x:Static pcoDO:PCOItemType.Plan}" Binding="{Binding Data.PCOItem.PCOItemType, Source={StaticResource LinkedItemButtonBindingProxy}}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Source" Value="../Resources/Icons/PCO/pcoItem.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="PCO" Binding="{Binding Type}" />
                <Condition Value="{x:Static pcoDO:PCOItemType.Song}" Binding="{Binding Data.PCOItem.PCOItemType, Source={StaticResource LinkedItemButtonBindingProxy}}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Source" Value="{StaticResource {x:Static themes:Icons.PCOSong}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="PCO" Binding="{Binding Type}" />
                <Condition Value="{x:Static pcoDO:PCOItemType.Media}" Binding="{Binding Data.PCOItem.PCOItemType, Source={StaticResource LinkedItemButtonBindingProxy}}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Source" Value="../Resources/Icons/PCO/pcoMediaItem.png" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Image>
    <TextBlock Text="{Binding Label, ElementName=self}" />
  </StackPanel>
</commonControls:BorderlessButton>