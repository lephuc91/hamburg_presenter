<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PresentationView.MediaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mediaDO="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mediaLibrary="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:overlay="clr-namespace:ProPresenter.UI.ThumbnailOverlay" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="self" xmlns:presentationview="clr-namespace:ProPresenter.UI.PresentationView" Foreground="{Binding GROUPCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <commonConverters:TimeSliceToStringConverter x:Key="TimeSliceToStringConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    <Style x:Key="PlayButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="IsEnabled" Value="True" />
      <Setter Property="UIElement.Opacity" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="#00FFFFFF">
              <Grid>
                <Ellipse Name="ButtonEllipse" Width="85" Height="85" Fill="#404040" Stroke="#a2a2a2" StrokeThickness="1" />
                <commonControls:PathControl Width="30" Height="30" Margin="10,0,0,0" Fill="#a2a2a2" PathType="Play" StrokeThickness="0" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="UIElement.Opacity" Value="0.5" />
        </Trigger>
        <DataTrigger Value="Web" Binding="{Binding MediaAction.Media.MediaType, ElementName=self}">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF">
    <StackPanel Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
      <Grid Width="150" Height="85">
        <mediaLibrary:MediaPreview x:Name="mediaPreview" Media="{Binding MediaAction.Media}" />
        <overlay:MediaOverlay x:Name="overlay" ShowText="False" Width="{Binding ElementName=mediaPreview, Path=ActualWidth}" Height="{Binding ElementName=mediaPreview, Path=ActualHeight}" BackgroundControl="{Binding ElementName=mediaPreview}" DataContext="{Binding ElementName=self, Path=OverlayVM}" />
      </Grid>
      <Button Margin="15,0,0,0" Style="{StaticResource PlayButtonStyle}" Click="PlayButton_Click" />
      <Grid Margin="15,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding MediaAction.WebMedia.Url, ElementName=self}" />
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="{Binding MediaAction.Media.MediaType, ElementName=self, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static mediaDO:MediaType.Web}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding ElementName=self, Path=MediaAction.Name}" />
          <StackPanel Grid.Row="1" Margin="0,5" Orientation="Horizontal">
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{mex:Localized CONTIGUOUS_VIEW_MEDIA_DURATION_label}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Text" Value="{Binding MediaAction.Duration, ElementName=self, Converter={StaticResource TimeSliceToStringConverter}}" />
                  <Style.Triggers>
                    <DataTrigger Value="Video" Binding="{Binding MediaAction.Media.MediaType}">
                      <Setter Property="Text" Value="{Binding MediaAction.MediaDuration, ElementName=self, Converter={StaticResource TimeSliceToStringConverter}}" />
                    </DataTrigger>
                    <DataTrigger Value="Audio" Binding="{Binding MediaAction.Media.MediaType}">
                      <Setter Property="Text" Value="{Binding MediaAction.MediaDuration, ElementName=self, Converter={StaticResource TimeSliceToStringConverter}}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
            <commonControls:BorderlessButton Width="22" Height="22" HorizontalAlignment="Left" Visibility="{Binding MediaAction.Media.MediaType, ConverterParameter={x:Static mediaDO:MediaType.LiveVideo}, Converter={StaticResource InvertedValueToVisibilityConverter}}" Click="OpenFileLocation">
              <commonControls:ImageMask ImageSource="../Resources/Icons/Spotlight.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
            </commonControls:BorderlessButton>
            <TextBlock Name="MediaFileLocation" VerticalAlignment="Center" Text="{Binding MediaAction.Media.SourceFile.FullPath, ElementName=self}" Visibility="{Binding MediaAction.Media.MediaType, ConverterParameter={x:Static mediaDO:MediaType.LiveVideo}, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          </StackPanel>
        </Grid>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>