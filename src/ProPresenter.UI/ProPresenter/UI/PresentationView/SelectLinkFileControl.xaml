<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PresentationView.SelectLinkFileControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="selectLinkFile" xmlns:presentationview="clr-namespace:ProPresenter.UI.PresentationView;assembly=ProPresenter.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left" Text="{mex:Localized PLACEHOLDER_PROBUNDLE_IMPORT_LINK_ALERT_informative}" />
    <ComboBox Name="SelectFileDropDown" Grid.Row="1" Width="300" HorizontalAlignment="Stretch" ItemsSource="{Binding Files, ElementName=selectLinkFile}" SelectedItem="{Binding File, ElementName=selectLinkFile}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding FinalName}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
  </Grid>
</UserControl>