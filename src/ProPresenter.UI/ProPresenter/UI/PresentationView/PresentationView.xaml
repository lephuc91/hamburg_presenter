          <PriorityBinding>
            <Binding ElementName="self" Path="DocumentCue.DocumentAction.Presentation.IsCheckingAccountStatus" />
          </PriorityBinding>
        </multiTracks:MultiTracksUnauthorizedOverlay.IsCheckingAccountStatus>
      </multiTracks:MultiTracksUnauthorizedOverlay>
    </Grid>
  </AdornerDecorator>
</UserControl>