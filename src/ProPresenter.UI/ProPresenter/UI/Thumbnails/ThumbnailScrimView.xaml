<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Thumbnails.ThumbnailScrimView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Thumbnails" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="RootScrimView">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary Source="ScrimTemplates.xaml" />
  </FrameworkElement.Resources>
  <ItemsControl ItemsSource="{Binding Items, ElementName=RootScrimView}">
    <ItemsControl.ItemContainerStyle>
      <Style TargetType="{x:Type FrameworkElement}">
        <Setter Property="Margin" Value="2" />
      </Style>
    </ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <local:ScrimPanel Orientation="Horizontal" Width="{Binding Width, ElementName=RootScrimView}" Height="{Binding Height, ElementName=RootScrimView}" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</UserControl>