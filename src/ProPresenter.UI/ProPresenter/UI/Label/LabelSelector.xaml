<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Label.LabelSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:label="clr-namespace:ProPresenter.DO.Label;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:label1="clr-namespace:ProPresenter.UI.Label">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <DataTemplate x:Key="ColorBox">
        <Border BorderBrush="#FF000000" BorderThickness="1">
          <Image MinWidth="13" MinHeight="13" Stretch="Fill">
            <Image.Source>
              <DrawingImage>
                <DrawingImage.Drawing>
                  <DrawingGroup>
                    <DrawingGroup.Children>
                      <GeometryDrawing Brush="#FF000000">
                        <GeometryDrawing.Geometry>
                          <RectangleGeometry Rect="0,0,1,1" />
                        </GeometryDrawing.Geometry>
                      </GeometryDrawing>
                      <GeometryDrawing Brush="#FFFFFFFF" Geometry="M1,0 L0,1 L1,1" />
                      <GeometryDrawing Brush="{Binding Converter={StaticResource ColorToBrushConverter}}">
                        <GeometryDrawing.Geometry>
                          <RectangleGeometry Rect="0,0,1,1" />
                        </GeometryDrawing.Geometry>
                      </GeometryDrawing>
                    </DrawingGroup.Children>
                  </DrawingGroup>
                </DrawingImage.Drawing>
              </DrawingImage>
            </Image.Source>
          </Image>
        </Border>
      </DataTemplate>
      <ContextMenu x:Key="LabelMenu" Placement="Bottom" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Labels}">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectLabelCommand, Source={StaticResource proxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="Header" Value="{Binding Text}" />
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding Path="Text" />
                  <Binding Path="Data.Name" Source="{StaticResource proxy}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
      <ContextMenu x:Key="ColorMenu" ItemsSource="{x:Static label:DefaultColors.DefaultLabelColors}" Placement="Bottom" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectColorCommand, Source={StaticResource proxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="HeaderTemplate" Value="{StaticResource ColorBox}" />
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding />
                  <Binding Path="Data.Color" Source="{StaticResource proxy}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Height="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid>
      <Button Padding="5,0" HorizontalContentAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" BorderThickness="1" ContextMenu="{StaticResource LabelMenu}">
        <commonControls:PathControl Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" PathType="DownArrow" Fill="{Binding Foreground, RelativeSource={RelativeSource Self}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
      </Button>
      <commonControls:PlaceholderTextBox Margin="0,0,18,0" HorizontalAlignment="Left" BorderBrush="#00FFFFFF" IsTextBindingExplicit="True" Background="{Binding SURFACE, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Name}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type commonControls:PlaceholderTextBox}}" TargetType="{x:Type commonControls:PlaceholderTextBox}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding MultipleValues}">
                <Setter Property="commonControls:PlaceholderTextBox.PlaceholderText" Value="{mex:Localized GLOBAL_MULTIPLE_VALUES}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:PlaceholderTextBox>
    </Grid>
    <commonControls:DropDownButton Grid.Column="1" Margin="7,0,0,0" CustomContextMenu="{StaticResource ColorMenu}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type commonControls:DropDownButton}">
          <Setter Property="commonControls:DropDownButton.CustomContent">
            <Setter.Value>
              <ContentPresenter Width="50" Margin="0,1,7,1" ContentTemplate="{StaticResource ColorBox}" Content="{Binding Data.Color, Source={StaticResource proxy}}" />
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding MultipleColors}">
              <Setter Property="commonControls:DropDownButton.CustomContent">
                <Setter.Value>
                  <StackPanel Orientation="Horizontal">
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <Style x:Key="{x:Type Ellipse}" TargetType="{x:Type Ellipse}">
                          <Setter Property="Fill" Value="#FFD3D3D3" />
                          <Setter Property="Height" Value="7" />
                          <Setter Property="Margin" Value="7,0,0,0" />
                          <Setter Property="Width" Value="7" />
                        </Style>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                    <Ellipse />
                    <Ellipse />
                    <Ellipse />
                  </StackPanel>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </commonControls:DropDownButton>
  </Grid>
</UserControl>