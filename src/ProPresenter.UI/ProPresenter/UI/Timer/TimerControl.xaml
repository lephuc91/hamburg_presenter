<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Timer.TimerControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Timer" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:timer="clr-namespace:ProPresenter.DO.Timer;assembly=ProPresenter.DO" x:Name="self">
  <FrameworkElement.Resources>
    <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    <Style x:Key="TextBoxStyle" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}" />
    <ObjectDataProvider x:Key="TimeFormatEnum" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:TypeExtension TypeName="timer:TimeFormat" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <local:TimerTypeSelector x:Name="TypeSelection" Grid.ColumnSpan="2" DisplayIcons="False" DataContext="{Binding TimerTypeSelectorVM, ElementName=self}" />
    <ContentControl Grid.Row="1" Grid.Column="0" Margin="0,5">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ContentControl}">
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate />
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Value="Countdown" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <commonControls:TimeSliceTextBox Height="22" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ShowMilliseconds="False" Style="{StaticResource TextBoxStyle}" TimeValue="{Binding CurrentTimer.Source.StartTime, ElementName=self, Mode=TwoWay}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Value="CountdownToTime" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <commonControls:TimeSliceTextBox Height="22" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ShowMilliseconds="False" Style="{StaticResource TextBoxStyle}" TimeValue="{Binding CurrentTimer.Source.EndTime, ElementName=self, Mode=TwoWay}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Value="ElapsedTime" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <commonControls:TimeSliceTextBox Height="22" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ShowMilliseconds="False" Style="{StaticResource TextBoxStyle}" TimeValue="{Binding CurrentTimer.Source.StartTime, ElementName=self, Mode=TwoWay}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ContentControl>
    <ContentControl Grid.Row="2" Grid.Column="0" Visibility="{Binding ShowLabel, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ContentControl}">
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock HorizontalAlignment="Center" FontSize="9" Text="{mex:Localized ACTION_PALETTE_TIMER_CONFIGURATION_DURATION_title}" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Value="CountdownToTime" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center" FontSize="9" Text="{mex:Localized ACTION_PALETTE_TIMER_CONFIGURATION_TIME_title}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Value="ElapsedTime" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center" FontSize="9" Text="{mex:Localized ACTION_PALETTE_TIMER_CONFIGURATION_START_title}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ContentControl>
    <ContentControl Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ContentControl}">
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate />
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Value="CountdownToTime" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <ComboBox Height="22" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource TimeFormatEnum}}" SelectedItem="{Binding CurrentTimer.Source.TimeFormat, ElementName=self, Mode=TwoWay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ComboBox>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Value="ElapsedTime" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <local:ElapseTimeEndTextBox Height="22" HorizontalAlignment="Stretch" EndTime="{Binding CurrentTimer.Source.EndTime, Mode=TwoWay, ElementName=self}">
                      <local:ElapseTimeEndTextBox.HasEndTime>
                        <PriorityBinding>
                          <Binding ElementName="self" Mode="TwoWay" Path="CurrentTimer.Source.HasEndTime" />
                        </PriorityBinding>
                      </local:ElapseTimeEndTextBox.HasEndTime>
                    </local:ElapseTimeEndTextBox>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ContentControl>
    <ContentControl Grid.Row="2" Grid.Column="1" Visibility="{Binding Path=ShowLabel, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:TimerControl}}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ContentControl}">
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate />
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Value="{x:Static timer:TimerType.CountdownToTime}" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center" FontSize="9" Text="{mex:Localized ACTION_PALETTE_TIMER_CONFIGURATION_FORMAT_title}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Value="{x:Static timer:TimerType.ElapsedTime}" Binding="{Binding CurrentTimer.Source.TimerType, ElementName=self}">
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Center" FontSize="9" Text="{mex:Localized ACTION_PALETTE_TIMER_CONFIGURATION_END_title}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ContentControl>
  </Grid>
</UserControl>