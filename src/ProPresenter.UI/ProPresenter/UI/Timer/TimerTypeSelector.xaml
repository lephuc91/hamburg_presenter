<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Timer.TimerTypeSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:timer="clr-namespace:ProPresenter.DO.Timer;assembly=ProPresenter.DO" x:Name="timerTypeSelector" xmlns:timer1="clr-namespace:ProPresenter.UI.Timer;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    <ObjectDataProvider x:Key="TimerTypeEnum" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:TypeExtension TypeName="timer:TimerType" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <CollectionViewSource x:Key="TimerTypes" Source="{Binding Source={StaticResource TimerTypeEnum}}" />
  </FrameworkElement.Resources>
  <Grid>
    <ComboBox SelectedItem="{Binding SelectedTimerType, ElementName=timerTypeSelector, Mode=TwoWay}" Visibility="{Binding DisplayIcons, ElementName=timerTypeSelector, Converter={StaticResource InvertedValueToVisibilityConverter}}">
      <ItemsControl.ItemsSource>
        <CompositeCollection>
          <CollectionContainer Collection="{Binding Source={StaticResource TimerTypes}}" />
        </CompositeCollection>
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Image Margin="0,0,5,0" HorizontalAlignment="Left">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Image}">
                  <Setter Property="Source" Value="../Resources/Icons/Timers/timerCountdown.png" />
                  <Style.Triggers>
                    <DataTrigger Value="CountdownToTime" Binding="{Binding}">
                      <Setter Property="Source" Value="../Resources/Icons/Timers/timerCountdownToTime.png" />
                    </DataTrigger>
                    <DataTrigger Value="ElapsedTime" Binding="{Binding}">
                      <Setter Property="Source" Value="../Resources/Icons/Timers/timerElapsedTime.png" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Image>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <ComboBox Name="TimerTypeSelectorIcon" SelectedItem="{Binding SelectedTimerType, ElementName=timerTypeSelector, Mode=TwoWay}" Visibility="{Binding DisplayIcons, ElementName=timerTypeSelector, Converter={StaticResource ValueToVisibilityConverter}}">
      <ItemsControl.ItemsSource>
        <CompositeCollection>
          <CollectionContainer Collection="{Binding Source={StaticResource TimerTypes}}" />
        </CompositeCollection>
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Image HorizontalAlignment="Left">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Image}">
                <Setter Property="Source" Value="../Resources/Icons/Timers/timerCountdown.png" />
                <Style.Triggers>
                  <DataTrigger Value="CountdownToTime" Binding="{Binding SelectedTimerType}">
                    <Setter Property="Source" Value="../Resources/Icons/Timers/timerCountdownToTime.png" />
                  </DataTrigger>
                  <DataTrigger Value="ElapsedTime" Binding="{Binding SelectedTimerType}">
                    <Setter Property="Source" Value="../Resources/Icons/Timers/timerElapsedTime.png" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Image>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="{x:Type ComboBoxItem}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" TextElement.Foreground="{TemplateBinding Control.Foreground}">
                  <StackPanel Margin="4,2" Orientation="Horizontal">
                    <Image HorizontalAlignment="Left">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Image}">
                          <Setter Property="Source" Value="../Resources/Icons/Timers/timerCountdown.png" />
                          <Style.Triggers>
                            <DataTrigger Value="CountdownToTime" Binding="{Binding}">
                              <Setter Property="Source" Value="../Resources/Icons/Timers/timerCountdownToTime.png" />
                            </DataTrigger>
                            <DataTrigger Value="ElapsedTime" Binding="{Binding}">
                              <Setter Property="Source" Value="../Resources/Icons/Timers/timerElapsedTime.png" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </Image>
                    <TextBlock Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
                  </StackPanel>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ItemsControl.ItemContainerStyle>
    </ComboBox>
  </Grid>
</UserControl>