<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Timer.TimerDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:do="clr-namespace:ProPresenter.DO.Timer;assembly=ProPresenter.DO" xmlns:links="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links" xmlns:local="clr-namespace:ProPresenter.UI.Timer" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="timerDetails">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverterNonCollapse" IsCollapsing="False" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <ObjectDataProvider x:Key="TimeFormatEnum" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="do:TimeFormat" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <Style x:Key="{x:Type commonControls:TimeSliceTextBox}" TargetType="{x:Type commonControls:TimeSliceTextBox}">
        <Setter Property="Background" Value="{Binding TEXTBOX_PALETTE.Standard.Background, Source={x:Static theming:AppTheme.Active}}" />
        <Setter Property="BorderBrush" Value="{Binding TEXTBOX_PALETTE.Standard.Border, Source={x:Static theming:AppTheme.Active}}" />
        <Setter Property="Foreground" Value="{Binding TEXTBOX_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="commonControls:ValidatingTextBox.UpdateTextOnEnterKey" Value="True" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TimerLabelColumn" />
        <ColumnDefinition Width="*" SharedSizeGroup="TimerTypeColumn" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMERS_WINDOW_TIMER_TYPE_title}" />
      <local:TimerTypeSelector Grid.Column="1" HorizontalAlignment="Left" DisplayIcons="False" SelectedTimerType="{Binding SelectedTimerType, ElementName=timerDetails, Mode=TwoWay}" />
    </Grid>
    <Grid Row="1" Margin="0,0,0,5" HorizontalAlignment="Stretch" Visibility="{Binding SelectedTimerType, ElementName=timerDetails, Converter={StaticResource ValueToVisibilityConverterNonCollapse}, ConverterParameter={x:Static do:TimerType.Countdown}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TimerLabelColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMERS_WINDOW_COUNTDOWN_DURATION_title}" />
      <commonControls:TimeSliceTextBox Grid.Column="1" HorizontalAlignment="Left" VerticalContentAlignment="Center" AllowNegativeValues="True" ShowMilliseconds="False" TimeValue="{Binding StartTime, ElementName=timerDetails, Mode=TwoWay}" />
    </Grid>
    <Grid Row="1" Margin="0,0,0,5" Visibility="{Binding SelectedTimerType, ElementName=timerDetails, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:TimerType.CountdownToTime}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TimerLabelColumn" />
        <ColumnDefinition Width="*" SharedSizeGroup="TimerTypeColumn" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMERS_WINDOW_COUNTDOWN_TO_TIME_TIME_title}" />
      <Grid Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <commonControls:TimeSliceTextBox Margin="0,0,5,0" VerticalContentAlignment="Center" ShowMilliseconds="False" TimeValue="{Binding EndTime, ElementName=timerDetails, Mode=TwoWay}" />
        <ComboBox Grid.Column="1" Height="22" Margin="0,0,1,0" HorizontalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource TimeFormatEnum}}" SelectedItem="{Binding TimeFormat, ElementName=timerDetails}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
      </Grid>
    </Grid>
    <Grid Row="1" Margin="0,0,0,5" Visibility="{Binding SelectedTimerType, ElementName=timerDetails, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:TimerType.ElapsedTime}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TimerLabelColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,5,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMERS_WINDOW_ELAPSED_START_title}" />
      <commonControls:TimeSliceTextBox Grid.Column="1" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalContentAlignment="Center" AllowNegativeValues="True" ShowMilliseconds="False" TimeValue="{Binding StartTime, ElementName=timerDetails, Mode=TwoWay}" />
      <TextBlock Grid.Row="1" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized TIMERS_WINDOW_ELAPSED_END_title}" />
      <local:ElapseTimeEndTextBox Grid.Row="1" Grid.Column="1" Width="80" Height="22" HorizontalAlignment="Left" AllowNegativeValues="True" EndTime="{Binding EndTime, ElementName=timerDetails, Mode=TwoWay}" HasEndTime="{Binding HasEndTime, ElementName=timerDetails, Mode=TwoWay}" />
    </Grid>
    <Grid Row="2" Margin="0,0,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TimerLabelColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <CheckBox Grid.Column="1" HorizontalAlignment="Left" Content="{mex:Localized ACTION_PALETTE_TIMER_CONFIGURATION_OVERRUN_title}" Foreground="{Binding Foreground, ElementName=timerDetails}" IsChecked="{Binding Overrun, ElementName=timerDetails}" />
    </Grid>
    <Grid Row="3" Margin="0,0,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TimerLabelColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <links:TimerFormatSelector Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" AvailableHourFormats="{Binding Format.AvailableHourFormats, ElementName=timerDetails}" AvailableMillisecondFormats="{Binding Format.AvailableMillisecondFormats, ElementName=timerDetails}" AvailableMinuteFormats="{Binding Format.AvailableMinuteFormats, ElementName=timerDetails}" AvailableSecondFormats="{Binding Format.AvailableSecondFormats, ElementName=timerDetails}" SecondsEnabled="{Binding Format.SecondsAvailable, ElementName=timerDetails}" SelectedHourFormat="{Binding Format.HourFormat, Mode=TwoWay, ElementName=timerDetails}" SelectedMillisecondFormat="{Binding Format.MillisecondFormat, Mode=TwoWay, ElementName=timerDetails}" SelectedMinuteFormat="{Binding Format.MinuteFormat, Mode=TwoWay, ElementName=timerDetails}" SelectedSecondFormat="{Binding Format.SecondFormat, Mode=TwoWay, ElementName=timerDetails}" Visibility="{Binding ShowTimerFormat, ElementName=timerDetails, Converter={StaticResource ValueToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>