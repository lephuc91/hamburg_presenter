<?xml version="1.0" encoding="utf-8"?>
<Button x:Class="ProPresenter.UI.Mask.MaskButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:ProPresenter.UI.Commands" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cues="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.Mask" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="maskButton" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ToolTip="{Binding SelectedMask.Name, ElementName=maskButton}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonUtility:BindingProxy x:Key="maskButtonProxy" Data="{Binding ElementName=maskButton}" />
      <converters:CustomSlideConverter x:Key="CustomSlideConverter" />
      <local:MaskStyleSelector x:Key="MaskStyleSelector" />
      <Style x:Key="MaskStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SelectMaskCommand, Source={StaticResource maskButtonProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="Data.SelectedMask" Source="{StaticResource maskButtonProxy}" />
              <Binding />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <ui:SlidePreviewSelector RenderTransparencyCheckerboard="True" ShowLabel="True" LabelText="{Binding Data.SelectedMask.Name, Source={StaticResource maskButtonProxy}}" Source="{Binding Data.SelectedMask.SlideAction.Slide, Source={StaticResource maskButtonProxy}, Converter={StaticResource CustomSlideConverter}}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </FrameworkElement.Style>
  <FrameworkElement.ContextMenu>
    <ContextMenu ItemContainerStyleSelector="{StaticResource MaskStyleSelector}" Placement="Bottom" Opened="ContextMenu_Opened">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <DataTemplate x:Key="{DataTemplateKey {x:Type cues:SlideCue}}" DataType="{x:Type cues:SlideCue}">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ItemsControl.ItemsSource>
        <CompositeCollection>
          <CollectionContainer Collection="{Binding Data.Masks, Source={StaticResource maskButtonProxy}}" />
          <Separator Visibility="{Binding Data.Masks.Count, Source={StaticResource maskButtonProxy}, Converter={StaticResource CountToVisibilityConverter}}" />
          <MenuItem Style="{StaticResource MaskStyle}" CommandParameter="{x:Null}" DataContext="{x:Null}" Header="{mex:Localized GLOBAL_NONE}" />
          <Separator />
          <MenuItem CommandParameter="{x:Static commands:ShowSource.LooksWindow}" Command="{Binding Data.EditMasksCommand, Source={StaticResource maskButtonProxy}}" Header="{mex:Localized AUDIENCE_LOOKS_MASK_EDIT_title}" />
          <MenuItem Command="{Binding Data.AddNewMaskCommand, Source={StaticResource maskButtonProxy}}" Header="{mex:Localized AUDIENCE_LOOKS_MASK_ADD_NEW_title}" />
        </CompositeCollection>
      </ItemsControl.ItemsSource>
    </ContextMenu>
  </FrameworkElement.ContextMenu>
</Button>