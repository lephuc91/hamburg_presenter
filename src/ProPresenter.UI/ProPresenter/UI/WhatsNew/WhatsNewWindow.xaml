<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.WhatsNew.WhatsNewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:dependencyInjection="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:whatsNewSettings="clr-namespace:ProPresenter.UI.ViewModels.WhatsNew" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Width="900" Height="600" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:whatsnew="clr-namespace:ProPresenter.UI.WhatsNew" uiUtility:UIElementHelper.Palette="{Binding WELCOME_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" DataContext="{dependencyInjection:DIMarkup {x:Type whatsNewSettings:IWhatsNewV2VM}}">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
        <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <converters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
        <converters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,30" HorizontalAlignment="Center" FontSize="36" FontWeight="Bold" Text="{mex:Localized WHATSNEW_HEADER_title}" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Data.Features, Source={StaticResource proxy}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="150,5,120,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <commonControls:ImageMask Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="50" Margin="0,5,20,0" HorizontalAlignment="Center" VerticalAlignment="top" Fill="{Binding Data.AccentColor, Source={StaticResource proxy}, Converter={StaticResource ColorToBrushConverter}}" ImageSource="{Binding Icon}" Visibility="{Binding Path=ColorizeImage, Converter={StaticResource ValueToVisibilityConverter}}" />
              <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="50" Margin="0,5,20,0" HorizontalAlignment="Center" VerticalAlignment="top" Source="{Binding Icon}" Visibility="{Binding Path=ColorizeImage, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" VerticalAlignment="Top" FontSize="14" TextWrapping="Wrap" Foreground="{Binding HEADERHELPERCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Description}" />
              <commonControls:BorderlessButton Grid.Row="2" Grid.Column="1" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" FontSize="14" Command="{Binding GotoLinkCommand}" Content="{Binding FeatureLinkText}" Foreground="{Binding TOGGLESWITCH_PALETTE.Checked.Background, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding Path=FeatureContainsLink, Converter={StaticResource ValueToVisibilityConverter}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <commonControls:BorderlessButton Grid.Row="2" Height="26" Margin="0,30,0,30" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" FontSize="18" Command="{Binding GotoLinkCommand}" Foreground="{Binding TOGGLESWITCH_PALETTE.Checked.Background, Source={x:Static theming:AppTheme.Active}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Text="{mex:Localized WHATSNEW_VIEW_ALL_CHANGES_LINK_text}" />
        <commonControls:ImageMask Margin="0,5,0,0" VerticalAlignment="Center" ImageSource="../Resources/Icons/RightArrow.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
      </StackPanel>
    </commonControls:BorderlessButton>
    <Grid Row="3" Background="{Binding SUBHEADER, Source={x:Static theming:AppTheme.Active}}">
      <Button Height="22" Margin="0,20" Padding="50,0" HorizontalAlignment="Center" uiUtility:UIElementHelper.CornerRadius="4" Command="{Binding GetStartedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{mex:Localized WHATSNEW_GET_STARTED_BUTTON_title}" />
    </Grid>
  </Grid>
  <!--Unknown connection ID: 1-->
</windowing:ChromedWindow>