<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TestPattern.TestPatternDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.TestPattern" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="testPatternVMProxy" Data="{Binding}" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <commonControls:DirectXImage Name="LivePreview" Grid.Row="0" Width="220" Margin="0,0,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RequestRenderCommand="{Binding RequestRenderCommand}">
        <UIElement.OpacityMask>
          <VisualBrush Stretch="None">
            <VisualBrush.Visual>
              <Rectangle Fill="#FF000000" RadiusX="4" RadiusY="4" Width="{Binding ActualWidth, ElementName=LivePreview}" Height="{Binding ActualHeight, ElementName=LivePreview}" />
            </VisualBrush.Visual>
          </VisualBrush>
        </UIElement.OpacityMask>
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.7" ShadowDepth="1" Color="{StaticResource {x:Static themesUI:Colors.Shadow}}" />
        </UIElement.Effect>
      </commonControls:DirectXImage>
      <Button Grid.Row="1" Width="230" Height="22" Margin="0,0,0,10" HorizontalAlignment="Center" uiUtility:UIElementHelper.CornerRadius="4" Command="{Binding CurrentState.ShowPatternCommand}" Content="{mex:Localized TEST_PATTERN_SHOW_title}" Visibility="{Binding Path=IsEnabled, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource Self}}" />
      <Button Grid.Row="1" Width="230" Height="22" Margin="0,0,0,10" HorizontalAlignment="Center" uiUtility:UIElementHelper.CornerRadius="4" Command="{Binding CurrentState.HidePatternCommand}" Content="{mex:Localized TEST_PATTERN_HIDE_title}" Visibility="{Binding Path=IsEnabled, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource Self}}" />
      <Separator Grid.Row="2" Margin="0,0,0,0" />
    </Grid>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" RequestBringIntoView="Details_RequestBringIntoView">
      <Grid Margin="0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:TestPatternStateOptionsView Grid.Row="0" Margin="15,0" DataContext="{Binding}" />
        <local:TestPatternSelector Grid.Row="1" Margin="15,10,15,0" VerticalAlignment="Top" DataContext="{Binding}" />
        <local:TestPatternAudioVideoSyncView Grid.Row="2" Margin="15,10,15,0" VerticalAlignment="Top" DataContext="{Binding SelectedPattern}" Visibility="{Binding ShowDelaySettings, Converter={StaticResource ValueToVisibilityConverter}}" />
        <local:TestPatternPropertiesView Grid.Row="3" Margin="15,10,15,0" VerticalAlignment="Top" DataContext="{Binding SelectedPattern}" Visibility="{Binding Properties.Count, Converter={StaticResource CountToVisibilityConverter}}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>