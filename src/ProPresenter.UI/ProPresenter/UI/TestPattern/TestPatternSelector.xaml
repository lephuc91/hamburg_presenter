<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TestPattern.TestPatternSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.TestPattern" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="testPatternVMProxy" Data="{Binding}" />
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <Style x:Key="ThumbnailViewStyle" TargetType="{x:Type local:TestPatternThumbnailView}">
        <Setter Property="Width" Value="100" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border CornerRadius="4" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Vertical">
        <TextBlock Grid.Column="0" FontSize="13" Text="{mex:Localized TEST_PATTERN_SELECTED_PATTERN_label}" />
        <TextBlock Grid.Column="0" Margin="0,8,0,0" FontSize="11" IsEnabled="False" Foreground="{Binding BUTTON_DISABLED_CONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding SelectedPattern.Name, Converter={StaticResource LocalizedStringConverter}}" />
      </StackPanel>
      <commonControls:BorderlessDropDownButton Height="60" HorizontalAlignment="Right">
        <commonControls:BorderlessDropDownButton.CustomContent>
          <local:TestPatternThumbnailView Margin="0,0,4,0" Style="{StaticResource ThumbnailViewStyle}" Thumbnail="{Binding SelectedPattern.Thumbnail}" />
        </commonControls:BorderlessDropDownButton.CustomContent>
        <commonControls:BorderlessDropDownButton.CustomContextMenu>
          <ContextMenu Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Data.TestPatterns, Source={StaticResource testPatternVMProxy}}">
            <ItemsControl.ItemContainerStyle>
              <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                <Setter Property="MenuItem.Command" Value="{Binding SelectPatternCommand}" />
                <Setter Property="HeaderTemplate">
                  <Setter.Value>
                    <DataTemplate>
                      <Grid Margin="0,4" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:TestPatternThumbnailView Grid.Column="0" Style="{StaticResource ThumbnailViewStyle}" Thumbnail="{Binding Thumbnail}" />
                        <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}" />
                      </Grid>
                    </DataTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MenuItem.IsChecked">
                  <Setter.Value>
                    <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                      <Binding Path="Data.SelectedPattern" Source="{StaticResource testPatternVMProxy}" />
                      <Binding />
                    </MultiBinding>
                  </Setter.Value>
                </Setter>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ContextMenu>
        </commonControls:BorderlessDropDownButton.CustomContextMenu>
      </commonControls:BorderlessDropDownButton>
    </Grid>
  </Border>
</UserControl>