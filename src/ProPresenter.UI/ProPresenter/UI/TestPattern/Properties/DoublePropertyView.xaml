<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TestPattern.Properties.DoublePropertyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.TestPattern.Properties" xmlns:themsUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:vmDo="clr-namespace:ProPresenter.UI.ViewModels.TestPattern.Property">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}" />
    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding ViewType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static vmDo:DoublePropertyVMViewType.Stepper}}">
      <commonControls:DoubleUpDown Width="60" Height="22" FormatString="{Binding Converter={local:NumericPropertyToFormatStringConverter}}" Increment="{Binding StepSize}" Maximum="{Binding Max}" Minimum="{Binding Min}" Value="{Binding Value, Mode=TwoWay}" />
      <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Units}" />
    </StackPanel>
    <commonControls:UnitsSlider Grid.Column="1" Width="140" HorizontalAlignment="Right" Background="{StaticResource {x:Static themsUI:Brushes.CheckerboardSecondary}}" FillMode="None" LargeChange="20" SmallChange="1" Maximum="{Binding Max}" Minimum="{Binding Min}" TickFrequency="{Binding StepSize}" Units="{Binding Units}" Visibility="{Binding ViewType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static vmDo:DoublePropertyVMViewType.Slider}}" Value="{Binding Value, Mode=TwoWay}" />
    <commonControls:SpeedSlider Grid.Column="1" Width="140" HorizontalAlignment="Right" Background="{StaticResource {x:Static themsUI:Brushes.CheckerboardSecondary}}" LargeChange="{Binding StepSize}" Maximum="{Binding Max}" Minimum="{Binding Min}" SmallChange="{Binding StepSize}" TickFrequency="{Binding StepSize}" Visibility="{Binding ViewType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static vmDo:DoublePropertyVMViewType.SpeedSlider}}" Value="{Binding Value, Mode=TwoWay}" />
  </Grid>
</UserControl>