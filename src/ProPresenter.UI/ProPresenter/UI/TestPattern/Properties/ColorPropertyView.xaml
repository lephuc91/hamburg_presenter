<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TestPattern.Properties.ColorPropertyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:properties="clr-namespace:ProPresenter.UI.TestPattern.Properties;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}" ToolTip="{Binding Name, Converter={StaticResource LocalizedStringConverter}}" />
    <commonControls:BubbleColorPicker Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AllowAlpha="{Binding AllowAlpha}" DefaultColors="{Binding DefaultColors}" SelectedColor="{Binding Color, Mode=TwoWay}" />
  </Grid>
</UserControl>