<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TestPattern.Properties.StringPropertyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:properties="clr-namespace:ProPresenter.UI.TestPattern.Properties;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Margin="0,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}" />
    <TextBox Grid.Row="1" Height="22" VerticalContentAlignment="Center" uiUtility:TextBoxHelper.UpdateOnEnterKey="True" MaxLength="{Binding MaxChars}" Text="{Binding Value, Mode=TwoWay}" />
  </Grid>
</UserControl>