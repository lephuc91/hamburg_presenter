<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TestPattern.Properties.IntPropertyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.TestPattern.Properties">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name, Converter={StaticResource LocalizedStringConverter}}" />
    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
      <commonControls:IntegerUpDown Width="60" Height="22" FormatString="{Binding Converter={local:NumericPropertyToFormatStringConverter}}" Maximum="{Binding Max}" Minimum="{Binding Min}" Value="{Binding Value, Mode=TwoWay}" />
      <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Units}" />
    </StackPanel>
  </Grid>
</UserControl>