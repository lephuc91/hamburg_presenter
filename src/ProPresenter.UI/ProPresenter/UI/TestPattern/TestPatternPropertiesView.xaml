<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TestPattern.TestPatternPropertiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:doProperties="clr-namespace:ProPresenter.UI.TestPattern.Properties" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:testpattern="clr-namespace:ProPresenter.UI.TestPattern">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="mainBorder" CornerRadius="4" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
    <ItemsControl ItemsSource="{Binding Properties}" RequestBringIntoView="Properties_RequestBringIntoView">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Visibility="{Binding IsShown, Converter={StaticResource ValueToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" Content="{Binding}">
              <ContentControl.ContentTemplateSelector>
                <doProperties:PropertyTemplateSelector />
              </ContentControl.ContentTemplateSelector>
            </ContentControl>
            <Separator Grid.Row="1">
              <UIElement.Visibility>
                <MultiBinding Converter="{converters:IsLastItemToVisibilityConverter}">
                  <Binding />
                  <Binding Path="ItemsSource" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                </MultiBinding>
              </UIElement.Visibility>
            </Separator>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>