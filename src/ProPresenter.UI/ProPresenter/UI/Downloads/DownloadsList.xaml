<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Downloads.DownloadsList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.Downloads" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" Width="380" Height="300">
  <Border BorderThickness="1" CornerRadius="{StaticResource {x:Static themes:Constants.WindowCornerRadius}}" Background="{Binding OUTLINEDETAIL, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid Margin="0,8,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding LIGHTCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized DOWNLOADS_POPOVER_HEADER_label}" />
      <TextBlock Grid.Row="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12">
        <Hyperlink Command="{Binding ClearCommand}">
          <TextBlock Text="{mex:Localized DOWNLOADS_POPOVER_HEADER_CLEAR_BUTTON_title}">
            <TextBlock.Foreground>
              <SolidColorBrush Color="{StaticResource {x:Static themes:Colors.Secondary}}" />
            </TextBlock.Foreground>
          </TextBlock>
        </Hyperlink>
      </TextBlock>
      <ItemsControl Grid.Row="1" Margin="0,5,0,0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsContainerVirtualizable="True" VirtualizingPanel.ScrollUnit="Pixel" ItemsSource="{Binding Items.Value}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <local:DownloadItemTemplate CancelDownloadCommand="{Binding CancelDownloadCommand}" FileName="{Binding Name.Value}" PercentComplete="{Binding PercentComplete}" ReceivedStatus="{Binding ReceivedStatus}" RetryDownloadCommand="{Binding RetryDownloadCommand}" Status="{Binding Status}" Thumbnail="{Binding Thumbnail}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <Control.Template>
          <ControlTemplate TargetType="{x:Type ItemsControl}">
            <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
              <ScrollViewer Padding="{TemplateBinding Control.Padding}" Focusable="False">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Control.Template>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>