<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Downloads.DownloadItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Pro.Common.Downloads;assembly=Pro.Common" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Downloads" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="downloadItemTemplate">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderThickness="0,1,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid Margin="8,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="50" Height="28.125" Margin="0,10">
        <Border.Background>
          <ImageBrush ImageSource="{StaticResource {x:Static themes:Icons.DownloadPlaceholder}}" Stretch="Uniform" />
        </Border.Background>
        <Image Stretch="UniformToFill" Source="{Binding ThumbnailImage, ElementName=downloadItemTemplate}" />
      </Border>
      <Grid Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Margin="5,2.5" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Foreground="{Binding LIGHTCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding FileName, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}" />
        <ProgressBar Grid.Row="2" Height="5" Margin="5,2.5" Visibility="{Binding Status, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static common:DownloadStatus.Active}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}" Value="{Binding PercentComplete, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}" />
        <TextBlock Grid.Row="3" Margin="5,2.5" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="9" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{Binding LISTITEM_DISABLED_CONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding ReceivedStatus, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}" />
      </Grid>
      <commonControls:BorderlessButton Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding CancelDownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}" ToolTip="{mex:Localized DOWNLOADS_POPOVER_CANCEL_BUTTON_tooltip}" Visibility="{Binding Status, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static common:DownloadStatus.Active}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}">
        <commonControls:ImageMask Width="12" Height="12" ImageSource="{StaticResource {x:Static themes:Icons.DownloadItemCancelIcon}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
      </commonControls:BorderlessButton>
      <commonControls:BorderlessButton Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding RetryDownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}" ToolTip="{mex:Localized DOWNLOADS_POPOVER_CANCEL_BUTTON_tooltip}" Visibility="{Binding Status, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static common:DownloadStatus.Stopped}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadItemTemplate}}}">
        <commonControls:ImageMask Width="12" Height="12" ImageSource="{StaticResource {x:Static themes:Icons.DownloadItemRetryIcon}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type commonControls:ImageMask}">
              <Setter Property="commonControls:ImageMask.Fill" Value="#D9ff9f0a" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}">
                  <Setter Property="commonControls:ImageMask.Fill" Value="#F2ff9f0a" />
                </DataTrigger>
                <DataTrigger Value="False" Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}">
                  <Setter Property="commonControls:ImageMask.Fill" Value="#66ff9f0a" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:ImageMask>
      </commonControls:BorderlessButton>
    </Grid>
  </Border>
</UserControl>