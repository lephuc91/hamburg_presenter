<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ArrangementView.ArrangementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arrangements="clr-namespace:ProPresenter.DO.Arrangements;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ArrangementView" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels" x:Name="arrangementView" DataContext="{di:DIMarkup {x:Type viewModels:IArrangementVM}}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <commonUtility:BindingProxy x:Key="dependencyProperties" Data="{Binding ElementName=arrangementView}" />
      <ContextMenu x:Key="ArrangementContextMenu" Placement="Bottom">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="{DataTemplateKey {x:Type arrangements:Arrangement}}" DataType="{x:Type arrangements:Arrangement}">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
            <Style x:Key="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
              <Setter Property="MenuItem.Command" Value="{Binding Data.SelectArrangementCommand, Source={StaticResource proxy}}" />
              <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True">
                      <Condition.Binding>
                        <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}">
                          <Binding />
                          <Binding Path="Data.DocumentAction.ActiveArrangement" Source="{StaticResource dependencyProperties}" />
                        </MultiBinding>
                      </Condition.Binding>
                    </Condition>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="MenuItem.IsChecked" Value="True" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem DataContext="{Binding Data.DocumentAction.Presentation.DefaultArrangement, Source={StaticResource dependencyProperties}}" Header="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_MENU_MASTER_title}" />
            <Separator Visibility="{Binding Data.DocumentAction.Presentation.Arrangements.Count, Source={StaticResource dependencyProperties}, Converter={StaticResource CountToVisibilityConverter}}" />
            <CollectionContainer Collection="{Binding Data.DocumentAction.Presentation.Arrangements, Source={StaticResource dependencyProperties}}" />
            <Separator />
            <MenuItem Command="{Binding Data.AddArrangementCommand, Source={StaticResource proxy}}" Header="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_MENU_NEW_ARRANGEMENT_title}" />
            <MenuItem Command="{Binding Data.OpenArrangementManagerCommand, Source={StaticResource proxy}}" Header="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_MENU_EDIT_ARRANGEMENTS_title}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding Foreground, ElementName=arrangementView}" Text="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_GROUPS_label}" />
    <Button Grid.Row="1" Width="150" Height="22" Margin="5,0" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ContextMenu="{StaticResource ArrangementContextMenu}">
      <Control.Template>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border SnapsToDevicePixels="True">
            <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Text" Value="{Binding DocumentAction.ActiveArrangement.Name, ElementName=arrangementView}" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding DocumentAction.ActiveArrangement.IsMaster, ElementName=arrangementView}">
                        <Setter Property="Text" Value="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_MENU_MASTER_title}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,5,0" PathType="DownArrow" StrokeThickness="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Control.Template>
    </Button>
    <local:ArrangementPanel Grid.Column="1" MinHeight="24" Background="#00FFFFFF" IsMasterView="True" ActiveGroup="{Binding ActiveGroup}" Arrangement="{Binding DocumentAction.Presentation.DefaultArrangement, ElementName=arrangementView}" FullOpacity="{Binding DocumentAction.ActiveArrangement.IsMaster}" MoveGroupCommand="{Binding MoveGroupCommand}" />
    <Border Grid.Row="1" Grid.Column="1" BorderThickness="1" BorderBrush="{Binding BUTTON_PALETTE.Standard.Border, Source={x:Static theming:AppTheme.Active}}">
      <local:ArrangementPanel MinHeight="24" FullOpacity="True" ActiveGroup="{Binding ActiveGroup}" Arrangement="{Binding DocumentAction.ActiveArrangement, ElementName=arrangementView}" Background="{Binding CONTAINER, Source={x:Static theming:AppTheme.Active}}" MoveGroupCommand="{Binding MoveGroupCommand}" RemoveGroupCommand="{Binding RemoveGroupCommand}" Visibility="{Binding DocumentAction.ActiveArrangement.IsMaster, ElementName=arrangementView, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
    </Border>
    <TextBlock Grid.Row="1" Grid.Column="1" Margin="7,9,0,9" IsHitTestVisible="False">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding DocumentAction.ActiveArrangement.IsMaster}">
              <Setter Property="Text" Value="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_SELECT_ARRANGEMENT_label}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding DocumentAction.ActiveArrangement.IsMaster}" />
                <Condition Value="0" Binding="{Binding DocumentAction.ActiveArrangement.Count}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Text" Value="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_EMPTY_label}" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
  </Grid>
</UserControl>