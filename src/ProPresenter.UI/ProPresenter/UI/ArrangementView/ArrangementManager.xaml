<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.ArrangementView.ArrangementManager" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arrangementView="clr-namespace:ProPresenter.UI.ArrangementView" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="self" Width="500" Height="250" MinWidth="250" MinHeight="250" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" CanMaximize="False" CanMinimize="False" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" Resources="{converters:FormattedLocalizedStringConverter Key=FormattedLocalizedStringConverter}" Title="{Binding Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=PRESENTATION_HEADER_ARRANGEMENTS_MANAGER_title, Path=PresentationName}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <StackPanel Margin="5" HorizontalAlignment="Left" Orientation="Horizontal">
        <commonControls:PathButton PathType="Plus" Command="{Binding AddArrangementCommand}" />
        <commonControls:PathButton PathType="Minus" Command="{Binding RemoveArrangementCommand}" CommandParameter="{Binding SelectedItem, ElementName=ArrangementListBox}" />
      </StackPanel>
      <Button Height="22" Margin="5" Padding="5,0" HorizontalAlignment="Right" Command="{Binding DuplicateArrangementCommand}" CommandParameter="{Binding SelectedItem, ElementName=ArrangementListBox}" Content="{mex:Localized GLOBAL_DUPLICATE_MENU_ITEM_title}" />
    </Grid>
    <arrangementView:ArrangementItemsListBox x:Name="ArrangementListBox" Grid.Row="1" Margin="5" BorderThickness="0" SelectionMode="Single" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding DocumentAction.Presentation.Arrangements}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <commonControls:EditableTextBlock Foreground="{Binding LISTITEM_CONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Name, Mode=TwoWay}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </arrangementView:ArrangementItemsListBox>
  </Grid>
</windowing:ChromedWindow>