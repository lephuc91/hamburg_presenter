<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ArrangementView.GroupToken" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="self" MaxWidth="200" xmlns:arrangementview="clr-namespace:ProPresenter.UI.ArrangementView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:IsNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpaceConverter" />
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonUtility:BindingProxy x:Key="selfProxy" Data="{Binding ElementName=self}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="2">
    <Border Height="22" CornerRadius="5" SnapsToDevicePixels="True" Background="{Binding ArrangementGroup.Label.Color, ElementName=self, Converter={StaticResource ColorToBrushConverter}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="{Binding Data.ArrangementGroup.Label.Color, Source={StaticResource selfProxy}, Converter={StaticResource ColorToBrushConverter}}" />
          <Setter Property="UIElement.Opacity" Value="1" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding FullOpacity, ElementName=self}">
              <Setter Property="UIElement.Opacity" Value="0.2" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Border>
    <Border Height="22" BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsActive, ElementName=self}">
              <Setter Property="BorderBrush" Value="#FFFFFFFF" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Border>
    <TextBlock Margin="10,0" VerticalAlignment="Center" Effect="{StaticResource DefaultDropShadowEffect}" TextTrimming="CharacterEllipsis" Foreground="{Binding TOKEN_CONTENT, Source={x:Static theming:AppTheme.Active}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="Text" Value="{mex:Localized PRESENTATION_HEADER_ARRANGEMENTS_DEFAULT_GROUP_name}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding ArrangementGroup.Label.Text, ElementName=self, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}}">
              <Setter Property="Text" Value="{Binding ArrangementGroup.Label.Text, ElementName=self}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Grid HorizontalAlignment="Right">
      <Ellipse Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFFFF">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Ellipse}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding ShowCloseButton, ElementName=self}" />
                  <Condition Value="True" Binding="{Binding IsMouseOver, ElementName=self}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Ellipse>
      <commonControls:CloseButton Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding RemoveArrangementGroupCommand, ElementName=self}" CommandParameter="{Binding ArrangementGroup, ElementName=self}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type commonControls:CloseButton}}" TargetType="{x:Type commonControls:CloseButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding ShowCloseButton, ElementName=self}" />
                  <Condition Value="True" Binding="{Binding IsMouseOver, ElementName=self}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:CloseButton>
    </Grid>
  </Grid>
</UserControl>