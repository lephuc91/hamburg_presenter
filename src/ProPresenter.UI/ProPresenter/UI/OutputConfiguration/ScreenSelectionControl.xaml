<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.OutputConfiguration.ScreenSelectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtitlity="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:do="clr-namespace:ProPresenter.DO.OutputConfiguration;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.OutputConfiguration" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="screenSelection">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../SourceDetailListResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonUtitlity:BindingProxy x:Key="screenSelectionProxy" Data="{Binding ElementName=screenSelection}" />
      <Style x:Key="{x:Type local:ScreenSelectionListBox}" BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type local:ScreenSelectionListBox}">
        <Setter Property="UIElement.AllowDrop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="commonControls:DragDropListBox.SelectItemsOnSelfDrop" Value="True" />
        <Setter Property="commonControls:ListBoxBase.SelectOnMouseUp" Value="False" />
        <Setter Property="ListBox.SelectionMode" Value="Single" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
      </Style>
      <Style x:Key="ScreenSelectionTypeTextBlockStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="AddScreenStyle" BasedOn="{StaticResource {x:Type commonControls:BorderlessPathButton}}" TargetType="{x:Type commonControls:BorderlessPathButton}">
        <Setter Property="FrameworkElement.ContextMenu" Value="{Binding DeviceSelector, ElementName=screenSelection}" />
        <Setter Property="Height" Value="25" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="IsEnabled" Value="{Binding CanAddMoreScreens, ElementName=screenSelection}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="commonControls:BorderlessPathButton.PathType" Value="Plus" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="25" />
        <Setter Property="uiUtility:ContextMenuHelper.OpenOnLeftClick" Value="True" />
      </Style>
      <Style x:Key="{x:Type commonControls:ToggleSwitch}" BasedOn="{StaticResource {x:Type commonControls:ToggleSwitch}}" TargetType="{x:Type commonControls:ToggleSwitch}">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <DataTemplate x:Key="ScreenItemTemplate">
        <Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Column="0" Margin="5,5,0,5">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <commonControls:EditableTextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0:F0} x {1:F0}">
                    <Binding Path="TotalSize.X" />
                    <Binding Path="TotalSize.Y" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>
      <Style x:Key="ListBoxItemStyle" BasedOn="{StaticResource {x:Type commonControls:ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
        <Setter Property="FrameworkElement.ContextMenu">
          <Setter.Value>
            <ContextMenu>
              <MenuItem Command="{x:Static commands:CommonApplicationCommands.Rename}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Command="{x:Static commands:CommonApplicationCommands.Delete}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Value="Audience" Binding="{Binding PlacementTarget.DataContext.ScreenTargetType, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <Condition Value="1" Binding="{Binding Data.AudienceArrangementScreens.Count, Source={StaticResource screenSelectionProxy}}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </MenuItem>
            </ContextMenu>
          </Setter.Value>
        </Setter>
        <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding SOURCELISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
      </Style>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35" />
      <RowDefinition Height="*" />
      <RowDefinition Height="35" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" uiUtility:UIElementHelper.Palette="{Binding DETAILHEADER_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <commonControls:ToggleSwitch Grid.Column="0" IsChecked="{Binding AudienceEnable}" />
      <TextBlock Grid.Column="1" Style="{StaticResource ScreenSelectionTypeTextBlockStyle}" Text="{mex:Localized GLOBAL_AUDIENCE_title}" />
      <commonControls:BorderlessPathButton Grid.Column="2" DataContext="{x:Static do:ScreenTargetType.Audience}" Style="{StaticResource AddScreenStyle}" />
    </Grid>
    <local:ScreenSelectionListBox Grid.Row="1" BorderThickness="0" DeselectOnLostFocus="True" ItemContainerStyle="{StaticResource ListBoxItemStyle}" ItemTemplate="{StaticResource ScreenItemTemplate}" uiUtility:UIElementHelper.Palette="{Binding DETAILLIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" ActiveItem="{Binding SelectedAudienceScreenArrangement, ElementName=screenSelection}" DeleteCommand="{Binding RemoveScreenArrangementCommand, ElementName=screenSelection}" ItemsSource="{Binding AudienceArrangementScreens, ElementName=screenSelection}" />
    <Grid Row="2" uiUtility:UIElementHelper.Palette="{Binding DETAILHEADER_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <commonControls:ToggleSwitch Grid.Column="0" IsChecked="{Binding StageEnable}" />
      <TextBlock Grid.Column="1" Style="{StaticResource ScreenSelectionTypeTextBlockStyle}" Text="{mex:Localized GLOBAL_STAGE_title}" />
      <commonControls:BorderlessPathButton Grid.Column="2" DataContext="{x:Static do:ScreenTargetType.Stage}" Style="{StaticResource AddScreenStyle}" />
    </Grid>
    <local:ScreenSelectionListBox Grid.Row="3" BorderThickness="0" DeselectOnLostFocus="True" ItemContainerStyle="{StaticResource ListBoxItemStyle}" ItemTemplate="{StaticResource ScreenItemTemplate}" uiUtility:UIElementHelper.Palette="{Binding DETAILLIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" ActiveItem="{Binding SelectedStageScreenArrangement, ElementName=screenSelection}" DeleteCommand="{Binding RemoveScreenArrangementCommand, ElementName=screenSelection}" ItemsSource="{Binding StageArrangementScreens, ElementName=screenSelection}" />
  </Grid>
</UserControl>