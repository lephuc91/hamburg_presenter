<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.OutputConfiguration.EdgeBlendCurveSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:do="clr-namespace:ProPresenter.DO.OutputConfiguration;assembly=ProPresenter.DO" x:Name="edgeBlendCurveSelector" xmlns:outputconfiguration="clr-namespace:ProPresenter.UI.OutputConfiguration;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
    <Style x:Key="curveButtonStyle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
      <Setter Property="ToggleButton.IsChecked" Value="False" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FrameworkElement.ToolTip" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Value="True">
              <Condition.Binding>
                <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding />
                  <Binding ElementName="edgeBlendCurveSelector" Path="BlendMode" />
                </MultiBinding>
              </Condition.Binding>
            </Condition>
          </MultiDataTrigger.Conditions>
          <Setter Property="ToggleButton.IsChecked" Value="True" />
        </MultiDataTrigger>
      </Style.Triggers>
      <EventSetter Event="Click" Handler="ToggleButton_Click" />
    </Style>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ToggleButton Grid.Column="0" DataContext="{x:Static do:BlendMode.Linear}" Style="{StaticResource curveButtonStyle}">
      <commonControls:ImageMask ImageSource="../Resources/Icons/EdgeBlend/edgeBlendCurveLinear.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
    </ToggleButton>
    <ToggleButton Grid.Column="1" DataContext="{x:Static do:BlendMode.Cubic}" Style="{StaticResource curveButtonStyle}">
      <commonControls:ImageMask ImageSource="../Resources/Icons/EdgeBlend/edgeBlendCurveCubic.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
    </ToggleButton>
    <ToggleButton Grid.Column="2" DataContext="{x:Static do:BlendMode.Quadratic}" Style="{StaticResource curveButtonStyle}">
      <commonControls:ImageMask ImageSource="../Resources/Icons/EdgeBlend/edgeBlendCurveQuadratic.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
    </ToggleButton>
    <TextBlock Grid.Column="3" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding BlendMode, ElementName=edgeBlendCurveSelector, Converter={StaticResource EnumToContentConverter}}" />
  </Grid>
</UserControl>