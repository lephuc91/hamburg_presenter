<?xml version="1.0" encoding="utf-8"?>
<MenuItem x:Class="ProPresenter.UI.OutputConfiguration.PlaceholderDeviceSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:outputConfiguration="clr-namespace:ProPresenter.UI.OutputConfiguration" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="placeholderDeviceSource" Style="{StaticResource {x:Type MenuItem}}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <commonUtility:BindingProxy x:Key="placeholderDeviceSourceProxy" Data="{Binding ElementName=placeholderDeviceSource}" />
      <Style x:Key="defaultSizeStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="HeaderTemplate">
          <Setter.Value>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding X, Mode=OneWay}" /> <Run Text=" x " /> <Run Text="{Binding Y, Mode=OneWay}" /></TextBlock>
            </DataTemplate>
          </Setter.Value>
        </Setter>
        <EventSetter Event="Click" Handler="DefaultSize_Click" />
      </Style>
      <Style x:Key="customSizeStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <EventSetter Event="Click" Handler="CustomSize_Click" />
      </Style>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}}" />
      </Style>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <ItemsControl.ItemsSource>
    <CompositeCollection>
      <CollectionContainer Collection="{Binding Data.DefaultModes, Source={StaticResource placeholderDeviceSourceProxy}}" />
      <Separator />
      <outputConfiguration:DynamicPlaceHolderDeviceMode />
    </CompositeCollection>
  </ItemsControl.ItemsSource>
</MenuItem>