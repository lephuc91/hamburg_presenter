<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.OutputConfiguration.Hardware" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:do="clr-namespace:ProPresenter.DO.OutputConfiguration;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.OutputConfiguration" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="hardware">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="hardwareProxy" Data="{Binding ElementName=hardware}" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <local:SizeToAspectRatioConverter x:Key="SizeToAspectRatioConverter" />
      <commonConverters:RectdConverter x:Key="RectdConverter" Data="{Binding Data.HardwareRectangle.Subrect, Source={StaticResource hardwareProxy}}" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <local:SupportsHdrRenderingConverter x:Key="SupportsHdrRenderingConverter" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
      <Style x:Key="Alignment" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="DoubleUpDownContentAlignment" BasedOn="{StaticResource {x:Type commonControls:DoubleUpDown}}" TargetType="{x:Type commonControls:DoubleUpDown}">
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="SquareRadioButton" BasedOn="{StaticResource {x:Type RadioButton}}" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Grid>
                <Border Name="rectangle" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="3">
                  <Border.Background>
                    <SolidColorBrush Color="Transparent" />
                  </Border.Background>
                </Border>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding ContentControl.Content}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="rectangle" Property="Border.Background" Value="#FFD3D3D3" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="rectangle" Property="Border.Background" Value="{Binding (uiUtility:UIElementHelper.Palette).Pressed.Background, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="18" />
      </Style>
      <Style x:Key="TextPlaceHolderVisibility" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:DeviceType.Placeholder}" Binding="{Binding HardwareRectangle.OutputDevice.DeviceType, ElementName=hardware}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="TextScreenVisibility" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:DeviceType.Screen}" Binding="{Binding HardwareRectangle.OutputDevice.DeviceType, ElementName=hardware}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="TextNDICardVisibility" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:DeviceType.BlackmagicCard}" Binding="{Binding HardwareRectangle.OutputDevice.DeviceType, ElementName=hardware}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
          <DataTrigger Value="{x:Static do:DeviceType.NDI}" Binding="{Binding HardwareRectangle.OutputDevice.DeviceType, ElementName=hardware}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ToggleAlignmentVisibility" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:SubrectTargetMode.TwoByOne}" Binding="{Binding}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
          <DataTrigger Value="{x:Static do:SubrectTargetMode.TwoByTwo}" Binding="{Binding}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
          <DataTrigger Value="{x:Static do:SubrectTargetMode.ThreeByOne}" Binding="{Binding}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ToggleCustomVisibility" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:SubrectTargetMode.Custom}" Binding="{Binding}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ToggleTwoByOneVisibility" TargetType="{x:Type FrameworkElement}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:SubrectTargetMode.TwoByOne}" Binding="{Binding}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ToggleTwoByTwoVisibility" TargetType="{x:Type FrameworkElement}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:SubrectTargetMode.TwoByTwo}" Binding="{Binding}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ToggleThreeByOneVisibility" TargetType="{x:Type FrameworkElement}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:SubrectTargetMode.ThreeByOne}" Binding="{Binding}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PlaceHolderContentAlignment" BasedOn="{StaticResource {x:Type commonControls:IntegerUpDown}}" TargetType="{x:Type commonControls:IntegerUpDown}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static do:DeviceType.Placeholder}" Binding="{Binding HardwareRectangle.OutputDevice.DeviceType, ElementName=hardware}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,5" Orientation="Horizontal">
        <TextBlock Style="{StaticResource Alignment}" Text="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_OUTPUT_title}" />
        <Image Height="12" Margin="5,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" Source="../Resources/Icons/WarningIcon.png" Visibility="{Binding HardwareRectangle.IsConflicting, ElementName=hardware, Converter={StaticResource ValueToVisibilityConverter}}" />
      </StackPanel>
      <commonControls:DropDownButton Grid.Row="1" Grid.Column="0" Height="22" Margin="0,0,10,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" CustomContextMenu="{Binding DeviceSelector, ElementName=hardware}" DataContext="{Binding HardwareRectangle, ElementName=hardware}">
        <commonControls:DropDownButton.CustomContent>
          <TextBlock Margin="5,0,0,0" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource Alignment}" TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="{Binding OutputDevice.Name}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding OutputDevice}" Value="{x:Null}">
                    <Setter Property="Text" Value="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_DEVICE_MENU_UNCONFIGURED_title}" />
                  </DataTrigger>
                  <DataTrigger Value="False" Binding="{Binding OutputDevice.IsAttached}">
                    <Setter Property="Text" Value="{Binding OutputDevice.Name, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=SCREEN_CONFIGURATION_HARDWARE_TAB_DEVICE_MENU_DISCONNECTED_name}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </commonControls:DropDownButton.CustomContent>
      </commonControls:DropDownButton>
      <Border Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top" BorderThickness="1" CornerRadius="4" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding HardwareRectangle.IsConfigured, ElementName=hardware, Converter={StaticResource ValueToVisibilityConverter}}">
        <Grid Margin="10,5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,5,10" HorizontalAlignment="Left" Text="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_NAME_label}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource Alignment}" TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HardwareRectangle.OutputDevice, ElementName=hardware}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <ContentControl Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" HorizontalContentAlignment="Left" Content="{Binding}" DataContext="{Binding HardwareRectangle.OutputDevice, ElementName=hardware}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <DataTemplate x:Key="{DataTemplateKey {x:Type do:PlaceholderDevice}}" DataType="{x:Type do:PlaceholderDevice}">
                  <TextBox Name="screenName" Height="22" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" uiUtility:TextBoxHelper.UpdateOnEnterKey="True" Text="{Binding PlaceholderDeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
                <DataTemplate x:Key="{DataTemplateKey {x:Type do:PhysicalDevice}}" DataType="{x:Type do:PhysicalDevice}">
                  <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                </DataTemplate>
                <DataTemplate x:Key="{DataTemplateKey {x:Type do:SoftDevice}}" DataType="{x:Type do:SoftDevice}">
                  <TextBox Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding SoftDeviceName, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </ContentControl>
          <TextBlock Name="modeLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,5,10" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource TextNDICardVisibility}" Text="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_MODE_label}" />
          <commonControls:DropDownButton Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="22" Margin="0,0,0,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Visibility="{Binding Visibility, ElementName=modeLabel}">
            <commonControls:DropDownButton.CustomContent>
              <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding Data.HardwareRectangle.OutputDevice.DeviceMode.Name, Source={StaticResource hardwareProxy}}" />
            </commonControls:DropDownButton.CustomContent>
            <commonControls:DropDownButton.CustomContextMenu>
              <ContextMenu Placement="Bottom" UsesItemContainerTemplate="True">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type do:DeviceMode}}">
                      <MenuItem Header="{Binding Name}" Click="DeviceMode_Click">
                        <MenuItem.IsChecked>
                          <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                            <Binding Path="ModeIndex" />
                            <Binding Path="Data.HardwareRectangle.OutputDevice.DeviceMode.ModeIndex" Source="{StaticResource hardwareProxy}" />
                          </MultiBinding>
                        </MenuItem.IsChecked>
                      </MenuItem>
                    </ItemContainerTemplate>
                    <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type local:DynamicDeviceMode}}">
                      <MenuItem Header="{Binding DisplayMember}" Click="DeviceMode_Click">
                        <MenuItem.IsChecked>
                          <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                            <Binding Path="DisplayValue.ModeIndex" />
                            <Binding Path="Data.HardwareRectangle.OutputDevice.DeviceMode.ModeIndex" Source="{StaticResource hardwareProxy}" />
                          </MultiBinding>
                        </MenuItem.IsChecked>
                      </MenuItem>
                    </ItemContainerTemplate>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type ContextMenu}}" TargetType="{x:Type ContextMenu}">
                    <Setter Property="ItemsSource" Value="{x:Null}" />
                    <Style.Triggers>
                      <DataTrigger Value="{x:Static do:DeviceType.BlackmagicCard}" Binding="{Binding Data.HardwareRectangle.OutputDevice.DeviceType, Source={StaticResource hardwareProxy}}">
                        <Setter Property="ItemsSource">
                          <Setter.Value>
                            <PriorityBinding>
                              <Binding Path="Data.HardwareRectangle.OutputDevice.AvailableModes" Source="{StaticResource hardwareProxy}" />
                            </PriorityBinding>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                      <DataTrigger Value="{x:Static do:DeviceType.NDI}" Binding="{Binding Data.HardwareRectangle.OutputDevice.DeviceType, Source={StaticResource hardwareProxy}}">
                        <Setter Property="ItemsSource">
                          <Setter.Value>
                            <CompositeCollection>
                              <CollectionContainer Collection="{Binding Source={x:Static do:SoftDevice.AvailableNDIModes}}" />
                              <Separator />
                              <MenuItem IsChecked="True" Header="{Binding Data.HardwareRectangle.OutputDevice.DeviceMode.Name, Source={StaticResource hardwareProxy}}">
                                <FrameworkElement.Style>
                                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Value="{x:Type do:CustomDeviceMode}" Binding="{Binding Data.HardwareRectangle.OutputDevice.DeviceMode, Source={StaticResource hardwareProxy}, Converter={StaticResource TypeOfConverter}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </MenuItem>
                              <local:DynamicDeviceMode />
                            </CompositeCollection>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ContextMenu>
            </commonControls:DropDownButton.CustomContextMenu>
          </commonControls:DropDownButton>
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,5,5" HorizontalAlignment="Left" Text="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_SIZE_label}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource Alignment}" TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="{x:Static do:DeviceType.Screen}" Binding="{Binding HardwareRectangle.OutputDevice.DeviceType, ElementName=hardware}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static do:DeviceType.Placeholder}" Binding="{Binding HardwareRectangle.OutputDevice.DeviceType, ElementName=hardware}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,5,5" HorizontalAlignment="Left" Style="{StaticResource TextScreenVisibility}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} x {1}">
                <Binding ElementName="hardware" Path="HardwareRectangle.OutputDevice.DeviceMode.Size.X" />
                <Binding ElementName="hardware" Path="HardwareRectangle.OutputDevice.DeviceMode.Size.Y" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding}" DataContext="{Binding HardwareRectangle.OutputDevice, ElementName=hardware}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <DataTemplate x:Key="{DataTemplateKey {x:Type do:DeviceBase}}" DataType="{x:Type do:DeviceBase}" />
                <DataTemplate x:Key="{DataTemplateKey {x:Type do:PlaceholderDevice}}" DataType="{x:Type do:PlaceholderDevice}">
                  <commonControls:IntegerUpDown Margin="0,0,3,0" Minimum="0" Style="{StaticResource PlaceHolderContentAlignment}" Value="{Binding PlaceholderDeviceMode.Width}" />
                </DataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </ContentControl>
          <ContentControl Grid.Row="2" Grid.Column="2" Content="{Binding}" DataContext="{Binding HardwareRectangle.OutputDevice, ElementName=hardware}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <DataTemplate x:Key="{DataTemplateKey {x:Type do:DeviceBase}}" DataType="{x:Type do:DeviceBase}" />
                <DataTemplate x:Key="{DataTemplateKey {x:Type do:PlaceholderDevice}}" DataType="{x:Type do:PlaceholderDevice}">
                  <commonControls:IntegerUpDown Margin="3,0,0,0" Minimum="0" Style="{StaticResource PlaceHolderContentAlignment}" Value="{Binding PlaceholderDeviceMode.Height}" />
                </DataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </ContentControl>
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,3,5" HorizontalAlignment="Center" Style="{StaticResource TextPlaceHolderVisibility}" Text="{mex:Localized GLOBAL_WIDTH}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Margin="3,0,0,5" HorizontalAlignment="Center" Style="{StaticResource TextPlaceHolderVisibility}" Text="{mex:Localized GLOBAL_HEIGHT}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,5,3" VerticalAlignment="Center" Text="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_OUTPUT_HDR_FORMAT_title}" Visibility="{Binding HardwareRectangle.OutputDevice.SupportsHdrRendering, ElementName=hardware, Converter={StaticResource SupportsHdrRenderingConverter}}" />
          <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,3" ItemsSource="{Binding HardwareRectangle.OutputDevice.AvailableHdrFormats, ElementName=hardware}" SelectedValue="{Binding HardwareRectangle.OutputDevice.SelectedHdrFormat, ElementName=hardware}" Visibility="{Binding HardwareRectangle.OutputDevice.SupportsHdrRendering, ElementName=hardware, Converter={StaticResource SupportsHdrRenderingConverter}}" SelectionChanged="HdrFormat_SelectionChanged">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
          <commonControls:HelpButton Grid.Row="3" Grid.Column="4" Width="20" Height="20" Margin="6,0,0,3" HelpResource="/pro/resource/HDR-format-colors" Visibility="{Binding HardwareRectangle.OutputDevice.SupportsHdrRendering, ElementName=hardware, Converter={StaticResource SupportsHdrRenderingConverter}}" />
        </Grid>
      </Border>
      <Border Grid.Row="3" Grid.Column="0" Margin="0,10,10,0" VerticalAlignment="Top" BorderThickness="1" CornerRadius="4" local:DeviceHelper.ConfiguredPhysicalVisibility="{Binding ElementName=hardware, Path=HardwareRectangle}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="8,4,2,4" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{mex:Localized SCREEN_CONFIGURATION_VIDEO_DELAY_title}" />
          <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <commonControls:IntegerUpDown Width="60" Height="22" Margin="0,4" FormatString="{}{0}" Increment="1" Minimum="0" Maximum="{Binding HardwareRectangle.OutputDevice.DeviceMode.RefreshRate, ElementName=hardware}" Value="{Binding HardwareRectangle.OutputDevice.VideoDelay, ElementName=hardware, Mode=TwoWay}" />
            <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{mex:Localized GLOBAL_VIDEO_FRAMES_UNIT}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" Style="{StaticResource Alignment}" Text="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_OUTPUT_TARGET_title}" />
      <ComboBox Name="subrectTargetMode" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,0,10" SelectedItem="{Binding HardwareRectangle.SubrectTargetMode, ElementName=hardware, Mode=TwoWay}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HardwareRectangle.OutputDevice, ElementName=hardware}" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="{DataTemplateKey {x:Type do:SubrectTargetMode}}" DataType="{x:Type do:SubrectTargetMode}">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <do:SubrectTargetMode>Full</do:SubrectTargetMode>
            <Separator />
            <do:SubrectTargetMode>TwoByOne</do:SubrectTargetMode>
            <do:SubrectTargetMode>TwoByTwo</do:SubrectTargetMode>
            <do:SubrectTargetMode>ThreeByOne</do:SubrectTargetMode>
            <Separator />
            <do:SubrectTargetMode>Custom</do:SubrectTargetMode>
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ComboBox>
      <Border Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" BorderThickness="1" CornerRadius="4" Style="{StaticResource ToggleAlignmentVisibility}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" DataContext="{Binding SelectedItem, ElementName=subrectTargetMode}">
        <Grid Margin="5" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_OUTPUT_ALIGNMENT_label}" />
          <Grid Column="1" Style="{StaticResource ToggleTwoByOneVisibility}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource SquareRadioButton}">
              <ToggleButton.IsChecked>
                <Binding Converter="{StaticResource EnumToBooleanConverter}" ElementName="hardware" Path="HardwareRectangle.SubrectTargetIndex">
                  <Binding.ConverterParameter>
                    <system1:Int32 xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib">0</system1:Int32>
                  </Binding.ConverterParameter>
                </Binding>
              </ToggleButton.IsChecked>
            </RadioButton>
            <RadioButton Grid.Column="1" Style="{StaticResource SquareRadioButton}">
              <ToggleButton.IsChecked>
                <Binding Converter="{StaticResource EnumToBooleanConverter}" ElementName="hardware" Path="HardwareRectangle.SubrectTargetIndex">
                  <Binding.ConverterParameter>
                    <Int32 xmlns="clr-namespace:System;assembly=System.Private.CoreLib">1</Int32>
                  </Binding.ConverterParameter>
                </Binding>
              </ToggleButton.IsChecked>
            </RadioButton>
          </Grid>
          <Grid Column="1" Style="{StaticResource ToggleTwoByTwoVisibility}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <RadioButton Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" Style="{StaticResource SquareRadioButton}">
