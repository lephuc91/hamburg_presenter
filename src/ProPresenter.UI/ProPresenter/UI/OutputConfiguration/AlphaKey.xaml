<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.OutputConfiguration.AlphaKey" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.OutputConfiguration" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.OutputConfiguration" x:Name="alphaKey">
  <FrameworkElement.Resources>
    <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    <commonConverters:IsInstanceOfTypeConverter x:Key="IsBlackmagicHardwareOptions" Type="{x:Type vm:IBlackmagicHardwareAlphaConfigurationVM}" />
    <commonConverters:IsInstanceOfTypeConverter x:Key="IsSecondScreenHardwareOptions" Type="{x:Type vm:ISecondScreenHardwareAlphaConfigurationVM}" />
    <DataTemplate x:Key="BlackmagicHardwareOptions">
      <StackPanel>
        <Separator Margin="0,0,0,10" />
        <local:BlackmagicHardwareAlphaSettings DescriptionColumnSizeGroupName="DescriptionColumn" SettingsColumnSizeGroupName="SettingsColumn" Context="{Binding}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="SecondScreenHardwareOptions">
      <StackPanel>
        <Separator Margin="0,0,0,10" />
        <local:Hardware HorizontalAlignment="Stretch" DeviceSelector="{Binding DeviceSelector, ElementName=alphaKey}" HardwareRectangle="{Binding AlphaRectangle}" />
      </StackPanel>
    </DataTemplate>
  </FrameworkElement.Resources>
  <StackPanel Grid.IsSharedSizeScope="True">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition SharedSizeGroup="DescriptionColumn" />
        <ColumnDefinition MinWidth="235" SharedSizeGroup="SettingsColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Margin="0,10" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized SCREEN_CONFIGURATION_ALPHA_KEY_TAB_TYPE_title}" />
      <ComboBox Grid.Column="2" Margin="10,10,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Context.AvailableModes, ElementName=alphaKey}" SelectedItem="{Binding Context.Mode, ElementName=alphaKey}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
      <commonControls:HelpButton Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top" HelpCommand="{Binding Context.ShowAlphaSettingsHelpCommand, ElementName=alphaKey}" />
    </Grid>
    <ContentControl HorizontalAlignment="Stretch" Content="{Binding Context.HardwareConfiguration, ElementName=alphaKey}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="{x:Type ContentControl}">
          <Setter Property="ContentTemplate" Value="{x:Null}" />
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding Context.HardwareConfiguration, ElementName=alphaKey, Converter={StaticResource IsBlackmagicHardwareOptions}}">
              <Setter Property="ContentTemplate" Value="{StaticResource BlackmagicHardwareOptions}" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding Context.HardwareConfiguration, ElementName=alphaKey, Converter={StaticResource IsSecondScreenHardwareOptions}}">
              <Setter Property="ContentTemplate" Value="{StaticResource SecondScreenHardwareOptions}" />
            </DataTrigger>
            <DataTrigger Value="{x:Static vm:AlphaBlendMode.None}" Binding="{Binding Context.Mode, ElementName=alphaKey}">
              <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ContentControl>
  </StackPanel>
</UserControl>