<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.OutputConfiguration.BlackmagicHardwareAlphaSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="blackmagicHardwareAlphaSettings" xmlns:outputconfiguration="clr-namespace:ProPresenter.UI.OutputConfiguration;assembly=ProPresenter.UI" Resources="{commonConverters:EnumToContentConverter Key=EnumToContentConverter}">
  <Grid HorizontalAlignment="Center">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition SharedSizeGroup="{Binding DescriptionColumnSizeGroupName, ElementName=blackmagicHardwareAlphaSettings}" />
      <ColumnDefinition SharedSizeGroup="{Binding SettingsColumnSizeGroupName, ElementName=blackmagicHardwareAlphaSettings}" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,10" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized SCREEN_CONFIGURATION_ALPHA_KEY_TAB_BLACKMAGIC_TYPE_label}" />
    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,10" ItemsSource="{Binding Context.SupportedAlphaKeyTypes, ElementName=blackmagicHardwareAlphaSettings}" SelectedItem="{Binding Context.AlphaKeyType, ElementName=blackmagicHardwareAlphaSettings}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized SCREEN_CONFIGURATION_ALPHA_KEY_TAB_BLACKMAGIC_BLEND_label}" />
    <Grid Row="1" Column="1" HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Slider Margin="10,0" IsMoveToPointEnabled="True" Maximum="1" Minimum="0" Value="{Binding Context.BlendValue, ElementName=blackmagicHardwareAlphaSettings}" />
      <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Context.BlendValue, ElementName=blackmagicHardwareAlphaSettings, StringFormat=P0}" />
    </Grid>
  </Grid>
</UserControl>