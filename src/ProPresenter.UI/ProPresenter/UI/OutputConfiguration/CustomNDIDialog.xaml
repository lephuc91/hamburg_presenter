<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.OutputConfiguration.CustomNDIDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:interop="clr-namespace:ProPresenterCore.ProCore.Interop;assembly=ProCore.Interop" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:outputConfiguration="clr-namespace:ProPresenter.UI.OutputConfiguration" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:validation="clr-namespace:ProPresenter.UI.Validation" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Title="CustomNDIDialog" Width="290" uiUtility:WindowHelper.ChildOf="ActiveWindow" CanClose="False" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" ShowInTaskbar="False" ShowTitle="False" ShowTitlebar="False" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner">
  <Grid Margin="12" DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type outputConfiguration:CustomNDIDialog}}}">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition Height="4" />
      <RowDefinition />
      <RowDefinition Height="4" />
      <RowDefinition />
      <RowDefinition Height="12" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition SharedSizeGroup="LabelSizeGroup" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition />
      <ColumnDefinition Width="4" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Text="{markupExtensions:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_CUSTOM_RESOLUTION_label}" />
    <controls:IntegerUpDown Grid.Row="0" Grid.Column="2" FormatString="{}{0:0} px" Maximum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MaxPlaceholderScreenDimension}}" Minimum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MinPlaceholderScreenDimension}}">
      <UpDownBase.Value xmlns="http://schemas.xceed.com/wpf/xaml/toolkit">
        <Binding Mode="TwoWay" Path="DeviceModeWidth" UpdateSourceTrigger="PropertyChanged" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
          <Binding.ValidationRules>
            <validation:IntegerRangeValidationRule ValidatesOnTargetUpdated="True" Maximum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MaxPlaceholderScreenDimension}}" Minimum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MinPlaceholderScreenDimension}}" />
          </Binding.ValidationRules>
        </Binding>
      </UpDownBase.Value>
    </controls:IntegerUpDown>
    <controls:IntegerUpDown Grid.Row="0" Grid.Column="4" FormatString="{}{0:0} px" Maximum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MaxPlaceholderScreenDimension}}" Minimum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MinPlaceholderScreenDimension}}">
      <UpDownBase.Value xmlns="http://schemas.xceed.com/wpf/xaml/toolkit">
        <Binding Mode="TwoWay" Path="DeviceModeHeight" UpdateSourceTrigger="PropertyChanged" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
          <Binding.ValidationRules>
            <validation:IntegerRangeValidationRule ValidatesOnTargetUpdated="True" Maximum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MaxPlaceholderScreenDimension}}" Minimum="{markupExtensions:EnumToValue {x:Static interop:ProRenderConstant.MinPlaceholderScreenDimension}}" />
          </Binding.ValidationRules>
        </Binding>
      </UpDownBase.Value>
    </controls:IntegerUpDown>
    <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{markupExtensions:Localized GLOBAL_WIDTH}" />
    <TextBlock Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{markupExtensions:Localized GLOBAL_HEIGHT}" />
    <TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" Text="{markupExtensions:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_CUSTOM_FRAME_RATE_label}" />
    <controls:DoubleUpDown Grid.Row="3" Grid.Column="2" FormatString="{}{0:0.##} fps" Maximum="240" Minimum="0.1" ShowButtonSpinner="False" Value="{Binding DeviceModeFrameRate}" />
    <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Content="{markupExtensions:Localized SCREEN_CONFIGURATION_HARDWARE_TAB_CUSTOM_INTERLACED_label}" IsChecked="{Binding IsInterlaced}" />
    <Button Grid.Row="7" Grid.Column="2" IsCancel="True" Content="{markupExtensions:Localized GLOBAL_CANCEL_BUTTON_title}" />
    <Button Grid.Row="7" Grid.Column="4" IsDefault="True" Content="{markupExtensions:Localized GLOBAL_OK_BUTTON_title}" Click="OkButton_OnClick" />
  </Grid>
</windowing:ChromedWindow>