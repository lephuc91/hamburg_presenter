<?xml version="1.0" encoding="utf-8"?>
<ContextMenu x:Class="ProPresenter.UI.OutputConfiguration.DeviceSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:do="clr-namespace:ProPresenter.DO.OutputConfiguration;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.OutputConfiguration" x:Name="deviceSelector" Closed="DeviceSelector_Closed">
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource {x:Type ContextMenu}}" TargetType="{x:Type ContextMenu}" />
  </FrameworkElement.Style>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="deviceSelectorProxy" Data="{Binding ElementName=deviceSelector}" />
      <Style x:Key="deviceStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Header" Value="{Binding Name}" />
        <EventSetter Event="Click" Handler="Device_Click" />
      </Style>
      <DataTemplate x:Key="{DataTemplateKey {x:Type do:DeviceModeBase}}" DataType="{x:Type do:DeviceModeBase}">
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
      </DataTemplate>
      <Style x:Key="deviceWithModesStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Header" Value="{Binding Name}" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding CanChangeModes}">
            <Setter Property="ItemsSource">
              <Setter.Value>
                <PriorityBinding>
                  <Binding Path="AvailableModes" />
                </PriorityBinding>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
        <EventSetter Event="Click" Handler="Device_Click" />
        <EventSetter Event="SubmenuOpened" Handler="ModeMenu_Opened" />
      </Style>
      <Style x:Key="physicalDeviceStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="HeaderTemplate">
          <Setter.Value>
            <DataTemplate>
              <local:PhysicalDeviceItem Margin="0,3" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" IdentifyScreenCommand="{Binding Data.IdentifyScreenCommand, Source={StaticResource deviceSelectorProxy}}" TargetScreen="{Binding}" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
        <EventSetter Event="Click" Handler="Device_Click" />
        <EventSetter Event="SubmenuOpened" Handler="ModeMenu_Opened" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ItemsControl.ItemsSource>
    <local:DeviceSelectorSource AddCombinedScreenCommand="{Binding Data.AddCombinedScreenCommand, Source={StaticResource deviceSelectorProxy}}" AddEdgeBlendScreenCommand="{Binding Data.AddEdgeBlendScreenCommand, Source={StaticResource deviceSelectorProxy}}" AssignDeviceCommand="{Binding Data.AssignDeviceCommand, Source={StaticResource deviceSelectorProxy}}" AttachedPhysicalDevices="{Binding Data.AttachedPhysicalDevices, Source={StaticResource deviceSelectorProxy}}" CanOpenScreenConfig="{Binding Data.CanOpenScreenConfig, Source={StaticResource deviceSelectorProxy}}" Devices="{Binding Data.Devices, Source={StaticResource deviceSelectorProxy}}" PlacementTarget="{Binding Data.PlacementTarget, Source={StaticResource deviceSelectorProxy}}" RemoveDeviceCommand="{Binding Data.RemoveDeviceCommand, Source={StaticResource deviceSelectorProxy}}" ShowSelectDevice="{Binding Data.ShowSelectDevice, Source={StaticResource deviceSelectorProxy}}" TemporaryDevices="{Binding Data.TemporaryDevices, Source={StaticResource deviceSelectorProxy}}" />
  </ItemsControl.ItemsSource>
</ContextMenu>