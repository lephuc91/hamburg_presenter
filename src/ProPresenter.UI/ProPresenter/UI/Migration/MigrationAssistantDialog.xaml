<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Migration.MigrationAssistantDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="self" Width="650" Height="350" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:migration="clr-namespace:ProPresenter.UI.Migration" Title="{mex:Localized MIGRATION_WINDOW_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="selfProxy" Data="{Binding ElementName=self}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Row="0" Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" FontSize="14" TextWrapping="Wrap" Text="{mex:Localized MIGRATION_WINDOW_LIBRARY_EXPLANATION_label}" />
      <DataGrid Grid.Row="1" Height="100" Margin="0,10" HorizontalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="False" CanUserResizeRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Single" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" ItemsSource="{Binding Libraries}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="{x:Type DataGridRow}">
              <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding ShouldImport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="*" Header="{mex:Localized MIGRATION_WINDOW_LIBRARY_title}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" Text="{Binding SourceName}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <CheckBox Grid.Row="2" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{mex:Localized MIGRATION_WINDOW_OPTIONS_LIBRARIES_title}" IsChecked="{Binding MigrateLibraries, Mode=TwoWay}" />
      <CheckBox Grid.Row="3" Margin="0,0,0,5" Content="{mex:Localized MIGRATION_WINDOW_OPTIONS_PLAYLISTS_title}" IsChecked="{Binding MigratePlaylists, Mode=TwoWay}" IsEnabled="{Binding MigrateLibraries}" />
      <CheckBox Grid.Row="4" Margin="0,0,0,5" Content="{mex:Localized MIGRATION_WINDOW_OPTIONS_MEDIA_title}" IsChecked="{Binding MigrateMedia, Mode=TwoWay}" />
      <CheckBox Grid.Row="5" Margin="0,0,0,20" Content="{mex:Localized MIGRATION_WINDOW_OPTIONS_SETTINGS_title}" IsChecked="{Binding MigrateSettings, Mode=TwoWay}" />
      <StackPanel Grid.Row="6" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <Button Height="22" MinWidth="80" Margin="0,0,10,0" Padding="10,0" IsCancel="True" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
        <Button Height="22" MinWidth="80" Padding="10,0" IsDefault="True" Content="{mex:Localized MIGRATION_WINDOW_START_BUTTON_title}" Click="ImportButton_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</windowing:ChromedWindow>