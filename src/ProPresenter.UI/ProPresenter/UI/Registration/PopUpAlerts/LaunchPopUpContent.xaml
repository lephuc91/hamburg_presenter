<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Registration.PopUpAlerts.LaunchPopUpContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="launchPopUp" xmlns:popupalerts="clr-namespace:ProPresenter.UI.Registration.PopUpAlerts;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="uiUtility:UIElementHelper.CornerRadius" Value="4" />
    </Style>
  </FrameworkElement.Resources>
  <Grid>
    <StackPanel>
      <TextBlock Margin="30,30,30,20" FontSize="24" FontWeight="Bold" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding Title, ElementName=launchPopUp}" />
      <TextBlock Margin="30,0,30,0" FontSize="18" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding Text, ElementName=launchPopUp}" />
      <Grid Margin="24,30,30,30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl Grid.IsSharedSizeScope="True" ItemsSource="{Binding Buttons, ElementName=launchPopUp}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid HorizontalAlignment="Stretch" Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <commonControls:BorderlessButton Grid.Column="2" Command="{Binding CloseCommand, ElementName=launchPopUp}" Content="{Binding SkipForNowButtonTitle, ElementName=launchPopUp}" />
      </Grid>
    </StackPanel>
    <commonControls:HelpButton Margin="20" HorizontalAlignment="Right" VerticalAlignment="Top" HelpCommand="{Binding HelpCommand, ElementName=launchPopUp}" />
  </Grid>
</UserControl>