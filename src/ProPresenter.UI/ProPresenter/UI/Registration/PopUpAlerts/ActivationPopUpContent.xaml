<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Registration.PopUpAlerts.ActivationPopUpContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="launchPopUp" xmlns:popupalerts="clr-namespace:ProPresenter.UI.Registration.PopUpAlerts;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
      <Style x:Key="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="uiUtility:UIElementHelper.CornerRadius" Value="4" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <TextBlock Margin="30,30,30,10" FontSize="22" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding TitleTranslationKey, ElementName=launchPopUp, Converter={StaticResource LocalizedStringConverter}}" />
    <TextBlock Margin="30,0,30,0" FontSize="24" FontWeight="Bold" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding FormattedOrganization, ElementName=launchPopUp}" />
    <ItemsControl Grid.IsSharedSizeScope="True" ItemsSource="{Binding TextTranslationKeysElements, ElementName=launchPopUp}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Margin="30,20,30,0" FontSize="18" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding Converter={StaticResource LocalizedStringConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Margin="24,30,30,30">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button IsDefault="True" Command="{Binding CloseCommand, ElementName=launchPopUp}" Content="{Binding ConfirmationButtonTitleKey, ElementName=launchPopUp, Converter={StaticResource LocalizedStringConverter}}" />
    </Grid>
  </StackPanel>
</UserControl>