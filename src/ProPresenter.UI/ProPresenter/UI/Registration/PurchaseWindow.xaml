<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Registration.PurchaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:webView="clr-namespace:ProPresenter.UI.Web" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="purchaseWindow" Width="650" Height="650" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.SendKeyEventsToMainWindow="False" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" xmlns:registration="clr-namespace:ProPresenter.UI.Registration" Title="{mex:Localized PURCHASE_WINDOW_title}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <webView:WebBrowserView x:Name="webBrowser" Grid.Row="0" CurrentHeaders="{Binding CurrentHeaders, Mode=TwoWay}" />
    <Button Grid.Row="1" Height="22" MinWidth="80" Margin="0,10,10,10" Padding="10,0" HorizontalAlignment="Right" Click="Button_Click">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
          <Setter Property="Content" Value="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsPurchaseComplete}">
              <Setter Property="Content" Value="{mex:Localized GLOBAL_DONE}" />
            </DataTrigger>
            <DataTrigger Value="Trial" Binding="{Binding StoreType, ElementName=purchaseWindow}">
              <Setter Property="Content" Value="{mex:Localized GLOBAL_DONE}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </Grid>
</windowing:ChromedWindow>