<?xml version="1.0" encoding="utf-8"?>
<components:FrameworkCollection x:Class="ProPresenter.UI.Chords.KeySelectionMenuSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:chords="clr-namespace:ProPresenter.DO.Chords;assembly=ProPresenter.DO" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:components="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Chords" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="keySelectionMenuSource">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="selfProxy" Data="{Binding ElementName=keySelectionMenuSource}" />
      <local:SelectedNoteConverter x:Key="SelectedNoteConverter" Data="{Binding Data.SelectedKey, Source={StaticResource selfProxy}}" />
      <local:SelectedScaleConverter x:Key="SelectedScaleConverter" Data="{Binding Data.SelectedKey, Source={StaticResource selfProxy}}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
