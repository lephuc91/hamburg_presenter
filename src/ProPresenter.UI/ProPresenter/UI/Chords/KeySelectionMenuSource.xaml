  <MenuItem Header="G" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.G}}" />
  <MenuItem Header="G#" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.Gis}}" />
  <Separator />
  <MenuItem IsCheckable="True" Header="{mex:Localized GLOBAL_MUSIC_KEY_MAJOR}" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedScaleConverter}, ConverterParameter={x:Static chords:Scale.Major}}" />
  <MenuItem IsCheckable="True" Header="{mex:Localized GLOBAL_MUSIC_KEY_MINOR}" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedScaleConverter}, ConverterParameter={x:Static chords:Scale.Minor}}" />
</components:FrameworkCollection>