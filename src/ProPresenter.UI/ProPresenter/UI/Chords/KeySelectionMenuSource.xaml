  <MenuItem Header="Db" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.Des}}" />
  <MenuItem Header="D" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.D}}" />
  <MenuItem Header="D#" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.Dis}}" />
  <MenuItem Header="Eb" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.Ees}}" />
  <MenuItem Header="E" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.E}}" />
  <MenuItem Header="F" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.F}}" />
  <MenuItem Header="F#" IsCheckable="True" IsChecked="{Binding Data.SelectedKey, Source={StaticResource selfProxy}, Converter={StaticResource SelectedNoteConverter}, ConverterParameter={x:Static chords:Note.Fis}}" />
