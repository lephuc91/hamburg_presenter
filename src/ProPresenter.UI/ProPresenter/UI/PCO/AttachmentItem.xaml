<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PCO.AttachmentItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:pco="clr-namespace:ProPresenter.UI.PCO">
  <Grid Background="#00FFFFFF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="Both" Source="{Binding Icon}" />
    <TextBlock Grid.Column="1" MaxWidth="250" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Filename}" />
  </Grid>
</UserControl>