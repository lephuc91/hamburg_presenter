<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.PCO.AttachmentManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.PCO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Width="325" Height="375" MinWidth="325" MinHeight="375" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" CanMaximize="False" CanMinimize="False" ShowInTaskbar="False" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterScreen" Title="{Binding Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=PLANNING_CENTER_ATTACHMENT_MANAGER_WINDOW_title, Path=ActivePlan.Name}">
  <FrameworkElement.Resources>
    <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox Grid.Column="0" Height="25" HorizontalAlignment="Stretch" ItemsSource="{Binding AllAttachmentGroups}" SelectedItem="{Binding SelectedAttachmentGroup}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
      <Grid Column="1" Width="22" Height="22" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <commonControls:BorderlessButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Command="{Binding RefreshAttachmentsCommand}" Visibility="{Binding IsPCOBusy, Converter={StaticResource InvertedValueToVisibilityConverter}}">
          <commonControls:ImageMask ImageSource="../Resources/Icons/Reset.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
        </commonControls:BorderlessButton>
        <commonControls:LoadingIndicator HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DisplayMode="Spinner" Visibility="{Binding IsPCOBusy, Converter={StaticResource ValueToVisibilityConverter}}" />
      </Grid>
    </Grid>
    <ScrollViewer Grid.Row="1" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding FilteredAttachmentGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" BorderThickness="0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
                <TextBlock Margin="4,3,0,3" FontWeight="SemiBold" Text="{Binding Name}" />
              </Border>
              <local:AttachmentItemsControl Grid.Row="1" ItemsSource="{Binding FilteredAttachments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <local:AttachmentItem />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </local:AttachmentItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <commonControls:SearchBox Grid.Row="2" Height="20" HorizontalAlignment="Stretch" KeepFocus="True" PlaceholderText="{mex:Localized GLOBAL_FILTER_FIELD_placeholder}" Text="{Binding FilterText}" />
  </Grid>
</windowing:ChromedWindow>