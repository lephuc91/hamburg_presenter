<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CustomSizeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="self" xmlns:ui="clr-namespace:ProPresenter.UI" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
  <StackPanel uiUtility:UIElementHelper.FocusedElement="{Binding ElementName=WidthInputControl}">
    <TextBlock Margin="0,0,0,10" Text="{mex:Localized EDITOR_PRESENTATION_PRESENTATION_INSPECTOR_CUSTOM_SIZE_DESCRIPTION_label}" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <commonControls:DoubleUpDown Name="WidthInputControl" Grid.Row="0" Grid.Column="0" Width="100" Height="22" Margin="0,0,5,0" VerticalContentAlignment="Center" FormatString="{}{0} pt" Minimum="1" Maximum="{Binding CapSizeValue, ElementName=self}" Value="{Binding X, ElementName=self}" />
      <commonControls:DoubleUpDown Grid.Row="0" Grid.Column="1" Width="100" Height="22" Margin="5,0,0,0" VerticalContentAlignment="Center" FormatString="{}{0} pt" Minimum="1" Maximum="{Binding CapSizeValue, ElementName=self}" Value="{Binding Y, ElementName=self}" />
      <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_X_COORDINATE}" />
      <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_Y_COORDINATE}" />
    </Grid>
  </StackPanel>
</UserControl>