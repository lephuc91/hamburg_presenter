<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.MenuLayout" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:analytics="clr-namespace:ProPresenter.DO.Analytics;assembly=ProPresenter.DO" xmlns:audience="clr-namespace:ProPresenter.DO.Looks;assembly=ProPresenter.DO" xmlns:captureAnalytics="clr-namespace:ProPresenter.DO.Analytics.Events.Capture;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cues="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:enum="clr-namespace:ProPresenter.UI.ViewModels.Editor" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:presentationUI="clr-namespace:ProPresenter.UI.PresentationView" xmlns:preview="clr-namespace:ProPresenter.UI.Preview" xmlns:propresenterUI="clr-namespace:ProPresenter.UI" xmlns:settings="clr-namespace:ProPresenter.DO.Settings;assembly=ProPresenter.DO" xmlns:slideEditor="clr-namespace:ProPresenter.UI.SlideEditor" xmlns:testPatternUI="clr-namespace:ProPresenter.UI.TestPattern" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="this" Focusable="True">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="AddShapeMenuSource.xaml" />
        <ui:SharedResourceDictionary Source="pack://application:,,,/ProPresenter.UI;component/Resources/Paths/Paths.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="selfProxy" Data="{Binding ElementName=this}" />
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:CountToBoolConverter x:Key="CountToBoolConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:CustomSlideConverter x:Key="CustomSlideConverter" />
      <converters:AddElementCommandParameterConverter x:Key="AddElementCommandParametersConverter" />
      <x:StaticExtension x:Key="MainMenu" Member="enum:InsertEditorObjectSourceType.EditorMainMenu" />
      <Style x:Key="CustomBezierPathMenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Header" Value="{mex:Localized EDITOR_MENU_INSERT_SHAPE_title}" />
        <Setter Property="MenuItem.Icon">
          <Setter.Value>
            <Path Fill="{Binding MENU_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}">
              <Path.Data>
                <RectangleGeometry RadiusX="3" RadiusY="3" Rect="2 2 14 14" />
              </Path.Data>
            </Path>
          </Setter.Value>
        </Setter>
        <Setter Property="ItemsSource" Value="{DynamicResource Source}" />
      </Style>
      <ObjectDataProvider x:Key="EditStageLayoutCommandParameterProvider" ObjectType="{x:Type uiCommands:EditStageLayoutCommandParameter}">
        <ObjectDataProvider.ConstructorParameters>
          <uiCommands:ShowSource>ApplicationMenu</uiCommands:ShowSource>
        </ObjectDataProvider.ConstructorParameters>
      </ObjectDataProvider>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Menu Name="MainMenu" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center">
    <MenuItem Header="{mex:Localized MAIN_MENU_APPLICATION_title}">
      <commonControls:RoutedMenuItem Command="{Binding ProMenu.About.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem uiUtility:MenuItemHelper.InvokeCommandWithChildren="True" Command="{Binding ProMenu.OpenSettings.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized MAIN_MENU_APPLICATION_SETTINGS_title}">
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Account.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.General.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Updates.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Screens.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Audio.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Network.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Input.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Devices.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Media.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Import.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Integrations.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Sync.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Visibility="{mex:FeatureFlag Cloud, IsInverted=True}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.Groups.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding ProMenu.SlideLabels.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      </commonControls:RoutedMenuItem>
      <commonControls:RoutedMenuItem Command="{Binding ProMenu.CheckForUpdates.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding ProMenu.Quit.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
    </MenuItem>
    <MenuItem Header="{mex:Localized MAIN_MENU_FILE_MENU_title}">
      <commonControls:RoutedMenuItem Command="{Binding FileMenu.NewPresentation.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Click="OnNewPresentationClick" />
      <commonControls:RoutedMenuItem Command="{Binding FileMenu.NewPlaylist.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Click="OnNewGeneralPlaylistClick" />
      <commonControls:RoutedMenuItem Command="{Binding FileMenu.NewLibrary.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Click="OnNewLibraryClick" />
      <MenuItem Header="{mex:Localized MAIN_MENU_FILE_IMPORT_SUBMENU_title}">
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportFile.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportProLibrary.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportMedia.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportTextFromClipboard.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <Separator Visibility="{Binding ShowHoW, ElementName=this, Converter={StaticResource ValueToVisibilityConverter}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportMultiTracks.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Visibility="{Binding ShowHoW, ElementName=this, Converter={StaticResource ValueToVisibilityConverter}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportSongSelect.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Visibility="{Binding ShowHoW, ElementName=this, Converter={StaticResource ValueToVisibilityConverter}}" />
        <Separator />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportPowerPoint.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ImportPowerPointLegacy.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      </MenuItem>
      <Separator />
      <MenuItem Header="{mex:Localized MAIN_MENU_FILE_EXPORT_SUBMENU_title}">
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ExportPresentation.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ExportPresentationBundle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ExportText.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ExportSlideImages.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <Separator />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ExportPlaylist.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding FileMenu.ExportThemes.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      </MenuItem>
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding FileMenu.Print.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
    </MenuItem>
    <MenuItem Header="{mex:Localized MAIN_MENU_EDIT_MENU_title}">
      <MenuItem Command="{Binding CommonInputActions.Undo.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" IsEnabled="{Binding ActiveUndoStack.CanUndo, FallbackValue=false}">
        <HeaderedItemsControl.Header>
          <PriorityBinding>
            <Binding Converter="{StaticResource FormattedLocalizedStringConverter}" ConverterParameter="UNDO_title" Path="ActiveUndoStack.NextUndoAction.Tag" />
            <Binding Path="CommonInputActions.Undo.Label" Source="{di:DIMarkup {x:Type inputActions:IInputActions}}" />
          </PriorityBinding>
        </HeaderedItemsControl.Header>
      </MenuItem>
      <MenuItem Command="{Binding CommonInputActions.Redo.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" IsEnabled="{Binding ActiveUndoStack.CanRedo, FallbackValue=false}">
        <HeaderedItemsControl.Header>
          <PriorityBinding>
            <Binding Converter="{StaticResource FormattedLocalizedStringConverter}" ConverterParameter="REDO_title" Path="ActiveUndoStack.NextRedoAction.Tag" />
            <Binding Path="CommonInputActions.Redo.Label" Source="{di:DIMarkup {x:Type inputActions:IInputActions}}" />
          </PriorityBinding>
        </HeaderedItemsControl.Header>
      </MenuItem>
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.Cut.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <MenuItem Header="{mex:Localized GLOBAL_COPY_ACTION}">
        <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.Copy.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding EditMenu.CopyTextStyle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      </MenuItem>
      <MenuItem Header="{mex:Localized GLOBAL_PASTE_ACTION}">
        <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.Paste.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.PasteAndMatchStyle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <commonControls:RoutedMenuItem Command="{Binding EditMenu.PasteTextStyle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      </MenuItem>
      <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.Duplicate.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.Delete.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.SelectAll.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.DeselectAll.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding CommonInputActions.Find.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized MAIN_MENU_EDIT_SEARCH_title}" Click="OnOpenQuickSearchClick" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding EditMenu.KeyMapping.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
    </MenuItem>
    <MenuItem Header="{mex:Localized MAIN_MENU_PRESENTATION_MENU_title}">
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.NewSlide.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.NextSlide.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.PreviousSlide.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.NextBackground.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.PreviousBackground.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <MenuItem UsesItemContainerTemplate="True" Header="{mex:Localized MAIN_MENU_PRESENTATION_CLEAR_GROUPS_title}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type inputActions:ClearGroupInputAction}}">
              <commonControls:RoutedMenuItem Command="{Binding BindCommand}" CommandParameter="{Binding}" Header="{Binding Label}" />
            </ItemContainerTemplate>
            <CollectionViewSource x:Key="ClearGroups" Source="{Binding ClearGroups, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <CollectionContainer Collection="{Binding Source={StaticResource ClearGroups}}" />
            <Separator Visibility="{Binding ClearGroups.Count, Converter={StaticResource CountToVisibilityConverter}, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
            <commonControls:RoutedMenuItem CommandParameter="{x:Static analytics:ClearGroupShownSource.ApplicationMenu}" Command="{Binding PresentationMenu.OpenClearGroups.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </MenuItem>
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ClearSlide.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ClearMedia.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ClearProps.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ClearAudio.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ClearMessages.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ClearAnnouncements.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ClearToLogo.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ShowTriggeredPresentation.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.ShowTriggeredAnnouncement.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.RevealInLibrary.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding PresentationMenu.SlideOnStageScreen.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" IsChecked="{Binding SlideOnStageDisplayOnly, Mode=OneWay}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="uiUtility:MenuItemHelper.GestureTextVisibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="SlideEditor" Binding="{Binding ActiveInlineType}">
                <Setter Property="uiUtility:MenuItemHelper.GestureTextVisibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Value="TemplateEditor" Binding="{Binding ActiveInlineType}">
                <Setter Property="uiUtility:MenuItemHelper.GestureTextVisibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Value="MaskEditor" Binding="{Binding ActiveInlineType}">
                <Setter Property="uiUtility:MenuItemHelper.GestureTextVisibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:RoutedMenuItem>
    </MenuItem>
    <slideEditor:MainEditorMenu />
    <MenuItem Header="{mex:Localized MAIN_TOOLBAR_REFLOW_BUTTON_label}" Visibility="{Binding IsReflowMenuVisible, Converter={StaticResource ValueToVisibilityConverter}}">
      <commonControls:RoutedMenuItem Command="{Binding ReflowMenu.Bold.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding ReflowMenu.Italic.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding ReflowMenu.Underline.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding ReflowMenu.StrikeThrough.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <Separator />
      <commonControls:RoutedMenuItem Command="{Binding ReflowMenu.Bigger.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      <commonControls:RoutedMenuItem Command="{Binding ReflowMenu.Smaller.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
    </MenuItem>
    <MenuItem Header="{mex:Localized MAIN_MENU_SCREEN_MENU_title}">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <CollectionViewSource x:Key="AudienceLookCollection" Source="{Binding AudienceLooks}" />
          <CollectionViewSource x:Key="StageScreens" Source="{Binding Data.StageScreenToLayoutMap, Source={StaticResource selfProxy}}" />
          <Style x:Key="ScreensHeaderMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MenuItem.IsCheckable" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
          </Style>
          <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type cues:SlideCue}}">
            <MenuItem CommandParameter="{Binding DataContext.Key, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}}" Click="SelectStageDisplayCueClick">
              <HeaderedItemsControl.Header>
                <StackPanel Margin="0,5" Orientation="Horizontal">
                  <propresenterUI:SlidePreview Width="125" Height="70" RenderTransparencyCheckerboard="True" PrimaryCheckerboardBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" SecondaryCheckerboardBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" Source="{Binding SlideAction.Slide, Converter={StaticResource CustomSlideConverter}}" />
                  <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
                </StackPanel>
              </HeaderedItemsControl.Header>
              <MenuItem.IsChecked>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
                  <Binding Path="DataContext.Value" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}" />
                </MultiBinding>
              </MenuItem.IsChecked>
            </MenuItem>
          </ItemContainerTemplate>
          <Style x:Key="StageScreenArrangementMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Style.Resources>
              <ResourceDictionary>
                <CompositeCollection x:Key="itmsSource">
                  <commonControls:RoutedMenuItem Command="{Binding Data.EditSelectedLayoutCommand, Source={StaticResource proxy}}" CommandParameter="{Binding Value}" Header="{mex:Localized MAIN_MENU_SCREEN_EDIT_STAGE_SELECTED_LAYOUT_title}" />
                  <Separator />
                  <CollectionContainer Collection="{Binding Data.StageLayouts, Source={StaticResource proxy}}" />
                </CompositeCollection>
              </ResourceDictionary>
            </Style.Resources>
            <Setter Property="HeaderTemplate">
              <Setter.Value>
                <DataTemplate>
                  <TextBlock>
                    <Run Text="{Binding Key.Name}" /> <Run Text=": " /> <Run FontStyle="Italic" Text="{Binding Value.Name}" /></TextBlock>
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="ItemsSource" Value="{StaticResource itmsSource}" />
            <Setter Property="MenuItem.UsesItemContainerTemplate" Value="True" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ItemsControl.ItemContainerStyleSelector>
        <propresenterUI:ScreenMenuItemStyleSelector />
      </ItemsControl.ItemContainerStyleSelector>
      <ItemsControl.ItemsSource>
        <CompositeCollection>
          <MenuItem Style="{StaticResource ScreensHeaderMenuItemStyle}" Header="{mex:Localized GLOBAL_AUDIENCE_title}" />
          <commonControls:RoutedMenuItem Command="{Binding ScreensMenu.AudienceEnable.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized MAIN_MENU_SCREEN_ENABLE_title}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                <Setter Property="Header" Value="{mex:Localized MAIN_MENU_SCREEN_ENABLE_title}" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding AudienceEnable}">
                    <Setter Property="Header" Value="{mex:Localized MAIN_MENU_SCREEN_DISABLE_title}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </commonControls:RoutedMenuItem>
          <MenuItem ItemsSource="{Binding Source={StaticResource AudienceLookCollection}}">
            <HeaderedItemsControl.HeaderTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{mex:Localized MAIN_MENU_SCREEN_CURRENT_AUDIENCE_LOOK_title}" />
                  <TextBlock Margin="3,0,0,0" FontStyle="Italic" Text="{Binding Data.LiveAudienceLook.Live.Name, Source={StaticResource proxy}}" />
                </StackPanel>
              </DataTemplate>
            </HeaderedItemsControl.HeaderTemplate>
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <DataTemplate x:Key="{DataTemplateKey {x:Type audience:AudienceLook}}" DataType="{x:Type audience:AudienceLook}">
                  <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
                </DataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <ItemsControl.ItemContainerStyle>
              <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                <Setter Property="MenuItem.Command" Value="{Binding Data.MakeSelectedLookLiveCommand, Source={StaticResource selfProxy}}" />
                <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                <Setter Property="MenuItem.IsChecked">
                  <Setter.Value>
                    <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                      <Binding Path="ID" />
                      <Binding Path="Data.LiveAudienceLook.Live.ID" Source="{StaticResource proxy}" />
                    </MultiBinding>
                  </Setter.Value>
                </Setter>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </MenuItem>
          <commonControls:RoutedMenuItem Command="{Binding ScreensMenu.EditLooks.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
          <Separator />
          <MenuItem Style="{StaticResource ScreensHeaderMenuItemStyle}" Header="{mex:Localized GLOBAL_STAGE_title}" />
          <commonControls:RoutedMenuItem Command="{Binding ScreensMenu.StageEnable.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized MAIN_MENU_SCREEN_ENABLE_title}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                <Setter Property="Header" Value="{mex:Localized MAIN_MENU_SCREEN_ENABLE_title}" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding StageEnable}">
                    <Setter Property="Header" Value="{mex:Localized MAIN_MENU_SCREEN_DISABLE_title}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </commonControls:RoutedMenuItem>
          <CollectionContainer Collection="{Binding Source={StaticResource StageScreens}}" />
