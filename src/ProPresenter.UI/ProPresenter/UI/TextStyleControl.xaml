<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TextStyleControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:text="clr-namespace:Pro.Text;assembly=Pro.Text" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="self" uiUtility:WindowHelper.SendKeyEventsToMainWindow="True" SnapsToDevicePixels="True" UseLayoutRounding="True" uiUtility:UIElementHelper.Palette="{Binding DETAILLIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" FocusManager.FocusedElement="{Binding ElementName=self}" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource Self}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <Style x:Key="TemplateSettingsToggleButtonStyle" BasedOn="{StaticResource {x:Type commonControls:RadioToggleButton}}" TargetType="{x:Type commonControls:RadioToggleButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="TextBlock.FontSize" Value="13" />
        <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
        <Setter Property="TextBlock.TextAlignment" Value="Center" />
      </Style>
      <Style x:Key="SettingsColorPickerStyle" BasedOn="{StaticResource {x:Type commonControls:ColorPicker}}" TargetType="{x:Type commonControls:ColorPicker}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Width" Value="65" />
      </Style>
      <Style x:Key="StepperStyle" BasedOn="{StaticResource {x:Type commonControls:DoubleUpDown}}" TargetType="{x:Type commonControls:DoubleUpDown}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="19" />
      </Style>
      <Style x:Key="CustomInputStyle" BasedOn="{StaticResource {x:Type commonControls:DoubleUpDown}}" TargetType="{x:Type commonControls:DoubleUpDown}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="UpDownBase.ShowButtonSpinner" Value="False" />
        <Setter Property="UpDownBase.UpdateValueOnEnterKey" Value="True" />
        <Setter Property="Width" Value="45" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderThickness="1" CornerRadius="{StaticResource {x:Static themes:Constants.WindowCornerRadius}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ui:TextStyleControl}}}" BorderBrush="{Binding POPUPBORDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Height="22" HorizontalAlignment="Left" FontWeight="SemiBold" Text="{mex:Localized TEXT_STYLE_POPOVER_FONT_HEADER_label}" />
      <Grid Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox Name="FontFamilySelector" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="22" Margin="0,0,0,5" ItemsSource="{Binding FontGroups, ElementName=self}" SelectionChanged="FontFamilySelectionChanged">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Width" Value="{Binding ElementName=FontFamilySelector, Path=ActualWidth}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <commonControls:FormattedTextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" FontBrush="{Binding (TextElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}" FontSelection="{Binding Fonts[0].Info, Mode=OneTime}" FormattedText="{Binding DisplayName, Mode=OneTime}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="22" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Text="{mex:Localized TEXT_STYLE_POPOVER_FONT_FAMILY_BUTTON_placeholder}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Path=SelectedItem, ElementName=FontFamilySelector}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
        <ComboBox Name="weightSelector" Grid.Row="1" Grid.Column="0" Height="22" Margin="0,0,5,0" ItemsSource="{Binding SelectedItem.Fonts, ElementName=FontFamilySelector}" SelectionChanged="WeightSelector_SelectionChanged">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <commonControls:FormattedTextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" FontBrush="{Binding (TextElement.Foreground), RelativeSource={RelativeSource TemplatedParent}}" FontSelection="{Binding Info, Mode=OneTime}" FormattedText="{Binding Info.DisplayFaceName, Mode=OneTime}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
              <Setter Property="IsEnabled" Value="True" />
              <Style.Triggers>
                <DataTrigger Value="1" Binding="{Binding SelectedItem.Fonts.Count, ElementName=FontFamilySelector}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ComboBox>
        <TextBlock Grid.Row="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Text="{mex:Localized TEXT_STYLE_POPOVER_FONT_WEIGHT_BUTTON_placeholder}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Path=SelectedItem, ElementName=weightSelector}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
        <commonControls:ColorPicker Name="FontColorPicker" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsColorPickerStyle}" SelectedColorChanged="FontColorChanged" />
        <Grid Row="2" Column="0" Margin="0,5,5,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <commonControls:RadioToggleButton Name="None" Grid.Column="0" Content="Aa" Style="{StaticResource TemplateSettingsToggleButtonStyle}" Tag="{x:Static text:CapitalizationType.None}" Checked="CapitalizationUpdate" />
          <commonControls:RadioToggleButton Name="AllCaps" Grid.Column="1" Content="AA" Style="{StaticResource TemplateSettingsToggleButtonStyle}" Tag="{x:Static text:CapitalizationType.AllCaps}" Checked="CapitalizationUpdate" />
          <commonControls:RadioToggleButton Name="SmallCaps" Grid.Column="2" Content="aa" Style="{StaticResource TemplateSettingsToggleButtonStyle}" Tag="{x:Static text:CapitalizationType.SmallCaps}" Visibility="Collapsed" Checked="CapitalizationUpdate" />
        </Grid>
        <Grid Row="2" Column="1" Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <commonControls:IntegerUpDown Name="CustomCharacterSizeInput" Grid.Column="0" Width="47" Height="22" HorizontalAlignment="Stretch" ShowButtonSpinner="False" UpdateValueOnEnterKey="True" ValueChanged="CustomCharacterSizeValueChanged" />
          <commonControls:IntegerUpDown Name="CharacterSizeStepper" Grid.Column="1" Width="19" Height="22" ValueChanged="CharacterSizeStepperValueChanged" />
        </Grid>
        <TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" FontSize="10" Text="{mex:Localized TEXT_STYLE_POPOVER_FONT_CAPITALIZATION_CONTROL_title}" />
        <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" FontSize="10" Text="{mex:Localized TEXT_STYLE_POPOVER_FONT_SIZE_CONTROL_title}" />
      </Grid>
      <Separator Grid.Row="2" Margin="0,10" />
      <Grid Row="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <commonControls:ParagraphAlignmentSelector Name="ParagraphAlignmentControl" Grid.Row="0" Margin="0,0,0,5" HorizontalAlignment="Stretch" AlignmentChanged="ParagraphAlignmentChanged" />
        <commonControls:DocumentAlignmentSelector Name="DocumentAlignmentControl" Grid.Row="1" HorizontalAlignment="Stretch" AlignmentChanged="DocumentAlignmentChanged" />
      </Grid>
      <Separator Grid.Row="4" Margin="0,10" />
      <Grid Row="5">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Height="22" HorizontalAlignment="Left" FontWeight="SemiBold" Text="{mex:Localized TEXT_STYLE_POPOVER_STROKE_HEADER_label}" />
        <Grid Row="0" Column="1" Width="90" Margin="0,0,0,5" HorizontalAlignment="Right">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <commonControls:RadioToggleButton Name="EnableStrokeBtn" Grid.Column="0" VerticalContentAlignment="Center" Style="{StaticResource TemplateSettingsToggleButtonStyle}" Content="{mex:Localized GLOBAL_ON}" Click="EnableStrokeBtn_Click" />
          <commonControls:RadioToggleButton Name="DisableStrokeBtn" Grid.Column="1" VerticalContentAlignment="Center" Style="{StaticResource TemplateSettingsToggleButtonStyle}" Content="{mex:Localized GLOBAL_OFF}" Click="DisableStrokeBtn_Click" />
        </Grid>
        <Grid Row="1" Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,5,0" Orientation="Vertical">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <commonControls:DoubleUpDown Name="CustomStrokeThicknessInput" Grid.Column="0" Maximum="10000" Minimum="0" Style="{StaticResource CustomInputStyle}" ValueChanged="CustomStrokeThicknessInputValueChanged" />
              <commonControls:DoubleUpDown Name="StrokeThicknessStepper" Grid.Column="1" Style="{StaticResource StepperStyle}" ValueChanged="StrokeThicknessStepperValueChanged" />
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" FontSize="10" Text="{mex:Localized TEXT_STYLE_POPOVER_STROKE_WIDTH_CONTROL_title}" />
          </StackPanel>
          <commonControls:ColorPicker Name="StrokeColorPicker" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource SettingsColorPickerStyle}" SelectedColorChanged="StrokeColorChanged" />
        </Grid>
      </Grid>
      <Separator Grid.Row="6" Margin="0,10" />
      <Grid Row="7">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Height="22" FontWeight="SemiBold" Text="{mex:Localized TEXT_STYLE_POPOVER_SHADOW_HEADER_label}" />
        <Grid Row="0" Column="1" ColumnSpan="2" Width="90" HorizontalAlignment="Right">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <commonControls:RadioToggleButton Name="EnableShadowBtn" Grid.Column="0" VerticalContentAlignment="Center" Style="{StaticResource TemplateSettingsToggleButtonStyle}" Content="{mex:Localized GLOBAL_ON}" Click="EnableShadowBtn_Click" />
          <commonControls:RadioToggleButton Name="DisableShadowBtn" Grid.Column="1" VerticalContentAlignment="Center" Style="{StaticResource TemplateSettingsToggleButtonStyle}" Content="{mex:Localized GLOBAL_OFF}" Click="DisableShadowBtn_Click" />
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,5,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <commonControls:DoubleUpDown Name="CustomShadowBlurInput" Grid.Column="0" Maximum="100" Minimum="1" Style="{StaticResource CustomInputStyle}" ValueChanged="CustomShadowBlurInputValueChanged" />
            <commonControls:DoubleUpDown Name="ShadowBlurStepper" Grid.Column="1" Style="{StaticResource StepperStyle}" ValueChanged="ShadowBlurStepperValueChanged" />
          </Grid>
          <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{mex:Localized TEXT_STYLE_POPOVER_SHADOW_BLUR_CONTROL_title}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,5,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <commonControls:DoubleUpDown Name="CustomShadowOpacityInput" Grid.Column="0" FormatString="P0" Increment=".05" Maximum="1" Minimum="0" Style="{StaticResource CustomInputStyle}" ValueChanged="CustomShadowOpacityInputValueChanged" />
            <commonControls:DoubleUpDown Name="ShadowOpacityStepper" Grid.Column="1" FormatString="P0" Increment=".05" Maximum="1" Style="{StaticResource StepperStyle}" ValueChanged="ShadowOpacityStepperValueChanged" />
          </Grid>
          <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{mex:Localized TEXT_STYLE_POPOVER_SHADOW_OPACITY_CONTROL_title}" />
        </StackPanel>
        <commonControls:ColorPicker Name="ShadowColorPicker" Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" VerticalAlignment="Top" Style="{StaticResource SettingsColorPickerStyle}" SelectedColorChanged="ShadowColorChanged" />
        <commonControls:Rotator Name="ShadowAngleRotator" Grid.Row="2" Grid.Column="0" Width="22" Height="22" Margin="0,5,3,0" HorizontalAlignment="Right" VerticalAlignment="Top" AngleUpdated="ShadowAngleRotatorAngleUpdated" />
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5,5,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <commonControls:DoubleUpDown Name="CustomShadowAngleInput" Grid.Column="0" FormatString="{}{0:N0}°" Maximum="360" Minimum="0" Style="{StaticResource CustomInputStyle}" ValueChanged="CustomShadowAngleInputValueChanged" />
            <commonControls:DoubleUpDown Name="ShadowAngleStepper" Grid.Column="1" Style="{StaticResource StepperStyle}" ValueChanged="ShadowAngleStepperValueChanged" />
          </Grid>
          <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{mex:Localized TEXT_STYLE_POPOVER_SHADOW_ANGLE_CONTROL_title}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,5,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <commonControls:DoubleUpDown Name="CustomShadowOffsetInput" Grid.Column="0" Width="47" Margin="0,0,0,0" FormatString="F0" Maximum="100" Minimum="0" Style="{StaticResource CustomInputStyle}" ValueChanged="CustomShadowOffsetInputValueChanged" />
            <commonControls:DoubleUpDown Name="ShadowOffsetStepper" Grid.Column="1" FormatString="F0" Style="{StaticResource StepperStyle}" ValueChanged="ShadowOffsetStepperValueChanged" />
          </Grid>
          <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{mex:Localized TEXT_STYLE_POPOVER_SHADOW_OFFSET_CONTROL_title}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>