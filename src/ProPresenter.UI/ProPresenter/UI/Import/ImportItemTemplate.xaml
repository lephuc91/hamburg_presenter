<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Import.ImportItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" Height="30" xmlns:import="clr-namespace:ProPresenter.UI.Import">
  <Border Margin="-5,-2" BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid Margin="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Source="../Resources/Icons/TxtFileIcon.png" />
      <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
    </Grid>
  </Border>
</UserControl>