<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Import.EditImportFileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:reflow="clr-namespace:ProPresenter.UI.ReflowEditor" xmlns:templates="clr-namespace:ProPresenter.UI.Templates" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="self" Width="850" Height="685" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.SendKeyEventsToMainWindow="True" ResizeMode="CanResize" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:import="clr-namespace:ProPresenter.UI.Import" Title="{mex:Localized IMPORT_TEXT_title}">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
          <Setter Property="uiUtility:UIElementHelper.DisableUndoInputBindings" Value="False" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Button Height="22" MinWidth="70" Margin="15,5" Padding="10,0,10,0" HorizontalAlignment="Left" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" Click="CancelButton_Click" />
      <Button Name="ImportButton" Height="22" MinWidth="70" Margin="15,5" Padding="10,0,10,0" HorizontalAlignment="Right" IsDefault="True" Content="{mex:Localized IMPORT_EDITOR_IMPORT_title}" Click="ImportButton_Click" />
    </Grid>
    <Grid Row="1">
      <Grid Margin="20,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_EDITOR_TITLE_label}" />
        <TextBox Grid.Row="0" Grid.Column="1" Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding DocumentOptions.CCLIData.Title, ElementName=self, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_EDITOR_COPYRIGHT_ARTIST_label}" />
        <TextBox Grid.Row="1" Grid.Column="1" Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding DocumentOptions.CCLIData.Artist, ElementName=self, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{mex:Localized IMPORT_EDITOR_COPYRIGHT_DISPLAY_label}" IsChecked="{Binding DocumentOptions.CCLIData.Display, ElementName=self, Mode=TwoWay}" ToolTip="{mex:Localized IMPORT_EDITOR_COPYRIGHT_DISPLAY_tooltip}" />
        <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Top" Orientation="Vertical">
          <TextBlock Grid.Row="1" Grid.Column="4" Margin="0,5,0,10" VerticalAlignment="Center" Text="{mex:Localized IMPORT_EDITOR_THEME_label}" />
          <templates:TemplateButton ContextGroup="ImportFile" ShowOptions="False" DefaultTemplate="{Binding Themes.DefaultTheme[0], ElementName=self}" DefaultTemplateHeader="{mex:Localized GLOBAL_DEFAULT}" SelectTemplateCommand="{Binding SelectTemplateCommand, ElementName=self}" SelectedTemplate="{Binding DocumentOptions.Template, ElementName=self}" TemplateSlideTooltipText="{mex:Localized THEMES_POPOVER_SELECT_THEME_SLIDE_tooltip}" />
        </StackPanel>
        <TextBox Grid.Row="2" Grid.Column="1" Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding DocumentOptions.CCLIData.Author, ElementName=self, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_EDITOR_COPYRIGHT_AUTHOR_label}" />
        <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_EDITOR_COPYRIGHT_PUBLISHER_label}" />
        <TextBox Grid.Row="3" Grid.Column="1" Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding DocumentOptions.CCLIData.Publisher, ElementName=self, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_EDITOR_COPYRIGHT_CCLI_label}" />
        <TextBox Grid.Row="2" Grid.Column="3" Width="60" Height="22" HorizontalAlignment="Right" VerticalContentAlignment="Center" Text="{Binding DocumentOptions.CCLIData.SongNumber, ElementName=self, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_EDITOR_COPYRIGHT_YEAR_label}" />
        <TextBox Grid.Row="3" Grid.Column="3" Width="60" Height="22" HorizontalAlignment="Right" VerticalContentAlignment="Center" Text="{Binding DocumentOptions.CCLIData.Copyright, ElementName=self, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
    </Grid>
    <reflow:ReflowEditor x:Name="ReflowEditor" Grid.Row="2" ShowCloseButton="False" ThemeContextGroup="ImportFile" AddDroppedActionCommand="{Binding PresentationVM.AddDroppedActionCommand, ElementName=self}" AddDroppedMediaActionCommand="{Binding PresentationVM.AddDroppedMediaActionCommand, ElementName=self}" AddMediaActionCommand="{Binding PresentationVM.AddMediaActionCommand, ElementName=self}" AddMediaPlaylistActionCommand="{Binding PresentationVM.AddMediaPlaylistActionCommand, ElementName=self}" CopyCommand="{Binding CopyCommand, ElementName=self}" CustomSlideMenuVM="{Binding PresentationVM.CustomSlideMenuVM, ElementName=self}" CutCommand="{Binding CutCommand, ElementName=self}" DeleteCommand="{Binding DeleteCommand, ElementName=self}" DropMediaFilesCommand="{Binding PresentationVM.DropMediaFilesCommand, ElementName=self}" DropPropCommand="{Binding PresentationVM.DropPropCommand, ElementName=self}" PasteCommand="{Binding PasteCommand, ElementName=self}" PlaylistItem="{Binding DocumentCue, ElementName=self}" RowCapacity="{Binding ReflowRowCapacity, ElementName=self, Mode=TwoWay}" SelectedSlides="{Binding SelectedSlides, ElementName=self}" SelectedTransition="{Binding DocumentOptions.WorkingPresentation.SelectedTransition, ElementName=self}" TextZoomLevel="{Binding ReflowTextZoomLevel, ElementName=self, Mode=TwoWay}" />
  </Grid>
</windowing:ChromedWindow>