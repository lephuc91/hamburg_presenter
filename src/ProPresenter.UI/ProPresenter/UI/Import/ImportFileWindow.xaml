<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Import.ImportFileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:do="clr-namespace:ProPresenter.DO;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.Import" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:templates="clr-namespace:ProPresenter.UI.Templates" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:ui1="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="self" Height="400" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Width" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" Title="{mex:Localized IMPORT_TEXT_title}">
  <FrameworkElement.Resources>
    <ui1:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui1:SharedResourceDictionary Source="../LibraryPlaylistResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <Style x:Key="HeaderStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="ImportControlButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ui1:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="15">
    <Grid.ColumnDefinitions>
      <ColumnDefinition>
        <FrameworkContentElement.Style>
          <Style TargetType="{x:Type ColumnDefinition}">
            <Setter Property="Width" Value="0" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding IsMultipleDocuments}" />
                  <Condition Value="True" Binding="{Binding Path=IsChecked, ElementName=ToggleShowList}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="250" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkContentElement.Style>
      </ColumnDefinition>
      <ColumnDefinition Width="350" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <local:ImportDocumentListBox x:Name="DocumentList" Grid.Row="0" Grid.Column="0" Height="280" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding Documents}" SelectedListItem="{Binding SelectedDocument, Mode=TwoWay}" SelectedListItems="{Binding SelectedDocuments}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <local:ImportItemTemplate DataContext="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </local:ImportDocumentListBox>
    <Grid Row="0" Column="1" Margin="10,0,10,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Style="{StaticResource HeaderStyle}" Text="{mex:Localized IMPORT_TEXT_PARSING_label}" />
      <Border Grid.Row="1" Margin="0,0,0,7" Background="{Binding GROUP, Source={x:Static theming:AppTheme.Active}}">
        <Grid Margin="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" HorizontalAlignment="Right" Style="{StaticResource HeaderStyle}" TextWrapping="Wrap" Text="{mex:Localized IMPORT_TEXT_SLIDE_DELIMITER_label}" />
          <local:BreakModeControl Grid.Row="0" Grid.Column="1" Height="22" Margin="0,0,0,5" HorizontalAlignment="Stretch" BreakMode="{Binding BreakMode}" CustomDelimiter="{Binding CustomDelimiter}" />
          <commonControls:IntegerUpDown Grid.Row="1" Grid.Column="0" Width="60" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" Minimum="1" Value="{Binding LinesPerSlide, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" HorizontalAlignment="Left" Style="{StaticResource HeaderStyle}" TextWrapping="Wrap" Text="{mex:Localized IMPORT_TEXT_SLIDE_DELIMITER_COUNT_label}" />
        </Grid>
      </Border>
      <TextBlock Grid.Row="2" Style="{StaticResource HeaderStyle}" Text="{mex:Localized IMPORT_TEXT_PRESENTATION_label}" />
      <Border Grid.Row="3" Margin="0,0,0,7" Background="{Binding GROUP, Source={x:Static theming:AppTheme.Active}}">
        <Grid Margin="5" HorizontalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" HorizontalAlignment="Right" Style="{StaticResource HeaderStyle}" Text="{mex:Localized IMPORT_TEXT_PRESENTATION_SIZE_label}" />
          <ui:SizeSelector x:Name="sizeSelector" Grid.Row="0" Grid.Column="1" Height="22" Margin="0,0,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" SetTargetToDefaultSize="True" Target="{Binding Data, Source={StaticResource proxy}}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,5,0" HorizontalAlignment="Right" Style="{StaticResource HeaderStyle}" Text="{mex:Localized IMPORT_TEXT_PRESENTATION_THEME_label}" />
          <templates:TemplateButton Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" AllowCreateAndEditTheme="False" ContextGroup="ImportFile" ShowOptions="False" DefaultTemplate="{Binding Themes.DefaultTheme[0]}" DefaultTemplateHeader="{mex:Localized GLOBAL_DEFAULT}" SelectTemplateCommand="{Binding SelectTemplateCommand}" SelectedTemplate="{Binding Template}" TemplateSlideTooltipText="{mex:Localized THEMES_POPOVER_SELECT_THEME_SLIDE_tooltip}" />
        </Grid>
      </Border>
      <TextBlock Grid.Row="4" Style="{StaticResource HeaderStyle}" Text="{mex:Localized IMPORT_TEXT_DESTINATION_label}" />
      <Border Grid.Row="5" Margin="0,0,0,7" HorizontalAlignment="Stretch" Background="{Binding GROUP, Source={x:Static theming:AppTheme.Active}}">
        <Grid Margin="5" HorizontalAlignment="Center" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_TEXT_DESTINATION_LIBRARY_label}" />
          <Button Grid.Row="0" Grid.Column="1" Height="22" Margin="0,0,0,5" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedLibrary.Name}" />
              <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, ElementName=self}" Stroke="{Binding Foreground, ElementName=self}" />
            </Grid>
            <FrameworkElement.ContextMenu>
              <ContextMenu ItemsSource="{x:Static do:DataVault.LibraryCollection}" Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                <ItemsControl.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="MenuItem.Command" Value="{Binding Data.SelectLibraryCommand, Source={StaticResource proxy}}" />
                    <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="MenuItem.IsChecked">
                      <Setter.Value>
                        <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                          <Binding />
                          <Binding Path="Data.SelectedLibrary" Source="{StaticResource proxy}" />
                        </MultiBinding>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,5,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized IMPORT_TEXT_DESTINATION_PLAYLIST_label}" />
          <Button Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,0,5" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                  <PriorityBinding>
                    <Binding Path="SelectedPlaylist.Name" />
                    <Binding Source="{mex:Localized GLOBAL_NONE}" />
                  </PriorityBinding>
                </TextBlock.Text>
              </TextBlock>
              <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, ElementName=self}" Stroke="{Binding Foreground, ElementName=self}" />
            </Grid>
            <FrameworkElement.ContextMenu>
              <ContextMenu Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                <ItemsControl.ItemsSource>
                  <CompositeCollection>
                    <MenuItem DataContext="{x:Null}" Header="{mex:Localized GLOBAL_NONE}" />
                    <Separator Style="{StaticResource {x:Type Separator}}" />
                    <CollectionContainer Collection="{Binding Data.Playlists, Source={StaticResource proxy}}" />
                  </CompositeCollection>
                </ItemsControl.ItemsSource>
                <ItemsControl.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="MenuItem.Command" Value="{Binding Data.SelectPlaylistCommand, Source={StaticResource proxy}}" />
                    <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                    <Setter Property="MenuItem.IsChecked">
                      <Setter.Value>
                        <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                          <Binding />
                          <Binding Path="Data.SelectedPlaylist" Source="{StaticResource proxy}" />
                        </MultiBinding>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Value="Group">
                        <DataTrigger.Binding>
                          <PriorityBinding>
                            <Binding Path="Type" />
                          </PriorityBinding>
                        </DataTrigger.Binding>
                        <Setter Property="IsEnabled" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
        </Grid>
      </Border>
    </Grid>
    <Button Grid.Row="1" Grid.Column="0" Height="22" MinWidth="80" Margin="0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding EditDocumentCommand}" Content="{mex:Localized IMPORT_TEXT_EDIT_title}" />
    <Grid Row="1" Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ToggleButton Name="ToggleShowList" Grid.Column="0" Height="22" MinWidth="40" Margin="10,5,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" Visibility="{Binding IsMultipleDocuments, Converter={StaticResource ValueToVisibilityConverter}}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
            <Setter Property="Content" Value="&lt;&lt;" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsChecked, ElementName=ToggleShowList}">
                <Setter Property="Content" Value="&gt;&gt;" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ToggleButton>
      <Button Grid.Column="0" Height="22" MinWidth="80" Margin="10,5,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding EditDocumentCommand}" Content="{mex:Localized IMPORT_TEXT_EDIT_title}" Visibility="{Binding IsMultipleDocuments, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
      <Button Grid.Column="1" Margin="0,5,5,5" Style="{StaticResource ImportControlButtonStyle}" Command="{Binding AbortImportCommand}" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      <Button Grid.Column="2" Margin="0,5,10,5" Style="{StaticResource ImportControlButtonStyle}" Command="{Binding ImportSingleDocumentCommand}" Content="{mex:Localized IMPORT_TEXT_IMPORT_title}" Visibility="{Binding IsMultipleDocuments, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
      <Button Grid.Column="3" Margin="0,5,10,5" Style="{StaticResource ImportControlButtonStyle}" Command="{Binding ImportAllDocumentCommand}" Content="{mex:Localized IMPORT_TEXT_IMPORT_ALL_title}" Visibility="{Binding IsMultipleDocuments, Converter={StaticResource ValueToVisibilityConverter}}" />
    </Grid>
  </Grid>
</windowing:ChromedWindow>