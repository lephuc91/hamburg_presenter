<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Import.ImportProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="importProgress" MaxWidth="460" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanClose="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:import="clr-namespace:ProPresenter.UI.Import;assembly=ProPresenter.UI" Title="{mex:Localized IMPORT_PROGRESS_title}" Resources="{commonConverters:FormattedLocalizedStringConverter Key=FormattedLocalizedStringConverter}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="Importing" Binding="{Binding ImportProcess.CurrentRequest.Status, ElementName=importProgress}">
              <Setter Property="Text" Value="{Binding ImportProcess.CurrentRequest.Name, ElementName=importProgress, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=IMPORT_PROGRESS_IMPORTING_label}" />
            </DataTrigger>
            <DataTrigger Value="Extracting" Binding="{Binding ImportProcess.CurrentRequest.Status, ElementName=importProgress}">
              <Setter Property="Text" Value="{Binding ImportProcess.CurrentRequest.Name, ElementName=importProgress, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=IMPORT_PROGRESS_IMPORTING_label}" />
            </DataTrigger>
            <DataTrigger Value="Converting" Binding="{Binding ImportProcess.CurrentRequest.Status, ElementName=importProgress}">
              <Setter Property="Text" Value="{Binding ImportProcess.CurrentRequest.Name, ElementName=importProgress, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=IMPORT_PROGRESS_CONVERTING_label}" />
            </DataTrigger>
            <DataTrigger Value="Migrating" Binding="{Binding ImportProcess.CurrentRequest.Status, ElementName=importProgress}">
              <Setter Property="Text" Value="{Binding ImportProcess.CurrentRequest.Name, ElementName=importProgress, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=IMPORT_PROGRESS_MIGRATING_label}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <ProgressBar Name="importProgressBar" Grid.Row="1" Height="22" Maximum="1" Minimum="0" Value="{Binding ImportProcess.CompletedPercentage, ElementName=importProgress}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ProgressBar}}" TargetType="{x:Type ProgressBar}">
          <Setter Property="ProgressBar.IsIndeterminate" Value="False" />
          <Style.Triggers>
            <DataTrigger Value="Extracting" Binding="{Binding ImportProcess.CurrentRequest.Status, ElementName=importProgress}">
              <Setter Property="ProgressBar.IsIndeterminate" Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ProgressBar>
    <Button Grid.Row="2" Height="22" MinWidth="80" Margin="0,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" Click="Cancel_Click" />
  </Grid>
</windowing:ChromedWindow>