<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Import.BreakModeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.Import" x:Name="self">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ComboBox IsEditable="True" TextSearch.TextPath="Text" Text="{Binding CustomDelimiter, ElementName=self, Mode=TwoWay}">
    <ItemsControl.ItemsSource>
      <CompositeCollection>
        <TextBlock Text="{Binding Source={x:Static local:BreakModeControl.BlankLine}}" />
        <TextBlock Text="{Binding Source={x:Static local:BreakModeControl.NewLine}}" />
      </CompositeCollection>
    </ItemsControl.ItemsSource>
  </ComboBox>
</UserControl>