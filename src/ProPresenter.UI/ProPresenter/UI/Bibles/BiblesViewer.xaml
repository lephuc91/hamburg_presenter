<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Bibles.BiblesViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonComponents="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:cues="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:floatingHeader="clr-namespace:ProPresenter.UI.FloatingHeaders" xmlns:local="clr-namespace:ProPresenter.UI.Bibles" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:presentationUI="clr-namespace:ProPresenter.UI.PresentationView" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:thumbnails="clr-namespace:ProPresenter.UI.Thumbnails" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" uiUtility:UIElementHelper.Palette="{Binding PRESENTATION_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource Self}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="dataContext" Data="{Binding}" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
      <local:BiblesViewerHeader ReferenceText="{Binding ReferenceText, Mode=TwoWay}" />
    </Border>
    <ScrollViewer Grid.Row="1" MaxHeight="500" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding LoadedBibles.Count, Converter={StaticResource CountToVisibilityConverter}}">
      <ItemsControl Background="{Binding SUBHEADER, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding SUBHEADERCONTENT, Source={x:Static theming:AppTheme.Active}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <CollectionViewSource x:Key="translations" Source="{Binding Translations}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <ContentPresenter Content="{Binding Data.Translations.PrimaryTranslation, Source={StaticResource dataContext}}" />
            <CollectionContainer Collection="{Binding Source={StaticResource translations}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ContentPresenter}">
            <Setter Property="ContentTemplate">
              <Setter.Value>
                <DataTemplate>
                  <local:BibleTranslationTemplate AddBibleTranslationCommand="{Binding Data.AddBibleTranslationCommand, Source={StaticResource dataContext}}" Foreground="{Binding SUBHEADERCONTENT, Source={x:Static theming:AppTheme.Active}}" LoadedBibles="{Binding Data.LoadedBibles, Source={StaticResource dataContext}}" ReferenceType="{Binding Data.ReferenceType, Source={StaticResource dataContext}}" RemoveBibleTranslationCommand="{Binding Data.RemoveBibleTranslationCommand, Source={StaticResource dataContext}}" SelectIncludeReferenceWithVerseCommand="{Binding Data.SelectIncludeReferenceWithVerseCommand, Source={StaticResource dataContext}}" SelectReferenceElementCommand="{Binding Data.SelectReferenceElementCommand, Source={StaticResource dataContext}}" SelectVerseElementCommand="{Binding Data.SelectVerseElementCommand, Source={StaticResource dataContext}}" TemplateSlide="{Binding Data.WorkingPresentation.ActiveTemplate, Source={StaticResource dataContext}}" Translations="{Binding Data.Translations, Source={StaticResource dataContext}}" />
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>
    </ScrollViewer>
    <Grid Row="2" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
      <floatingHeader:BiblesViewerFloatingHeaderControl ActivePlaylistItem="{Binding BibleDocumentCue}" ActiveSlide="{Binding ActiveSlide}" CanScrollToSlide="{Binding ScrollToSlide}" Items="{Binding Items}" SlidesChanged="{Binding ScrollToTop}" ViewSettings="{Binding BiblePresentationViewSettings}">
        <commonControls:FloatingHeaderControl.ItemTemplates>
          <commonComponents:TaggedDataTemplate Tag="{x:Static cues:CueType.Document}">
            <thumbnails:CustomPresentationThumbnailPanel AllowDrag="False" ActiveItem="{Binding Data.ActiveSlide, Source={StaticResource dataContext}}" ActiveItems="{Binding Data.ActiveSlides, Source={StaticResource dataContext}}" CopyCommand="{Binding Data.CopyCommand, Source={StaticResource dataContext}}" ItemActivatedCommand="{Binding Data.TriggerSlideCommand, Source={StaticResource dataContext}}" Items="{Binding Data.WorkingPresentation.DefaultArrangement.ArrangedCues, Source={StaticResource dataContext}}" RowCapacity="{Binding Data.PanelRowCapacity, Source={StaticResource dataContext}}" SelectedItems="{Binding Data.SelectedItems, Source={StaticResource dataContext}}" ViewSettings="{Binding Data.BiblePresentationViewSettings, Source={StaticResource dataContext}}">
              <thumbnails:UniformViewPanel.ThumbnailContextMenu>
                <ContextMenu>
                  <MenuItem Command="{x:Static commands:CommonApplicationCommands.Copy}" />
                </ContextMenu>
              </thumbnails:UniformViewPanel.ThumbnailContextMenu>
            </thumbnails:CustomPresentationThumbnailPanel>
          </commonComponents:TaggedDataTemplate>
        </commonControls:FloatingHeaderControl.ItemTemplates>
      </floatingHeader:BiblesViewerFloatingHeaderControl>
    </Grid>
    <Grid Row="3" uiUtility:UIElementHelper.Palette="{Binding PRESENTATION_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Column="0">
        <Button Name="SaveCopyDocumentButton" Grid.Column="0" Height="22" Margin="8,0,0,0" Padding="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Stretch" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="{mex:Localized BIBLE_FOOTER_SAVE_AS_label}" />
            <Border Grid.Column="1" Width="16" Margin="4,0,0,0" HorizontalAlignment="Right">
              <commonControls:PathControl Name="Arrow" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" PathType="DownArrow" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            </Border>
          </StackPanel>
          <FrameworkElement.ContextMenu>
            <ContextMenu Placement="Bottom">
              <MenuItem Command="{Binding SaveAsDocumentCommand}" Header="{mex:Localized BIBLE_FOOTER_SAVE_AS_MENU_PRESENTATION_title}" />
              <MenuItem Command="{Binding CopyToCurrentDocumentCommand}" Header="{mex:Localized BIBLE_FOOTER_SAVE_AS_MENU_COPY_TO_PRESENTATION_title}" />
              <MenuItem Header="{mex:Localized BIBLE_FOOTER_SAVE_AS_MENU_PLAYLIST_title}">
                <FrameworkElement.Resources>
                  <ui:SharedResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                      <ui:SharedResourceDictionary Source="../LibraryPlaylistResources.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                    <CompositeCollection x:Key="PlaylistCollection">
                      <TextBlock Margin="0" Style="{StaticResource HeaderStyle}" Text="{mex:Localized PLAYLIST_GLOBAL_PLAYLIST_title}" />
                      <CollectionContainer Collection="{Binding Data.Playlists, Source={StaticResource dataContext}, Converter={StaticResource FlattenPlaylistsConverter}}" />
                    </CompositeCollection>
                  </ui:SharedResourceDictionary>
                </FrameworkElement.Resources>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="ItemsSource" Value="{StaticResource PlaylistCollection}" />
                  </Style>
                </FrameworkElement.Style>
                <ItemsControl.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="MenuItem.Command" Value="{Binding Data.SaveToSelectedPlaylistCommand, Source={StaticResource dataContext}}" />
                    <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                    <Style.Triggers>
                      <DataTrigger Value="Group">
                        <DataTrigger.Binding>
                          <PriorityBinding>
                            <Binding Path="Type" />
                          </PriorityBinding>
                        </DataTrigger.Binding>
                        <Setter Property="IsEnabled" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </MenuItem>
            </ContextMenu>
          </FrameworkElement.ContextMenu>
        </Button>
      </Grid>
      <StackPanel Grid.Column="1" Margin="12,0" Orientation="Horizontal">
        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" />
      </StackPanel>
      <presentationUI:ViewerStatusBar Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsListSettingsAvailable="True" IsListViewAvailable="True" IsThumbnailSettingsAvailable="True" IsThumbnailViewAvailable="True" IsViewOptionPopupAvailable="True" TransitionDisplayMode="Foreground" RowCapacity="{Binding PanelRowCapacity}" SelectedTransition="{Binding SelectedTransition, Mode=TwoWay}" SelectedViewSettings="{Binding BiblePresentationViewSettings}">
        <local:VerseNavigationControl GoToNextVerseCommand="{Binding GoToNextVerseCommand}" GoToPreviousVerseCommand="{Binding GoToPreviousVerseCommand}" />
      </presentationUI:ViewerStatusBar>
    </Grid>
  </Grid>
</UserControl>