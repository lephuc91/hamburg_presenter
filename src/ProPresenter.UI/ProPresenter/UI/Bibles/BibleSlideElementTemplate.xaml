<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Bibles.BibleSlideElementTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="bibleSlideElementTemplate" xmlns:bibles="clr-namespace:ProPresenter.UI.Bibles;assembly=ProPresenter.UI">
  <FrameworkElement.Style>
    <Style TargetType="{x:Type UserControl}">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="UIElement.Opacity" Value="0.5" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image Name="PreviewImage" Grid.Column="0" Width="118" Height="67" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, ElementName=bibleSlideElementTemplate}" Text="{Binding Name}" />
  </Grid>
</UserControl>