<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Bibles.LoadedBibleSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:bible="clr-namespace:ProPresenter.DO.Bibles;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:localConverters="clr-namespace:ProPresenter.UI.Bibles.Converters" xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="loadedBibleSelectorSelf" xmlns:bibles="clr-namespace:ProPresenter.UI.Bibles">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <CollectionViewSource x:Key="LoadedBibleItemsSource" Source="{Binding LoadedBibles, ElementName=loadedBibleSelectorSelf}">
        <CollectionViewSource.SortDescriptions>
          <scm:SortDescription scm:SortDescription.Direction="Ascending" scm:SortDescription.PropertyName="Name" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
      <localConverters:AbbreviationToBibleNameConverter x:Key="AbbreviationToBibleNameConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Button Height="22" HorizontalContentAlignment="Stretch" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
    <ContentControl.Content>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Row="0">
          <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource AbbreviationToBibleNameConverter}">
                <Binding ElementName="loadedBibleSelectorSelf" Path="CurrentBibleTranslation.Abbreviation" />
                <Binding ElementName="loadedBibleSelectorSelf" Path="LoadedBibles" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Grid>
        <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, ElementName=loadedBibleSelectorSelf}" Stroke="{Binding Foreground, ElementName=loadedBibleSelectorSelf}" />
      </Grid>
    </ContentControl.Content>
    <FrameworkElement.ContextMenu>
      <ContextMenu Placement="Bottom" ItemsSource="{Binding Source={StaticResource LoadedBibleItemsSource}}" Opened="ContextMenu_Opened">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="{DataTemplateKey {x:Type bible:BibleBase}}" DataType="{x:Type bible:BibleBase}">
              <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
            </DataTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <EventSetter Event="Click" Handler="MenuItem_Click" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
    </FrameworkElement.ContextMenu>
  </Button>
</UserControl>