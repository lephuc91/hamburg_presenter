<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:propresenterUI="clr-namespace:ProPresenter.UI" xmlns:settingsVM="clr-namespace:ProPresenter.UI.ViewModels.Settings" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="settingsWindow" Width="740" Height="680" MinWidth="740" MinHeight="680" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.SendKeyEventsToMainWindow="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanClose="True" CanMaximize="False" CanMinimize="True" RenderOptions.BitmapScalingMode="Fant" ResizeDirection="Vertical" ResizeMode="CanResizeWithGrip" ShowTitle="False" Style="{StaticResource {x:Type windowing:ChromedWindow}}" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" Title="{mex:Localized SETTINGS_WINDOW_WINDOWS_title}" uiUtility:WindowHelper.HideOnClose="{Binding HideOnClose, RelativeSource={RelativeSource Self}}" Background="{Binding CONTAINER, Source={x:Static theming:AppTheme.Active}}" ControlButtonPalette="{Binding CUEINSPECTOR_CONTROLBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" DataContext="{di:DIMarkup {x:Type settingsVM:ISettingsVM}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../SourceDetailListResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ui:InterfaceDataTemplateSelector x:Key="PageTemplateSelector">
