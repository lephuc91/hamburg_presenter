  </windowing:ChromedWindow.LeftContent>
  <windowing:ChromedWindow.RightContent>
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{Binding CONTAINER, Source={x:Static theming:AppTheme.Active}}" />
  </windowing:ChromedWindow.RightContent>
</windowing:ChromedWindow>