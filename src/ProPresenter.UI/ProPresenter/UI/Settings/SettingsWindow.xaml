          <ResourceDictionary Source="PageTemplates/SettingsPageTemplates.xaml" />
        </ui:InterfaceDataTemplateSelector.TemplateDictionary>
      </ui:InterfaceDataTemplateSelector>
      <ui:InterfaceDataTemplateSelector x:Key="ListItemTeplateSelector">
        <ui:InterfaceDataTemplateSelector.TemplateDictionary>
          <ResourceDictionary Source="ListItemTemplates/SettingsItemTemplates.xaml" />
        </ui:InterfaceDataTemplateSelector.TemplateDictionary>
      </ui:InterfaceDataTemplateSelector>
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
