      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <local:SettingsListBox Grid.Column="0" HorizontalAlignment="Stretch" BorderThickness="0" DeselectOnLostFocus="True" ItemContainerStyle="{StaticResource SettingsListBoxItemContainerStyle}" ItemTemplateSelector="{StaticResource ListItemTeplateSelector}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" Style="{StaticResource {x:Type ListBox}}" uiUtility:UIElementHelper.Palette="{Binding DETAILLIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" ActiveItem="{Binding ActiveItem}" ItemsSource="{Binding Items}" SelectedListItem="{Binding SelectedItem, Mode=TwoWay}" Visibility="{Binding SearchVM.IsSearching, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
    <Grid Column="0" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding SearchVM.IsSearching, Converter={StaticResource ValueToVisibilityConverter}}">
      <local:SettingsSearchResultListBox HorizontalAlignment="Stretch" BorderThickness="0" DeselectOnLostFocus="True" ItemContainerStyle="{StaticResource SettingsListBoxItemContainerStyle}" ItemTemplateSelector="{StaticResource ListItemTeplateSelector}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" Style="{StaticResource {x:Type ListBox}}" uiUtility:UIElementHelper.Palette="{Binding DETAILLIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" ActiveItem="{Binding ActiveItem, Mode=TwoWay}" DataContext="{Binding SearchVM}" ItemsSource="{Binding SearchResults}" SelectedListItem="{Binding SelectedItem, Mode=TwoWay}" Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibilityConverter}}" />
      <TextBlock Margin="0,50,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" TextTrimming="None" TextWrapping="WrapWithOverflow" Text="{Binding SearchVM.SearchText, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=SETTINGS_SEARCH_RESULTS_EMPTY_message}" Visibility="{Binding SearchVM.SearchResults.Count, Converter={StaticResource InvertedCountToVisibilityConverter}}" />
    </Grid>
    <commonControls:NonLeakingTemplateSelectingContentControl Grid.Column="1" ContentTemplateSelector="{StaticResource PageTemplateSelector}" Content="{Binding ActivePage}" />
  </Grid>
  <windowing:ChromedWindow.LeftContent>
