      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <commonControls:SearchBox Height="22" Margin="5,10,5,10" HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="{mex:Localized SETTINGS_SEARCH_PLACEHOLDER_title}" Text="{Binding SearchVM.SearchText, Mode=TwoWay}" />
      <Border Grid.Column="1" Background="{Binding CONTAINER, Source={x:Static theming:AppTheme.Active}}">
        <local:SettingsHeaderNavigation Margin="0,15,0,0" DataContext="{Binding NavigationVM}" />
