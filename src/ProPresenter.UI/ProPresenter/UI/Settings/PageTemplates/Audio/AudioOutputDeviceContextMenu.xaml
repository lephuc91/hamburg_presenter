<?xml version="1.0" encoding="utf-8"?>
<ContextMenu x:Class="ProPresenter.UI.Settings.PageTemplates.Audio.AudioOutputDeviceContextMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:devices="clr-namespace:Pro.ssAPI.Devices;assembly=Pro.ssAPI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="audioOutputDeviceContextMenu" Style="{StaticResource {x:Type ContextMenu}}" UsesItemContainerTemplate="True" xmlns:audio="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Audio;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="audioOutputDeviceContextMenuProxy" Data="{Binding ElementName=audioOutputDeviceContextMenu}" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <Style x:Key="DeviceTypeHeaderStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <CollectionViewSource x:Key="OtherAudioDevices" Source="{Binding Data.AudioOutputDevices, Source={StaticResource audioOutputDeviceContextMenuProxy}}" Filter="OnFilterOtherAudioDevice" />
      <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type devices:AudioOutputDevice}}">
        <MenuItem uiUtility:CommandHelper.CommandParameter="{Binding}" Command="{Binding Data.SelectDeviceCommand, Source={StaticResource audioOutputDeviceContextMenuProxy}}">
          <HeaderedItemsControl.Header>
            <PriorityBinding>
              <Binding Path="Name" />
            </PriorityBinding>
          </HeaderedItemsControl.Header>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
              <Setter Property="MenuItem.IsChecked" Value="False" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="False" Binding="{Binding Data.DeviceDisabled, Source={StaticResource audioOutputDeviceContextMenuProxy}}" />
                    <Condition Value="True">
                      <Condition.Binding>
                        <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                          <Binding />
                          <Binding Path="Data.AudioDestination.AudioDevice" Source="{StaticResource audioOutputDeviceContextMenuProxy}" />
                        </MultiBinding>
                      </Condition.Binding>
                    </Condition>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="MenuItem.IsChecked" Value="True" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </MenuItem>
      </ItemContainerTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ItemsControl.ItemsSource>
    <CompositeCollection>
      <MenuItem Command="{Binding Data.SelectNoDeviceCommand, Source={StaticResource audioOutputDeviceContextMenuProxy}}" Header="{Binding Data.NoDeviceText, Source={StaticResource audioOutputDeviceContextMenuProxy}}" IsChecked="{Binding Data.IsNoDevice, Source={StaticResource audioOutputDeviceContextMenuProxy}, Mode=OneWay}" />
      <Separator />
      <CollectionContainer Collection="{Binding Source={StaticResource OtherAudioDevices}}" />
      <MenuItem IsEnabled="False" Visibility="{Binding Data.ASIODevices.Count, Source={StaticResource audioOutputDeviceContextMenuProxy}, Converter={StaticResource CountToVisibilityConverter}}">
        <HeaderedItemsControl.Header>
          <TextBlock Style="{StaticResource DeviceTypeHeaderStyle}" Text="{mex:Localized SETTINGS_AUDIO_ASIO_HEADER_title}" />
        </HeaderedItemsControl.Header>
      </MenuItem>
      <CollectionContainer Collection="{Binding Data.ASIODevices, Source={StaticResource audioOutputDeviceContextMenuProxy}}" />
      <MenuItem IsEnabled="False" Visibility="{Binding Data.WaveOutDevices.Count, Source={StaticResource audioOutputDeviceContextMenuProxy}, Converter={StaticResource CountToVisibilityConverter}}">
        <HeaderedItemsControl.Header>
          <TextBlock Style="{StaticResource DeviceTypeHeaderStyle}" Text="{mex:Localized SETTINGS_AUDIO_WAVE_OUT_HEADER_title}" />
        </HeaderedItemsControl.Header>
      </MenuItem>
      <CollectionContainer Collection="{Binding Data.WaveOutDevices, Source={StaticResource audioOutputDeviceContextMenuProxy}}" />
    </CompositeCollection>
  </ItemsControl.ItemsSource>
</ContextMenu>