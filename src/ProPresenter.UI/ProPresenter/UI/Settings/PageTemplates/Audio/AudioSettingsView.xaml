<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Audio.AudioSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:audio="clr-namespace:Pro.DO.Audio;assembly=Pro.DO" xmlns:audioControls="clr-namespace:Pro.UI.Controls.Audio;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Audio" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="audioSettingsVMProxy" Data="{Binding}" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <commonConverters:TimeSliceToTimeFormatConverter x:Key="TimeSliceToTimeFormatConverter" ConversionUnit="TotalMilliSeconds" />
      <Style x:Key="{x:Type commonControls:DoubleUpDown}" BasedOn="{StaticResource {x:Type commonControls:DoubleUpDown}}" TargetType="{x:Type commonControls:DoubleUpDown}">
        <Setter Property="UpDownBase.ShowButtonSpinner" Value="False" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <commonControls:GroupedControl Grid.Row="0">
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_AUDIO_CHANNEL_COUNT_title}" />
          <commonControls:IntegerUpDown Grid.Column="1" Width="60" HorizontalAlignment="Right" Maximum="16" Minimum="1" Value="{Binding BusCount}" />
        </Grid>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="1" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_AUDIO_INSPECTOR_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="2">
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_AUDIO_INSPECTOR_DEVICE_title}" />
          <commonControls:BorderlessDropDownButton Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Right">
            <commonControls:BorderlessDropDownButton.CustomContent>
              <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right" Text="{Binding MonitorDestinationDisplayName}" />
            </commonControls:BorderlessDropDownButton.CustomContent>
            <commonControls:BorderlessDropDownButton.CustomContextMenu>
              <local:AudioOutputDeviceContextMenu ASIODevices="{Binding ASIODevices}" AudioDestination="{Binding MonitorDestination}" AudioOutputDevices="{Binding AudioOutputDevices}" IsNoDevice="{Binding MonitorOnMains}" NoDeviceText="{mex:Localized SETTINGS_AUDIO_LISTEN_ON_MAIN_title}" SelectDeviceCommand="{Binding SelectInspectorDeviceCommand}" SelectNoDeviceCommand="{Binding SelectMonitorOnMainsCommand}" WaveOutDevices="{Binding WaveOutDevices}" />
            </commonControls:BorderlessDropDownButton.CustomContextMenu>
          </commonControls:BorderlessDropDownButton>
          <Button Grid.Row="1" Grid.Column="1" Height="22" Margin="0,5,0,0" HorizontalAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Content="{mex:Localized SETTINGS_AUDIO_ROUTING_title}" IsEnabled="{Binding MonitorOnMains, Converter={StaticResource InvertedBooleanConverter}}">
            <FrameworkElement.ContextMenu>
              <ContextMenu Placement="Bottom">
                <Control.Template>
                  <ControlTemplate>
                    <audioControls:BusToDeviceChannelControl BorderThickness="1" ShowMuteAndSoloButtons="True" ShowOutputSoloControls="False" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" AudioMap="{Binding Data.MonitorDestination.Routing.ChannelMap, Source={StaticResource audioSettingsVMProxy}}" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" ColumnHeaderText="{mex:Localized AUDIO_PREFERENCES_ROUTING_DEVICE_CHANNEL_label}" RowHeaderText="{mex:Localized AUDIO_PREFERENCES_ROUTING_PROPRESENTER_CHANNEL_label}" TextElement.Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" />
                  </ControlTemplate>
                </Control.Template>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}" IsEnabled="{Binding MonitorOnMains, Converter={StaticResource InvertedBooleanConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_AUDIO_INSPECTOR_LEVEL_title}" />
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <commonControls:FillSlider Width="200" VerticalAlignment="Center" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding MonitorDestination.Routing.MasterChannel.Level, Mode=TwoWay}" />
            <commonControls:DoubleUpDown Grid.Column="1" Width="60" Height="22" VerticalAlignment="Center" DefaultValue="0" FormatString="{}{0:N0}dB" Increment="1" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding MonitorDestination.Routing.MasterChannel.Level, Mode=TwoWay}" />
          </StackPanel>
        </Grid>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="3" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_AUDIO_MAIN_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="4">
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_AUDIO_MAIN_DEVICE_title}" />
          <commonControls:BorderlessDropDownButton Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Right">
            <commonControls:BorderlessDropDownButton.CustomContent>
              <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Text" Value="{Binding MainDestination.Name}" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Value="False" Binding="{Binding DisableMainOutputDevice}" />
                          <Condition Value="false" Binding="{Binding MainDestination.IsConnected}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Text" Value="{Binding MainDestination.Name, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=SETTINGS_AUDIO_DISCONNECTED_DEVICE_MENU_title}" />
                      </MultiDataTrigger>
                      <DataTrigger Value="True" Binding="{Binding DisableMainOutputDevice}">
                        <Setter Property="Text" Value="{mex:Localized SETTINGS_AUDIO_MAIN_OUTPUT_NO_DEVICE_ITEM_title}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </commonControls:BorderlessDropDownButton.CustomContent>
            <commonControls:BorderlessDropDownButton.CustomContextMenu>
              <local:AudioOutputDeviceContextMenu ASIODevices="{Binding ASIODevices}" AudioDestination="{Binding MainDestination}" AudioOutputDevices="{Binding AudioOutputDevices}" DeviceDisabled="{Binding DisableMainOutputDevice}" IsNoDevice="{Binding DisableMainOutputDevice}" NoDeviceText="{mex:Localized SETTINGS_AUDIO_MAIN_OUTPUT_NO_DEVICE_ITEM_title}" SelectDeviceCommand="{Binding SelectMainDeviceCommand}" SelectNoDeviceCommand="{Binding SelectNoMainDeviceCommand}" WaveOutDevices="{Binding WaveOutDevices}" />
            </commonControls:BorderlessDropDownButton.CustomContextMenu>
          </commonControls:BorderlessDropDownButton>
          <Button Grid.Row="1" Grid.Column="1" Height="22" Margin="0,5,0,0" HorizontalAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Content="{mex:Localized SETTINGS_AUDIO_ROUTING_title}" IsEnabled="{Binding DisableMainOutputDevice, Converter={StaticResource InvertedBooleanConverter}}">
            <FrameworkElement.ContextMenu>
              <ContextMenu Placement="Bottom" Closed="ContextMenu_OnClosed">
                <Control.Template>
                  <ControlTemplate>
                    <audioControls:BusToDeviceChannelControl BorderThickness="1" ShowMuteAndSoloButtons="True" ShowOutputSoloControls="False" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" AudioMap="{Binding Data.MainDestination.Routing.ChannelMap, Source={StaticResource audioSettingsVMProxy}}" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" ColumnHeaderText="{mex:Localized AUDIO_PREFERENCES_ROUTING_DEVICE_CHANNEL_label}" RowHeaderText="{mex:Localized AUDIO_PREFERENCES_ROUTING_PROPRESENTER_CHANNEL_label}" TextElement.Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" />
                  </ControlTemplate>
                </Control.Template>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}" IsEnabled="{Binding DisableMainOutputDevice, Converter={StaticResource InvertedBooleanConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_AUDIO_MAIN_LEVEL_title}" />
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <commonControls:FillSlider Width="200" VerticalAlignment="Center" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding MainDestination.Routing.MasterChannel.Level, Mode=TwoWay}" />
            <commonControls:DoubleUpDown Grid.Column="1" Width="60" Height="22" VerticalAlignment="Center" DefaultValue="0" FormatString="{}{0:N0}dB" Increment="1" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding MainDestination.Routing.MasterChannel.Level, Mode=TwoWay}" />
          </StackPanel>
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}" IsEnabled="{Binding DisableMainOutputDevice, Converter={StaticResource InvertedBooleanConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_AUDIO_MAIN_DELAY_title}" />
          <commonControls:IntegerUpDown Grid.Column="1" Width="60" Height="22" HorizontalAlignment="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FormatString="{}{0}ms" Increment="1" Maximum="1500" Minimum="0" Value="{Binding MainDelay, Converter={StaticResource TimeSliceToTimeFormatConverter}}" />
        </Grid>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="5" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_AUDIO_SDI_NDI_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="6">
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_AUDIO_SDI_NDI_ENABLE_title}" />
          <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding SDINDIEnabled, Mode=TwoWay}" />
          <Button Grid.Row="1" Grid.Column="1" Height="22" Margin="0,5,0,0" HorizontalAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Content="{mex:Localized SETTINGS_AUDIO_ROUTING_title}" IsEnabled="{Binding SDINDIEnabled}">
            <FrameworkElement.ContextMenu>
              <ContextMenu Placement="Bottom">
                <Control.Template>
                  <ControlTemplate>
                    <audioControls:BusToDeviceChannelControl BorderThickness="1" ShowMuteAndSoloButtons="True" ShowOutputSoloControls="False" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" AudioMap="{Binding Data.SdiNdiDestination.Routing.ChannelMap, Source={StaticResource audioSettingsVMProxy}}" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" ColumnHeaderText="{mex:Localized AUDIO_PREFERENCES_ROUTING_DEVICE_CHANNEL_label}" RowHeaderText="{mex:Localized AUDIO_PREFERENCES_ROUTING_PROPRESENTER_CHANNEL_label}" TextElement.Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" />
                  </ControlTemplate>
                </Control.Template>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}" IsEnabled="{Binding SDINDIEnabled}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_AUDIO_SDI_NDI_LEVEL_title}" />
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <commonControls:FillSlider Width="200" VerticalAlignment="Center" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding SdiNdiDestination.Routing.MasterChannel.Level, Mode=TwoWay}" />
            <commonControls:DoubleUpDown Grid.Column="1" Width="60" Height="22" VerticalAlignment="Center" DefaultValue="0" FormatString="{}{0:N0}dB" Increment="1" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding SdiNdiDestination.Routing.MasterChannel.Level, Mode=TwoWay}" />
          </StackPanel>
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource audioSettingsVMProxy}}" IsEnabled="{Binding SDINDIEnabled}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_AUDIO_SDI_NDI_DELAY_title}" />
          <commonControls:IntegerUpDown Grid.Column="1" Width="60" Height="22" HorizontalAlignment="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FormatString="{}{0}ms" Increment="1" Maximum="1500" Minimum="0" Value="{Binding SDINDIDelay, Converter={StaticResource TimeSliceToTimeFormatConverter}}" />
        </Grid>
      </commonControls:GroupedControl>
      <commonControls:HelpButton Grid.Row="7" Margin="0,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding HelpCommand}" />
    </Grid>
  </ScrollViewer>
</UserControl>