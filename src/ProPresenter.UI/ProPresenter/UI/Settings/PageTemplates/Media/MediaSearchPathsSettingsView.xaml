<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Media.MediaSearchPathsSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Media" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="mediaSearchPaths">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="mediaSearchPathsVMProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <commonControls:GroupedControl>
      <Grid DataContext="{Binding Data, Source={StaticResource mediaSearchPathsVMProxy}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_MEDIA_SEARCH_PATHS_description}" />
        <Border Grid.Row="1" BorderThickness="1,1,1,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
          <local:MediaSearchPathsListBox Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" ItemsSource="{Binding SearchRoots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <local:MediaSearchPathItemTemplate />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </local:MediaSearchPathsListBox>
        </Border>
      </Grid>
    </commonControls:GroupedControl>
    <commonControls:HelpButton Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding HelpCommand}" />
  </Grid>
</UserControl>