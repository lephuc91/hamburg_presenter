<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Network.NetworkSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="networkSettingsView" xmlns:network="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Network">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="networkSettingsViewVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <commonControls:GroupedControl Grid.Row="0">
        <Grid DataContext="{Binding Data, Source={StaticResource networkSettingsViewVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_NETWORK_ENABLE_NETWORK_title}" />
          <commonControls:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNetwork, Mode=TwoWay}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource networkSettingsViewVMProxy}}" IsEnabled="{Binding EnableNetwork}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_NETWORK_NETWORK_NAME_title}" />
          <TextBox Grid.Column="1" Width="125" Height="22" HorizontalAlignment="Right" VerticalContentAlignment="Center" TextWrapping="WrapWithOverflow" Text="{Binding NetworkName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource networkSettingsViewVMProxy}}" IsEnabled="{Binding EnableNetwork}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_NETWORK_IP_ADDRESS_title}" />
          <TextBlock Grid.Column="1" HorizontalAlignment="Right" IsEnabled="False" Text="{Binding IpAddress}" Visibility="{Binding EnableNetwork, Converter={StaticResource ValueToVisibilityConverter}}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource networkSettingsViewVMProxy}}" IsEnabled="{Binding EnableNetwork}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_NETWORK_PORT_title}" />
          <commonControls:IntegerUpDown Grid.Column="1" Width="75" Height="22" Margin="0,0,7,0" HorizontalAlignment="Left" VerticalContentAlignment="Center" AllowSpin="False" Maximum="65535" Minimum="0" ShowButtonSpinner="False" TextAlignment="Left" Watermark="{Binding AutoPort}" Value="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      </commonControls:GroupedControl>
      <commonControls:GroupedControl Grid.Row="1" Margin="0,15,0,0" HorizontalContentAlignment="Stretch">
        <local:ChildPageButton ChildPageVM="{Binding Data.NetworkLinkVM, Source={StaticResource networkSettingsViewVMProxy}}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
              <Image Width="24" Source="{StaticResource {x:Static themes:Icons.SettingsNetworkLink}}" Stretch="Uniform" />
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_NETWORK_NETWORK_LINK_BUTTON_title}" />
            <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Text" Value="{mex:Localized SETTINGS_NETWORK_NETWORK_LINK_DISABLED_title}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Data.NetworkLinkVM.Enabled, Source={StaticResource networkSettingsViewVMProxy}}">
                      <Setter Property="Text" Value="{mex:Localized SETTINGS_NETWORK_NETWORK_LINK_ENABLED_title}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
        </local:ChildPageButton>
      </commonControls:GroupedControl>
      <StackPanel Grid.Row="2" Margin="0,25,0,8" HorizontalAlignment="Left" Orientation="Horizontal">
        <TextBlock HorizontalAlignment="Left" FontWeight="Bold" Text="{mex:Localized SETTINGS_NETWORK_PROREMOTE_V2_HEADER_title}" />
        <commonControls:HelpButton Margin="5,0,0,0" HorizontalAlignment="Left" HelpCommand="{Binding ProremoteHelpCommand}" />
      </StackPanel>
      <commonControls:GroupedControl Grid.Row="3" HorizontalAlignment="Stretch" IsEnabled="{Binding EnableNetwork}">
        <Grid DataContext="{Binding Data, Source={StaticResource networkSettingsViewVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_NETWORK_ENABLE_title}" />
          <TextBlock Grid.Column="1" Text="{mex:Localized SETTINGS_NETWORK_PASSWORD_title}" />
          <commonControls:PlaceholderTextBox Grid.Column="2" Width="150" Height="22" Margin="8,0,8,0" VerticalContentAlignment="Center" IsEnabled="{Binding EnableProRemoteV2}" PlaceholderText="{mex:Localized SETTINGS_NETWORK_PROREMOTE_V2_PASSWORD_REQUIRED_title}" SelectAndFocus="{Binding ProRemoteV2PasswordNeedFocus}" Text="{Binding ProRemoteV2Password, UpdateSourceTrigger=PropertyChanged}" />
          <commonControls:ToggleSwitch Grid.Column="3" IsChecked="{Binding EnableProRemoteV2, Mode=TwoWay}" />
        </Grid>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="6" Margin="0,25,0,8" HorizontalAlignment="Left" FontWeight="Bold" Text="{mex:Localized SETTINGS_NETWORK_STAGE_APP_HEADER_title}" />
      <commonControls:GroupedControl Grid.Row="7" HorizontalAlignment="Stretch" IsEnabled="{Binding EnableNetwork}">
        <Grid DataContext="{Binding Data, Source={StaticResource networkSettingsViewVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_NETWORK_ENABLE_title}" />
          <TextBlock Grid.Column="1" Text="{mex:Localized SETTINGS_NETWORK_STAGE_APP_PASSWORD_title}" />
          <commonControls:PlaceholderTextBox Grid.Column="2" Width="150" Height="22" Margin="8,0,0,0" VerticalContentAlignment="Center" IsEnabled="{Binding EnableStageApp}" PlaceholderText="{mex:Localized SETTINGS_NETWORK_STAGE_APP_PASSWORD_OPTIONAL_title}" Text="{Binding StageAppPassword, UpdateSourceTrigger=PropertyChanged}" />
          <commonControls:ToggleSwitch Grid.Column="3" Margin="8,0,0,0" IsChecked="{Binding EnableStageApp, Mode=TwoWay}" />
        </Grid>
      </commonControls:GroupedControl>
      <StackPanel Grid.Row="8" Margin="0,25,0,8" HorizontalAlignment="Left" Orientation="Horizontal">
        <TextBlock HorizontalAlignment="Left" FontWeight="Bold" Text="{mex:Localized SETTINGS_NETWORK_TCP_HEADER_title}" />
        <commonControls:HelpButton Margin="5,0,0,0" HorizontalAlignment="Left" HelpCommand="{Binding TcpIpHelpCommand}" />
      </StackPanel>
      <commonControls:GroupedControl Grid.Row="9" HorizontalAlignment="Stretch" IsEnabled="{Binding EnableNetwork}">
        <Grid DataContext="{Binding Data, Source={StaticResource networkSettingsViewVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_NETWORK_ENABLE_title}" />
          <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="{mex:Localized SETTINGS_NETWORK_TCP_CONNECTION_PORT_title}" />
          <commonControls:IntegerUpDown Grid.Column="2" Width="75" Height="22" Margin="0,0,7,0" HorizontalAlignment="Left" VerticalContentAlignment="Center" AllowSpin="False" Maximum="65535" Minimum="0" ShowButtonSpinner="False" TextAlignment="Left" IsEnabled="{Binding EnableTcpConnection}" Watermark="{Binding TcpConnectionAutoPort}" Value="{Binding TcpConnectionPort, UpdateSourceTrigger=PropertyChanged}" />
          <commonControls:ToggleSwitch Grid.Column="3" Margin="8,0,0,0" IsChecked="{Binding EnableTcpConnection, Mode=TwoWay}" />
        </Grid>
      </commonControls:GroupedControl>
      <Button Grid.Row="10" Height="22" Margin="0,50,0,0" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" uiUtility:UIElementHelper.CornerRadius="4" Command="{Binding ApiDocumentationCommand}" Content="{mex:Localized SETTINGS_NETWORK_API_DOCUMENTATION_BUTTON_title}" />
    </Grid>
  </ScrollViewer>
</UserControl>