                  <DataTemplate>
                    <local:GroupMemberItemTemplate ToolTip="{Binding Name}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
                    <Setter Property="FrameworkElement.ContextMenu">
                      <Setter.Value>
                        <ContextMenu>
                          <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                      </Setter.Value>
                    </Setter>
                    <Setter Property="commonControls:ListBoxItem.FocusOnContextMenuClose" Value="False" />
                    <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding SOURCELISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </local:GroupMemberList>
            </Border>
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
              <Grid Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderThickness="0,0,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
                  <commonControls:BorderlessPathButton Margin="5,2" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" PathType="Plus">
                    <FrameworkElement.ContextMenu>
                      <ContextMenu ItemsSource="{StaticResource Connections}" Placement="Bottom" UsesItemContainerTemplate="True" Opened="AddMenu_Opened">
                        <FrameworkElement.Resources>
                          <ResourceDictionary>
                            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type networkAPI:AvailableGroup}}">
                              <MenuItem Style="{StaticResource EntityStyle}" />
                            </ItemContainerTemplate>
                            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type networkAPI:AvailableDevice}}">
                              <MenuItem Style="{StaticResource EntityStyle}" />
                            </ItemContainerTemplate>
                          </ResourceDictionary>
                        </FrameworkElement.Resources>
                      </ContextMenu>
                    </FrameworkElement.ContextMenu>
                  </commonControls:BorderlessPathButton>
                </Border>
                <Border Grid.Column="1" BorderThickness="0,0,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
