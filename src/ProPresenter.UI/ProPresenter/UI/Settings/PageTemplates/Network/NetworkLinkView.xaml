<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Network.NetworkLinkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Network" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:networkAPI="clr-namespace:ProPresenter.Controller.NetworkAPI;assembly=ProPresenter.Controller" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="networkLinkView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="networkLinkVMProxy" Data="{Binding}" />
      <Style x:Key="ElementStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <converters:TypeOfConverter x:Key="TypeOfConverter" />
      <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <converters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <converters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <converters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <Style x:Key="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="EntityStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.ConnectToCommand, Source={StaticResource networkLinkVMProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="Header" Value="{Binding Name}" />
      </Style>
      <CompositeCollection x:Key="Connections">
        <MenuItem FontWeight="Bold" IsEnabled="False" Header="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_GROUP_HEADER_title}" />
        <MenuItem IsEnabled="False" Header="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_GROUP_NONE_AVAILABLE_title}" Visibility="{Binding Data.Groups.Count, Source={StaticResource networkLinkVMProxy}, Converter={StaticResource InvertedCountToVisibilityConverter}}" />
        <CollectionContainer Collection="{Binding Data.Groups, Source={StaticResource networkLinkVMProxy}}" />
        <Separator />
        <MenuItem FontWeight="Bold" IsEnabled="False" Header="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_DEVICE_HEADER_title}" />
        <MenuItem IsEnabled="False" Header="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_DEVICE_NONE_AVAILABLE_title}" Visibility="{Binding Data.Devices.Count, Source={StaticResource networkLinkVMProxy}, Converter={StaticResource InvertedCountToVisibilityConverter}}" />
        <CollectionContainer Collection="{Binding Data.Devices, Source={StaticResource networkLinkVMProxy}}" />
        <Separator />
        <MenuItem Command="{Binding ConnectCommand}" Header="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_MANUAL_CONNECTION_title}" />
      </CompositeCollection>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <commonControls:GroupedControl Grid.Row="0" HorizontalAlignment="Stretch">
      <Grid DataContext="{Binding Data, Source={StaticResource networkLinkVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_ENABLE_title}" />
        <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource networkLinkVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_GROUP_title}" />
        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Binding GroupName}" />
              <Style.Triggers>
                <DataTrigger xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib" Value="{x:Static system1:String.Empty}" Binding="{Binding GroupName}">
                  <Setter Property="Foreground" Value="{Binding TEXTBOX_DISABLED_CONTENT, Source={x:Static theming:AppTheme.Active}}" />
                  <Setter Property="Text" Value="{mex:Localized GLOBAL_NONE}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
    </commonControls:GroupedControl>
    <commonControls:GroupedControl Grid.Row="1" Margin="0,15,0,0">
      <Grid Margin="10,10,0,10" DataContext="{Binding Data, Source={StaticResource networkLinkVMProxy}}" IsEnabled="{Binding Enabled}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="150" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
