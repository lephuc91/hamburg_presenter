                  </commonControls:BorderlessButton>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <Border Grid.Column="1" Margin="10,0,10,0" BorderThickness="1" CornerRadius="2" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
            <Grid>
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_NOT_CONNECTED_title}" Visibility="{Binding GroupName, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static String.Empty}}" />
              <Grid Visibility="{Binding GroupMembers.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <Grid Margin="0,5,0,0" HorizontalAlignment="Left" Visibility="{Binding GroupName, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static String.Empty}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" MaxWidth="150" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Top" Text="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_MEMBER_NAME_title}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,5,20,0" HorizontalAlignment="Right" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding SelectedMember.Name}" />
                  <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0" BorderThickness="0,1,0,0" BorderBrush="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Margin="5,5,0,0" Text="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_MEMBER_VERSION_title}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,20,0" HorizontalAlignment="Right" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding SelectedMember.Version}" />
                  <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0" BorderThickness="0,1,0,0" BorderBrush="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Margin="5,5,0,0" Text="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_MEMBER_IPADDRESS_title}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,5,20,0" HorizontalAlignment="Right" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding SelectedMember.Ip}" />
                  <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0" BorderThickness="0,1,0,0" BorderBrush="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" />
                  <TextBlock Grid.Row="6" Grid.Column="0" Margin="5,5,0,0" Text="{mex:Localized SETTINGS_PAGE_NETWORK_LINK_MEMBER_PORT_title}" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,5,20,0" HorizontalAlignment="Right" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding SelectedMember.Port}" />
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </commonControls:GroupedControl>
    <commonControls:HelpButton Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding Data.HelpCommand, Source={StaticResource networkLinkVMProxy}}" />
  </Grid>
</UserControl>