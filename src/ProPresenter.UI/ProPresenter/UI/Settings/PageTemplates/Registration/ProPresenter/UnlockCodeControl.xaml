<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Registration.ProPresenter.UnlockCodeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Registration" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" MinWidth="570" xmlns:propresenter="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Registration.ProPresenter" Background="{Binding CONTAINER, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="viewModelProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <Style x:Key="InputTextBox" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="uiUtility:UIElementHelper.CornerRadius" Value="4" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="20,15" IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <commonControls:GroupedControl Margin="0" ContentMargin="8 6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_ACCOUNT_REGISTRATION_NAME_label}" />
        <TextBox Grid.Column="1" HorizontalAlignment="Stretch" CharacterCasing="Upper" Style="{StaticResource InputTextBox}" TabIndex="0" TextAlignment="Right" uiUtility:UIElementHelper.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" Text="{Binding Data.RegistrationName, UpdateSourceTrigger=PropertyChanged, Source={StaticResource viewModelProxy}}" />
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_ACCOUNT_UNLOCK_CODE_label}" />
        <local:LicenseCodeTextBox Grid.Column="1" HorizontalAlignment="Stretch" FontFamily="Consolas" FontSize="14" Style="{StaticResource InputTextBox}" TabIndex="1" TextAlignment="Right" Text="{Binding Data.UnlockCode, UpdateSourceTrigger=PropertyChanged, Source={StaticResource viewModelProxy}}" />
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_ACCOUNT_DEVICE_NAME_label}" />
        <TextBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource InputTextBox}" TabIndex="2" TextAlignment="Right" Text="{Binding Data.DeviceName, UpdateSourceTrigger=PropertyChanged, Source={StaticResource viewModelProxy}}" />
      </Grid>
    </commonControls:GroupedControl>
    <Grid Row="1" Margin="0,15,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding CancelCommand}" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" IsDefault="True" Command="{Binding RegisterCommand}" Content="{mex:Localized SETTINGS_ACCOUNT_REGISTER_BUTTON_title}" />
    </Grid>
  </Grid>
</UserControl>