<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Registration.Header.Header" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Registration.Header" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.Settings.Pages.Registration.Header">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ui:InterfaceDataTemplateSelector x:Key="HeaderTemplateSelector">
        <ui:InterfaceDataTemplateSelector.TemplateDictionary>
          <ResourceDictionary>
            <DataTemplate x:Key="{DataTemplateKey {x:Type vm:ISignedInHeaderVM}}" DataType="{x:Type vm:ISignedInHeaderVM}">
              <local:SignedInHeader />
            </DataTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Type vm:ISignedOutHeaderVM}}" DataType="{x:Type vm:ISignedOutHeaderVM}">
              <local:SignedOutHeader />
            </DataTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Type vm:IRegisteredWithCodeHeaderVM}}" DataType="{x:Type vm:IRegisteredWithCodeHeaderVM}">
              <local:RegisteredWithCodeHeader />
            </DataTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Type vm:IUndeterminedHeaderVM}}" DataType="{x:Type vm:IUndeterminedHeaderVM}">
              <local:UndeterminedHeader />
            </DataTemplate>
          </ResourceDictionary>
        </ui:InterfaceDataTemplateSelector.TemplateDictionary>
      </ui:InterfaceDataTemplateSelector>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <commonControls:NonLeakingTemplateSelectingContentControl ContentTemplateSelector="{StaticResource HeaderTemplateSelector}" Content="{Binding}" />
</UserControl>