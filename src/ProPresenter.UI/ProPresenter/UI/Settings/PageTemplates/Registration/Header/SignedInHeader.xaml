<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Registration.Header.SignedInHeader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:header="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Registration.Header;assembly=ProPresenter.UI">
  <StackPanel>
    <Ellipse Width="100" Margin="0,0,0,20" HorizontalAlignment="Stretch" Stretch="UniformToFill">
      <Shape.Fill>
        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding OrganizationLogo}" />
      </Shape.Fill>
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.7" ShadowDepth="1" Color="{StaticResource {x:Static themesUI:Colors.Shadow}}" />
      </UIElement.Effect>
    </Ellipse>
    <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding OrganizationName}">
      <UIElement.InputBindings>
        <MouseBinding Command="{Binding CopyOrganizationIdCommand}">
          <MouseBinding.Gesture>
            <MouseGesture Modifiers="Alt" MouseAction="LeftClick" />
          </MouseBinding.Gesture>
        </MouseBinding>
      </UIElement.InputBindings>
    </TextBlock>
  </StackPanel>
</UserControl>