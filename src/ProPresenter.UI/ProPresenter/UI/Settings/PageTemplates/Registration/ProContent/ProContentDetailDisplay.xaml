<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Registration.ProContent.ProContentDetailDisplay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Registration.ProContent" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <Style x:Key="Value" TargetType="{x:Type TextBlock}">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="UIElement.Opacity" Value="0.6" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <TextBlock Visibility="{Binding Visibility, ElementName=signInButton, Converter={StaticResource InvertedValueToVisibilityConverter}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource Value}" TargetType="{x:Type TextBlock}">
          <Setter Property="Text" Value="{mex:Localized SETTINGS_ACCOUNT_SIGN_IN_TO_ACCESS_PROCONTENT_label}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsSignedIn}">
              <Setter Property="Text" Value="{Binding SubscriptionType, Converter={StaticResource EnumToContentConverter}}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Button Name="signInButton" HorizontalAlignment="Right" Command="{Binding SignInCommand}" Content="{mex:Localized SETTINGS_ACCOUNT_SIGN_IN_BUTTON_title}" Visibility="{Binding IsEnabled, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource Self}}" />
  </Grid>
</UserControl>