<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Registration.ProContent.ProContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Registration.ProContent" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="proContentSectionVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <Style x:Key="Description" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Image Height="18" Margin="8" HorizontalAlignment="Left" Source="{StaticResource {x:Static themesUI:Icons.ProContentWordmark}}" />
    <commonControls:GroupedControl Grid.Row="1">
      <Grid DataContext="{Binding Data, Source={StaticResource proContentSectionVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource Description}" Text="{mex:Localized SETTINGS_ACCOUNT_ACCOUNT_TYPE_label}" />
        <local:ProContentDetailDisplay Grid.Column="1" DataContext="{Binding}" />
      </Grid>
    </commonControls:GroupedControl>
    <Button Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right" Command="{Binding UpgradeCommand}" Content="{mex:Localized SETTINGS_ACCOUNT_UPGRADE_PROCONTENT_BUTTON_title}" Visibility="{Binding IsEnabled, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource Self}}" />
  </Grid>
</UserControl>