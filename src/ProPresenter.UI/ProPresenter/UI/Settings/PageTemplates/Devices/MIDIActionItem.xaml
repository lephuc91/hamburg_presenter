<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Devices.MIDIActionItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" x:Name="actionItemSelf" xmlns:devices="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Devices">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,0,0,3">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, ElementName=actionItemSelf}" Text="{Binding Action, ElementName=actionItemSelf, Converter={StaticResource EnumToContentConverter}}" />
    <commonControls:IntegerUpDown Grid.Column="1" Width="50" Height="22" Margin="0,0,5,0" VerticalAlignment="Center" VerticalContentAlignment="Center" DefaultValue="0" DisplayDefaultValueOnEmptyText="True" Maximum="127" Minimum="0" Value="{Binding NoteNumber, ElementName=actionItemSelf, Mode=TwoWay}" />
    <StackPanel Grid.Column="2" MinWidth="50" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Foreground="{Binding Foreground, ElementName=actionItemSelf}" Text="{Binding PitchValue.Note, ElementName=actionItemSelf, Converter={StaticResource EnumToDescriptionConverter}, Mode=OneWay}" />
      <TextBlock Foreground="{Binding Foreground, ElementName=actionItemSelf}" Text="{Binding PitchValue.Octave, ElementName=actionItemSelf, Mode=OneWay}" />
    </StackPanel>
  </Grid>
</UserControl>