<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Devices.DevicesSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:controls="clr-namespace:ProPresenter.UI.Controls" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:devices="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Devices" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:settingsVM="clr-namespace:ProPresenter.UI.ViewModels.Settings" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:utility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="devicesSettingsView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="devicesSettingVMProxy" Data="{Binding}" />
      <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="False" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <converters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="1" CornerRadius="10" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding ElementName=DeviceList, Path=Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl Name="DeviceList" Grid.Row="0" Grid.Column="0" Height="400" Margin="2,3,2,3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Devices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <FrameworkElement.ContextMenu>
                  <ContextMenu>
                    <MenuItem Command="{Binding Data.DeleteDeviceCommand, Source={StaticResource devicesSettingVMProxy}}" CommandParameter="{Binding}" Header="{mex:Localized GLOBAL_DELETE_title}" />
                  </ContextMenu>
                </FrameworkElement.ContextMenu>
                <Grid Row="0" Column="0" ZIndex="10">
                  <Button Grid.Row="0" Grid.Column="0" MinWidth="80" Margin="0,0,20,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding Data.ToggleDeviceConnectionCommand, Source={StaticResource devicesSettingVMProxy}}" CommandParameter="{Binding}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                        <Setter Property="Content" Value="{mex:Localized SETTINGS_DEVICE_CONNECT_title}" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="utility:UIElementHelper.CornerRadius" Value="4" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsConnected}">
                            <Setter Property="Content" Value="{mex:Localized SETTINGS_DEVICE_DISCONNECT_title}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                </Grid>
                <Grid Row="0" Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <devices:DeviceChildPageButton Grid.Row="0" Grid.Column="0" ChildPageVM="{Binding Data.MidiDeviceSettingsVM, Source={StaticResource devicesSettingVMProxy}}" IsEnabled="{Binding IsConnected, Converter={StaticResource InvertedBooleanConverter}}" SetTargetDeviceCommand="{Binding Data.MidiDeviceSettingsVM.SetTargetDeviceCommand, Source={StaticResource devicesSettingVMProxy}}" SetTargetDeviceCommandParameter="{Binding}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="7" Fill="#FF7FFF00" RadiusX="3" RadiusY="3" Visibility="{Binding IsConnected, Converter={StaticResource ValueToVisibilityConverter}}" />
                      <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="40" Height="40" Margin="5,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
                        <Image Width="24" Source="{StaticResource {x:Static themes:Icons.SettingsDevices}}" Stretch="Uniform" />
                      </Border>
                      <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Label}" />
                      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{Binding Type}" />
                        <TextBlock Margin="5,0,5,0" VerticalAlignment="Center" Text=" : " />
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Status}" />
                      </StackPanel>
                      <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="-1,10,-2,0" BorderThickness="0,0,0,1" BorderBrush="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" />
                    </Grid>
                  </devices:DeviceChildPageButton>
                  <Separator Grid.Row="1" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Row="1" Column="0" Visibility="Collapsed">
          <Button Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" utility:ContextMenuHelper.OpenOnLeftClick="True">
            <Control.Template>
              <ControlTemplate>
                <Border Background="#00FFFFFF">
                  <commonControls:PathControl Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" PathType="Plus" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="2" />
                </Border>
              </ControlTemplate>
            </Control.Template>
            <FrameworkElement.ContextMenu>
              <ContextMenu Placement="Bottom">
                <ItemsControl.Items>
                  <MenuItem Header="MIDI" Command="{Binding Data.AddMIDIDeviceCommand, Source={StaticResource devicesSettingVMProxy}}" CommandParameter="{Binding SelectActivePageCommand, Source={di:DIMarkup {x:Type settingsVM:ISettingsVM}}}" />
                </ItemsControl.Items>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
        </Grid>
      </Grid>
    </Border>
    <controls:ImageTextButton Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" ButtonBackground="#80707070" ButtonHeight="80" ButtonWidth="80" ImageSource="{StaticResource {x:Static themes:Icons.EmptyAdd}}" Command="{Binding Data.AddMIDIDeviceCommand, Source={StaticResource devicesSettingVMProxy}}" CommandParameter="{Binding SelectActivePageCommand, Source={di:DIMarkup {x:Type settingsVM:ISettingsVM}}}" Text="{mex:Localized SETTINGS_DEVICE_SETTINGS_PAGE_ADD_DEVICE_label}" Visibility="{Binding ElementName=DeviceList, Path=Items.Count, Converter={StaticResource InvertedCountToVisibilityConverter}}" />
    <Button Grid.Row="2" Grid.Column="1" Height="22" MinWidth="75" Margin="0,0,0,10" Padding="10,0" HorizontalAlignment="Right" Command="{Binding OpenMIDISettingsCommand}" Content="{mex:Localized SETTINGS_DEVICE_MIDI_MAP_WINDOW_title}" />
    <commonControls:HelpButton Grid.Row="2" Grid.Column="2" Margin="10,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Top" HelpCommand="{Binding Data.HelpCommand, Source={StaticResource devicesSettingVMProxy}}" />
  </Grid>
</UserControl>