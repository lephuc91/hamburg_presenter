<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.UpdatesSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:utility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="updatesSettingsView" xmlns:pagetemplates="clr-namespace:ProPresenter.UI.Settings.PageTemplates">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="updatesSettingVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" IsInverted="True" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ScrollViewer Name="updatesSettingsScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <commonControls:GroupedControl Grid.Row="0">
          <Grid DataContext="{Binding Data, Source={StaticResource updatesSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_UPDATES_INSTALLED_VERSION_label}" />
            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding InstalledVersion}" />
            <TextBlock Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12">
              <Hyperlink Command="{Binding ShowInstalledReleaseNotesCommand}">
                <TextBlock Text="{mex:Localized SETTINGS_UPDATES_RELEASE_NOTES_BUTTON_title}">
                  <TextBlock.Foreground>
                    <SolidColorBrush Color="{StaticResource {x:Static themes:Colors.Secondary}}" />
                  </TextBlock.Foreground>
                </TextBlock>
              </Hyperlink>
            </TextBlock>
          </Grid>
          <Grid DataContext="{Binding Data, Source={StaticResource updatesSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_UPDATES_DATE_LAST_UPDATED_label}" />
            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding UpdateDate}" />
          </Grid>
        </commonControls:GroupedControl>
        <commonControls:GroupedControl Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Stretch">
          <Grid DataContext="{Binding Data, Source={StaticResource updatesSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_UPDATES_CHECK_FOR_UPDATES_label}" />
            <Button Grid.Column="1" Height="22" MinWidth="80" Padding="5,0" HorizontalAlignment="Right" Command="{Binding Data.CheckUpdatesCommand, Source={StaticResource updatesSettingVMProxy}}" Content="{mex:Localized SETTINGS_UPDATES_CHECK_NOW_BUTTON_title}" />
          </Grid>
        </commonControls:GroupedControl>
        <TextBlock Grid.Row="2" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_UPDATES_UPDATE_CHANNEL_SECTION_title}" />
        <commonControls:GroupedControl Grid.Row="3" HorizontalAlignment="Stretch">
          <Grid DataContext="{Binding Data, Source={StaticResource updatesSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_UPDATES_BETA_UPDATES_BUTTON_title}" />
            <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding BetaChannelSelected, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_UPDATES_BETA_UPDATES_DESCRIPTION_label}" />
          </Grid>
          <Grid DataContext="{Binding Data, Source={StaticResource updatesSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_UPDATES_NOTIFIY_WHEN_UPDATES_AVAILABLE_BUTTON_title}" />
            <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding NotifyUpdatesAvailable, Mode=TwoWay}" />
          </Grid>
        </commonControls:GroupedControl>
        <TextBlock Grid.Row="4" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_UPDATES_AVAILABLE_UPDATES_SECTION_title}" />
        <commonControls:GroupedControl Grid.Row="5" HorizontalAlignment="Stretch" Visibility="{Binding AvailableUpdates.Count, Converter={StaticResource InvertedCountToVisibilityConverter}}">
          <Grid DataContext="{Binding Data, Source={StaticResource updatesSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_UPDATES_AVAILABLE_UPDATES_NONE_label}" />
            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_UPDATES_AVAILABLE_UPDATES_UPDATE_TO_DATE_label}" />
          </Grid>
        </commonControls:GroupedControl>
        <commonControls:GroupedControl Grid.Row="6" HorizontalAlignment="Stretch" Items="{Binding AvailableUpdates}" Visibility="{Binding AvailableUpdates.Count, Converter={StaticResource CountToVisibilityConverter}}">
          <commonControls:GroupedControl.ItemContentTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Title}" />
                <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Version}" />
                <Button Grid.Row="1" Grid.Column="1" Height="22" MinWidth="80" Margin="15,5,0,0" Padding="5,0" HorizontalAlignment="Right" utility:UIElementHelper.CornerRadius="4" Command="{Binding ButtonCommand}" Content="{Binding ButtonName}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12">
                  <Hyperlink Command="{Binding ShowReleaseNotesCommand}">
                    <TextBlock Text="{mex:Localized SETTINGS_UPDATES_RELEASE_NOTES_BUTTON_title}">
                      <TextBlock.Foreground>
                        <SolidColorBrush Color="{StaticResource {x:Static themes:Colors.Secondary}}" />
                      </TextBlock.Foreground>
                    </TextBlock>
                  </Hyperlink>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </commonControls:GroupedControl.ItemContentTemplate>
        </commonControls:GroupedControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>