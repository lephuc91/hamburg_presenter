<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.General.CopyrightLayout" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:ProPresenter.UI.Commands" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.General" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
  <Border BorderThickness="1" BorderBrush="{Binding POPUPBORDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="150" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_GENERAL_CCLI_LAYOUT_COPYRIGHT_FORMAT_LABEL_title}" />
      <TextBlock Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_GENERAL_CCLI_LAYOUT_AVAILABLE_TOKENS_LABEL_title}" />
      <local:CcliTokenTextBox Grid.Row="1" DocumentChangeEndedCommand="{Binding DocumentChangeEndedCommand}" DocumentChangeStartedCommand="{Binding DocumentChangeStartedCommand}" Text="{Binding CopyrightLayoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tokens="{Binding CopyrightTokens}" />
      <local:CcliTokenListBox Grid.Row="1" Grid.Column="1" ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}" Style="{StaticResource {x:Type ListBox}}" Tokens="{Binding AvailableCopyrightTokens}" />
      <Button Grid.Row="2" Height="22" MinWidth="100" Margin="0,10,0,0" Padding="10,0" HorizontalAlignment="Left" uiUtility:UIElementHelper.CornerRadius="4" CommandParameter="{x:Static commands:ShowSource.Preference}" Command="{Binding EditCopyrightTemplateCommand}" Content="{mex:Localized SETTINGS_GENERAL_CCLI_LAYOUT_EDIT_TEMPLATE_BUTTON_title}" />
      <Button Grid.Row="2" Grid.Column="1" Height="22" MinWidth="80" Margin="0,10,0,0" Padding="10,0" HorizontalAlignment="Right" uiUtility:UIElementHelper.CornerRadius="4" Command="{Binding CloseCopyrightLayoutCommand}" Content="{mex:Localized GLOBAL_DONE}" />
    </Grid>
  </Border>
</UserControl>