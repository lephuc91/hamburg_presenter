<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Settings.PageTemplates.General.DuplicateWorkspaceProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="duplicateprogress" utility:WindowHelper.ChildOf="MainWindow" utility:WindowHelper.HideOnClose="True" utility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:general="clr-namespace:ProPresenter.UI.Settings.PageTemplates.General;assembly=ProPresenter.UI" Background="{Binding (utility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}">
  <Grid Width="450" Margin="10,0,10,10">
