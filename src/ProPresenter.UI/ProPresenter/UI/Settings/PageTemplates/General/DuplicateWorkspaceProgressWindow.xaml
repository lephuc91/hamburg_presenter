    <controls:BorderlessPathButton Grid.Row="1" Grid.Column="2" PathHeight="22" PathType="Cancel" PathWidth="22" Command="{Binding CancelCommand, ElementName=duplicateprogress}" />
    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Text="{Binding Status, ElementName=duplicateprogress}" />
  </Grid>
</windowing:ChromedWindow>