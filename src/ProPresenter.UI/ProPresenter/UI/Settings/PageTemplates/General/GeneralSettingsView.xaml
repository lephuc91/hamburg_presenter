<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.General.GeneralSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cloudWorkspaces="clr-namespace:ProPresenter.UI.CloudWorkspaces" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:dependencyInjection="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:general="clr-namespace:ProPresenter.UI.Settings.PageTemplates.General" xmlns:generalSettings="clr-namespace:ProPresenter.UI.Settings.PageTemplates.General" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:pagesVM="clr-namespace:ProPresenter.UI.ViewModels.Settings.Pages" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.Workspaces" xmlns:workspace="clr-namespace:ProPresenter.UI.Workspaces" x:Name="generalSettingsView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../CloudOnboarding/CloudOnboardingResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="generalSettingVMProxy" Data="{Binding}" />
      <generalSettings:SelectedLanguageConverter x:Key="SelectedLanguageConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
      </Style>
      <ObjectDataProvider x:Key="CopyrightDisplayType" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="pagesVM:CopyrightDisplayType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <StackPanel Name="copyrightLayoutAnchorPanel" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
    <ScrollViewer Name="generalSettingsScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized LOCALWORKSPACE_WORKSPACE_HEADER_title}" />
        <TextBlock Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized LOCALWORKSPACE_WORKSPACE_HEADER_title}" Visibility="{mex:FeatureFlag Cloud}" />
        <commonControls:GroupedControl Grid.Row="1" Margin="0,0,0,25" Visibility="{mex:FeatureFlag Cloud}">
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized LOCALWORKSPACE_ACTIVE_WORKSPACE_title}" />
            <cloudWorkspaces:CloudWorkspaceControl Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized LOCALWORKSPACE_WORKSPACE_DESCRIPTION_title}" />
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" HorizontalAlignment="Right" DataContext="{dependencyInjection:DIMarkup {x:Type viewModels:IWorkspacesVM}}" Visibility="{Binding IsCloudSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Button Padding="10,3" Command="{Binding ManageCloudWorkspacesLinkCommand}" Content="{mex:Localized CLOUDWORKSPACE_MANAGE_CLOUD_STORAGE_button}" DataContext="{dependencyInjection:DIMarkup {x:Type viewModels:IWorkspacesVM}}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="{x:Static viewModels:WorkspaceType.Synced}" Binding="{Binding SelectedWorkspace.WorkspaceType}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <Button Padding="10,3" Command="{Binding PublishWorkspaceWithConfirmCommand}" Content="{mex:Localized CLOUDWORKSPACE_CONVERT_TO_CLOUD_CONFIRM_button}" DataContext="{dependencyInjection:DIMarkup {x:Type viewModels:IWorkspacesVM}}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="{x:Static viewModels:WorkspaceType.Local}" Binding="{Binding SelectedWorkspace.WorkspaceType}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
            </StackPanel>
          </Grid>
        </commonControls:GroupedControl>
        <commonControls:GroupedControl Grid.Row="1" Margin="0,0,0,25" Visibility="{mex:FeatureFlag Cloud, IsInverted=True}">
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized LOCALWORKSPACE_ACTIVE_WORKSPACE_title}" />
            <workspace:WorkspaceControl Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ShowExtraMenuItems="True" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized LOCALWORKSPACE_WORKSPACE_DESCRIPTION_title}" />
          </Grid>
        </commonControls:GroupedControl>
        <commonControls:GroupedControl Grid.Row="2" Margin="0,0,0,25" Visibility="{mex:FeatureFlag CloudComingSoon}">
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
              <Image Width="90" Height="24" VerticalAlignment="Center" Source="{DynamicResource {x:Static themes:Icons.CloudWorkspaceLogo}}" Stretch="Uniform" />
            </StackPanel>
            <Button Grid.Row="0" Grid.Column="1" Height="22" MinWidth="140" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding SignUpForEarlyAccessCommand}" Content="{mex:Localized CLOUD_COMING_SOON_SIGN_UP_BUTTON_title}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}">
              <Run Text="{mex:Localized CLOUD_COMING_SOON_SETTINGS_title}" /> <Run Text=" " /> <Hyperlink Foreground="{StaticResource CloudOnboarding.HyperlinkBrush}" TextDecorations="None" Command="{Binding LearnMoreCloudCommand}"><Run FontSize="12" Text="{mex:Localized CLOUD_COMING_SOON_LEARN_MORE_BUTTON_title}" /></Hyperlink></TextBlock>
          </Grid>
        </commonControls:GroupedControl>
        <commonControls:GroupedControl Grid.Row="3">
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_HOUSE_OF_WORSHIP_INTEGRATIONS_BUTTON_title}" />
            <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableHoW, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_GENERAL_HOUSE_OF_WORSHIP_INTEGRATIONS_DESCRIPTION_LABEL_title}" />
          </Grid>
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_SHARE_CRASH_REPORTS_BUTTON_title}" />
            <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableCrashReporting}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_GENERAL_SHARE_CRASH_REPORTS_DESCRIPTION_LABEL_title}" />
          </Grid>
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_SHARE_ANALYTICS_BUTTON_title}" />
            <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableAnalytics}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_GENERAL_SHARE_ANALYTICS_DESCRIPTION_LABEL_title}" />
          </Grid>
        </commonControls:GroupedControl>
        <commonControls:GroupedControl Grid.Row="4" Margin="0,15,0,0">
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="{mex:Localized SETTINGS_GENERAL_LOGO_HEADER_title}" />
            <commonControls:BorderlessButton Grid.Column="1" Height="Auto" HorizontalAlignment="Right" Command="{Binding AddLogoCommand}">
              <FrameworkElement.ContextMenu>
                <ContextMenu Placement="Bottom">
                  <MenuItem Command="{Binding RemoveLogoCommand}" Header="{mex:Localized SETTINGS_GENERAL_REMOVE_LOGO_MENU_ITEM_title}" />
                  <Separator />
                  <MenuItem Command="{Binding OpenFileLocationCommand}" Header="{mex:Localized GLOBAL_SHOW_IN_FINDER_MENU_ITEM_windows_title}" />
                </ContextMenu>
              </FrameworkElement.ContextMenu>
              <Border Width="80" Height="45" Background="#00FFFFFF" BorderThickness="2" CornerRadius="3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}">
                <Image HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" Source="{Binding LogoImageSource}" />
              </Border>
            </commonControls:BorderlessButton>
          </Grid>
        </commonControls:GroupedControl>
        <TextBlock Grid.Row="5" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_GENERAL_LANGUAGE_SECTION_title}" />
        <commonControls:GroupedControl Grid.Row="6">
          <Grid DataContext="{Binding Data, Source={StaticResource generalSettingVMProxy}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_LANGUAGE_SELECTOR_title}" />
            <commonControls:BorderlessComboBox Grid.Row="0" Grid.Column="1" Height="22" MinWidth="80" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource SelectedLanguageConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </commonControls:BorderlessComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_GENERAL_LANGUAGE_CHANGE_REQUIRES_RESTART_title}" />
          </Grid>
        </commonControls:GroupedControl>
        <Grid Row="7" Visibility="{Binding EnableHoW, Converter={StaticResource ValueToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_GENERAL_CCLI_REPORTING_COLUMN_COPYRIGHT_title}" />
          <commonControls:GroupedControl Grid.Row="1">
            <Grid DataContext="{Binding Data.CopyrightSettingsVM, Source={StaticResource generalSettingVMProxy}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_ENABLE_COPYRIGHT_DISPLAY_BUTTON_title}" />
              <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableCopyrightDisplay, Mode=TwoWay}" />
            </Grid>
            <Grid DataContext="{Binding Data.CopyrightSettingsVM, Source={StaticResource generalSettingVMProxy}}" Visibility="{Binding EnableCopyrightDisplay, Converter={StaticResource ValueToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_COPYRIGHT_DISPLAY_LOCATION_label}" />
              <commonControls:BorderlessComboBox Grid.Row="0" Grid.Column="1" Height="22" MinWidth="80" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource CopyrightDisplayType}}" SelectedItem="{Binding CopyrightDisplayType}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </commonControls:BorderlessComboBox>
            </Grid>
            <Grid DataContext="{Binding Data.CopyrightSettingsVM, Source={StaticResource generalSettingVMProxy}}" Visibility="{Binding EnableCopyrightDisplay, Converter={StaticResource ValueToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_CCLI_LICENSE_NUMBER_LABEL_title}" />
              <TextBox Grid.Column="1" Width="125" Height="22" HorizontalAlignment="Right" VerticalContentAlignment="Center" TextWrapping="WrapWithOverflow" Text="{Binding CopyrightLicenseNumber, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid DataContext="{Binding Data.CopyrightSettingsVM, Source={StaticResource generalSettingVMProxy}}" Visibility="{Binding EnableCopyrightDisplay, Converter={StaticResource ValueToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_COPYRIGHT_LAYOUT_label}" />
              <Button Height="22" MinWidth="80" Padding="5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding OpenCopyrightLayoutCommand}" Content="{mex:Localized SETTINGS_GENERAL_COPYRIGHT_EDIT_LAYOUT_BUTTON_title}" />
            </Grid>
          </commonControls:GroupedControl>
          <commonControls:GroupedControl Grid.Row="2" Margin="0,15,0,0" HorizontalContentAlignment="Stretch">
            <local:ChildPageButton ChildPageVM="{Binding Data.CopyrightSettingsVM, Source={StaticResource generalSettingVMProxy}}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
                  <Image Width="24" Source="{StaticResource {x:Static themes:Icons.SongSelectIcon}}" Stretch="Uniform" />
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_GENERAL_COPYRIGHT_REPORTING_BUTTON_title}" />
                <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_GENERAL_COPYRIGHT_REPORTING_BUTTON_desc}" />
              </Grid>
            </local:ChildPageButton>
          </commonControls:GroupedControl>
        </Grid>
      </Grid>
    </ScrollViewer>
    <commonControls:ModalPopup Name="CCLILayout" MinWidth="380" MinHeight="250" HorizontalAlignment="Center" IsModal="True" Placement="Bottom" StaysOpen="True" VerticalOffset="50" IsOpen="{Binding Data.CopyrightSettingsVM.EditCopyrightLayoutPopupOpen, Source={StaticResource generalSettingVMProxy}}" PlacementTarget="{Binding ElementName=copyrightLayoutAnchorPanel}">
      <generalSettings:CopyrightLayout DataContext="{Binding Data.CopyrightSettingsVM, Source={StaticResource generalSettingVMProxy}}" />
    </commonControls:ModalPopup>
  </Grid>
</UserControl>