<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.FeatureFlags.FeatureFlagSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:theming="clr-namespace:ProPresenter.UI.Theming;assembly=ProPresenter.UI" xmlns:featureflags="clr-namespace:ProPresenter.UI.Settings.PageTemplates.FeatureFlags">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="featureFlagSettingsVMProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="35" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <commonControls:GroupedControl Grid.Row="0">
        <ItemsControl ItemsSource="{Binding Data.FeatureFlags, Source={StaticResource featureFlagSettingsVMProxy}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="5,3,2,0" IsEnabled="{Binding CanSetFlag}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="32" />
                  <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" TextWrapping="WrapWithOverflow" Foreground="{Binding HEADERHELPERCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Description}" />
                <commonControls:ToggleSwitch Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" VerticalAlignment="Top" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{Binding ERROR, Source={x:Static theming:AppTheme.Active}}" Text="{Binding WarningLabelText}" />
      <Button Grid.Row="2" Height="24" MinWidth="120" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding ResetToDefaultsCommand}" Content="{mex:Localized SETTINGS_FEATURE_FLAGS_RESET_FLAGS}" />
    </Grid>
  </ScrollViewer>
</UserControl>