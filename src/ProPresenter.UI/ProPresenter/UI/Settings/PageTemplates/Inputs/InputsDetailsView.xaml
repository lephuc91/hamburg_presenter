<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.InputsDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:pages="clr-namespace:ProPresenter.UI.Settings.PageTemplates" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:inputs="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="inputsSettingsVMProxy" Data="{Binding}" />
      <commonConverters:TimeSliceToDoubleSecondConverter x:Key="TimeSliceToDoubleSecondConverter" RoundDecimalPlace="1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <commonControls:GroupedControl Grid.Row="0" Margin="0,15,0,0">
      <Grid DataContext="{Binding Data, Source={StaticResource inputsSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_TRANSITION_DURATION_title}" />
        <commonControls:FillSlider Grid.Column="1" Width="180" VerticalAlignment="Center" VerticalContentAlignment="Center" IsMoveToPointEnabled="True" Maximum="10" Minimum="0" Value="{Binding AudioInputTransitionTime, Converter={StaticResource TimeSliceToDoubleSecondConverter}, Mode=TwoWay}" />
        <commonControls:DoubleUpDown Grid.Column="2" Width="34" Margin="0,-2,0,0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" FormatString="{}{0:F1}s" Increment="0.1" Maximum="10" Minimum="0" ShowButtonSpinner="False" Value="{Binding AudioInputTransitionTime, Converter={StaticResource TimeSliceToDoubleSecondConverter}, Mode=TwoWay}" />
      </Grid>
    </commonControls:GroupedControl>
    <commonControls:GroupedControl Grid.Row="1" Margin="0,15,0,0">
      <pages:ChildPageButton ChildPageVM="{Binding Data.NdiInputsSettingsVM, Source={StaticResource inputsSettingsVMProxy}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
            <Image Width="24" Source="{StaticResource {x:Static themes:Icons.SettingsNdi}}" Stretch="Uniform" />
          </Border>
          <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_INPUTS_NDI_INPUT_DISCOVERY_title}" />
        </Grid>
      </pages:ChildPageButton>
    </commonControls:GroupedControl>
    <commonControls:HelpButton Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding HelpCommand}" />
  </Grid>
</UserControl>