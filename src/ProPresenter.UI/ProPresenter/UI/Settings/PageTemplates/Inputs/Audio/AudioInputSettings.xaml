<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.Audio.AudioInputSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:audioControls="clr-namespace:Pro.UI.Controls.Audio;assembly=Pro.UI" xmlns:commonAudio="clr-namespace:Pro.DO.Audio;assembly=Pro.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:input="clr-namespace:ProPresenter.UI.Input" xmlns:inputs="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Audio" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="audioInputsSettingsVMProxy" Data="{Binding}" />
      <commonConverters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverter" />
      <commonConverters:TimeSliceToTimeFormatConverter x:Key="TimeSliceToTimeFormatConverter" ConversionUnit="TotalMilliSeconds" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Row="1" Margin="0,15,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <commonControls:GroupedControl Grid.Row="0" Margin="0,15,0,0" GroupBackground="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding SelectedAudioInput, Converter={StaticResource IsNotNullToVisibilityConverter}}">
      <Grid DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUT_NAME_title}" />
        <commonControls:PlaceholderTextBox Grid.Column="1" Width="250" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" IsTextBindingExplicit="True" PlaceholderText="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_NAME_prompt}" Text="{Binding SelectedAudioInput.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_SOURCE_title}" />
        <input:AudioSourceDeviceSelector Grid.Column="1" Width="250" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" AddAirCastDeviceCommand="{Binding AddAirCastDeviceCommand}" AudioDevices="{Binding AudioDevices}" ClearDeviceCommand="{Binding ClearDeviceCommand}" SelectAudioDeviceCommand="{Binding SelectAudioDeviceCommand}" SelectVideoDeviceCommand="{Binding SelectVideoDeviceCommand}" Source="{Binding SelectedAudioInput.Source}" VideoDevices="{Binding VideoDevices}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}" Visibility="{Binding CanConfigureAirCast, Converter={StaticResource ValueToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUT_AIRPLAY_DISPLAY_NAME_title}" />
        <TextBox Grid.Column="1" Width="250" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" uiUtility:TextBoxHelper.UpdateOnEnterKey="True" Text="{Binding AirCastDisplayName, Mode=TwoWay}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}" Visibility="{Binding CanConfigureAirCast, Converter={StaticResource ValueToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUT_AIRPLAY_PASSWORD_title}" />
        <TextBox Grid.Column="1" Width="90" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalContentAlignment="Center" uiUtility:TextBoxHelper.UpdateOnEnterKey="True" Text="{Binding AirCastPassword, Mode=TwoWay}" />
        <commonControls:ToggleSwitch Grid.Column="2" IsChecked="{Binding AirCastPasswordEnabled}" />
      </Grid>
      <local:AudioModeSelector DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}" />
    </commonControls:GroupedControl>
    <commonControls:GroupedControl Grid.Row="1" Margin="0,15,0,0" GroupBackground="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding SelectedAudioInput, Converter={StaticResource IsNotNullToVisibilityConverter}}">
      <Grid DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_DELAY_title}" />
        <commonControls:DoubleUpDown Grid.Column="1" Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" FormatString="{}{0}ms" Maximum="1500" Minimum="0" IsEnabled="{Binding SelectedAudioInput.Source.IsDeviceConnected}" Value="{Binding AudioInputAudioDelay, Converter={StaticResource TimeSliceToTimeFormatConverter}}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_MASTER_LEVEL_label}" />
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsEnabled="{Binding SelectedAudioInput.Source.IsDeviceConnected}">
          <commonControls:FillSlider Width="210" VerticalAlignment="Center" Maximum="{x:Static commonAudio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static commonAudio:AudioConstants.DecibelRangeMinimum}" Value="{Binding SelectedAudioInput.Source.Routing.MasterChannel.Level}" />
          <commonControls:DoubleUpDown Width="40" Height="22" FormatString="{}{0:N0}dB" Increment="1" Maximum="{x:Static commonAudio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static commonAudio:AudioConstants.DecibelRangeMinimum}" ShowButtonSpinner="False" Value="{Binding SelectedAudioInput.Source.Routing.MasterChannel.Level}" />
        </StackPanel>
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource audioInputsSettingsVMProxy}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_CHANNELS_SECTION_label}" />
          <commonControls:BorderlessToggleButton Width="24" Height="24" uiUtility:UIElementHelper.Palette="{Binding AUDIOMONITORINGBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" Command="{Binding ToggleAudioInputAudioMonitoringCommand}" IsChecked="{Binding SelectedAudioInput.Source.IsMonitoring, Mode=OneWay}" ToolTip="{mex:Localized SETTINGS_INPUTS_VIDEO_MONITOR_AUDIO_tooltip}">
            <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/Preferences/Input/InputListen@2x.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessToggleButton}}}" />
          </commonControls:BorderlessToggleButton>
        </StackPanel>
        <Button Grid.Row="0" HorizontalAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Content="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUT_AUDIO_ROUTING_title}" IsEnabled="{Binding SelectedAudioInput.Source.HasDevice}">
          <FrameworkElement.ContextMenu>
            <ContextMenu Placement="Bottom">
              <Control.Template>
                <ControlTemplate>
                  <audioControls:DeviceToBusChannelControl AutoOnly="True" BorderThickness="1" ShowInputAudioControls="False" ShowMuteAndSoloButtons="False" ShowOutputAudioControls="False" ShowOutputChannelIndex="True" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" AudioMap="{Binding Data.SelectedAudioInput.Source.Routing.ChannelMap, Source={StaticResource audioInputsSettingsVMProxy}}" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" ColumnHeaderText="{mex:Localized SETTINGS_INPUTS_ROUTING_PROPRESENTER_CHANNEL_label}" RowHeaderText="{Binding Data.SelectedAudioInput.Source.DeviceName, Source={StaticResource audioInputsSettingsVMProxy}}" TextElement.Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" />
                </ControlTemplate>
              </Control.Template>
            </ContextMenu>
          </FrameworkElement.ContextMenu>
        </Button>
        <Border Grid.Row="1" Grid.Column="2" MaxHeight="180" Margin="0,2,0,0" BorderThickness="1" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
          <inputs:ChannelSetMixer ChannelLevels="{Binding SelectedAudioInput.Source.DeviceChannelLevels}" ChannelMap="{Binding SelectedAudioInput.Source.Routing.ChannelMap}" ChannelSet="{Binding SelectedAudioInput.Source.Routing.ChannelSet}" MasterChannel="{Binding SelectedAudioInput.Source.Routing.MasterChannel}" Visibility="{Binding SelectedAudioInput.Source.IsDeviceConnected, Converter={StaticResource ValueToVisibilityConverter}}" />
        </Border>
        <ui:SelectAllNoneControl Grid.Row="2" IsEnabled="{Binding SelectedAudioInput.Source.IsDeviceConnected}" SelectAllCommand="{Binding EnableAllChannelsCommand}" SelectNoneCommand="{Binding DisableAllChannelsCommand}" />
      </Grid>
    </commonControls:GroupedControl>
  </Grid>
</UserControl>