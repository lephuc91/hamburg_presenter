<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.Audio.AudioModeSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.Settings.Pages.Inputs.Audio" xmlns:audio="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Audio">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="audioModeSelectorDataContextProxy" Data="{Binding}" />
      <Style x:Key="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
      </Style>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_MODE_title}" />
      <UniformGrid Grid.Column="1" HorizontalAlignment="Right" Columns="4">
        <RadioButton BorderThickness="0" Content="{mex:Localized SETTINGS_INPUTS_AUDIO_MODE_OFF_label}" IsChecked="{Binding BehaviorMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:AudioBehaviorModeInternal.Off}}" />
        <RadioButton BorderThickness="1,0,0,0" Content="{mex:Localized SETTINGS_INPUTS_AUDIO_MODE_ON_label}" IsChecked="{Binding BehaviorMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:AudioBehaviorModeInternal.On}}" />
        <RadioButton BorderThickness="1,0,0,0" Content="{mex:Localized SETTINGS_INPUTS_AUDIO_MODE_AUTO_OFF_label}" IsChecked="{Binding BehaviorMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:AudioBehaviorModeInternal.AutoOff}}" />
        <RadioButton BorderThickness="1,0,0,0" Content="{mex:Localized SETTINGS_INPUTS_AUDIO_MODE_AUTO_ON_label}" IsChecked="{Binding BehaviorMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:AudioBehaviorModeInternal.AutoOn}}" />
      </UniformGrid>
    </Grid>
    <Grid Row="1" HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" HorizontalAlignment="Left" TextWrapping="WrapWithOverflow" Foreground="{Binding PANELDISABLEDCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding SelectedAudioInput.BehaviorMode, Converter={StaticResource EnumToContentConverter}}" />
      <commonControls:BorderlessToggleButton Name="optionsButton" Grid.Column="1" Visibility="{Binding BehaviorMode, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static vm:AudioBehaviorModeInternal.AutoOn}}">
        <commonControls:ImageMask Width="16" HorizontalAlignment="Right" ImageSource="{StaticResource {x:Static themesUI:Icons.SettingsGeneral}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessToggleButton}}}" />
      </commonControls:BorderlessToggleButton>
    </Grid>
    <commonControls:AnchoredPopup Name="linkedVideoInputsPopup" HorizontalAlignment="Center" Placement="Bottom" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=optionsButton}" PlacementTarget="{Binding ElementName=optionsButton}">
      <Border Width="200" Height="300" BorderThickness="1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
          <StackPanel Orientation="Vertical">
            <TextBlock Margin="10,4,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Medium" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_MODE_OPTIONS_POPUP_label}" />
            <Separator Margin="0,2" />
            <ItemsControl FocusVisualStyle="{x:Null}" ItemsSource="{Binding Data.VideoInputs, Source={StaticResource audioModeSelectorDataContextProxy}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Vertical">
                    <Grid Height="24">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsLinked, Mode=TwoWay}" />
                      <TextBlock Grid.Column="1" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
                    </Grid>
                    <Separator Margin="0,2" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </commonControls:AnchoredPopup>
  </Grid>
</UserControl>