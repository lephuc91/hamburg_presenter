<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.Video.DirectXPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="directXPreview" Background="#FF000000" xmlns:video="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Video">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="directXPreviewProxy" Data="{Binding ElementName=directXPreview}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <commonControls:DirectXImage Width="{Binding ElementName=directXPreview, Path=ActualWidth}" Height="{Binding ElementName=directXPreview, Path=ActualHeight}" RequestRenderCommand="{Binding Data.RequestRenderCommand, Source={StaticResource directXPreviewProxy}}" Visibility="{Binding Data.VideoInput.HasSignal, Source={StaticResource directXPreviewProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="#FFFFFFFF" Text="{mex:Localized GLOBAL_VIDEO_INPUT_NO_VIDEO_SOURCE_title}" Visibility="{Binding Data.VideoInput.VideoDevice, Source={StaticResource directXPreviewProxy}, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Null}}" />
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_INPUTS_VIDEO_PREVIEW_STATUS_DEVICE_NO_SIGNAL_title}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding Data.VideoInput.VideoDevice, Source={StaticResource directXPreviewProxy}, Converter={StaticResource IsNotNullToBoolConverter}}" />
                  <Condition Value="False" Binding="{Binding Data.VideoInput.HasSignal, Source={StaticResource directXPreviewProxy}}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
    </Grid>
  </Grid>
</UserControl>