<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.Video.AddVideoInputOnEmpty" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:controls="clr-namespace:ProPresenter.UI.Controls" xmlns:input="clr-namespace:ProPresenter.UI.Input" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Video" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:ImageTextButton Grid.Column="0" VerticalAlignment="Center" ButtonHeight="80" ButtonWidth="80" ImageSource="{StaticResource {x:Static themes:Icons.EmptyAdd}}" ButtonBackground="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" Command="{Binding AddVideoInputCommand}" Text="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUT_ADD_label}" />
      <Rectangle Grid.Column="1" Width="2" Height="80" Margin="0,-20,0,0" Fill="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" />
      <controls:ImageTextButton Grid.Column="2" VerticalAlignment="Center" ButtonHeight="80" ButtonWidth="80" ImageSource="{StaticResource {x:Static themes:Icons.EmptyAdd}}" ButtonBackground="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" Command="{Binding AddAirCastDeviceOnEmptyCommand}" Text="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUT_ADD_AIRCAST_label}" />
    </Grid>
  </Grid>
</UserControl>