<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.Video.AddVideoInput" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:liveVideo="clr-namespace:ProPresenter.UI.LiveVideo" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:video="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Video">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="VideoInputsSettingsVMProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
    <commonControls:BorderlessPathButton Margin="4,4,0,4" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" PathType="Plus">
      <FrameworkElement.ContextMenu>
        <ContextMenu Placement="Bottom" VirtualizingPanel.IsVirtualizing="True" MinWidth="{Binding Path=PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
          <ItemsControl.ItemsSource>
            <CompositeCollection>
              <CollectionContainer>
                <CollectionContainer.Collection>
                  <liveVideo:VideoInputDeviceSelectorSource AddAirCastDeviceCommand="{Binding Data.AddAirCastDeviceCommand, Source={StaticResource VideoInputsSettingsVMProxy}}" AvailableDevices="{Binding Data.VideoDevices, Source={StaticResource VideoInputsSettingsVMProxy}}" SelectVideoDeviceCommand="{Binding Data.AddVideoDeviceCommand, Source={StaticResource VideoInputsSettingsVMProxy}}" SetNoSourceCommand="{Binding Data.AddVideoInputCommand, Source={StaticResource VideoInputsSettingsVMProxy}}" />
                </CollectionContainer.Collection>
              </CollectionContainer>
            </CompositeCollection>
          </ItemsControl.ItemsSource>
        </ContextMenu>
      </FrameworkElement.ContextMenu>
    </commonControls:BorderlessPathButton>
    <Border Width="1" Margin="8" BorderThickness="1,0,0,0" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" />
    <commonControls:BorderlessPathButton Margin="0,4" PathType="Minus" Command="{Binding RemoveVideoInputCommand}" />
  </StackPanel>
</UserControl>