<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.Video.VideoInputPreviewSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:liveVideoControls="clr-namespace:ProPresenter.UI.LiveVideo" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Video" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:previewViewSettings="clr-namespace:ProPresenter.DO.PanelViewSettings;assembly=ProPresenter.DO" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:thumbnails="clr-namespace:ProPresenter.UI.Thumbnails" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="videoSettings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="videoSettingsProxy" Data="{Binding ElementName=videoSettings}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:TimeSliceToTimeFormatConverter x:Key="TimeSliceToTimeFormatConverter" ConversionUnit="TotalMilliSeconds" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="1*" />
      <RowDefinition Height="45" />
    </Grid.RowDefinitions>
    <thumbnails:PreviewContainer x:Name="PreviewContainer" Grid.Row="0" AspectRatio="{Binding ElementName=videoSettings, Path=PreviewAspectRatio}" ViewSettings="{di:DIMarkup {x:Type previewViewSettings:ThumbnailViewSettings}}">
      <ContentControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="{Binding ElementName=PreviewContainer, Path=ActualWidth}" Height="{Binding ElementName=PreviewContainer, Path=ActualHeight}">
        <ContentControl.Content>
          <local:DirectXPreview RequestRenderCommand="{Binding Data.RequestRenderCommand, Source={StaticResource videoSettingsProxy}}" VideoInput="{Binding Data.VideoInput, Source={StaticResource videoSettingsProxy}}" Visibility="{Binding IsPreviewActive, ElementName=videoSettings, Converter={StaticResource ValueToVisibilityConverter}}" />
        </ContentControl.Content>
      </ContentControl>
      <liveVideoControls:VideoInputPreview Width="{Binding ElementName=PreviewContainer, Path=ActualWidth}" Height="{Binding ElementName=PreviewContainer, Path=ActualHeight}" VideoInput="{Binding VideoInput, ElementName=videoSettings}" Visibility="{Binding IsPreviewActive, ElementName=videoSettings, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
    </thumbnails:PreviewContainer>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <commonControls:BorderlessToggleButton Width="24" Height="24" IsChecked="{Binding IsPreviewActive, ElementName=videoSettings}">
        <commonControls:ImageMask Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessToggleButton}}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type commonControls:ImageMask}">
              <Setter Property="commonControls:ImageMask.ImageSource" Value="/ProPresenter.UI;component/Resources/Icons/Preferences/Input/Off.png" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessToggleButton}}}">
                  <Setter Property="commonControls:ImageMask.ImageSource" Value="/ProPresenter.UI;component/Resources/Icons/Preferences/Input/On.png" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:ImageMask>
      </commonControls:BorderlessToggleButton>
      <commonControls:BorderlessToggleButton Grid.Column="1" Width="24" Height="24" uiUtility:UIElementHelper.Palette="{Binding AUDIOMONITORINGBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" Command="{Binding ToggleVideoInputAudioMonitoringCommand, ElementName=videoSettings}" IsChecked="{Binding VideoInput.AudioSource.IsMonitoring, ElementName=videoSettings, Mode=OneWay}" ToolTip="{mex:Localized SETTINGS_INPUTS_VIDEO_MONITOR_AUDIO_tooltip}" Visibility="{Binding VideoInput.AudioSource.HasDevice, ElementName=videoSettings, Converter={StaticResource ValueToVisibilityConverter}}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/Preferences/Input/InputListen@2x.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessToggleButton}}}" />
      </commonControls:BorderlessToggleButton>
      <Rectangle Grid.Column="2" Width="1" Height="24" Margin="10,0" VerticalAlignment="Center" Fill="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" />
      <commonControls:BorderlessButton Grid.Column="3" Width="24" Height="24" Command="{Binding CaptureThumbnailCommand, ElementName=videoSettings}" ToolTip="{mex:Localized SETTINGS_INPUTS_VIDEO_CAPTURE_THUMBNAIL_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/Preferences/Input/Enabled.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
      </commonControls:BorderlessButton>
      <commonControls:BorderlessButton Grid.Column="4" Width="24" Height="24" Command="{Binding SelectThumbnailCommand, ElementName=videoSettings}" ToolTip="{mex:Localized SETTINGS_INPUTS_VIDEO_CHOOSE_THUMBNAIL_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/Preferences/Input/SelectThumbnail.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
      </commonControls:BorderlessButton>
      <commonControls:BorderlessButton Grid.Column="5" Width="24" Height="24" Command="{Binding ClearThumbnailCommand, ElementName=videoSettings}" ToolTip="{mex:Localized SETTINGS_INPUTS_VIDEO_CLEAR_THUMBNAIL_tooltip}" Visibility="{Binding VideoInput.HasThumbnail, ElementName=videoSettings, Converter={StaticResource ValueToVisibilityConverter}}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/Preferences/Input/ClearThumbnail.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
      </commonControls:BorderlessButton>
      <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding VideoInput.VideoMode.Name, ElementName=videoSettings}" Visibility="{Binding VideoInput.HasSignal, ElementName=videoSettings, Converter={StaticResource ValueToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>