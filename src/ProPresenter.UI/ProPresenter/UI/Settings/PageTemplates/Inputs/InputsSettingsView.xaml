<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.InputsSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:audio="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Audio" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:video="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs.Video">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:TimeSliceToDoubleSecondConverter x:Key="TimeSliceToDoubleSecondConverter" RoundDecimalPlace="1" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="4" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
        <TabControl Margin="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" SelectedIndex="{Binding SelectedIndex}">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="4" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
                  <UniformGrid Name="HeaderPanel" HorizontalAlignment="Stretch" IsItemsHost="True" Rows="1" />
                </Border>
                <Separator Grid.Row="1" Margin="0,8" />
                <Border Name="Border" Grid.Row="2" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                  <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Control.Template>
          <commonControls:BorderlessTabItem uiUtility:UIElementHelper.CornerRadius="4">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock HorizontalAlignment="Center" Text="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUTS_title}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <Grid>
              <video:DirectXVideoInputsView DataContext="{Binding VideoInputsSettingsVM}" />
            </Grid>
          </commonControls:BorderlessTabItem>
          <commonControls:BorderlessTabItem uiUtility:UIElementHelper.CornerRadius="4">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock HorizontalAlignment="Center" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUTS_title}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <audio:AudioInputsView DataContext="{Binding AudioInputsSettingsVM}" />
          </commonControls:BorderlessTabItem>
        </TabControl>
      </Border>
      <local:InputsDetailsView Grid.Row="1" DataContext="{Binding}" />
    </Grid>
  </ScrollViewer>
</UserControl>