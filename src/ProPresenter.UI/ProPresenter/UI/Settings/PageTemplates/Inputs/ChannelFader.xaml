<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.ChannelFader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:audio="clr-namespace:Pro.DO.Audio;assembly=Pro.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:input="clr-namespace:ProPresenter.UI.Input" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs" x:Name="channelFaderSelf">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <local:DecibelToBrushConverter x:Key="DecibelToBrushConverter" />
      <local:DecibelToLabelConverter x:Key="DecibelToLabelConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="30" />
      <ColumnDefinition />
      <ColumnDefinition Width="150" />
      <ColumnDefinition Width="40" />
      <ColumnDefinition Width="40" />
      <ColumnDefinition Width="45" />
    </Grid.ColumnDefinitions>
    <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Channel.MuteActive, ElementName=channelFaderSelf, Converter={StaticResource InvertedBooleanConverter}}" />
    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ChannelName, ElementName=channelFaderSelf}" />
    <input:LevelFillMeter Grid.Column="2" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ClipMarkFill="#FFFF0000" PeakValue="{Binding ThisChannelLevel.Peak, ElementName=channelFaderSelf}" ShowClipMark="{Binding ThisChannelLevel.Clip, ElementName=channelFaderSelf}" Value="{Binding ThisChannelLevel.RMS, ElementName=channelFaderSelf}" />
    <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding ThisChannelLevel.Peak, ElementName=channelFaderSelf, Converter={StaticResource DecibelToBrushConverter}}" Text="{Binding ThisChannelLevel.Peak, Converter={StaticResource DecibelToLabelConverter}, ElementName=channelFaderSelf}" />
    <local:LevelSliderKnob Grid.Column="4" Width="26" Height="26" Margin="0,2" HorizontalAlignment="Center" VerticalAlignment="Center" TrackBackground="#3D3D3D" TrackFill="#4BD964" Value="{Binding Channel.Level, ElementName=channelFaderSelf}">
      <commonControls:SliderKnob.KnobFill>
        <LinearGradientBrush StartPoint="-.1 0" EndPoint="1.1 1">
          <GradientStop Offset="0" Color="#F4F4F4" />
          <GradientStop Offset="1" Color="#C6C6C6" />
        </LinearGradientBrush>
      </commonControls:SliderKnob.KnobFill>
    </local:LevelSliderKnob>
    <commonControls:DoubleUpDown Grid.Column="5" Width="40" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" FormatString="{}{0:N0}" Increment="1" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" ShowButtonSpinner="False" TextAlignment="Left" Value="{Binding Channel.Level, ElementName=channelFaderSelf}" />
  </Grid>
</UserControl>