<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.InputListItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" x:Name="inputListItem">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:StringNullOrEmptyToVisibilityConverter x:Key="InvertedStringNullOrEmptyToVisibilityConverter" IsInverted="True" />
      <Style x:Key="VideoInputIconStyle" TargetType="{x:Type local:InputListItemTemplate}">
        <Setter Property="local:InputListItemTemplate.Icon" Value="{StaticResource {x:Static themesUI:Icons.VideoInput}}" />
        <Style.Triggers>
          <DataTrigger Value="Aircast" Binding="{Binding VideoDevice.Type}">
            <Setter Property="local:InputListItemTemplate.Icon" Value="{StaticResource {x:Static themesUI:Icons.AirCastVideo}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="AudioInputIconStyle" TargetType="{x:Type local:InputListItemTemplate}">
        <Setter Property="local:InputListItemTemplate.Icon" Value="{StaticResource {x:Static themesUI:Icons.SettingsAudioInput}}" />
        <Style.Triggers>
          <DataTrigger Value="Aircast" Binding="{Binding Source.VideoDevice.Type}">
            <Setter Property="local:InputListItemTemplate.Icon" Value="{StaticResource {x:Static themesUI:Icons.AirCastAudio}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image Grid.Column="0" Margin="4,0,0,0" RenderOptions.BitmapScalingMode="Fant" Stretch="Uniform" Source="{Binding ElementName=inputListItem, Path=Icon}" />
    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding DefaultDescription}" />
    <TextBlock Grid.Column="2" Text=": " Visibility="{Binding Description, Converter={StaticResource InvertedStringNullOrEmptyToVisibilityConverter}}" />
    <commonControls:EditableTextBlock Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontStyle="Italic" Text="{Binding Description}" />
  </Grid>
</UserControl>