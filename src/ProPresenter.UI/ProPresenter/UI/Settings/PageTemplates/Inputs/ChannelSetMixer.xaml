<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Inputs.ChannelSetMixer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Inputs" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="channelSetMixerSelf">
  <FrameworkElement.Resources>
    <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
    <utility:BindingProxy x:Key="channelSetMixerProxy" Data="{Binding ElementName=channelSetMixerSelf}" />
  </FrameworkElement.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
    <ItemsControl FocusVisualStyle="{x:Null}" ItemsSource="{Binding ChannelSet, ElementName=channelSetMixerSelf}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Vertical">
            <local:ChannelFader AllChannelLevels="{Binding Data.ChannelLevels, Source={StaticResource channelSetMixerProxy}, Mode=OneWay}" Channel="{Binding}" ChannelMap="{Binding Data.ChannelMap, Source={StaticResource channelSetMixerProxy}}" ChannelName="{Binding Name, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=SETTINGS_INPUTS_AUDIO_CHANNEL_title}" />
            <Separator Margin="0,2" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>