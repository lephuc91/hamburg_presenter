<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Integrations.MultiTracksSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:integrations="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Integrations">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="multiTracksSettingsVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Image Width="400" VerticalAlignment="Top" Source="{StaticResource {x:Static themes:Icons.MultiTracksTrademark}}" Stretch="Uniform" />
    <Grid Row="1" Margin="0,25,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource InvertedValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Text="{mex:Localized SETTINGS_MULTITRACKS_MARKETING_description}" />
      <Button Grid.Row="1" MinWidth="80" Margin="0,25,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Command="{Binding LoginLogoutCommand}" Content="{mex:Localized GLOBAL_LOGIN_title}" />
    </Grid>
    <Grid Row="1" Margin="0,25,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <commonControls:GroupedControl Grid.Row="0">
        <Grid DataContext="{Binding Data, Source={StaticResource multiTracksSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_MULTITRACKS_USER_title}" />
          <TextBlock Grid.Column="1" Text="{Binding Username}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource multiTracksSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_MULTITRACKS_ORGANIZATION_title}" />
          <TextBlock Grid.Column="1" Text="{Binding OrganizationName}" />
        </Grid>
      </commonControls:GroupedControl>
      <Button Grid.Row="1" MinWidth="80" Margin="0,25,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding LoginLogoutCommand}" Content="{mex:Localized GLOBAL_LOGOUT_title}" />
    </Grid>
    <commonControls:HelpButton Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding HelpCommand}" />
    <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <Hyperlink Command="{Binding OpenSupportCommand}">
        <TextBlock Text="multitracks.com" />
      </Hyperlink>
    </TextBlock>
  </Grid>
</UserControl>