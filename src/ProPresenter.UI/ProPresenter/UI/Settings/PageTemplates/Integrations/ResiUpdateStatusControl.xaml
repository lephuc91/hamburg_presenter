<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Integrations.ResiUpdateStatusControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" x:Name="updateStatusControl" xmlns:integrations="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Integrations;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Height="22">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock VerticalAlignment="Center" Text="{Binding UpdateStatus, Converter={StaticResource EnumToContentConverter}, ElementName=updateStatusControl}" />
    <ProgressBar Grid.Column="1" Height="4" Margin="7,0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay, ElementName=updateStatusControl}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ProgressBar}}" TargetType="{x:Type ProgressBar}">
          <Setter Property="ProgressBar.IsIndeterminate" Value="False" />
          <Style.Triggers>
            <DataTrigger Value="Installing" Binding="{Binding UpdateStatus, ElementName=updateStatusControl}">
              <Setter Property="ProgressBar.IsIndeterminate" Value="True" />
            </DataTrigger>
            <DataTrigger Value="Starting" Binding="{Binding UpdateStatus, ElementName=updateStatusControl}">
              <Setter Property="ProgressBar.IsIndeterminate" Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ProgressBar>
    <commonControls:CloseButton Grid.Column="2" Width="18" Height="18" Command="{Binding CancelDownloadCommand, ElementName=updateStatusControl}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type commonControls:CloseButton}}" TargetType="{x:Type commonControls:CloseButton}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <DataTrigger Value="Downloading" Binding="{Binding UpdateStatus, ElementName=updateStatusControl}">
              <Setter Property="IsEnabled" Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </commonControls:CloseButton>
  </Grid>
</UserControl>