<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Integrations.IntegrationsSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:integrations="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Integrations">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="integrationsSettingsVMProxy" Data="{Binding}" />
      <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <converters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <local:ChildPageButton x:Key="ResiButton" ChildPageVM="{Binding}" DataContext="{Binding Data.Resi, Source={StaticResource integrationsSettingsVMProxy}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
            <Image Width="24" Stretch="Uniform" Source="{StaticResource {x:Static themes:Icons.SettingsResi}}" />
          </Border>
          <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_INTEGRATIONS_RESI_title}" />
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding StatusText}" />
        </Grid>
      </local:ChildPageButton>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <commonControls:GroupedControl VerticalAlignment="Top" Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}" Visibility="{Binding ShowHoW, Converter={StaticResource ValueToVisibilityConverter}}">
      <local:ChildPageButton ChildPageVM="{Binding}" DataContext="{Binding Data.PlanningCenter, Source={StaticResource integrationsSettingsVMProxy}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
            <Image Width="24" Source="{StaticResource {x:Static themes:Icons.SettingsPlanningCenter}}" Stretch="Uniform" />
          </Border>
          <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_INTEGRATIONS_PLANNING_CENTER_title}" />
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding StatusText}" />
        </Grid>
      </local:ChildPageButton>
      <local:ChildPageButton ChildPageVM="{Binding}" DataContext="{Binding Data.MultiTracks, Source={StaticResource integrationsSettingsVMProxy}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
            <Image Width="24" Source="{StaticResource {x:Static themes:Icons.SettingsMultiTracks}}" Stretch="Uniform" />
          </Border>
          <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_INTEGRATIONS_MULTITRACKS_title}" />
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding StatusText}" />
        </Grid>
      </local:ChildPageButton>
      <local:ChildPageButton ChildPageVM="{Binding}" DataContext="{Binding Data.SongSelect, Source={StaticResource integrationsSettingsVMProxy}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="8" Background="{Binding SOURCELIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
            <Image Width="24" Source="{StaticResource {x:Static themes:Icons.SettingsSongSelect}}" Stretch="Uniform" />
          </Border>
          <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_INTEGRATIONS_SONGSELECT_title}" />
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding StatusText}" />
        </Grid>
      </local:ChildPageButton>
      <StaticResourceExtension ResourceKey="ResiButton" />
    </commonControls:GroupedControl>
    <commonControls:GroupedControl VerticalAlignment="Top" Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}" Visibility="{Binding ShowHoW, Converter={StaticResource InvertedValueToVisibilityConverter}}">
      <StaticResourceExtension ResourceKey="ResiButton" />
    </commonControls:GroupedControl>
  </Grid>
</UserControl>