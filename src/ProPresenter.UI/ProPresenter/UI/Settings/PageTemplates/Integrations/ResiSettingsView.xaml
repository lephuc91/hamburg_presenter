<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Integrations.ResiSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:captureAnalytics="clr-namespace:ProPresenter.DO.Analytics.Events.Capture;assembly=ProPresenter.DO" xmlns:commands="clr-namespace:ProPresenter.UI.Commands" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Integrations" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.Settings.Pages.Integrations">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="resiSettingsVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Image Width="400" VerticalAlignment="Top" Source="{StaticResource {x:Static themes:Icons.ResiBrandLogo}}" Stretch="Uniform" />
    <Grid Row="1" Margin="0,25,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource InvertedValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Text="{mex:Localized SETTINGS_RESI_MARKETING_description}" />
      <StackPanel Grid.Row="1" Margin="0,25,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
        <Button Grid.Column="0" MinWidth="80" Margin="0,0,10,0" Command="{Binding MoreInfoCommand}" Content="{mex:Localized RESI_CAPTURE_SETTINGS_MORE_INFO_BUTTON_title}" />
        <Button MinWidth="80" HorizontalAlignment="Center" VerticalAlignment="Top" Command="{Binding LoginCommand}" Content="{mex:Localized SETTINGS_RESI_ACCOUNT_REGISTER_BUTTON_title}" />
      </StackPanel>
    </Grid>
    <Grid Row="1" Margin="0,25,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_RESI_ACCOUNT_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="1">
        <Grid DataContext="{Binding Data, Source={StaticResource resiSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_RESI_ACCOUNT_ORGANIZATION_title}" />
          <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Username}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource resiSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_RESI_ACCOUNT_STATUS_title}" />
          <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding StatusText}" />
        </Grid>
      </commonControls:GroupedControl>
      <StackPanel Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
        <Button Margin="0,0,15,0" Command="{Binding ManageCommand}" Content="{mex:Localized SETTINGS_RESI_ACCOUNT_MANAGE_title}" />
        <Button Command="{Binding LogoutCommand}" Content="{mex:Localized SETTINGS_RESI_ACCOUNT_UNREGISTER_BUTTON_title}" />
      </StackPanel>
      <TextBlock Grid.Row="3" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_RESI_ENCODER_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="4">
        <Grid DataContext="{Binding Data, Source={StaticResource resiSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_RESI_ENCODER_NAME_title}" />
          <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding EncoderName}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource resiSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_RESI_ENCODER_VERSION_title}" />
          <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Right" Text="{Binding PluginVersion}" Visibility="{Binding ShowDownload, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          <Button Grid.Column="1" Width="150" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" uiUtility:UIElementHelper.CornerRadius="4" Command="{Binding DownloadCommand}" Content="{Binding DownloadButtonLabel}" Visibility="{Binding ShowDownload, Converter={StaticResource ValueToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                <Setter Property="IsEnabled" Value="True" />
                <Style.Triggers>
                  <DataTrigger Value="Downloading" Binding="{Binding UpdateStatus}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Button>
        </Grid>
        <local:ResiUpdateStatusControl CancelDownloadCommand="{Binding CancelDownloadCommand}" DataContext="{Binding Data, Source={StaticResource resiSettingsVMProxy}}" DownloadProgress="{Binding DownloadProgress}" UpdateStatus="{Binding UpdateStatus}" Visibility="{Binding UpdateStatus, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static vm:UpdateStatusInternal.None}}" />
      </commonControls:GroupedControl>
      <Button Grid.Row="5" Margin="0,15,0,0" HorizontalAlignment="Right" Command="{Binding CheckUpdateCommand}" Content="{mex:Localized SETTINGS_RESI_ENCODER_CHECK_UPDATE_title}" Visibility="{Binding ShowCheckUpdate, Converter={StaticResource ValueToVisibilityConverter}}" />
    </Grid>
    <commonControls:HelpButton Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding HelpCommand}" Visibility="{Binding IsLoggedIn, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
    <Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" uiUtility:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" CommandParameter="{x:Static captureAnalytics:CaptureShownSource.PreferenceResi}" Command="{Binding ScreensMenu.CaptureSettings.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Content="{mex:Localized SETTINGS_RESI_ENCODER_CAPTURE_SETTINGS_title}" Visibility="{Binding IsLoggedIn, Converter={StaticResource ValueToVisibilityConverter}}" />
    <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <Hyperlink Command="{Binding OpenSupportCommand}">
        <TextBlock Text="{Binding SupportLinkMask}" />
      </Hyperlink>
    </TextBlock>
  </Grid>
</UserControl>