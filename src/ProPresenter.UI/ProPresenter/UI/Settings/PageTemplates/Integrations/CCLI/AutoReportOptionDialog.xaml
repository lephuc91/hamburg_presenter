    <Button Grid.Row="3" Width="200" Height="22" Margin="0,0,0,10" IsDefault="True" Content="{mex:Localized SETTINGS_SONGSELECT_AUTOMATICALLY_REPORT_BUTTON_title}" Click="AutoReport_Click" />
    <Button Grid.Row="4" Width="200" Height="22" Content="{mex:Localized SETTINGS_SONGSELECT_MANUALLY_REPORT_BUTTON_title}" Click="ManualReport_Click" />
  </Grid>
</windowing:ChromedWindow>