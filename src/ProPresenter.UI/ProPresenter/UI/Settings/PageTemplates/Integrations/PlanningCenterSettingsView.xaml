<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.Integrations.PlanningCenterSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:integrations="clr-namespace:ProPresenter.UI.Settings.PageTemplates.Integrations">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="planningCenterSettingsVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Image Width="400" VerticalAlignment="Top" Source="{StaticResource {x:Static themes:Icons.PlanningCenterTrademark}}" Stretch="Uniform" />
    <Grid Row="1" Margin="0,25,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource InvertedValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_MARKETING_description}" />
      <Button Grid.Row="1" MinWidth="80" Margin="0,25,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Command="{Binding LoginLogoutCommand}" Content="{mex:Localized GLOBAL_LOGIN_title}" />
    </Grid>
    <Grid Row="1" Margin="0,25,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <commonControls:GroupedControl Grid.Row="0">
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_USER_title}" />
          <TextBlock Grid.Column="1" Text="{Binding Username}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_ORGANIZATION_title}" />
          <TextBlock Grid.Column="1" Text="{Binding OrganizationName}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_AUTO_CHECK_PLAN_UPDATES_title}" />
          <commonControls:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPlanUpdate, Mode=TwoWay}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_MATCH_PRESENTATIONS_IN_LIBRARY_title}" />
          <commonControls:ToggleSwitch Grid.Column="1" IsChecked="{Binding MatchSongs, Mode=TwoWay}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_SHOW_HISTORICAL_SERVICE_PLANS_title}" />
          <commonControls:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowHistoricalPlans, Mode=TwoWay}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_MAKE_ARRANGEMENTS_title}" />
          <commonControls:ToggleSwitch Grid.Column="1" IsChecked="{Binding ArrangementFromSequences, Mode=TwoWay}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_AUTO_UPLOAD_title}" />
          <commonControls:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpload, Mode=TwoWay}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_AUTO_DOWNLOAD_title}" />
          <commonControls:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownload, Mode=TwoWay}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource planningCenterSettingsVMProxy}}" Visibility="{Binding AutoDownload, Converter={StaticResource ValueToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_PLANNING_CENTER_DOWNLOAD_LIBRARY_title}" />
          <commonControls:BorderlessDropDownButton Grid.Column="1">
            <commonControls:BorderlessDropDownButton.CustomContent>
              <TextBlock Margin="0,0,5,0" Text="{Binding TargetLibrary}" />
            </commonControls:BorderlessDropDownButton.CustomContent>
            <commonControls:BorderlessDropDownButton.CustomContextMenu>
              <ContextMenu Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Data.LibraryCollection, Source={StaticResource planningCenterSettingsVMProxy}}">
                <ItemsControl.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="MenuItem.Command" Value="{Binding Data.SelectLibraryCommand, Source={StaticResource planningCenterSettingsVMProxy}}" />
                    <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="MenuItem.IsChecked">
                      <Setter.Value>
                        <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                          <MultiBinding.Bindings>
                            <Binding Path="Name" />
                            <Binding Path="Data.TargetLibrary" Source="{StaticResource planningCenterSettingsVMProxy}" />
                          </MultiBinding.Bindings>
                        </MultiBinding>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </ContextMenu>
            </commonControls:BorderlessDropDownButton.CustomContextMenu>
          </commonControls:BorderlessDropDownButton>
        </Grid>
      </commonControls:GroupedControl>
      <Button Grid.Row="1" MinWidth="80" Margin="0,25,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding LoginLogoutCommand}" Content="{mex:Localized GLOBAL_LOGOUT_title}" />
    </Grid>
    <commonControls:HelpButton Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding HelpCommand}" />
    <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <Hyperlink Command="{Binding OpenSupportCommand}">
        <TextBlock Text="planningcenter.com/services" />
      </Hyperlink>
    </TextBlock>
  </Grid>
</UserControl>