<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.ImportSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proSSAPI="clr-namespace:Pro.ssAPI;assembly=Pro.ssAPI" xmlns:proTriggering="clr-namespace:Pro.DO.Triggering;assembly=Pro.DO" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.Settings.Pages.Import" xmlns:pagetemplates="clr-namespace:ProPresenter.UI.Settings.PageTemplates">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="importSettingsVMProxy" Data="{Binding}" />
      <commonConverters:TimeSliceToTimeFormatConverter x:Key="TimeSliceToTimeFormatConverter" ConversionUnit="TotalSeconds" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <ObjectDataProvider x:Key="EndBehavior" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="proSSAPI:EndBehaviorType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="Duration" MethodName="GetValues" ObjectType="{x:Type Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="vm:ImportDurationTypeInternal" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="BaseComboBoxStyle" BasedOn="{StaticResource {x:Type commonControls:BorderlessComboBox}}" TargetType="{x:Type commonControls:BorderlessComboBox}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="ItemTemplate">
          <Setter.Value>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ScaleBehaviorComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="{x:Type commonControls:BorderlessComboBox}">
        <Setter Property="ItemsSource">
          <Setter.Value>
            <ui:ScaleBehaviorItemsSource SupportsCustomScale="False" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LayerComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="{x:Type commonControls:BorderlessComboBox}">
        <Setter Property="ItemsSource">
          <Setter.Value>
            <collections1:ArrayList xmlns:collections1="clr-namespace:System.Collections;assembly=System.Runtime">
              <vm:ImportLayerInternal>Background</vm:ImportLayerInternal>
              <vm:ImportLayerInternal>Foreground</vm:ImportLayerInternal>
            </collections1:ArrayList>
          </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="100" />
      </Style>
      <Style x:Key="NextBehaviorComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="{x:Type commonControls:BorderlessComboBox}">
        <Setter Property="ItemsSource">
          <Setter.Value>
            <ArrayList xmlns="clr-namespace:System.Collections;assembly=System.Runtime">
              <proTriggering:CompletionTargetType>None</proTriggering:CompletionTargetType>
              <proTriggering:CompletionTargetType>Next</proTriggering:CompletionTargetType>
              <proTriggering:CompletionTargetType>Random</proTriggering:CompletionTargetType>
            </ArrayList>
          </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="100" />
      </Style>
      <Style x:Key="PlaybackBehaviorComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="{x:Type commonControls:BorderlessComboBox}">
        <Setter Property="ItemsSource">
          <Setter.Value>
            <ArrayList xmlns="clr-namespace:System.Collections;assembly=System.Runtime">
              <proSSAPI:PlaybackBehaviorType>Stop</proSSAPI:PlaybackBehaviorType>
              <proSSAPI:PlaybackBehaviorType>Loop</proSSAPI:PlaybackBehaviorType>
            </ArrayList>
          </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="100" />
      </Style>
      <Style x:Key="AudioBehaviorComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="{x:Type commonControls:BorderlessComboBox}">
        <Setter Property="ItemsSource">
          <Setter.Value>
            <ArrayList xmlns="clr-namespace:System.Collections;assembly=System.Runtime">
              <proTriggering:AudioBehaviorType>Stop</proTriggering:AudioBehaviorType>
              <proTriggering:AudioBehaviorType>Loop</proTriggering:AudioBehaviorType>
              <proTriggering:AudioBehaviorType>Next</proTriggering:AudioBehaviorType>
            </ArrayList>
          </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="100" />
      </Style>
      <Style x:Key="RandomTimeInputControlStyle" BasedOn="{StaticResource {x:Type commonControls:IntegerUpDown}}" TargetType="{x:Type commonControls:IntegerUpDown}">
        <Setter Property="NumericUpDown.FormatString" Value="{}{0}s" />
        <Setter Property="Visibility" Value="{Binding ImportDurationType, ConverterParameter={x:Static vm:ImportDurationTypeInternal.Random}, Converter={StaticResource ValueToVisibilityConverter}}" />
        <Setter Property="Width" Value="60" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_IMPORT_SCALING_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="1">
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_SCALING_FOREGROUND_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource ScaleBehaviorComboBoxStyle}" SelectedItem="{Binding ForegroundScaleBehavior}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_SCALING_BACKGROUND_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource ScaleBehaviorComboBoxStyle}" SelectedItem="{Binding BackgroundScaleBehavior}" />
        </Grid>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="2" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_IMPORT_IMAGE_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="3">
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_IMAGE_BEHAVIOR_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource LayerComboBoxStyle}" SelectedItem="{Binding ImageLayer}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_IMAGE_DURATION_title}" />
          <Grid Column="1" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <commonControls:BorderlessComboBox Width="100" Style="{StaticResource BaseComboBoxStyle}" ItemsSource="{Binding Source={StaticResource Duration}}" SelectedItem="{Binding ImportDurationType}" />
            <commonControls:IntegerUpDown Grid.Column="1" Width="60" Margin="7,0,0,0" VerticalAlignment="Center" FormatString="{}{0}s" Minimum="1" Visibility="{Binding ImportDurationType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static vm:ImportDurationTypeInternal.Time}}" Value="{Binding ImageDurationTime, Converter={StaticResource TimeSliceToTimeFormatConverter}}" />
            <commonControls:IntegerUpDown Grid.Column="1" Margin="7,0" VerticalAlignment="Center" Minimum="1" Style="{StaticResource RandomTimeInputControlStyle}" Maximum="{Binding RandomMaxTime}" Value="{Binding RandomMinTime}" />
            <commonControls:IntegerUpDown Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource RandomTimeInputControlStyle}" Minimum="{Binding RandomMinTime}" Value="{Binding RandomMaxTime}" />
          </Grid>
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_IMAGE_NEXT_BEHAVIOR_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource NextBehaviorComboBoxStyle}" IsEnabled="{Binding IsImageNextBehaviorEnabled}" SelectedItem="{Binding ImageNextBehavior}" />
        </Grid>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="4" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_IMPORT_VIDEO_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="5">
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_VIDEO_BEHAVIOR_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource LayerComboBoxStyle}" SelectedItem="{Binding VideoLayer}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_VIDEO_PLAYBACK_BEHAVIOR_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource PlaybackBehaviorComboBoxStyle}" SelectedItem="{Binding VideoPlaybackBehavior}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_VIDEO_END_BEHAVIOR_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource BaseComboBoxStyle}" IsEnabled="{Binding IsVideoEndAndNextBehaviorEnabled}" ItemsSource="{Binding Source={StaticResource EndBehavior}}" SelectedItem="{Binding VideoEndBehavior}" />
        </Grid>
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_VIDEO_NEXT_BEHAVIOR_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource NextBehaviorComboBoxStyle}" IsEnabled="{Binding IsVideoEndAndNextBehaviorEnabled}" SelectedItem="{Binding VideoNextBehavior}" />
        </Grid>
      </commonControls:GroupedControl>
      <TextBlock Grid.Row="6" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_IMPORT_AUDIO_SECTION_title}" />
      <commonControls:GroupedControl Grid.Row="7">
        <Grid DataContext="{Binding Data, Source={StaticResource importSettingsVMProxy}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_IMPORT_AUDIO_PLAYBACK_BEHAVIOR_title}" />
          <commonControls:BorderlessComboBox Grid.Column="1" Style="{StaticResource AudioBehaviorComboBoxStyle}" SelectedItem="{Binding AudioPlaybackBehavior}" />
        </Grid>
      </commonControls:GroupedControl>
    </Grid>
  </ScrollViewer>
</UserControl>