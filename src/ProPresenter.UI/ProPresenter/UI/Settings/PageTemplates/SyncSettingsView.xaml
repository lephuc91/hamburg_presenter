<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.PageTemplates.SyncSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.UI.Settings" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.Settings.Pages.Sync" xmlns:pagetemplates="clr-namespace:ProPresenter.UI.Settings.PageTemplates">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="syncSettingsVMProxy" Data="{Binding}" />
      <ObjectDataProvider x:Key="Direction" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="vm:SyncDirection" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:ValueToVisibilityConverter x:Key="NonCollapseValueToVisibilityConverter" IsCollapsing="False" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{Binding Source={x:Static settings:PageConstants.PAGE_MARGIN}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <commonControls:GroupedControl Grid.Row="0">
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,15,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_SYNC_REPOSITORY_title}" />
        <TextBox Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Text="{Binding Source}" />
        <commonControls:BorderlessButton Grid.Column="2" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding AddSourceCommand}">
          <commonControls:ImageMask ImageSource="{StaticResource {x:Static themes:Icons.FolderBrowser}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
        </commonControls:BorderlessButton>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,30,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_SYNC_REPOSITORY_description}" />
      </Grid>
    </commonControls:GroupedControl>
    <commonControls:GroupedControl Grid.Row="1" Margin="0,15,0,0">
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Margin="0,0,15,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_SYNC_DIRECTION_title}" />
        <commonControls:BorderlessComboBox Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding Source={StaticResource Direction}}" SelectedItem="{Binding Direction}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </commonControls:BorderlessComboBox>
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Margin="0,0,15,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized SETTINGS_SYNC_REPLACE_FILES_title}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized SETTINGS_SYNC_REPLACE_FILES_description}" />
        <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding ReplaceFiles, Mode=TwoWay}" />
      </Grid>
    </commonControls:GroupedControl>
    <TextBlock Grid.Row="2" Margin="0,25,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized SETTINGS_SYNC_INCLUDE_OPTIONS_SECTION_title}" />
    <commonControls:GroupedControl Grid.Row="3">
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_SYNC_INCLUDE_LIBRARIES_title}" />
        <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding IncludeLibraries, Mode=TwoWay}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_SYNC_INCLUDE_MEDIA_title}" />
        <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding IncludeMedia, Mode=TwoWay}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_SYNC_INCLUDE_PLAYLISTS_title}" />
        <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding IncludePlaylists, Mode=TwoWay}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_SYNC_INCLUDE_THEMES_title}" />
        <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding IncludeThemes, Mode=TwoWay}" />
      </Grid>
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{mex:Localized SETTINGS_SYNC_INCLUDE_SUPPORT_FILES_title}" />
        <commonControls:ToggleSwitch Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding IncludeConfiguration, Mode=TwoWay}" />
      </Grid>
    </commonControls:GroupedControl>
    <commonControls:GroupedControl Grid.Row="4" Margin="0,15,0,0">
      <Grid DataContext="{Binding Data, Source={StaticResource syncSettingsVMProxy}}">
        <Grid Visibility="{Binding SyncController.IsSyncing, Converter={StaticResource InvertedValueToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Left" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding ReadySyncTitle}" />
          <Button Grid.Column="1" Padding="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding SyncCommand}" Content="{mex:Localized SETTINGS_SYNC_SYNC_BUTTON_title}" />
        </Grid>
        <Grid Visibility="{Binding SyncController.IsSyncing, Converter={StaticResource ValueToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressBar Grid.Column="0" Height="4" Maximum="100" Minimum="0" Visibility="Visible" Value="{Binding SyncController.PercentComplete}" />
          <commonControls:CloseButton Grid.Column="1" Width="14" Height="14" Margin="5,0,0,0" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding SyncController.Current.Name}" />
        </Grid>
      </Grid>
    </commonControls:GroupedControl>
    <commonControls:HelpButton Grid.Row="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" HelpCommand="{Binding HelpCommand}" />
  </Grid>
</UserControl>