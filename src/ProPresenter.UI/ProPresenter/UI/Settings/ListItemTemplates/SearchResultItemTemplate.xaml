<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Settings.ListItemTemplates.SearchResultItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Settings.ListItemTemplates" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" x:Name="settingsItemTemplate">
  <ContentControl Content="{Binding}">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type ContentControl}">
        <Setter Property="ContentTemplate">
          <Setter.Value>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="20" Height="20" Margin="12,0,0,0" CornerRadius="4" Background="{Binding Background}">
                  <commonControls:ImageMask HorizontalAlignment="Center" VerticalAlignment="Center" Width="{Binding ImageSource.Width, RelativeSource={RelativeSource Self}}" Height="{Binding ImageSource.Height, RelativeSource={RelativeSource Self}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:SearchResultItemTemplate}}}" ImageSource="{Binding Icon}" />
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.7" ShadowDepth="1" Color="{StaticResource {x:Static themesUI:Colors.Shadow}}" />
                  </UIElement.Effect>
                </Border>
                <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{Binding NameIndent}" Text="{Binding Name}" ToolTip="{Binding Name}" />
              </Grid>
            </DataTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsRegistration}">
            <Setter Property="ContentTemplate">
              <Setter.Value>
                <DataTemplate>
                  <local:RegistrationItemTemplate DataContext="{Binding Item}" />
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
  </ContentControl>
</UserControl>