<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Header.HeaderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.Header" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="headerView" Background="{Binding HEADER, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <commonConverters:TimeSliceToStringConverter x:Key="TimeSliceToStringConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverterInverted" IsInverted="True" />
    <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <commonUtility:BindingProxy x:Key="headerViewProxy" Data="{Binding ElementName=headerView}" />
  </FrameworkElement.Resources>
  <Grid Height="36" Background="{Binding HeaderAction.Color, Converter={StaticResource ColorToBrushConverter}, ElementName=headerView}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" Effect="{StaticResource DefaultDropShadowEffect}" FontSize="20" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" Text="{Binding HeaderAction.Name, ElementName=headerView}" />
    <Button Grid.Column="1" Height="22" MinWidth="60" Padding="5,0" Command="{Binding TriggerHeaderItemCommand, ElementName=headerView}" CommandParameter="{Binding HeaderAction, ElementName=headerView}" Content="{mex:Localized CONTIGUOUS_VIEW_HEADER_TRIGGER_BUTTON_title}" />
    <commonControls:BorderlessToggleButton Name="settingsButton" Grid.Column="2" Width="20" Height="18" Margin="8,0" uiUtility:ContextMenuHelper.CenterMenu="True" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ContextMenuService.Placement="Bottom">
      <commonControls:ImageMask ImageSource="../Resources/Icons/GearIcon.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessToggleButton}}}" />
    </commonControls:BorderlessToggleButton>
    <commonControls:AnchoredPopup Placement="Bottom" StaysOpen="False" DataContext="{Binding Data, Source={StaticResource headerViewProxy}}" IsOpen="{Binding IsChecked, ElementName=settingsButton}" PlacementTarget="{Binding ElementName=settingsButton}">
      <local:HeaderSettings HeaderAction="{Binding HeaderAction}" Timers="{Binding Timers}" />
    </commonControls:AnchoredPopup>
  </Grid>
</UserControl>