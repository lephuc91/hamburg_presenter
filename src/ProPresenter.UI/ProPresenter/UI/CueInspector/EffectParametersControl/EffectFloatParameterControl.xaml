<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CueInspector.EffectParametersControl.EffectFloatParameterControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" x:Name="floatParamSelf" xmlns:effectparameterscontrol="clr-namespace:ProPresenter.UI.CueInspector.EffectParametersControl;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:FloatToDoubleConverter x:Key="FloatToDoubleConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Margin="5,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Label}" />
    <Slider Name="floatParamSlider" Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center" Maximum="{Binding MaxValue}" Minimum="{Binding MinValue}" Value="{Binding Value, Mode=TwoWay, ElementName=floatParamSelf, Converter={StaticResource FloatToDoubleConverter}}" />
    <commonControls:FloatUpDown Grid.Column="2" Width="55" Height="22" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FormatString="F2" Increment="0.01" Maximum="{Binding MaxValue}" Minimum="{Binding MinValue}" Value="{Binding Value, Mode=TwoWay, ElementName=floatParamSlider}" />
  </Grid>
</UserControl>