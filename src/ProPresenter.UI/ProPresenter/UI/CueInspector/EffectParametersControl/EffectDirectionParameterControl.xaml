<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CueInspector.EffectParametersControl.EffectDirectionParameterControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.CueInspector" xmlns:localConverter="clr-namespace:ProPresenter.UI.Transitions.Converters" x:Name="directionParamSelf" xmlns:effectparameterscontrol="clr-namespace:ProPresenter.UI.CueInspector.EffectParametersControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <localConverter:AvailableDirectionConverter x:Key="AvailableDirectionConverter" />
      <local:CueInspectorDirectionConverter x:Key="CueInspectorDirectionConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Margin="5,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Label}" />
    <ComboBox Grid.Column="1" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" ItemsSource="{Binding AllowedDirections, Converter={StaticResource AvailableDirectionConverter}}" SelectedItem="{Binding Value, ElementName=directionParamSelf, Mode=TwoWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Converter={StaticResource CueInspectorDirectionConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
  </Grid>
</UserControl>