<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CueInspector.Crop.PreviewOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.CueInspector.Crop" x:Name="self" Background="#01FFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="False" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <local:CropControl x:Name="CropControl" MouseMove="CropControl_MouseMove" MouseUp="CropControl_MouseUp" PreviewMouseDown="CropControl_PreviewMouseDown" CropPosition="{Binding PropertiesVM.CropPosition}" CropSize="{Binding PropertiesVM.CropSize}" MediaSize="{Binding PropertiesVM.MediaSize}" Visibility="{Binding PropertiesVM.CropEnable, Converter={StaticResource ValueToVisibilityConverter}}" />
</UserControl>