<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CueInspector.CueAudio" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:audioControls="clr-namespace:Pro.UI.Controls.Audio;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverter="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.CueInspector" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="cueAudio">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverter:TimeSliceToTimeFormatConverter x:Key="TimeSliceToTimeFormatConverter" ConversionUnit="TotalSeconds" SignificantDigits="2" />
      <commonUtility:BindingProxy x:Key="audioVMProxy" Data="{Binding}" />
      <Style x:Key="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}" TargetType="{x:Type Slider}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="80" MaxWidth="200" SharedSizeGroup="CIPropertiesLabelColumnGroup" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_FADE_IN_label}" />
    <Grid Row="0" Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Slider Grid.Column="0" Margin="0,0,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Maximum="5" Minimum="0" TickFrequency="0.05" Value="{Binding FadeIn, Converter={StaticResource TimeSliceToTimeFormatConverter}, Mode=TwoWay}" />
      <commonControls:DoubleUpDown Grid.Column="1" Width="60" Height="22" Margin="2,0,0,5" VerticalAlignment="Center" FormatString="{}{0}s" Increment="0.05" Maximum="5" Minimum="0" Value="{Binding FadeIn, Converter={StaticResource TimeSliceToTimeFormatConverter}}" />
    </Grid>
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_FADE_OUT_label}" />
    <Grid Row="1" Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Slider Grid.Column="0" Margin="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Maximum="5" Minimum="0" TickFrequency="0.05" Value="{Binding FadeOut, Converter={StaticResource TimeSliceToTimeFormatConverter}, Mode=TwoWay}" />
      <commonControls:DoubleUpDown Grid.Column="1" Width="60" Height="22" Margin="2,0,0,0" VerticalAlignment="Center" FormatString="{}{0}s" Increment="0.05" Maximum="5" Minimum="0" Value="{Binding FadeOut, Converter={StaticResource TimeSliceToTimeFormatConverter}}" />
    </Grid>
    <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10" HorizontalAlignment="Stretch" />
    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNELS_label}" />
    <Button Grid.Row="3" Grid.Column="1" Height="22" Padding="5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Content="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNEL_ROUTING_title}">
      <FrameworkElement.ContextMenu>
        <ContextMenu Placement="Bottom">
          <Control.Template>
            <ControlTemplate>
              <audioControls:MediaToVirtualChannelControl BorderThickness="1" ShowInputAudioControls="False" ShowMuteAndSoloButtons="False" ShowOutputAudioControls="False" ShowOutputChannelIndex="True" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" AudioMap="{Binding Data.AudioMap, Source={StaticResource audioVMProxy}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" BorderBrush="{Binding (uiUtility:UIElementHelper.Palette).Standard.Border, RelativeSource={RelativeSource Self}}" ColumnHeaderText="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNEL_ROUTING_OUTPUT_CHANNEL_label}" RowHeaderText="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNEL_ROUTING_MEDIA_CHANNEL_label}" TextElement.Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource Self}}" />
            </ControlTemplate>
          </Control.Template>
        </ContextMenu>
      </FrameworkElement.ContextMenu>
    </Button>
    <ItemsControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{Binding InputChannelSet}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <local:ChannelControl AudioMap="{Binding Data.AudioMap, Source={StaticResource audioVMProxy}}" MediaAudioChannel="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>