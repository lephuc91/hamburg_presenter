<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CueInspector.SavePresetContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="savePresetContent" xmlns:cueinspector="clr-namespace:ProPresenter.UI.CueInspector;assembly=ProPresenter.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="10" HorizontalAlignment="Left" Orientation="Horizontal">
      <TextBlock Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized CUE_INSPECTOR_EFFECTS_TAB_PRESET_NAME_label}" />
      <TextBox Name="PresetNameTb" Width="300" Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" MaxLength="60" Text="{Binding PresetName, ElementName=savePresetContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
  </Grid>
</UserControl>