<?xml version="1.0" encoding="utf-8"?>
<commonComponents:FrameworkCollection x:Class="ProPresenter.UI.CueInspector.PlaybackMarkerContextMenuSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:actionsMenu="clr-namespace:ProPresenter.UI.ActionsMenu" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonComponents="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="markerMenuSource" xmlns:cueinspector="clr-namespace:ProPresenter.UI.CueInspector">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="markerMenuSourceProxy" Data="{Binding ElementName=markerMenuSource}" />
      <commonControls:AnchoredPopup x:Key="RenamePopup" HorizontalAlignment="Center" Placement="Bottom" StaysOpen="False">
        <Border BorderThickness="0.5" Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
          <TextBox Width="200" Margin="8" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" KeyDown="MarkerName_KeyDown" LostFocus="MarkerName_LostFocus" LostKeyboardFocus="MarkerName_KeyboardLostFocus" />
        </Border>
      </commonControls:AnchoredPopup>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <MenuItem>
    <FrameworkElement.Style>
      <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{x:Static commonCommands:CommonApplicationCommands.Rename}" />
        <Setter Property="Header" Value="{mex:Localized GLOBAL_RENAME_MENU_ITEM_title}" />
        <Style.Triggers>
          <DataTrigger Value="" Binding="{Binding Name}">
            <Setter Property="Header" Value="{mex:Localized PLAYBACK_MARKERS_CONTEXTUAL_MENU_ADD_NAME_label}" />
          </DataTrigger>
          <DataTrigger Value="True" Binding="{Binding Data.UsePopupRename, Source={StaticResource markerMenuSourceProxy}}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.ShowRenamePopupCommand, Source={StaticResource markerMenuSourceProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{StaticResource RenamePopup}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
  </MenuItem>
  <MenuItem>
    <HeaderedItemsControl.Header>
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Text="{mex:Localized PLAYBACK_MARKERS_CONTEXTUAL_MENU_COLOR_label}" />
        <commonControls:ColorPicker Width="50" Margin="15,0,0,0" SelectedColor="{Binding Data.MarkerColor, Mode=TwoWay, Source={StaticResource markerMenuSourceProxy}}" />
      </StackPanel>
    </HeaderedItemsControl.Header>
  </MenuItem>
  <MenuItem Command="{Binding Data.MoveToPlayheadCommand, Source={StaticResource markerMenuSourceProxy}}" Header="{mex:Localized PLAYBACK_MARKERS_CONTEXTUAL_MENU_MOVE_TO_PLAYHEAD_label}" />
  <Separator />
  <actionsMenu:AddEditActionMenuSource CanAddCaptureAction="False" DataContext="{Binding Data.ActionsMenuVM, Source={StaticResource markerMenuSourceProxy}}" />
  <Separator />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.CutCommand}" />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Copy}" />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Paste}" />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Duplicate}" />
  <Separator />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" />
</commonComponents:FrameworkCollection>