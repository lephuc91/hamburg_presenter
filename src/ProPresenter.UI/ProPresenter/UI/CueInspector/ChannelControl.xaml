<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CueInspector.ChannelControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:audio="clr-namespace:Pro.DO.Audio;assembly=Pro.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="self" xmlns:cueinspector="clr-namespace:ProPresenter.UI.CueInspector">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ChannelControlToggleButtonStyle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="5,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderThickness="0,1,0,0" BorderBrush="{Binding TABITEM_BORDER, Source={x:Static theming:AppTheme.Active}}">
    <Grid Margin="0,10">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="80" MaxWidth="200" SharedSizeGroup="CIPropertiesLabelColumnGroup" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding MediaAudioChannel.Name, ElementName=self}" />
      <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <ToggleButton Margin="0,0,5,0" Padding="5,0" Style="{StaticResource ChannelControlToggleButtonStyle}" Content="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNELS_MUTE_title}" IsChecked="{Binding MediaAudioChannel.MuteActive, ElementName=self}" />
        <ToggleButton Padding="5,0" Style="{StaticResource ChannelControlToggleButtonStyle}" Content="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNELS_SOLO_title}" IsChecked="{Binding MediaAudioChannel.SoloActive, ElementName=self}" />
      </StackPanel>
      <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNELS_VOLUME_label}" />
      <Grid Row="1" Column="1" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <commonControls:FillSlider Grid.Column="0" Margin="0,0,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding MediaAudioChannel.Level, ElementName=self}" />
        <commonControls:DoubleUpDown Grid.Column="1" Width="60" Height="22" Margin="2,0,0,5" VerticalAlignment="Center" FormatString="{}{0:N0}dB" Increment="1" Maximum="{x:Static audio:AudioConstants.DecibelRangeMaximum}" Minimum="{x:Static audio:AudioConstants.DecibelRangeMinimum}" Value="{Binding MediaAudioChannel.Level, ElementName=self}" />
      </Grid>
      <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Text="{mex:Localized CUE_INSPECTOR_AUDIO_TAB_CHANNELS_OUTPUTS_label}" />
      <ItemsControl Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Outputs, ElementName=self}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>