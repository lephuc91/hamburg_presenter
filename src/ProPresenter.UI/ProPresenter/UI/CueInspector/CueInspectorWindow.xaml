  <local:CueInspector x:Name="CueInspector" Background="{Binding CUEINSPECTOR_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" CloseCICommand="{Binding CloseCICommand}" LoadCIOutputCommand="{Binding LoadCIOutputCommand}" OutputController="{Binding OutputController}" SelectedInspectorTab="{Binding ActiveTab}" UnloadCIOutputCommand="{Binding UnloadCIOutputCommand}" />
  <windowing:ChromedWindow.LeftContent>
    <commonControls:BorderlessDropDownButton Height="28" MaxWidth="300" Margin="8,0,0,0">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <commonUtility:BindingProxy x:Key="ciVMProxy" Data="{Binding}" />
          <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
          <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
          <local:SelectedMediaCheckedConverter x:Key="SelectedMediaCheckedConverter" />
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <commonControls:BorderlessDropDownButton.CustomContent>
        <TextBlock Margin="0,0,8,0" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding ActiveMediaCue.MediaCue.Name}" />
      </commonControls:BorderlessDropDownButton.CustomContent>
      <commonControls:BorderlessDropDownButton.CustomContextMenu>
        <ContextMenu Placement="Bottom" ItemsSource="{Binding Items}">
          <ItemsControl.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
              <Setter Property="MenuItem.Command" Value="{Binding Data.ChangeActiveMediaCueCommand, Source={StaticResource ciVMProxy}}" />
              <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
              <Setter Property="MenuItem.IsChecked">
                <Setter.Value>
                  <MultiBinding Converter="{StaticResource SelectedMediaCheckedConverter}">
                    <Binding Mode="OneWay" Path="" />
                    <Binding Path="Data.ActiveMediaCue" Source="{StaticResource ciVMProxy}" />
                  </MultiBinding>
                </Setter.Value>
              </Setter>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <mediaLibrary:MediaPreview Grid.Column="0" Width="80" Height="45" Margin="0,2" Media="{Binding MediaCue.MediaAction.Media}" Visibility="{Binding MediaCue.MediaAction.IsGraphicMedia, Converter={StaticResource ValueToVisibilityConverter}}" />
                <livevideo:VideoInputPreview Grid.Column="0" Width="80" Height="45" Margin="0,2" VideoInput="{Binding MediaCue.MediaAction.LiveVideo.LiveVideo.Input}" Visibility="{Binding MediaCue.MediaAction.LiveVideo, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Null}}" />
                <Grid Width="80" Height="45" Margin="0,2" Visibility="{Binding MediaCue.MediaAction.AudioMedia, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Null}}">
                  <Image Source="../Resources/Icons/Outline/AudioItem@3x.png" />
                </Grid>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding MediaCue.Name}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ContextMenu>
      </commonControls:BorderlessDropDownButton.CustomContextMenu>
    </commonControls:BorderlessDropDownButton>
  </windowing:ChromedWindow.LeftContent>
