<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.ProContentOutlineViewHeader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proUIThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.DO.Settings;assembly=ProPresenter.DO" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:procontent="clr-namespace:ProPresenter.UI.ProContent;assembly=ProPresenter.UI">
  <Grid Margin="0,2" DataContext="{Binding ProContentVM}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image Grid.Column="0" Height="22" Margin="0,0,6,0" HorizontalAlignment="Left" Source="{StaticResource {x:Static proUIThemes:Icons.ProContentWordmark}}" />
    <commonControls:BorderlessButton Grid.Column="1" Width="20" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom" Command="{Binding BrowseMoreCommand}" ToolTip="{mex:Localized MEDIA_BIN_OUTLINE_CONTEXT_MENU_BROWSE_MORE_title}">
      <commonControls:ImageMask ImageSource="{StaticResource {x:Static proUIThemes:Icons.ProContentOutlineGlobe}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
    </commonControls:BorderlessButton>
    <commonControls:ExpanderToggleButton Grid.Column="2" CollapsedPathType="VDownArrow" ExpandedPathType="VUpArrow" ShouldFill="False" IsChecked="{Binding ProContentOutlineVisible, Source={x:Static settings:Layout.Settings}, Mode=TwoWay}" />
  </Grid>
</UserControl>