<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.ProContentNoNetworkExperience" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:procontent="clr-namespace:ProPresenter.UI.ProContent;assembly=ProPresenter.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Image Grid.Row="0" Width="300" Source="{StaticResource {x:Static themesUI:Icons.ProContentWordmark}}" Stretch="Uniform" />
      <TextBlock Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="{mex:Localized PRO_CONTENT_MEDIA_BIN_NO_NETWORK_text}" />
    </Grid>
  </ScrollViewer>
</UserControl>