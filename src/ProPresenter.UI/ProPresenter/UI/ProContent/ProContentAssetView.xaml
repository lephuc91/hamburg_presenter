<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.ProContentAssetView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:icons="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ProContent" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.ProContent.Collection">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsCollapsing="False" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid" Background="#00FFFFFF">
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="8">
      <Border.Background>
        <SolidColorBrush Color="{StaticResource {x:Static icons:Colors.Primary}}" />
      </Border.Background>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Margin" Value="4,4,4,0" />
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding IsMouseOver, ElementName=MainGrid}" />
                <Condition Value="True" Binding="{Binding IsNavigable}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Value="CarouselLarge" Binding="{Binding Path=ContentViewType, RelativeSource={RelativeSource AncestorType=local:ProContentAssetView}}">
              <Setter Property="Margin" Value="4,4,4,18" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Border>
    <Grid Margin="{x:Static local:ProContentAssetList.THUMBNAIL_MARGIN}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Name="PreviewGrid" Row="0">
        <local:ProContentThumbnail HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="8" AspectRatio="{Binding Path=AspectRatio, RelativeSource={RelativeSource AncestorType=local:ProContentAssetView}}" Preview="{Binding Preview}" ShouldShowPreviewIfAvailable="{Binding IsMouseOver, ElementName=PreviewGrid}" Thumbnail="{Binding Thumbnail}" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="0 8 0 8" Opacity="0.8" Background="{Binding HEADER, Source={x:Static theming:AppTheme.Active}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding ElementName=MainGrid, Path=IsMouseOver}" />
                    <Condition Value="Pack" Binding="{Binding Type}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Grid Margin="3,0">
            <FrameworkElement.ToolTip>
              <ItemsControl>
                <ItemsControl.ItemsSource>
                  <PriorityBinding>
                    <Binding Path="DownloadContainsTooltip" />
                  </PriorityBinding>
                </ItemsControl.ItemsSource>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Description}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </FrameworkElement.ToolTip>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Column="0" Margin="2">
              <UIElement.Visibility>
                <PriorityBinding>
                  <Binding Converter="{StaticResource CountToVisibilityConverter}" Path="LoopCount" />
                </PriorityBinding>
              </UIElement.Visibility>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="UI_LoopCount" Grid.Column="0" Margin="0,0,2,0" VerticalAlignment="Center" FontSize="11">
                <TextBlock.Text>
                  <PriorityBinding>
                    <Binding Path="LoopCount" />
                  </PriorityBinding>
                </TextBlock.Text>
              </TextBlock>
              <Image Grid.Column="1" Width="12" Height="12" Source="{StaticResource {x:Static icons:Icons.ProContentLoop}}" />
            </Grid>
            <Grid Column="1" Margin="2">
              <UIElement.Visibility>
                <PriorityBinding>
                  <Binding Converter="{StaticResource CountToVisibilityConverter}" Path="CountdownCount" />
                </PriorityBinding>
              </UIElement.Visibility>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="0,0,2,0" VerticalAlignment="Center" FontSize="11">
                <TextBlock.Text>
                  <PriorityBinding>
                    <Binding Path="CountdownCount" />
                  </PriorityBinding>
                </TextBlock.Text>
              </TextBlock>
              <Image Grid.Column="1" Width="12" Height="12" Source="{StaticResource {x:Static icons:Icons.ProContentCountdown}}" />
            </Grid>
            <Grid Column="2" Margin="2">
              <UIElement.Visibility>
                <PriorityBinding>
                  <Binding Converter="{StaticResource CountToVisibilityConverter}" Path="StillCount" />
                </PriorityBinding>
              </UIElement.Visibility>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="0,0,2,0" VerticalAlignment="Center" FontSize="11">
                <TextBlock.Text>
                  <PriorityBinding>
                    <Binding Path="StillCount" />
                  </PriorityBinding>
                </TextBlock.Text>
              </TextBlock>
              <Image Grid.Column="1" Width="12" Height="12" Source="{StaticResource {x:Static icons:Icons.ProContentStill}}" />
            </Grid>
          </Grid>
        </Border>
        <commonControls:BorderlessButton Grid.Column="1" Margin="0,0,5,5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding DownloadCommand}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
              <Setter Property="Visibility" Value="{Binding ElementName=MainGrid, Path=IsMouseOver, Converter={StaticResource ValueToVisibilityConverter}}" />
              <Style.Triggers>
                <DataTrigger Value="File" Binding="{Binding Type}">
                  <Setter Property="FrameworkElement.ToolTip" Value="{mex:Localized PRO_CONTENT_MEDIA_BIN_DOWNLOAD_MEDIA_tooltip}" />
                </DataTrigger>
                <DataTrigger Value="Pack" Binding="{Binding Type}">
                  <Setter Property="FrameworkElement.ToolTip" Value="{mex:Localized PRO_CONTENT_MEDIA_BIN_DOWNLOAD_PACK_tooltip}" />
                </DataTrigger>
                <DataTrigger Value="False" Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <commonControls:ImageMask Width="30" Height="30" ImageSource="{StaticResource {x:Static icons:Icons.ProContentDownloadFull}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
        </commonControls:BorderlessButton>
        <Image Width="53" Height="20" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{StaticResource {x:Static icons:Icons.ProContentFreeBadge}}" Visibility="{Binding IsFree, Converter={StaticResource ValueToVisibilityConverter}}" />
      </Grid>
      <TextBlock Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".85" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="{Binding ElementName=PreviewGrid, Path=ActualWidth}" Foreground="{Binding ONPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding DisplayName}" Visibility="{Binding Path=ContentViewType, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static viewModels:LayoutType.CarouselLarge}, RelativeSource={RelativeSource AncestorType=local:ProContentAssetView}}" />
    </Grid>
  </Grid>
</UserControl>