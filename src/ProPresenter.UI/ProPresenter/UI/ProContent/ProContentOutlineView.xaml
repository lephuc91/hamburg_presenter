<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.ProContentOutlineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ProContent" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.DO.Settings;assembly=ProPresenter.DO" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../SourceDetailListResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid DataContext="{Binding ProContentVM}">
    <local:ProContentGroupListBox x:Name="proContentGroupListBox" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" DeselectOnLostFocus="True" SelectionMode="Single" Style="{StaticResource {x:Type ListBox}}" uiUtility:UIElementHelper.Palette="{Binding DETAILLIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" ActiveItem="{Binding SelectedRootElement, Mode=TwoWay}" FocusSearchBox="{Binding FocusSearchBox}" ItemsSource="{Binding Groups}" Visibility="{Binding ProContentOutlineVisible, Source={x:Static settings:Layout.Settings}, Converter={StaticResource ValueToVisibilityConverter}}">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <DataTemplate x:Key="{x:Static local:ProContentGroupListTemplateSelector.StandardGroupKey}">
            <Grid Margin="16,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <commonControls:ImageMask Grid.Column="0" Width="14" Height="14" Margin="4" HorizontalAlignment="Left" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:ListBoxItem}}" ImageSource="{Binding Icon}" />
              <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
            </Grid>
          </DataTemplate>
          <DataTemplate x:Key="{x:Static local:ProContentGroupListTemplateSelector.SearchGroupKey}">
            <Grid Margin="0,4,0,4" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
              <TextBox Name="searchTextbox" Height="24" Padding="24,0,20,0" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" BorderThickness="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" ToolTip="{mex:Localized MEDIA_BIN_OUTLINE_SEARCH_FIELD_tooltip}" KeyDown="SearchTextbox_KeyDown">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                      <Setter Property="Border.CornerRadius" Value="8" />
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </TextBox>
              <commonControls:PathControl Width="14" Height="14" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#00FFFFFF" PathType="Magnifier" Stroke="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, ElementName=searchTextbox}" />
              <TextBlock Margin="25,0,25,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, ElementName=searchTextbox}" Text="{mex:Localized MEDIA_BIN_OUTLINE_SEARCH_FIELD_placeholder}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding Text.Length, ElementName=searchTextbox}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <commonControls:CloseButton Width="12" Height="12" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ClearSearchCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type commonControls:CloseButton}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding Text.Length, ElementName=searchTextbox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </commonControls:CloseButton>
            </Grid>
          </DataTemplate>
          <Style x:Key="{x:Static local:ProContentGroupListContainerStyleSelector.StandardGroupKey}" BasedOn="{StaticResource {x:Type commonControls:ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
            <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding DETAILLISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
          </Style>
          <Style x:Key="{x:Static local:ProContentGroupListContainerStyleSelector.SearchGroupKey}" BasedOn="{StaticResource {x:Type commonControls:ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ItemsControl.ItemTemplateSelector>
        <local:ProContentGroupListTemplateSelector />
      </ItemsControl.ItemTemplateSelector>
      <ItemsControl.ItemContainerStyleSelector>
        <local:ProContentGroupListContainerStyleSelector />
      </ItemsControl.ItemContainerStyleSelector>
    </local:ProContentGroupListBox>
  </Grid>
</UserControl>