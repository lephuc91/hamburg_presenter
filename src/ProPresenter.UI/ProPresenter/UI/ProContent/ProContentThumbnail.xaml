<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.ProContentThumbnail" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:proUiImages="clr-namespace:Pro.UI.Controls.Images;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:thumbnail="clr-namespace:ProPresenter.UI.Thumbnails" xmlns:thumbnailViewSettings="clr-namespace:ProPresenter.DO.PanelViewSettings;assembly=ProPresenter.DO" x:Name="ThumbnailView" Background="#FF000000" xmlns:procontent="clr-namespace:ProPresenter.UI.ProContent">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:IsNotEmptyToBoolConverter x:Key="IsNotEmptyToBoolConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.OpacityMask>
    <VisualBrush Stretch="None">
      <VisualBrush.Visual>
        <Rectangle Fill="#FF000000" Width="{Binding ActualWidth, ElementName=ThumbnailView}" Height="{Binding ActualHeight, ElementName=ThumbnailView}" RadiusX="{Binding CornerRadius, ElementName=ThumbnailView}" RadiusY="{Binding CornerRadius, ElementName=ThumbnailView}" />
      </VisualBrush.Visual>
    </VisualBrush>
  </UIElement.OpacityMask>
  <UIElement.Effect>
    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.7" ShadowDepth="1" Color="{StaticResource {x:Static themesUI:Colors.Shadow}}" />
  </UIElement.Effect>
  <thumbnail:PreviewContainer AspectRatio="{Binding AspectRatio, ElementName=ThumbnailView}" ViewSettings="{di:DIMarkup {x:Type thumbnailViewSettings:ThumbnailViewSettings}}">
    <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill" StretchDirection="Both" Source="{Binding ThumbnailImage, ElementName=ThumbnailView}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Image}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding PreviewImage, ElementName=ThumbnailView, Converter={StaticResource IsNotEmptyToBoolConverter}}" />
                <Condition Value="True" Binding="{Binding ShouldShowPreviewIfAvailable, ElementName=ThumbnailView}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Hidden" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Image>
    <proUiImages:AnimatedImageView AnimationSource="{Binding PreviewImage, ElementName=ThumbnailView}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type proUiImages:AnimatedImageView}">
          <Setter Property="Visibility" Value="Hidden" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding PreviewImage, ElementName=ThumbnailView, Converter={StaticResource IsNotNullToBoolConverter}}" />
                <Condition Value="True" Binding="{Binding ShouldShowPreviewIfAvailable, ElementName=ThumbnailView}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </proUiImages:AnimatedImageView>
  </thumbnail:PreviewContainer>
</UserControl>