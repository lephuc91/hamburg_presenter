<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.ProContentCarouselView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ProContent" xmlns:proUIThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="proContentCarouselView" uiUtility:ScrollViewerHelper.UseHorizontalScrolling="True" Background="#00FFFFFF" FocusVisualStyle="{x:Null}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="ProContentItemsControlTemplate">
        <Border Name="PART_Main_Border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
          <ScrollViewer Name="PART_ScrollViewer" Padding="{TemplateBinding Control.Padding}" CanContentScroll="True" Focusable="False">
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsCollapsing="False" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF">
    <Border Width="30" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="#00FFFFFF" Visibility="{Binding IsMouseOver, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=local:ProContentCarouselView}}">
      <commonControls:BorderlessButton HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding ScrollBackwardCommand, ElementName=proContentCarouselView}" Visibility="{Binding IsEnabled, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource Self}}">
        <commonControls:ImageMask ImageSource="{StaticResource {x:Static proUIThemes:Icons.ProContentGoBack}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
      </commonControls:BorderlessButton>
    </Border>
    <local:ProContentAssetList x:Name="ProContentAssetList" Margin="{x:Static local:ProContentLayoutHelper.COLLECTION_MARGIN}" VerticalContentAlignment="Top" EnableAnimateScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" Template="{StaticResource ProContentItemsControlTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Standard" AssetViewData="{Binding ElementName=proContentCarouselView, Path=AssetViewData}" CanScrollBack="{Binding CanScrollBackward, ElementName=proContentCarouselView}" CanScrollForward="{Binding CanScrollForward, ElementName=proContentCarouselView}" ContentLayoutType="{Binding LayoutType}" FocusVisualStyle="{x:Null}" ItemsSource="{Binding Assets}" SelectAssetCommand="{Binding ElementName=proContentCarouselView, Path=SelectAssetCommand}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </local:ProContentAssetList>
    <Border Width="30" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#00FFFFFF" Visibility="{Binding IsMouseOver, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=local:ProContentCarouselView}}">
      <commonControls:BorderlessButton HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding ScrollForwardCommand, ElementName=proContentCarouselView}" Visibility="{Binding IsEnabled, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource Self}}">
        <commonControls:ImageMask ImageSource="{StaticResource {x:Static proUIThemes:Icons.ProContentGoForward}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
      </commonControls:BorderlessButton>
    </Border>
  </Grid>
</UserControl>