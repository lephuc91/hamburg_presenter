<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.Dialog.Download.PackDownloadDialogHeader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.ProContent.Dialog.Download" xmlns:proContent="clr-namespace:ProPresenter.UI.ProContent" x:Name="PackHeader">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <proContent:ProContentThumbnail Width="300" Margin="{x:Static proContent:ProContentAssetList.THUMBNAIL_MARGIN}" HorizontalAlignment="Center" ShouldShowPreviewIfAvailable="True" AspectRatio="{Binding Context.ThumbnailAspectRatio, ElementName=PackHeader}" Preview="{Binding Context.Preview, ElementName=PackHeader}" Thumbnail="{Binding Context.Thumbnail, ElementName=PackHeader}" />
    <Grid Column="1" Margin="10,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Margin="10" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding Context.PackTitle, RelativeSource={RelativeSource AncestorType={x:Type local:PackDownloadDialogHeader}}}" />
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Context.Contains, RelativeSource={RelativeSource AncestorType={x:Type local:PackDownloadDialogHeader}}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Margin="5,5,15,5" VerticalAlignment="Center" FontSize="13" Content="{Binding Description}" IsChecked="{Binding ShouldDownload}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>