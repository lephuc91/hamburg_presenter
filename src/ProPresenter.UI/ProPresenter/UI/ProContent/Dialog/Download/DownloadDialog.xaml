<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.ProContent.Dialog.Download.DownloadDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ProContent.Dialog.Download" xmlns:mediaLibrary="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.ProContent.Dialog.Download" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.SendKeyEventsToMainWindow="False" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" WindowStartupLocation="CenterOwner" Title="{mex:Localized PROCONTENT_DOWNLOAD_DIALOG_WINDOW_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
      <commonConverters:IsInstanceOfTypeConverter x:Key="IsPackDialogVariant" Type="{x:Type vm:IProContentDownloadPackDialogVM}" />
      <commonConverters:IsInstanceOfTypeConverter x:Key="IsFileDialogVariant" Type="{x:Type vm:IProContentDownloadFileDialogVM}" />
      <commonConverters:IsInstanceOfTypeConverter x:Key="IsCollectionDialogVariant" Type="{x:Type vm:IProContentDownloadCollectionDialogVM}" />
      <commonConverters:BorderClipConverter x:Key="BorderClipConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" CountTarget="1" />
      <commonConverters:ValueToVisibilityConverter x:Key="HideIfNotNullVisibilityConvetrer" IsCollapsing="False" />
      <DataTemplate x:Key="FileHeader">
        <local:FileDownloadDialogHeader Context="{Binding}" />
      </DataTemplate>
      <DataTemplate x:Key="PackHeader">
        <local:PackDownloadDialogHeader Context="{Binding}" />
      </DataTemplate>
      <DataTemplate x:Key="CollectionHeader">
        <local:CollectionDownloadDialogHeader Context="{Binding}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource {x:Type windowing:ChromedWindow}}" TargetType="{x:Type windowing:ChromedWindow}">
      <Setter Property="Width" Value="100" />
      <Style.Triggers>
        <DataTrigger Value="True" Binding="{Binding Context, Converter={StaticResource IsFileDialogVariant}, RelativeSource={RelativeSource Self}}">
          <Setter Property="Width" Value="380" />
        </DataTrigger>
        <DataTrigger Value="True" Binding="{Binding Context, Converter={StaticResource IsPackDialogVariant}, RelativeSource={RelativeSource Self}}">
          <Setter Property="Width" Value="520" />
        </DataTrigger>
        <DataTrigger Value="True" Binding="{Binding Context, Converter={StaticResource IsCollectionDialogVariant}, RelativeSource={RelativeSource Self}}">
          <Setter Property="Width" Value="380" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ContentControl Content="{Binding Context, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ContentControl}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding Context, Converter={StaticResource IsFileDialogVariant}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}">
              <Setter Property="ContentTemplate" Value="{StaticResource FileHeader}" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding Context, Converter={StaticResource IsPackDialogVariant}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}">
              <Setter Property="ContentTemplate" Value="{StaticResource PackHeader}" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding Context, Converter={StaticResource IsCollectionDialogVariant}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}">
              <Setter Property="ContentTemplate" Value="{StaticResource CollectionHeader}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ContentControl>
    <Separator Grid.Row="1" Margin="10,3" />
    <Grid Row="2" Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Margin="5" HorizontalAlignment="Right" FontSize="13" Text="{mex:Localized PROCONTENT_DOWNLOAD_DIALOG_RESOLUTION_title}" Visibility="{Binding Context.AvailableFormats.Count, Converter={StaticResource CountToVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" />
      <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding Context.AvailableFormats, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" SelectedItem="{Binding Context.SelectedFormat, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" Visibility="{Binding Context.AvailableFormats.Count, Converter={StaticResource CountToVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="2" Grid.Column="1" Margin="5" HorizontalAlignment="Right" FontSize="13" Text="{mex:Localized MEDIA_PLAYLIST_SELECTOR_PLAYLIST_label}" />
      <mediaLibrary:MediaLibrarySelectionControl Grid.Row="2" Grid.Column="2" Height="22" NoSelectionTranslationKey="MEDIA_PLAYLIST_SELECTOR_NEW_PLAYLIST_MENU_ITEM_title" Playlists="{Binding Context.Playlists, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" SelectedPlaylist="{Binding Context.SelectedPlaylist, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized MEDIA_PLAYLIST_SELECTOR_NEW_PLAYLIST_NAME_label}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Context.SelectedPlaylist, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <commonControls:PlaceholderTextBox Grid.Row="3" Grid.Column="2" Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" PlaceholderText="{mex:Localized MEDIA_PLAYLIST_SELECTOR_NEW_PLAYLIST_MENU_ITEM_placeholder}" Text="{Binding Context.NewPlaylistName, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" Visibility="{Binding Context.SelectedPlaylist, Converter={StaticResource HideIfNotNullVisibilityConvetrer}, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" />
    </Grid>
    <Grid Row="3" Height="32" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsSharedSizeScope="true">
      <Grid.ColumnDefinitions>
        <ColumnDefinition SharedSizeGroup="A" />
        <ColumnDefinition SharedSizeGroup="A" />
      </Grid.ColumnDefinitions>
      <Button Margin="5" Padding="10,0" IsCancel="True" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      <Button Grid.Column="1" Margin="5" Padding="10,0" IsDefault="True" Content="{mex:Localized PROCONTENT_DOWNLOAD_DIALOG_DOWNLOAD_BUTTON_title}" IsEnabled="{Binding Context.CanStartDownload, RelativeSource={RelativeSource AncestorType={x:Type local:DownloadDialog}}}" Click="OK_Click" />
    </Grid>
  </Grid>
</windowing:ChromedWindow>