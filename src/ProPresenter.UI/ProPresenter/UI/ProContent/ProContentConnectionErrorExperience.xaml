<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ProContent.ProContentConnectionErrorExperience" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.ProContent" xmlns:markdown="clr-namespace:Pro.UI.Controls.Markdown;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Image Grid.Row="0" Width="300" Source="{StaticResource {x:Static themesUI:Icons.ProContentWordmark}}" Stretch="Uniform" />
      <TextBlock Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="{mex:Localized PRO_CONTENT_MEDIA_BIN_CONTACT_ERROR_text}" />
      <Button Grid.Row="2" Width="75" Height="22" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Command="{Binding RefreshCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProContentConnectionErrorExperience}}}" Content="{mex:Localized PRO_CONTENT_MEDIA_BIN_NO_NETWORK_RETRY_BUTTON_title}" />
      <markdown:MarkdownTextBlock Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
        <markdown:MarkdownTextBlock.Markdown>
          <MultiBinding StringFormat="{mex:Localized PRO_CONTENT_MEDIA_BIN_ISSUE_PERSISTS_text[{0}]({1})}">
            <Binding Path="ShowSupportWebsiteLinkTextKey" RelativeSource="{RelativeSource AncestorType={x:Type local:ProContentConnectionErrorExperience}}" />
            <Binding Path="ShowSupportWebsiteUrl" RelativeSource="{RelativeSource AncestorType={x:Type local:ProContentConnectionErrorExperience}}" />
          </MultiBinding>
        </markdown:MarkdownTextBlock.Markdown>
      </markdown:MarkdownTextBlock>
    </Grid>
  </ScrollViewer>
</UserControl>