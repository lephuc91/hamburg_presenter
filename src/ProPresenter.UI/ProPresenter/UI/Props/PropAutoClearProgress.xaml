<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Props.PropAutoClearProgress" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:props="clr-namespace:ProPresenter.UI.Props">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="False" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Visibility="{Binding ShowProgress, Converter={StaticResource ValueToVisibilityConverter}}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ProgressBar Grid.Column="0" Height="6" Maximum="1" Minimum="0" Value="{Binding PlayProgress, Mode=OneWay}" />
    <controls:BorderlessButton Grid.Column="1" Margin="2,0,0,0" Command="{Binding TogglePropAutoClearCommand}">
      <Grid>
        <Ellipse Width="14" Height="14" Fill="{Binding BUTTON_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" />
        <controls:PathControl Width="8" Height="8" Stroke="#00FFFFFF" Fill="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type controls:PathControl}">
              <Setter Property="Margin" Value="0" />
              <Setter Property="controls:PathControl.PathType" Value="Pause" />
              <Style.Triggers>
                <DataTrigger Value="False" Binding="{Binding IsPlaying}">
                  <Setter Property="Margin" Value="2,0,0,0" />
                  <Setter Property="controls:PathControl.PathType" Value="Play" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </controls:PathControl>
      </Grid>
    </controls:BorderlessButton>
  </Grid>
</UserControl>