<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Props.PropListItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:controls1="clr-namespace:ProPresenter.UI.Controls" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:converters1="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Props" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="propTemplate" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" Foreground="{Binding LISTITEM_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="propTemplateProxy" Data="{Binding ElementName=propTemplate}" />
      <converters1:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="0,-2" BorderThickness="2">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsActive}">
            <Setter Property="Background" Value="{Binding THUMBNAILLISTPRESENTATION, Source={x:Static theming:AppTheme.Active}}" />
            <Setter Property="BorderBrush" Value="{Binding THUMBNAILPRESENTATIONBORDER, Source={x:Static theming:AppTheme.Active}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <Grid Margin="12,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <local:PropsThumbnailView Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,5" CornerRadius="6" Width="{Binding Path=ThumbnailWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PropCueList}}}" AspectRatio="{Binding ThumbnailAspectRatio}" Thumbnail="{Binding PreviewImage}" ThumbnailSize="{Binding ThumbnailSize, Mode=TwoWay}" />
      <commonControls:EditableTextBlock Name="PropName" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" ClickToEdit="False" FontSize="13" Text="{Binding Name, Mode=TwoWay}" />
      <Grid Row="0" Column="1" Margin="10,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <commonControls:TruncatedTextblock Grid.Column="0" Height="20" HorizontalTextAlignment="Right" TruncatingMode="Middle" VerticalTextAlignment="Middle" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type commonControls:TruncatedTextblock}">
              <Setter Property="commonControls:TruncatedTextblock.Text" Value="{Binding SlideAction.Slide.SelectedTransition.Name}" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SlideAction.Slide.SelectedTransition}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding SlideAction.Slide.SelectedTransition.SupportsDuration}">
                  <Setter Property="commonControls:TruncatedTextblock.Text">
                    <Setter.Value>
                      <MultiBinding StringFormat="{}{0}: {1:0.0}s">
                        <Binding Path="SlideAction.Slide.SelectedTransition.Name" />
                        <Binding Path="SlideAction.Slide.SelectedTransition.Duration.TotalSeconds" />
                      </MultiBinding>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:TruncatedTextblock>
        <controls1:TransitionSelectorButton Grid.Column="1" Margin="5,0,0,0" AlwaysActive="True" HideWhenNull="True" SelectedTransition="{Binding SlideAction.Slide.SelectedTransition}" />
      </Grid>
      <Grid Row="1" Column="2" Margin="10,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="False" Binding="{Binding IsActive}" />
                  <Condition Value="True" Binding="{Binding AutoClearEnabled}" />
                  <Condition Value="False" Binding="{Binding ShowProgress}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <commonControls:TruncatedTextblock Grid.Column="0" Height="20" HorizontalTextAlignment="Right" TruncatingMode="Middle" VerticalTextAlignment="Middle" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding AutoClearDuration, ConverterParameter=PROP_CONTROL_DECK_AUTO_CLEAR_LABEL_string, Converter={StaticResource FormattedLocalizedStringConverter}}" />
        <commonControls:ImageMask Grid.Column="1" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" ImageSource="{StaticResource {x:Static themes:Icons.PropsAutoClearBadge}}" Fill="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" />
      </Grid>
      <local:PropAutoClearProgress Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" />
    </Grid>
  </Border>
</UserControl>