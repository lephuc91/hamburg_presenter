<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Props.PropListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:controls="clr-namespace:ProPresenter.UI.Controls" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:local="clr-namespace:ProPresenter.UI.Props" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="propListView" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" Foreground="{Binding LISTITEM_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../SourceDetailListResources.xaml" />
        <ui:SharedResourceDictionary Source="PropGroupsItemsMenuResource.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <utility:BindingProxy x:Key="propsVMProxy" Data="{Binding}" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <converters:PropAddCommandVisibilityMultiConverter x:Key="PropAddCommandVisibilityMultiConverter" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:PropCueList x:Name="PropsList" Margin="0,-1,0,0" HorizontalContentAlignment="Stretch" Background="#FF464646" BorderThickness="0" ContextMenu="{StaticResource PropsControlContextMenu}" DeselectOnLostFocus="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectItemsOnSelfDrop="False" SelectionMode="Extended" Style="{StaticResource {x:Type ListBox}}" VirtualizingPanel.ScrollUnit="Pixel" uiUtility:UIElementHelper.RegisterCopyCommand="{Binding CopyCommand}" uiUtility:UIElementHelper.RegisterCutCommand="{Binding CutCommand}" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding DeleteCommand}" uiUtility:UIElementHelper.RegisterDuplicateCommand="{Binding DuplicateCommand}" uiUtility:UIElementHelper.RegisterPasteCommand="{Binding PasteCommand}" DragDropCollection="{Binding DragDropSource}" DropActionCommand="{Binding DropActionCommand}" ItemsSource="{Binding PropCues}" RenameNextItem="{Binding RenameNextItem, Mode=TwoWay}" RowCapacity="{Binding RowCapacity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" SelectedItem="{Binding SelectedCue}" SelectedListItems="{Binding SelectedCues}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
            <local:PropListItemTemplate DataContext="{Binding}" TogglePropCommand="{Binding Data.TogglePropCommand, Source={StaticResource propsVMProxy}}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type commonControls:ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
          <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource CollectionContextMenu}" />
          <Setter Property="commonControls:ListBoxItem.FocusOnContextMenuClose" Value="False" />
          <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding SOURCELISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
    </local:PropCueList>
    <controls:ImageTextButton ButtonBackground="#80707070" ButtonHeight="80" ButtonWidth="80" ImageSource="{StaticResource {x:Static themes:Icons.EmptyAdd}}" Command="{Binding Parent.ActiveGroup.AddPropCommand}" Text="{markupExtensions:Localized PROPS_WINDOW_ADD_PROP_label}" ToolTip="{markupExtensions:Localized PROPS_ADD_BUTTON_tooltip}">
      <UIElement.Visibility>
        <MultiBinding Converter="{StaticResource PropAddCommandVisibilityMultiConverter}">
          <Binding Path="DragDropSource.Count" />
          <Binding Path="FilterText" />
        </MultiBinding>
      </UIElement.Visibility>
    </controls:ImageTextButton>
  </Grid>
</UserControl>