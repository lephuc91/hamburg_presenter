<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Props.PropGroups" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Props" xmlns:ui="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" Focusable="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ui:BindingProxy x:Key="CollectionViewProxy" Data="{Binding}" />
      <commonConverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <local:PropsGridOrList x:Name="propsGridOrList" FooterVisiblility="{Binding ActiveGroup.IsReadyToEdit, Converter={StaticResource BooleanToVisibilityConverter}}" RowCapacity="{Binding Data.RowCapacity, Source={StaticResource CollectionViewProxy}, Mode=TwoWay}" SearchText="{Binding ActiveGroup.FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ViewType="{Binding Data.ListOrGrid, Source={StaticResource CollectionViewProxy}, Mode=TwoWay}">
    <local:PropsGridOrList.HeaderElement>
      <local:PropGroupHeader />
    </local:PropsGridOrList.HeaderElement>
    <local:PropsGridOrList.ListElement>
      <local:PropListView Margin="5" DataContext="{Binding Data.ActiveGroup, Source={StaticResource CollectionViewProxy}}" RowCapacity="{Binding Data.RowCapacity, Source={StaticResource CollectionViewProxy}, Mode=TwoWay}" />
    </local:PropsGridOrList.ListElement>
    <local:PropsGridOrList.GridElement>
      <local:PropGridView Margin="5" DataContext="{Binding Data.ActiveGroup, Source={StaticResource CollectionViewProxy}}" RowCapacity="{Binding Data.RowCapacity, Source={StaticResource CollectionViewProxy}, Mode=TwoWay}" />
    </local:PropsGridOrList.GridElement>
  </local:PropsGridOrList>
</UserControl>