<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Props.PropTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:propresenterUI="clr-namespace:ProPresenter.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:transitionsui="clr-namespace:ProPresenter.UI.Transitions" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="propTemplate" xmlns:props="clr-namespace:ProPresenter.UI.Props" Foreground="{Binding LISTITEM_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="propTemplateProxy" Data="{Binding ElementName=propTemplate}" />
      <converters:CustomSlideConverter x:Key="CustomSlideConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="0,-2" BorderThickness="2">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsActive, ElementName=propTemplate}">
            <Setter Property="Background" Value="{Binding THUMBNAILLISTPRESENTATION, Source={x:Static theming:AppTheme.Active}}" />
            <Setter Property="BorderBrush" Value="{Binding THUMBNAILPRESENTATIONBORDER, Source={x:Static theming:AppTheme.Active}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <Grid Margin="12,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <propresenterUI:ScaleToFitSlidePreview Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="92.44" Height="52" Margin="0,5" HorizontalAlignment="Center" VerticalAlignment="Center" ForceBackgroundDraw="True" RenderTransparencyCheckerboard="True" PrimaryCheckerboardBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" SecondaryCheckerboardBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" Source="{Binding SlideAction.Slide, Converter={StaticResource CustomSlideConverter}}" />
      <commonControls:EditableTextBlock Name="PropName" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" ClickToEdit="False" FontSize="13" Text="{Binding Name, Mode=TwoWay}" />
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Binding SlideAction.Slide.SelectedTransition.Name}" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SlideAction.Slide.SelectedTransition}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding SlideAction.Slide.SelectedTransition.SupportsDuration}">
                  <Setter Property="Text">
                    <Setter.Value>
                      <MultiBinding StringFormat="{}{0}: {1:0.0}s">
                        <Binding Path="SlideAction.Slide.SelectedTransition.Name" />
                        <Binding Path="SlideAction.Slide.SelectedTransition.Duration.TotalSeconds" />
                      </MultiBinding>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
        <transitionsui:ScrimControl IsMediaTransition="False" Fill="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Transition="{Binding SlideAction.Slide.SelectedTransition}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type transitionsui:ScrimControl}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SlideAction.Slide.SelectedTransition}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </transitionsui:ScrimControl>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>