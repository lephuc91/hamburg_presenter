<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CueTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:cues="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI" xmlns:proConverter="clr-namespace:ProPresenter.UI.Converters" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="cueTemplate" uiUtility:UIElementHelper.Palette="{Binding DETAILLISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="CueIconResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:TimeSliceToStringConverter x:Key="TimeSliceToStringConverter" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="TemplateGrid" SizeChanged="CueTemplateGridSizeChanged">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Name="IconColumn" Width="20" />
        <ColumnDefinition Name="InfoColumn" />
        <ColumnDefinition Name="AdditionalInfoColumn" />
      </Grid.ColumnDefinitions>
      <Image Name="Icon" Grid.Column="0" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CueIconStyle}" Visibility="{Binding ShowIcon, ElementName=cueTemplate, Converter={StaticResource ValueToVisibilityConverter}}" />
      <DockPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
        <commonControls:EditableTextBlock Effect="{StaticResource DefaultDropShadowEffect}">
          <commonControls:EditableTextBlock.Text>
            <PriorityBinding>
              <Binding Mode="TwoWay" Path="Name" UpdateSourceTrigger="PropertyChanged" />
            </PriorityBinding>
          </commonControls:EditableTextBlock.Text>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type commonControls:EditableTextBlock}">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="{x:Static cues:CueType.Placeholder}" Binding="{Binding Type}" />
                    <Condition Value="True" Binding="{Binding IsLinked}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <DataTrigger Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="False" Binding="{Binding CanRename, ElementName=cueTemplate}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="True">
                  <DataTrigger.Binding>
                    <PriorityBinding>
                      <Binding Converter="{StaticResource IsNotNullToBoolConverter}" Path="HeaderAction" />
                    </PriorityBinding>
                  </DataTrigger.Binding>
                  <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:EditableTextBlock>
        <TextBlock Effect="{StaticResource DefaultDropShadowEffect}" TextTrimming="CharacterEllipsis" Text="{Binding Name}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="{x:Static cues:CueType.Placeholder}" Binding="{Binding Type}" />
                    <Condition Value="True" Binding="{Binding IsLinked}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="False" Binding="{Binding CanRename, ElementName=cueTemplate}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True">
                  <DataTrigger.Binding>
                    <PriorityBinding>
                      <Binding Converter="{StaticResource IsNotNullToBoolConverter}" Path="HeaderAction" />
                    </PriorityBinding>
                  </DataTrigger.Binding>
                  <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
        <TextBlock TextTrimming="CharacterEllipsis" Visibility="{Binding ShowArrangementName, ElementName=cueTemplate, Converter={StaticResource ValueToVisibilityConverter}}">
          <TextBlock.Text>
            <PriorityBinding>
              <Binding Path="DocumentAction.ActiveArrangementName" Converter="{proConverter:ArrangementNameToFormatConverter}" />
            </PriorityBinding>
          </TextBlock.Text>
        </TextBlock>
      </DockPanel>
      <Grid Column="2" HorizontalAlignment="Right">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Image Name="TargetIcon" Margin="0,0,5,0" VerticalAlignment="Center" Source="Resources/Icons/Header/headerTarget_targetAnnouncement.png">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="{x:Static cues:CueType.Document}" Binding="{Binding Type}" />
                    <Condition Value="Announcement" Binding="{Binding DocumentAction.Destination}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="{x:Static cues:CueType.PCO}" Binding="{Binding Type}" />
                    <Condition Value="DocumentLinked" Binding="{Binding PCOAction.LinkedObjectType}" />
                    <Condition Value="Announcement" Binding="{Binding DocumentAction.Destination}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Image>
        <TextBlock Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource AncestorType={x:Type local:CueTemplate}}}" Visibility="{Binding ShowItemDetails, ElementName=cueTemplate, Converter={StaticResource ValueToVisibilityConverter}}">
          <TextBlock.Text>
            <PriorityBinding>
              <Binding Path="DocumentAction.LibraryName" />
              <Binding Converter="{StaticResource TimeSliceToStringConverter}" Path="MediaAction.MediaDuration" />
            </PriorityBinding>
          </TextBlock.Text>
        </TextBlock>
      </Grid>
    </Grid>
    <Border Height="22" Margin="-1" BorderThickness="0,1" IsHitTestVisible="False" BorderBrush="{Binding HEADERITEMDIVIDER, Source={x:Static theming:AppTheme.Active}}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="UIElement.Opacity" Value="0" />
          <Style.Triggers>
            <DataTrigger Value="True">
              <DataTrigger.Binding>
                <PriorityBinding>
                  <Binding Converter="{StaticResource IsNotNullToBoolConverter}" Path="HeaderAction" />
                </PriorityBinding>
              </DataTrigger.Binding>
              <Setter Property="Background" Value="{Binding HeaderAction.Color, Converter={StaticResource ColorToBrushConverter}}" />
              <Setter Property="UIElement.Opacity" Value="0.2" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Border>
  </Grid>
</UserControl>