<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Feedback.FeedbackDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:feedback="clr-namespace:ProPresenter.UI.Feedback" xmlns:local="clr-namespace:ProPresenter.UI.Feedback" xmlns:markdown="clr-namespace:Pro.UI.Controls.Markdown;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:userattachments="clr-namespace:ProPresenter.UI.UserAttachments" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="feedbackDialog" Width="650" MinHeight="700" uiUtility:WindowHelper.ChildOf="MainWindow" AllowDrop="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" Title="{mex:Localized USER_FEEDBACK_WINDOW_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="SecondaryColorBrush" Color="{StaticResource {x:Static themes:Colors.ContentSecondary}}" />
      <Style x:Key="{x:Type commonControls:PlaceholderTextBox}" BasedOn="{StaticResource {x:Type commonControls:PlaceholderTextBox}}" TargetType="{x:Type commonControls:PlaceholderTextBox}">
        <Setter Property="IsTabStop" Value="True" />
      </Style>
      <Style x:Key="SupportTicketCheckboxStyle" BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
        <Setter Property="Visibility" Value="{Binding RequestType, Converter={StaticResource ValueToVisibilityConverter}}" />
        <Style.Triggers>
          <DataTrigger Value="TechnicalIssue" Binding="{Binding RequestType}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="ErrorTemplate">
        <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
          <Border BorderBrush="#FFF96A6A" BorderThickness="1">
            <AdornedElementPlaceholder Name="textBox" />
          </Border>
          <Image Height="12" Margin="5,7,0,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Source="../Resources/Icons/WarningIcon.png" ToolTip="{Binding [0].ErrorContent}" />
        </StackPanel>
      </ControlTemplate>
      <commonUtility:BindingProxy x:Key="feedbackDialogProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" />
      </Style>
      <ObjectDataProvider x:Key="FeedbackRequestType" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="feedback:FeedbackRequestType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="70" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="65" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="65" />
    </Grid.ColumnDefinitions>
    <StackPanel Name="stackPanel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Margin="0,24,0,0" FontSize="16" FontWeight="Bold" Text="{mex:Localized USER_FEEDBACK_CONTACT_INFORMATION_title}" />
      <TextBlock Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold">
        <Run Text="{mex:Localized USER_FEEDBACK_FORM_EMAIL_label}" /> <Run Text="*" /></TextBlock>
      <Grid Margin="0,2,0,0">
        <commonControls:PlaceholderTextBox Height="28" Margin="0,0,110,0" VerticalAlignment="Center" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" Text="{Binding Email, ValidatesOnDataErrors=True}" />
      </Grid>
      <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold">
        <Run Text="{mex:Localized USER_FEEDBACK_FORM_NAME_label}" /> <Run Text="*" /></TextBlock>
      <Grid Margin="0,2,0,0">
        <commonControls:PlaceholderTextBox Height="28" Margin="0,0,110,0" VerticalAlignment="Center" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" Text="{Binding Name, ValidatesOnDataErrors=True}" />
      </Grid>
      <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="Bold" Text="{mex:Localized USER_FEEDBACK_DETAILS_title}" />
      <TextBlock Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold">
        <Run Text="{mex:Localized USER_FEEDBACK_FORM_REQUEST_TYPE_label}" /> <Run Text="*" /></TextBlock>
      <Grid Margin="0,2,0,0">
        <ComboBox Height="28" Margin="0,4,110,0" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" ItemsSource="{Binding Source={StaticResource FeedbackRequestType}}" SelectedItem="{Binding RequestType, Mode=TwoWay, ValidatesOnDataErrors=True}" SelectionChanged="FeedbackRequestTypeComboBox_SelectionChanged">
          <ItemsControl.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="None" Binding="{Binding}" />
                    <Condition Value="False">
                      <Condition.Binding>
                        <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                          <Binding Path="Data.RequestType" Source="{StaticResource feedbackDialogProxy}" />
                          <Binding />
                        </MultiBinding>
                      </Condition.Binding>
                    </Condition>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
      </Grid>
      <Grid Margin="0,2,0,0">
        <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold">
          <Run Text="{mex:Localized USER_FEEDBACK_FORM_SUBJECT_label}" /> <Run Text="*" /></TextBlock>
        <commonControls:PlaceholderTextBox Height="28" Margin="0,24,0,0" VerticalAlignment="Center" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" PlaceholderText="{mex:Localized USER_FEEDBACK_FORM_SUBJECT_placeholder}" Text="{Binding Subject, ValidatesOnDataErrors=True}" />
      </Grid>
      <TextBlock Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold">
        <Run Text="{mex:Localized USER_FEEDBACK_FORM_DESCRIPTION_label}" /> <Run Text="*" /></TextBlock>
      <commonControls:PlaceholderTextBox Height="88" Margin="0,4,0,0" AcceptsReturn="True" MinLines="4" TextContentVerticalAlignment="Top" TextWrapping="Wrap" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Description, ValidatesOnDataErrors=True}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type commonControls:PlaceholderTextBox}}" TargetType="{x:Type commonControls:PlaceholderTextBox}">
            <Setter Property="commonControls:PlaceholderTextBox.PlaceholderText" Value="{mex:Localized USER_FEEDBACK_FORM_DESCRIPTION_REQUEST_placeholder}" />
            <Style.Triggers>
              <DataTrigger Value="TechnicalIssue" Binding="{Binding RequestType}">
                <Setter Property="commonControls:PlaceholderTextBox.PlaceholderText" Value="{mex:Localized USER_FEEDBACK_FORM_DESCRIPTION_TECHNICAL_ISSUE_placeholder}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:PlaceholderTextBox>
      <TextBlock Margin="4,0,0,0" FontSize="11" Foreground="#FF808080" Text="{mex:Localized USER_FEEDBACK_FORM_DESCRIPTION_TECHNICAL_ISSUE_INSTRUCTIONS_label}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="{Binding RequestType, Converter={StaticResource ValueToVisibilityConverter}}" />
            <Style.Triggers>
              <DataTrigger Value="TechnicalIssue" Binding="{Binding RequestType}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <userattachments:UserAttachmentListControl Height="130" Margin="0,10,0,5" IsTabStop="False" Width="{Binding Width, ElementName=stackPanel}" AttachmentInProgress="{Binding AttachmentInProgress}" DataContext="{Binding AttachmentsVM, ValidatesOnDataErrors=True}" />
      <CheckBox Name="chkboxSupportTicket" Margin="0,15,15,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource SupportTicketCheckboxStyle}" Content="{mex:Localized USER_FEEDBACK_PREVIOUS_TICKET_label}" IsChecked="{Binding PreviousTicketSelected}" />
      <Grid Margin="20,10,0,0" Visibility="{Binding IsChecked, ElementName=chkboxSupportTicket, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{mex:Localized USER_FEEDBACK_FORM_TICKET_NUMBER_label}" />
        <commonControls:PlaceholderTextBox Grid.Row="0" Grid.Column="1" Width="100" Height="28" VerticalAlignment="Center" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" Text="{Binding TicketId, ValidatesOnDataErrors=True}" />
      </Grid>
      <markdown:MarkdownTextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource SecondaryColorBrush}" IsTabStop="False" TextAlignment="Left" TextTrimming="None" TextWrapping="WrapWithOverflow" Width="{Binding Width, ElementName=stackPanel}" Markdown="{mex:Localized USER_FEEDBACK_TERMS_OF_SERVICE_label, {x:Static local:Constants.PRIVACY_POLICY_URL}, {x:Static local:Constants.TERMS_AND_CONDITIONS_URL}}" />
    </StackPanel>
    <Grid Row="1" Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,5" HorizontalAlignment="Right" Foreground="#FFF96A6A" Text="{Binding Error}" />
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="25" Margin="0,0,7,0" Source="../Resources/Icons/WarningIcon.png" Visibility="{Binding NetworkAvailable, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        <StackPanel Grid.Column="1" Orientation="Vertical">
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_NO_INTERNET_CONNECTION_message}" Visibility="{Binding NetworkAvailable, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized USER_FEEDBACK_NO_NETWORK_RECOMMENDATION_text}" Visibility="{Binding NetworkAvailable, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        </StackPanel>
        <Button Grid.Column="2" Width="80" Height="25" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsCancel="True" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
        <Button Grid.Column="3" Width="80" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding SubmitCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{mex:Localized USER_FEEDBACK_FORM_SEND_BUTTON_title}" IsEnabled="{Binding NetworkAvailable}" />
      </Grid>
    </Grid>
  </Grid>
</windowing:ChromedWindow>