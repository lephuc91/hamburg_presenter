<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Feedback.CrashReportingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Feedback" xmlns:markdown="clr-namespace:Pro.UI.Controls.Markdown;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:userattachments="clr-namespace:ProPresenter.UI.UserAttachments" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Width="660" MinHeight="600" MaxHeight="800" uiUtility:WindowHelper.ChildOf="MainWindow" AllowDrop="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" Title="{mex:Localized CRASH_REPORT_WINDOW_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="SecondaryColorBrush" Color="{StaticResource {x:Static themes:Colors.ContentSecondary}}" />
      <Style x:Key="{x:Type commonControls:PlaceholderTextBox}" BasedOn="{StaticResource {x:Type commonControls:PlaceholderTextBox}}" TargetType="{x:Type commonControls:PlaceholderTextBox}">
        <Setter Property="IsTabStop" Value="True" />
      </Style>
      <ControlTemplate x:Key="ErrorTemplate">
        <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
          <Border BorderBrush="#FFF96A6A" BorderThickness="1">
            <AdornedElementPlaceholder Name="textBox" />
          </Border>
          <Image Height="12" Margin="5,7,0,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Source="../Resources/Icons/WarningIcon.png" ToolTip="{Binding [0].ErrorContent}" />
        </StackPanel>
      </ControlTemplate>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="70" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="65" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="65" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
      <Image Width="70" Height="70" Margin="0,5,20,0" VerticalAlignment="Center" Source="{StaticResource {x:Static themes:Icons.AppIcon}}" />
      <TextBlock Width="500" Margin="0,5,0,0" VerticalAlignment="Top" FontSize="14" TextWrapping="Wrap" Text="{mex:Localized CRASH_REPORT_FORM_HEADER_text}" Visibility="{Binding IsEnableCrashReporting, Converter={StaticResource ValueToVisibilityConverter}}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="stackPanel" VerticalAlignment="Top">
        <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="Bold" Text="{mex:Localized USER_FEEDBACK_FORM_DESCRIPTION_label}" />
        <commonControls:PlaceholderTextBox Height="88" Margin="0,4,0,0" AcceptsReturn="True" MinLines="4" TextContentVerticalAlignment="Top" TextWrapping="Wrap" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" PlaceholderText="{mex:Localized USER_FEEDBACK_FORM_DESCRIPTION_TECHNICAL_ISSUE_placeholder}" Text="{Binding Description, ValidatesOnDataErrors=True}" />
        <TextBlock Margin="5,3,0,0" FontSize="11" Foreground="#FF808080" Text="{mex:Localized USER_FEEDBACK_FORM_DESCRIPTION_TECHNICAL_ISSUE_INSTRUCTIONS_label}" />
        <userattachments:UserAttachmentListControl Height="130" Margin="0,20,0,0" AttachmentInProgress="{Binding AttachmentInProgress}" DataContext="{Binding AttachmentsVM}" />
        <CheckBox Name="chkboxSupportFollowup" Margin="0,15,15,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{mex:Localized USER_FEEDBACK_CONTACT_FOLLOWUP_OPTIONAL_label}" IsChecked="{Binding SupportFollowupSelected}" />
        <TextBlock Margin="0,15,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding IsChecked, ElementName=chkboxSupportFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Run Text="{mex:Localized USER_FEEDBACK_FORM_EMAIL_label}" /> <Run Text="*" /></TextBlock>
        <Grid Margin="0,2,0,0" Visibility="{Binding IsChecked, ElementName=chkboxSupportFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
          <commonControls:PlaceholderTextBox Height="28" Margin="0,0,110,0" VerticalAlignment="Center" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Email, ValidatesOnDataErrors=True}" />
        </Grid>
        <TextBlock Margin="0,15,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding IsChecked, ElementName=chkboxSupportFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Run Text="{mex:Localized USER_FEEDBACK_FORM_NAME_label}" /> <Run Text="*" /></TextBlock>
        <Grid Margin="0,2,0,0" Visibility="{Binding IsChecked, ElementName=chkboxSupportFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
          <commonControls:PlaceholderTextBox Height="28" Margin="0,0,110,0" VerticalAlignment="Center" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Name, ValidatesOnDataErrors=True}" />
        </Grid>
        <markdown:MarkdownTextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource SecondaryColorBrush}" IsTabStop="False" TextAlignment="Left" TextTrimming="None" TextWrapping="WrapWithOverflow" Width="{Binding Width, ElementName=stackPanel}" Markdown="{mex:Localized USER_FEEDBACK_TERMS_OF_SERVICE_label, {x:Static local:Constants.PRIVACY_POLICY_URL}, {x:Static local:Constants.TERMS_AND_CONDITIONS_URL}}" />
      </StackPanel>
    </ScrollViewer>
    <Grid Row="2" Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,5" HorizontalAlignment="Right" Foreground="#FFF96A6A" Text="{Binding Error}" />
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="25" Margin="0,0,7,0" Source="../Resources/Icons/WarningIcon.png" Visibility="{Binding NetworkAvailable, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        <StackPanel Grid.Column="1" Orientation="Vertical">
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_NO_INTERNET_CONNECTION_message}" Visibility="{Binding NetworkAvailable, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized USER_FEEDBACK_NO_NETWORK_RECOMMENDATION_text}" Visibility="{Binding NetworkAvailable, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        </StackPanel>
        <Button Grid.Column="2" Width="80" Height="25" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsCancel="True" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
        <Button Grid.Column="3" Width="80" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding SubmitCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{mex:Localized CRASH_REPORT_FORM_SEND_BUTTON_title}" IsEnabled="{Binding NetworkAvailable}" />
      </Grid>
    </Grid>
  </Grid>
</windowing:ChromedWindow>