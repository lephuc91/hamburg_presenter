<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ThirdParty.ThirdPartyViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="thirdPartyViewer" Height="300" xmlns:thirdparty="clr-namespace:ProPresenter.UI.ThirdParty" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="185" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>
    <ListBox Name="thirdPartySWlist" Grid.Row="0" Grid.Column="0" DisplayMemberPath="Key" SelectedIndex="0" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" ItemsSource="{Binding Licenses, ElementName=thirdPartyViewer}" />
    <ScrollViewer Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <TextBox AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding SelectedItem.Value, ElementName=thirdPartySWlist, Mode=OneWay}" />
    </ScrollViewer>
  </Grid>
</UserControl>