<?xml version="1.0" encoding="utf-8"?>
<uiComponents:FrameworkCollection x:Class="ProPresenter.UI.LiveVideo.VideoInputDeviceSelectorSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.LiveVideo" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiComponents="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="videoSourceSelectorSource">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="videoSourceSelectorSourceProxy" Data="{Binding ElementName=videoSourceSelectorSource}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:IsNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpaceConverter" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <CollectionViewSource x:Key="AvailableVideoDevices" Source="{Binding AvailableDevices, ElementName=videoSourceSelectorSource}" />
      <local:SelectVideoDeviceCommandParameterConverter x:Key="SelectVideoDeviceCommandParameterConverter" />
      <local:VideoInputDeviceShouldDisplayModesConverter x:Key="VideoInputDeviceShouldDisplayModesConverter" />
      <Style x:Key="DeviceTypeHeaderStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="VideoInputDeviceStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SelectVideoDeviceCommand, Source={StaticResource videoSourceSelectorSourceProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{MultiBinding Converter={StaticResource SelectVideoDeviceCommandParameterConverter}, Bindings={Binding}}" />
        <Setter Property="Header" Value="{Binding Name}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Mode="OneWay" Path="Data.SelectedLiveVideoInput.VideoDevice" Source="{StaticResource videoSourceSelectorSourceProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <MenuItem IsEnabled="False">
    <HeaderedItemsControl.Header>
      <TextBlock Style="{StaticResource DeviceTypeHeaderStyle}" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_ADD_ADD_VIDEO_INPUTS_label}" />
    </HeaderedItemsControl.Header>
  </MenuItem>
  <MenuItem HorizontalAlignment="Stretch" VerticalAlignment="Center" Command="{Binding Data.SetNoSourceCommand, Source={StaticResource videoSourceSelectorSourceProxy}}" Header="{mex:Localized GLOBAL_VIDEO_INPUT_NO_VIDEO_SOURCE_title}">
    <FrameworkElement.Style>
      <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.IsChecked" Value="False" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Data.SelectedLiveVideoInput.VideoDevice, Source={StaticResource videoSourceSelectorSourceProxy}}" Value="{x:Null}" />
              <Condition Value="False" Binding="{Binding Data.SelectedLiveVideoInput.DeviceRenderID, Source={StaticResource videoSourceSelectorSourceProxy}, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="MenuItem.IsChecked" Value="True" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
  </MenuItem>
  <Separator />
  <MenuItem Header="">
    <HeaderedItemsControl.HeaderTemplate>
      <DataTemplate>
        <TextBlock Visibility="Collapsed" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource Self}}" Text="{Binding Data.SelectedLiveVideoInput.DeviceRenderID, Source={StaticResource videoSourceSelectorSourceProxy}, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=SETTINGS_INPUTS_DISCONNECTED_DEVICE_MENU_title}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Data.SelectedLiveVideoInput.VideoDevice, Source={StaticResource videoSourceSelectorSourceProxy}}" Value="{x:Null}" />
                    <Condition Value="True" Binding="{Binding Data.SelectedLiveVideoInput.DeviceRenderID, Source={StaticResource videoSourceSelectorSourceProxy}, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </DataTemplate>
    </HeaderedItemsControl.HeaderTemplate>
    <FrameworkElement.Style>
      <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.IsChecked" Value="False" />
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Data.SelectedLiveVideoInput.VideoDevice, Source={StaticResource videoSourceSelectorSourceProxy}}" Value="{x:Null}" />
              <Condition Value="True" Binding="{Binding Data.SelectedLiveVideoInput.DeviceRenderID, Source={StaticResource videoSourceSelectorSourceProxy}, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="MenuItem.IsChecked" Value="True" />
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
  </MenuItem>
  <uiComponents:FrameworkCollectionWrapper BoundCollection="{Binding Source={StaticResource AvailableVideoDevices}}">
    <uiComponents:FrameworkCollectionWrapper.BoundDataTemplate>
      <DataTemplate>
        <MenuItem>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <commonUtility:BindingProxy x:Key="VideoDeviceProxy" Data="{Binding}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource VideoInputDeviceStyle}" TargetType="{x:Type MenuItem}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding Data, Source={StaticResource VideoDeviceProxy}, Converter={StaticResource VideoInputDeviceShouldDisplayModesConverter}}">
                  <Setter Property="ItemsSource">
                    <Setter.Value>
                      <CompositeCollection>
                        <CollectionContainer>
                          <CollectionContainer.Collection>
                            <uiComponents:FrameworkCollection>
                              <uiComponents:FrameworkCollectionWrapper BoundCollection="{Binding Path=Data.Modes, Source={StaticResource VideoDeviceProxy}}">
                                <uiComponents:FrameworkCollectionWrapper.BoundDataTemplate>
                                  <DataTemplate>
                                    <MenuItem Command="{Binding Data.SelectVideoDeviceCommand, Source={StaticResource videoSourceSelectorSourceProxy}}" Header="{Binding Name}">
                                      <MenuItem.CommandParameter>
                                        <MultiBinding Converter="{StaticResource SelectVideoDeviceCommandParameterConverter}">
                                          <MultiBinding.Bindings>
                                            <Binding Path="Data" Source="{StaticResource VideoDeviceProxy}" />
                                            <Binding />
                                          </MultiBinding.Bindings>
                                        </MultiBinding>
                                      </MenuItem.CommandParameter>
                                      <MenuItem.IsChecked>
                                        <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}">
                                          <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
                                          <Binding Mode="OneWay" Path="Data.SelectedLiveVideoInput.VideoMode" Source="{StaticResource videoSourceSelectorSourceProxy}" />
                                        </MultiBinding>
                                      </MenuItem.IsChecked>
                                    </MenuItem>
                                  </DataTemplate>
                                </uiComponents:FrameworkCollectionWrapper.BoundDataTemplate>
                              </uiComponents:FrameworkCollectionWrapper>
                            </uiComponents:FrameworkCollection>
                          </CollectionContainer.Collection>
                        </CollectionContainer>
                      </CompositeCollection>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </MenuItem>
      </DataTemplate>
    </uiComponents:FrameworkCollectionWrapper.BoundDataTemplate>
  </uiComponents:FrameworkCollectionWrapper>
  <Separator Visibility="{Binding Visibility, Source={x:Reference Name=AddAirCastMenuItem}}" />
  <MenuItem IsEnabled="False" Visibility="{Binding Visibility, Source={x:Reference Name=AddAirCastMenuItem}}">
    <HeaderedItemsControl.Header>
      <TextBlock Style="{StaticResource DeviceTypeHeaderStyle}" Text="{mex:Localized SETTINGS_INPUTS_AUDIO_INPUT_ADD_ADD_AIRCAST_INPUT_label}" />
    </HeaderedItemsControl.Header>
  </MenuItem>
  <MenuItem Name="AddAirCastMenuItem" Command="{Binding Data.AddAirCastDeviceCommand, Source={StaticResource videoSourceSelectorSourceProxy}}" CommandParameter="{Binding Data.SelectedLiveVideoInput, Source={StaticResource videoSourceSelectorSourceProxy}}" Header="{mex:Localized SETTINGS_INPUTS_VIDEO_INPUT_ADD_AIRCAST_label}">
    <FrameworkElement.Style>
      <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <MenuItem.Icon>
      <controls:ImageMask ImageSource="{StaticResource {x:Static themesUI:Icons.AirCastVideo}}" Fill="{Binding MENU_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}" />
    </MenuItem.Icon>
  </MenuItem>
</uiComponents:FrameworkCollection>