<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.LiveVideo.VideoInputSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="videoInputSelector" xmlns:livevideo="clr-namespace:ProPresenter.UI.LiveVideo;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="videoInputSelectorProxy" Data="{Binding ElementName=videoInputSelector}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:IsNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpaceConverter" />
      <CollectionViewSource x:Key="AvailableInputs" Source="{Binding AvailableInputs, ElementName=videoInputSelector}" />
      <Style x:Key="InputNameStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Text" Value="{Binding Name}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding}" Value="{x:Null}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Text" Value="{mex:Localized GLOBAL_VIDEO_INPUT_NO_VIDEO_SOURCE_title}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="InputStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="HeaderTemplate">
          <Setter.Value>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource InputNameStyle}" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext.Index" RelativeSource="{RelativeSource Self}" />
              <Binding Mode="OneWay" Path="Data.LiveVideoInput.Index" Source="{StaticResource videoInputSelectorProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <EventSetter Event="Click" Handler="InputClick" />
      </Style>
      <Style x:Key="RemoveInputStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.IsChecked" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Data.LiveVideoInput, Source={StaticResource videoInputSelectorProxy}}" Value="{x:Null}">
            <Setter Property="MenuItem.IsChecked" Value="True" />
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
        <EventSetter Event="Click" Handler="RemoveInputClick" />
      </Style>
      <Style x:Key="OpenSetupStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <EventSetter Event="Click" Handler="OpenSetupClick" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Button Name="InputSelectorButton" Height="22" HorizontalContentAlignment="Stretch" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource InputNameStyle}" TextTrimming="CharacterEllipsis" DataContext="{Binding Data.LiveVideoInput, Source={StaticResource videoInputSelectorProxy}}" />
      <commonControls:PathControl Name="Arrow" Grid.Column="1" Width="8" Height="8" Margin="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" PathType="DownArrow" Fill="{Binding Foreground, ElementName=videoInputSelector}" Stroke="{Binding Foreground, ElementName=videoInputSelector}" />
    </Grid>
    <FrameworkElement.ContextMenu>
      <ContextMenu Placement="Bottom" VirtualizingPanel.IsVirtualizing="True" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}}" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Tag="NoVideoSource" Text="{mex:Localized GLOBAL_VIDEO_INPUT_NO_VIDEO_SOURCE_title}" />
            <Separator>
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type Separator}}" TargetType="{x:Type Separator}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Data.LiveVideoInput, Source={StaticResource videoInputSelectorProxy}}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Separator>
            <CollectionContainer Collection="{Binding Source={StaticResource AvailableInputs}}" />
            <Separator />
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Tag="OpenSetup" Text="{mex:Localized GLOBAL_VIDEO_INPUT_SETUP_BUTTON_title}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
    </FrameworkElement.ContextMenu>
  </Button>
</UserControl>