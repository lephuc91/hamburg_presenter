<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Export.ExportImagesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:export="clr-namespace:ProPresenter.DO.Export;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:validation="clr-namespace:ProPresenter.UI.Validation" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Width="350" uiUtility:WindowHelper.ChildOf="MainWindow" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:export1="clr-namespace:ProPresenter.UI.Export" Title="{mex:Localized EXPORT_IMAGES_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:IsNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpaceConverter" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <Style x:Key="ValidatedTextBoxStyle" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
        <Style.Triggers>
          <Trigger Property="Validation.HasError" Value="True">
            <Setter Property="BorderBrush" Value="#FFFF0000" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{mex:Localized EXPORT_IMAGES_SAVE_AS_label}" />
        <TextBox Name="PathNameTextBox" Grid.Column="1" Height="22" Margin="5,0,0,0" VerticalContentAlignment="Center" Style="{StaticResource ValidatedTextBoxStyle}">
          <TextBox.Text>
            <Binding NotifyOnValidationError="True" Path="ExportName" UpdateSourceTrigger="PropertyChanged">
              <Binding.ValidationRules>
                <validation:ExportValidationRule ValidatesOnTargetUpdated="True" />
              </Binding.ValidationRules>
            </Binding>
          </TextBox.Text>
        </TextBox>
      </Grid>
      <Grid Row="1" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <commonControls:FolderBrowserButton Grid.Column="0" IsChoosingFolder="True" TargetPath="{Binding Directory, Mode=TwoWay}" />
        <TextBlock Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding FullFilePath}" />
      </Grid>
    </Grid>
    <Separator Grid.Row="1" Margin="0,10" />
    <Grid Row="2" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <RadioButton HorizontalAlignment="Stretch" GroupName="1" IsChecked="{Binding ImageExportExtension, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static export:ImageExportExtension.JPG}}">
        <ContentControl.Content>
          <TextBlock TextWrapping="Wrap" Text="{mex:Localized EXPORT_IMAGES_FORMAT_JPEG_label}" />
        </ContentControl.Content>
      </RadioButton>
      <RadioButton Grid.Row="1" Margin="0,3,0,0" HorizontalAlignment="Stretch" GroupName="1" IsChecked="{Binding ImageExportExtension, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static export:ImageExportExtension.PNG}}">
        <ContentControl.Content>
          <TextBlock TextWrapping="Wrap" Text="{mex:Localized EXPORT_IMAGES_FORMAT_PNG_label}" />
        </ContentControl.Content>
      </RadioButton>
      <CheckBox Grid.Row="2" Margin="0,5,0,0" HorizontalAlignment="Stretch" Content="{mex:Localized EXPORT_IMAGES_INCLUDE_MEDIA_label}" IsChecked="{Binding IncludeMedia}" />
    </Grid>
    <Separator Grid.Row="3" Margin="0,10" />
    <StackPanel Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
      <Button Height="22" MinWidth="80" Padding="5,0" VerticalAlignment="Center" IsCancel="True" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      <Button Height="22" MinWidth="80" Margin="10,0,0,0" Padding="5,0" VerticalAlignment="Center" IsDefault="True" Content="{mex:Localized GLOBAL_SAVE}" IsEnabled="{Binding ElementName=PathNameTextBox, Path=(Validation.HasError), Converter={StaticResource InvertedBooleanConverter}}" Click="ExportButton_Click" />
    </StackPanel>
  </Grid>
</windowing:ChromedWindow>