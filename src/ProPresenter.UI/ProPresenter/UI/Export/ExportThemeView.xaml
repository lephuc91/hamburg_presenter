<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Export.ExportThemeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Width="450" uiUtility:WindowHelper.ChildOf="MainWindow" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:export="clr-namespace:ProPresenter.UI.Export" Title="{mex:Localized EXPORT_THEMES_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.DataContext>
    <vm:TemplateExportVM />
  </FrameworkElement.DataContext>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{mex:Localized EXPORT_THEMES_SELECT_THEMES_label}" />
    <DataGrid Grid.Row="1" Height="225" Margin="0,10,0,0" AutoGenerateColumns="False" CanUserResizeColumns="False" GridLinesVisibility="None" HorizontalScrollBarVisibility="Disabled" IsReadOnly="True" RowHeaderWidth="0" SelectionMode="Single" ItemsSource="{Binding ThemeKeys}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="Auto">
          <DataGridColumn.HeaderStyle>
            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="{x:Type DataGridColumnHeader}">
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
          </DataGridColumn.HeaderStyle>
          <DataGridColumn.HeaderTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Data.AllSelected, Source={StaticResource proxy}}" />
            </DataTemplate>
          </DataGridColumn.HeaderTemplate>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox Margin="10,3" HorizontalAlignment="Center" IsChecked="{Binding DataContext.CanExport, Mode=TwoWay, RelativeSource={RelativeSource Self}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Theme.Name}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Height="22" MinWidth="70" Padding="10,0" VerticalAlignment="Center" IsCancel="True" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      <Button Height="22" MinWidth="70" Margin="10,0,0,0" Padding="10,0" VerticalAlignment="Center" IsDefault="True" Content="{mex:Localized EXPORT_BUTTON_title}" Click="ExportButton_Click">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
            <Style.Triggers>
              <DataTrigger Value="0" Binding="{Binding ThemesToExport.Count}">
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Button>
    </StackPanel>
  </Grid>
</windowing:ChromedWindow>