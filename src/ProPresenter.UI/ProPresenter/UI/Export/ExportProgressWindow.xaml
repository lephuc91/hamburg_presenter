<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Export.ExportProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="self" Height="130" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Width" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:export="clr-namespace:ProPresenter.UI.Export;assembly=ProPresenter.UI" Title="{mex:Localized EXPORT_PROGRESS_title}" Resources="{commonConverters:FormattedLocalizedStringConverter Key=FormattedLocalizedStringConverter}">
  <Grid Width="450" Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding ExportProcess.CurrentRequest.CurrentItemName, ElementName=self, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=EXPORT_PROGRESS_EXPORTING_label}" />
    <ProgressBar Grid.Row="1" Height="22" Minimum="0" IsIndeterminate="{Binding ExportProcess.CurrentRequest.Archiving, ElementName=self}" Maximum="{Binding ExportProcess.CurrentRequest.ItemCount, ElementName=self}" Value="{Binding ExportProcess.CompletedCount, ElementName=self, Mode=OneWay}" />
    <Button Grid.Row="2" Height="22" MinWidth="80" Margin="0,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" Click="Cancel_Click" />
  </Grid>
</windowing:ChromedWindow>