<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Macros.MacroGroupGridView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ProPresenter.UI.Controls" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters1="clr-namespace:ProPresenter.UI.Converters" xmlns:local="clr-namespace:ProPresenter.UI.Macros" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="macroGroupGridView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MacroGroupsResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <utility:BindingProxy x:Key="macrosVMProxy" Data="{Binding}" />
      <ContextMenu x:Key="ActionsMenu" DataContext="{Binding Data, Source={StaticResource macrosVMProxy}}" Closed="MacroMenu_Closed" Opened="MacroMenu_Opened">
        <ItemsControl.ItemsSource>
          <local:MacroItemMenuSource ActionsMenuVM="{Binding Data.ActionsMenuVM, Source={StaticResource macrosVMProxy}}" />
        </ItemsControl.ItemsSource>
      </ContextMenu>
      <converters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <converters1:MacroAddCommandVisibilityMultiConverter x:Key="MacroAddCommandVisibilityMultiConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:MacroGridFloatingHeaderControl Panel="{Binding ElementName=macroGrid}">
      <local:MacroGridPanel x:Name="macroGrid" Margin="5" AllowDrop="True" ContextMenu="{StaticResource CollectionContextMenu}" xmlns:thumbnails="clr-namespace:ProPresenter.UI.Thumbnails" InView="True" MinItemWidth="76" SelectItemsOnSelfDrop="False" ThumbnailContextMenu="{StaticResource ActionsMenu}" uiUtility:UIElementHelper.RegisterCopyCommand="{Binding CopyCommand}" uiUtility:UIElementHelper.RegisterCutCommand="{Binding CutCommand}" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding DeleteCommand}" uiUtility:UIElementHelper.RegisterDuplicateCommand="{Binding DuplicateCommand}" uiUtility:UIElementHelper.RegisterPasteCommand="{Binding PasteCommand}" DataContext="{Binding Data, Source={StaticResource macrosVMProxy}}" DragDropItemsSource="{Binding SourceMacros}" DropActionCommand="{Binding DropActionCommand}" FocusVisualStyle="{x:Null}" ItemActivatedCommand="{Binding TriggerMacroCommand}" Items="{Binding FilteredMacros}" RenameNextItem="{Binding RenameNextItem, Mode=TwoWay}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}" SelectedItems="{Binding SelectedMacros}" UpdateDialogPlacementCommand="{Binding UpdateDialogPlacementCommand}" />
    </local:MacroGridFloatingHeaderControl>
    <controls:ImageTextButton Grid.Row="0" ButtonBackground="#80707070" ButtonHeight="80" ButtonWidth="80" ImageSource="{StaticResource {x:Static themes:Icons.EmptyAdd}}" Command="{Binding AddMacroCommand}" Text="{markupExtensions:Localized MACROS_WINDOW_ADD_MACROS_label}">
      <UIElement.Visibility>
        <MultiBinding Converter="{StaticResource MacroAddCommandVisibilityMultiConverter}">
          <Binding Path="SourceMacros" />
          <Binding Path="FilterText" />
        </MultiBinding>
      </UIElement.Visibility>
    </controls:ImageTextButton>
  </Grid>
</UserControl>