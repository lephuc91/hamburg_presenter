<?xml version="1.0" encoding="utf-8"?>
<commonComponents:FrameworkCollection x:Class="ProPresenter.UI.Macros.MacroItemMenuSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:actionsMenu="clr-namespace:ProPresenter.UI.ActionsMenu" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonComponents="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters1="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.Macros" x:Name="macroItemMenuSource" xmlns:macros="clr-namespace:ProPresenter.UI.Macros">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="macroItemMenuSourceProxy" Data="{Binding ElementName=macroItemMenuSource}" />
      <converters1:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <commonUtility:BindingProxy x:Key="vmProxy" Data="{Binding}" />
      <converters1:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <ui:InterfaceItemContainerTemplateSelector x:Key="MacroGroupTemplateSelector" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <MenuItem ItemContainerTemplateSelector="{StaticResource MacroGroupTemplateSelector}" UsesItemContainerTemplate="True" Header="{mex:Localized MACROS_CONTEXTUAL_MENU_ADD_TO_title}" ItemsSource="{Binding Parent.MacroGroups}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <DataTemplate x:Key="{DataTemplateKey {x:Type vm:IMacroGroupVM}}" DataType="{x:Type vm:IMacroGroupVM}">
          <MenuItem Command="{Binding AddMacroToGroupCommand}" Header="{Binding MacroGroup.Name}" IsEnabled="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource InvertedBooleanConverter}}">
            <MenuItem.IsChecked>
              <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                <Binding Path="Parent.SelectedMacroGroup" />
                <Binding />
              </MultiBinding>
            </MenuItem.IsChecked>
          </MenuItem>
        </DataTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
  </MenuItem>
  <MenuItem ItemContainerTemplateSelector="{StaticResource MacroGroupTemplateSelector}" UsesItemContainerTemplate="True" Header="{mex:Localized MACROS_CONTEXTUAL_MENU_MOVE_TO_title}" ItemsSource="{Binding Parent.MacroGroups}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <DataTemplate x:Key="{DataTemplateKey {x:Type vm:IMacroGroupVM}}" DataType="{x:Type vm:IMacroGroupVM}">
          <MenuItem Command="{Binding MoveMacroGroupCommand}" Header="{Binding MacroGroup.Name}" IsEnabled="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource InvertedBooleanConverter}}">
            <MenuItem.IsChecked>
              <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                <Binding Path="Parent.SelectedMacroGroup" />
                <Binding />
              </MultiBinding>
            </MenuItem.IsChecked>
          </MenuItem>
        </DataTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
  </MenuItem>
  <Separator />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Rename}" />
  <MenuItem>
    <HeaderedItemsControl.Header>
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Text="{mex:Localized MACROS_CONTEXTUAL_MENU_COLOR_label}" />
        <commonControls:ColorPicker Width="50" Margin="15,0,0,0" SelectedColor="{Binding MacroColor, Mode=TwoWay}" />
      </StackPanel>
    </HeaderedItemsControl.Header>
  </MenuItem>
  <MenuItem Command="{Binding ChangeIconCommand}" Header="{mex:Localized MACROS_CONTEXTUAL_MENU_ICON_label}" />
  <MenuItem Command="{Binding TriggerOnStartupCommand}" Header="{mex:Localized MACROS_CONTEXTUAL_MENU_TRIGGER_ON_STARTUP_label}" IsChecked="{Binding TriggerOnStartup, Mode=OneWay}" />
  <Separator />
  <actionsMenu:AddEditActionMenuSource ShowOpenMacros="False" DataContext="{Binding Data.ActionsMenuVM, Source={StaticResource macroItemMenuSourceProxy}}" />
  <Separator />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.CutCommand}" />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Copy}" />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Paste}" />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Duplicate}" />
  <Separator />
  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" />
</commonComponents:FrameworkCollection>