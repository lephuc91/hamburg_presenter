<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Macros.MacroGroupSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:local="clr-namespace:ProPresenter.UI.Macros" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <common:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
      <converters:MacroAddVisibilityMultiConverter x:Key="MacroAddVisibilityMultiConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="HeaderRow">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <controls:BorderlessToggleButton Name="DropdownButton" Grid.Column="0" Margin="5" HorizontalAlignment="Left" IsChecked="{Binding IsCollectionPopupOpen, Mode=TwoWay}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type controls:BorderlessToggleButton}}" TargetType="{x:Type controls:BorderlessToggleButton}">
          <Style.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Foreground">
                <Setter.Value>
                  <PriorityBinding>
                    <Binding Path="(uiUtility:UIElementHelper.Palette).Standard.Content" RelativeSource="{RelativeSource Self}" />
                  </PriorityBinding>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground">
                <Setter.Value>
                  <PriorityBinding>
                    <Binding Path="(uiUtility:UIElementHelper.Palette).Hover.Content" RelativeSource="{RelativeSource Self}" />
                  </PriorityBinding>
                </Setter.Value>
              </Setter>
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <StackPanel Name="CollectionPanel" Orientation="Horizontal">
        <TextBlock MinWidth="20" Margin="5" FontWeight="Bold" Text="{Binding SelectedMacroGroup.MacroGroup.Name}" />
        <StackPanel Name="IconButton" Margin="2,0" VerticalAlignment="Center">
          <controls:PathControl Width="8" Height="8" Fill="#00FFFFFF" PathType="VUpArrow" Stroke="{Binding BORDERLESSBUTTON_CONTENT, Source={x:Static theming:AppTheme.Active}}" />
          <controls:PathControl Width="8" Height="8" Fill="#00FFFFFF" PathType="VDownArrow" Stroke="{Binding BORDERLESSBUTTON_CONTENT, Source={x:Static theming:AppTheme.Active}}" />
        </StackPanel>
      </StackPanel>
    </controls:BorderlessToggleButton>
    <controls:BorderlessPathButton Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" PathType="Plus" Command="{Binding SelectedMacroGroup.AddMacroCommand}" ToolTip="{markupExtensions:Localized MACROS_ADD_BUTTON_tooltip}">
      <UIElement.Visibility>
        <MultiBinding Converter="{StaticResource MacroAddVisibilityMultiConverter}">
          <Binding Path="SelectedMacroGroup.SourceMacros.Count" />
          <Binding Path="SelectedMacroGroup.FilterText" />
        </MultiBinding>
      </UIElement.Visibility>
    </controls:BorderlessPathButton>
    <Separator Grid.Row="1" Grid.ColumnSpan="2" />
    <controls:AnchoredPopup Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowsTransparency="True" HorizontalOffset="-10" Placement="Bottom" VerticalOffset="0" IsOpen="{Binding Path=IsCollectionPopupOpen}" PlacementTarget="{Binding ElementName=CollectionPanel}" StaysOpen="{Binding ElementName=GroupPicker, Path=IsDragging}">
      <local:MacroGroupPicker x:Name="GroupPicker" DataContext="{Binding Path=Data, Source={StaticResource BindingProxy}}" />
    </controls:AnchoredPopup>
  </Grid>
</UserControl>