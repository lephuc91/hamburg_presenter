<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Macros.MacroGroupPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Macros" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:utility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="MacgroGroupItemStyle" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FrameworkElement.ContextMenu">
          <Setter.Value>
            <ContextMenu>
              <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Rename}" />
              <MenuItem utility:CommandTargets.Assign="MacroGroupList" utility:CommandTargets.Default="False" Command="{x:Static commonCommands:CommonApplicationCommands.Duplicate}" />
              <MenuItem utility:CommandTargets.Assign="MacroGroupList" utility:CommandTargets.Default="False" Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" />
            </ContextMenu>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="ListBoxItem.IsSelected" Value="true" />
              <Condition Property="Selector.IsSelectionActive" Value="true" />
            </MultiTrigger.Conditions>
            <Setter Property="Background" Value="{Binding (utility:UIElementHelper.Palette).Selected.Background, RelativeSource={RelativeSource Self}}" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Width="180" Background="#00FFFFFF">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Height="20" Background="#00FFFFFF">
      <controls:PathControl Width="30" Height="30" HorizontalAlignment="Center" PathType="UpArrow" Fill="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Stroke="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" />
    </Grid>
    <Border Grid.Row="1" BorderThickness="0" CornerRadius="5" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="8,8,8,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{markupExtensions:Localized MACROS_HEADER_COLLECTION_POPUP_title}" />
          <controls:BorderlessPathButton Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" utility:ContextMenuHelper.OpenOnLeftClick="True" PathType="Plus" Command="{Binding AddMacroGroupCommand}" />
          <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
        </Grid>
        <local:MacroGroupList x:Name="MacroGroupList" Grid.Row="1" MaxHeight="150" Margin="5,0,5,5" utility:CommandTargets.Register="MacroGroupList" Background="#00FFFFFF" BorderBrush="#00FFFFFF" DeselectOnLostFocus="False" ItemContainerStyle="{StaticResource MacgroGroupItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" utility:UIElementHelper.RegisterDeleteCommand="{Binding DeleteMacroGroupCommand}" utility:UIElementHelper.RegisterDuplicateCommand="{Binding DuplicateMacroGroupCommand}" ActiveItem="{Binding SelectedMacroGroup}" CloseCollectionPopupCommand="{Binding CloseCollectionPopupCommand}" ItemsSource="{Binding MacroGroups}" RenameNextItem="{Binding RenameNextItem, Mode=TwoWay}" SelectedListItem="{Binding SelectedMacroGroup}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid HorizontalAlignment="Stretch" Background="#00FFFFFF">
                <controls:EditableTextBlock MinWidth="150" Margin="5,5,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Top" ClickToEdit="True" Text="{Binding Name, Mode=TwoWay}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </local:MacroGroupList>
      </Grid>
    </Border>
  </Grid>
</UserControl>