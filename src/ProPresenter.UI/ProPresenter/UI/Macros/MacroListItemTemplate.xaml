<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Macros.MacroListItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:local="clr-namespace:ProPresenter.UI.Macros" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:thumbnail="clr-namespace:ProPresenter.UI.Thumbnails" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="macroListItemTemplate" MinHeight="50" Background="#00FFFFFF">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../Resources/Paths/Paths.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsCollapsing="False" IsInverted="True" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <converters:MacroCustomIconToImageSourceConverter x:Key="MacroCustomIconToImageSourceConverter" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border Name="triggerBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="1" Opacity="0" Background="{Binding MEDIAGRIDACTIVEITEM, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding THUMBNAILPRESENTATION, Source={x:Static theming:AppTheme.Active}}" />
    <Grid VerticalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Name="macroBorder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Margin="5" BorderThickness="1" CornerRadius="5" Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="10" ShadowDepth="0" />
        </UIElement.Effect>
        <Image Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
          <Image.Source>
            <MultiBinding Converter="{StaticResource MacroCustomIconToImageSourceConverter}">
              <Binding Path="ImageType" />
              <Binding Path="Macro.Icon" />
            </MultiBinding>
          </Image.Source>
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="#B7B7B7" />
          </UIElement.Effect>
        </Image>
      </Border>
      <commonControls:EditableTextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" ClickToEdit="False" FontSize="13" Text="{Binding Name, Mode=TwoWay}" />
      <thumbnail:ThumbnailScrimView Grid.Row="1" Grid.Column="1" Margin="8,0,0,2" Items="{Binding ScrimItems}" />
      <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <Image Width="20" Height="20" Margin="0,0,8,0" Source="../Resources/Icons/WarningIcon.png" ToolTip="{Binding WarningMessage}" Visibility="{Binding IsValid, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        <Image Width="20" Height="20" Margin="0,0,8,0" Source="../Resources/Icons/Outline/Playlist/Calendar.png" Visibility="{Binding IsSetToTriggerInCalendar, Converter={StaticResource ValueToVisibilityConverter}}" />
        <commonControls:PathControl Width="20" Height="20" Data="{StaticResource Startup}" Stroke="#00FFFFFF" Fill="{Binding Foreground, ElementName=macroListItemTemplate}" Visibility="{Binding TriggerOnStartup, Converter={StaticResource ValueToVisibilityConverter}}" />
      </StackPanel>
      <commonControls:AnchoredPopup HorizontalAlignment="Center" VerticalAlignment="Stretch" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" IsOpen="{Binding IsListIconPopUpOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=macroBorder}">
        <local:MacroIconPicker DataContext="{Binding}" SelectIconCommand="{Binding Parent.SelectIconCommand}" />
      </commonControls:AnchoredPopup>
    </Grid>
  </Grid>
</UserControl>