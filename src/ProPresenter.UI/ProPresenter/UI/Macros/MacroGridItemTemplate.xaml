<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Macros.MacroGridItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters1="clr-namespace:ProPresenter.UI.Converters" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Macros" xmlns:macroPanelViewSettings="clr-namespace:ProPresenter.DO.PanelViewSettings;assembly=ProPresenter.DO" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="macroGridItemTemplate" BorderBrush="#FF0000FF" BorderThickness="0" ToolTip="{Binding Name}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../Resources/Paths/Paths.xaml" />
        <ui:SharedResourceDictionary Source="MacroGroupsResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <converters1:MacroCustomIconToImageSourceConverter x:Key="MacroCustomIconToImageSourceConverter" />
      <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <local:MacroGridItemPreviewContainer AspectRatio="{Binding ElementName=macroGridItemTemplate, Path=Source.ThumbnailAspectRatio}" ViewSettings="{di:DIMarkup {x:Type macroPanelViewSettings:ThumbnailViewSettings}}">
    <Border Name="MainBorder" Height="{x:Static local:MacroGroupsConstants.GRID_ITEM_HEIGHT}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsSelected}">
              <Setter Property="Background" Value="{Binding SECONDARY, Source={x:Static theming:AppTheme.Active}}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Name="macroBorder" Width="60" Height="60" Margin="5" HorizontalAlignment="Stretch" BorderThickness="1" CornerRadius="6" Background="{Binding Macro.Color, Converter={StaticResource ColorToBrushConverter}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" />
          </UIElement.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Grid.RowSpan="2" Width="25" Height="25" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform">
              <Image.Source>
                <MultiBinding Converter="{StaticResource MacroCustomIconToImageSourceConverter}">
                  <Binding Path="ImageType" />
                  <Binding Path="Macro.Icon" />
                </MultiBinding>
              </Image.Source>
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="#B7B7B7" />
              </UIElement.Effect>
            </Image>
            <Image Grid.Row="0" Width="15" Height="15" Margin="3,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True" Source="../Resources/Icons/WarningIcon.png" ToolTip="{Binding WarningMessage}" Visibility="{Binding IsValid, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          </Grid>
        </Border>
        <controls:EditableTextBlock Grid.Row="1" MaxWidth="60" HorizontalAlignment="Center" VerticalAlignment="Top" ClickToEdit="False" Effect="{StaticResource DefaultDropShadowEffect}" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Name, Mode=TwoWay}" />
        <Border Name="triggerBorder" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="1" CornerRadius="6" Focusable="False" IsHitTestVisible="False" Opacity="0" Background="{Binding MEDIAGRIDACTIVEITEM, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding THUMBNAILPRESENTATION, Source={x:Static theming:AppTheme.Active}}" />
        <controls:AnchoredPopup HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowsTransparency="True" HorizontalOffset="-45" Placement="Bottom" StaysOpen="False" IsOpen="{Binding IsGridIconPopUpOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=macroBorder}">
          <local:MacroIconPicker DataContext="{Binding}" SelectIconCommand="{Binding Parent.SelectIconCommand}" />
        </controls:AnchoredPopup>
      </Grid>
    </Border>
  </local:MacroGridItemPreviewContainer>
</UserControl>