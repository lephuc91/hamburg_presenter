<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SizeSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels" x:Name="self" xmlns:ui1="clr-namespace:ProPresenter.UI">
  <FrameworkElement.DataContext>
    <viewModels:SizeSelectorVM />
  </FrameworkElement.DataContext>
  <FrameworkElement.Resources>
    <ResourceDictionary Source="SizeSelectorResources.xaml" />
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Button Name="Selector" Grid.Row="0" Height="22" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
      <Grid Width="{Binding Path=ActualWidth, ElementName=Selector}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentControl Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" ContentTemplate="{StaticResource ResolutionFormatTemplate}" Content="{Binding SelectedSize}" />
        <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, ElementName=self}" Stroke="{Binding Foreground, ElementName=self}" />
      </Grid>
      <FrameworkElement.ContextMenu>
        <ContextMenu ItemContainerStyleSelector="{StaticResource SizeItemStyleSelector}" ItemsSource="{StaticResource Source}" Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" Opened="ContextMenu_Opened" />
      </FrameworkElement.ContextMenu>
    </Button>
    <Grid Row="1" Margin="0,15,0,0" Visibility="{Binding SizeIsConfigured, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Image Grid.Row="0" Grid.Column="0" Width="16" Height="16" Margin="0,0,5,0" Source="/ProPresenter.UI;component/Resources/Icons/WarningIcon.png" />
      <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{Binding UnconfiguredSizeMessage, ElementName=self}" />
      <Button Grid.Row="1" Grid.ColumnSpan="2" Height="22" Margin="0,10,0,0" Command="{Binding ResizeToScreenCommand}" Content="{Binding ResizeButtonContent, ElementName=self}" />
    </Grid>
  </Grid>
</UserControl>