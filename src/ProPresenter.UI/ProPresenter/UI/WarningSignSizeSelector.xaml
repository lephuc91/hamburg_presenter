<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.WarningSignSizeSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels" x:Name="self" xmlns:ui="clr-namespace:ProPresenter.UI">
  <FrameworkElement.DataContext>
    <viewModels:SizeSelectorVM />
  </FrameworkElement.DataContext>
  <FrameworkElement.Resources>
    <ResourceDictionary Source="SizeSelectorResources.xaml" />
  </FrameworkElement.Resources>
  <commonControls:BorderlessButton Grid.Row="0" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ToolTip="{mex:Localized PRESENTATION_HEADER_SIZE_MISMATCH_tooltip}">
    <Border Height="14">
      <Image Source="../Resources/Icons/WarningIcon.png" StretchDirection="DownOnly" />
    </Border>
    <FrameworkElement.ContextMenu>
      <ContextMenu ItemContainerStyleSelector="{StaticResource SizeItemStyleSelector}" ItemsSource="{StaticResource Source}" Placement="Bottom" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" Opened="ContextMenu_Opened" />
    </FrameworkElement.ContextMenu>
  </commonControls:BorderlessButton>
</UserControl>