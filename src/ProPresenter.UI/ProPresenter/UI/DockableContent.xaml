<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.DockableContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverter="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="self" BorderThickness="0" xmlns:ui="clr-namespace:ProPresenter.UI;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverter:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <commonConverter:ValueToVisibilityConverter x:Key="ValueToVisibilityConverterInverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <windowing:Caption Grid.Row="0">
      <Grid Margin="0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <commonControls:BorderlessToggleButton Name="DockUndock" Grid.Row="0" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="DockUndock_Click">
          <Image Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/ModulesDockUndock/modulesDockUndock.png" StretchDirection="DownOnly" />
        </commonControls:BorderlessToggleButton>
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" IsHitTestVisible="False" Text="{Binding Title, ElementName=self}" />
        <Grid Row="0" Margin="0,0,10,0" HorizontalAlignment="Right">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <ContentPresenter Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Content="{Binding AdditionalHeaderContent, ElementName=self}" />
          <commonControls:CloseButton Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsChecked, ElementName=DockUndock, Converter={StaticResource ValueToVisibilityConverterInverter}}" Click="Close_Click" />
        </Grid>
        <ContentPresenter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{Binding SubHeader, ElementName=self}" />
      </Grid>
    </windowing:Caption>
    <ContentPresenter Grid.Row="1" Content="{Binding Child, ElementName=self}" />
  </Grid>
</UserControl>