<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.MediaLibrary.MediaPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ci="clr-namespace:ProPresenter.UI.CueInspector" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:livevideo="clr-namespace:ProPresenter.UI.LiveVideo" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" x:Name="mediaPreview" xmlns:medialibrary="clr-namespace:ProPresenter.UI.MediaLibrary">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsCollapsing="False" IsInverted="True" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="False" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ci:PreviewImage Item="{Binding Media, ElementName=mediaPreview}" ShowIconForNonVisualMedia="{Binding ElementName=mediaPreview, Path=ShowIconForNonVisualMedia}" Visibility="{Binding Media.MediaType, ElementName=mediaPreview, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static media:MediaType.LiveVideo}}" />
    <livevideo:VideoInputPreview VideoInput="{Binding VideoInput, ElementName=mediaPreview}" Visibility="{Binding Media.MediaType, ElementName=mediaPreview, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static media:MediaType.LiveVideo}}" />
  </Grid>
</UserControl>