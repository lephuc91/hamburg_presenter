<?xml version="1.0" encoding="utf-8"?>
<components:FrameworkCollection x:Class="ProPresenter.UI.MediaLibrary.MediaActionMenuSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:components="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proSSAPI="clr-namespace:Pro.ssAPI;assembly=Pro.ssAPI" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="mediaActionMenuSource">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <commonUtility:BindingProxy x:Key="mediaActionMenuSourceProxy" Data="{Binding ElementName=mediaActionMenuSource}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <local:TargetLayerVisibilityConverter x:Key="TargetLayerVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <local:TimeSliceToTotalSecondsConverter x:Key="TimeSliceToTotalSecondsConverter" />
      <Style x:Key="BehaviorMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SetMediaTargetLayerCommand, Source={StaticResource mediaActionMenuSourceProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="Header" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
        <Setter Property="HeaderedItemsControl.HeaderStringFormat" Value="{}{0}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Path="Data.MediaAction.TriggerLayer" Source="{StaticResource mediaActionMenuSourceProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="Visibility">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource TargetLayerVisibilityConverter}">
              <Binding Path="Data.MediaAction.Media.MediaType" Source="{StaticResource mediaActionMenuSourceProxy}" />
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="False" Binding="{Binding Data.CanSetTargetLayer, Source={StaticResource mediaActionMenuSourceProxy}}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ScalingMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SetMediaScaleBehaviorCommand, Source={StaticResource mediaActionMenuSourceProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="Header" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
        <Setter Property="HeaderedItemsControl.HeaderStringFormat" Value="{}{0}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Path="Data.Drawing.ScaleBehavior" Source="{StaticResource mediaActionMenuSourceProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="LiveVideo" Binding="{Binding Data.MediaAction.Media.MediaType, Source={StaticResource mediaActionMenuSourceProxy}}">
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
                  <Binding Path="Data.Drawing.ScaleBehavior" Source="{StaticResource mediaActionMenuSourceProxy}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="VideoMediaMenuStyleBase" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Visibility" Value="{Binding Data.MediaAction.Media.MediaType, ConverterParameter={x:Static media:MediaType.Video}, Source={StaticResource mediaActionMenuSourceProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
      </Style>
      <Style x:Key="AlphaTypeSeparatorStyle" BasedOn="{StaticResource {x:Type Separator}}" TargetType="{x:Type Separator}">
        <Setter Property="Visibility" Value="{Binding Data.SupportsPremultipliedAlphaSetting, Source={StaticResource mediaActionMenuSourceProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
      </Style>
      <Style x:Key="AlphaTypeMenuStyleBase" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Visibility" Value="{Binding Data.SupportsPremultipliedAlphaSetting, Source={StaticResource mediaActionMenuSourceProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
      </Style>
      <Style x:Key="AlphaTypeMenuStyle" BasedOn="{StaticResource AlphaTypeMenuStyleBase}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SetAlphaTypeCommand, Source={StaticResource mediaActionMenuSourceProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="HeaderedItemsControl.HeaderStringFormat" Value="{}{0}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Path="Data.Drawing.AlphaType" Source="{StaticResource mediaActionMenuSourceProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PlaybackBehaviorMenuItemStyle" BasedOn="{StaticResource VideoMediaMenuStyleBase}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SetPlaybackBehaviorCommand, Source={StaticResource mediaActionMenuSourceProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="Header" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
        <Setter Property="HeaderedItemsControl.HeaderStringFormat" Value="{}{0}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Path="Data.Transport.PlaybackBehaviorType" Source="{StaticResource mediaActionMenuSourceProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SoftLoopDurationMenuItemStyle" BasedOn="{StaticResource VideoMediaMenuStyleBase}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SetSoftLoopDurationCommand, Source={StaticResource mediaActionMenuSourceProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="Header" Value="{Binding Converter={StaticResource TimeSliceToTotalSecondsConverter}}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Path="Data.Video.SoftLoopDuration" Source="{StaticResource mediaActionMenuSourceProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="Stop" Binding="{Binding Data.Transport.PlaybackBehaviorType, Source={StaticResource mediaActionMenuSourceProxy}}">
            <Setter Property="MenuItem.IsChecked" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
          <DataTrigger Value="False" Binding="{Binding Data.Video.SoftLoop, Source={StaticResource mediaActionMenuSourceProxy}}">
            <Setter Property="MenuItem.IsChecked" Value="False" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="EndBehaviorMenuItemStyle" BasedOn="{StaticResource VideoMediaMenuStyleBase}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SetEndBehaviorTypeCommand, Source={StaticResource mediaActionMenuSourceProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="Header" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
        <Setter Property="HeaderedItemsControl.HeaderStringFormat" Value="{}{0}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Path="Data.Video.EndBehavior" Source="{StaticResource mediaActionMenuSourceProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="Loop" Binding="{Binding Data.Transport.PlaybackBehaviorType, Source={StaticResource mediaActionMenuSourceProxy}}">
            <Setter Property="MenuItem.IsChecked" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <MenuItem Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_BEHAVIOR_title}" Visibility="{Binding Data.CanSetTargetLayer, Source={StaticResource mediaActionMenuSourceProxy}, Converter={StaticResource ValueToVisibilityConverter}}">
    <MenuItem DataContext="{x:Static media:TriggerLayer.Background}" Style="{StaticResource BehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static media:TriggerLayer.Foreground}" Style="{StaticResource BehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static media:TriggerLayer.Input}" Style="{StaticResource BehaviorMenuItemStyle}" />
  </MenuItem>
  <MenuItem Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_SCALING_title}">
    <MenuItem DataContext="{x:Static proSSAPI:ScaleBehavior.ScaleToFit}" Style="{StaticResource ScalingMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:ScaleBehavior.ScaleToFill}" Style="{StaticResource ScalingMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:ScaleBehavior.StretchToFill}" Style="{StaticResource ScalingMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:ScaleBehavior.ScaleAndBlur}" Style="{StaticResource ScalingMenuItemStyle}" />
  </MenuItem>
  <MenuItem Style="{StaticResource AlphaTypeMenuStyleBase}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_ALPHA_TYPE_title}">
    <MenuItem DataContext="{x:Static media:AlphaType.Straight}" Style="{StaticResource AlphaTypeMenuStyle}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_ALPHA_TYPE_STRAIGHT_title}" />
    <MenuItem DataContext="{x:Static media:AlphaType.Premultiplied}" Style="{StaticResource AlphaTypeMenuStyle}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_ALPHA_TYPE_PREMULTIPLIED_title}" />
  </MenuItem>
  <Separator Visibility="{Binding Data.MediaAction.Media.MediaType, Source={StaticResource mediaActionMenuSourceProxy}, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static media:MediaType.Video}}" />
  <MenuItem Name="PlaybackBehaviorHeader" Style="{StaticResource VideoMediaMenuStyleBase}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_PLAYBACK_title}">
    <MenuItem DataContext="{x:Static proSSAPI:PlaybackBehaviorType.Stop}" Style="{StaticResource PlaybackBehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:PlaybackBehaviorType.Loop}" Style="{StaticResource PlaybackBehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:PlaybackBehaviorType.LoopForCount}" Style="{StaticResource PlaybackBehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:PlaybackBehaviorType.LoopForTime}" Style="{StaticResource PlaybackBehaviorMenuItemStyle}" />
  </MenuItem>
  <MenuItem Name="LoopBehaviorHeader" Style="{StaticResource VideoMediaMenuStyleBase}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_LOOP_BEHAVIOR_title}">
    <MenuItem HeaderStringFormat="{}{0}" Command="{Binding Data.SetSoftLoopDurationCommand, Source={StaticResource mediaActionMenuSourceProxy}}" CommandParameter="{Binding}" DataContext="{x:Null}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_PLAYBACK_STANDARD_LOOP_title}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource VideoMediaMenuStyleBase}" TargetType="{x:Type MenuItem}">
          <Setter Property="MenuItem.IsChecked" Value="False" />
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding Data.Video.SoftLoop, Source={StaticResource mediaActionMenuSourceProxy}}">
              <Setter Property="MenuItem.IsChecked" Value="True" />
            </DataTrigger>
            <DataTrigger Value="Stop" Binding="{Binding Data.Transport.PlaybackBehaviorType, Source={StaticResource mediaActionMenuSourceProxy}}">
              <Setter Property="MenuItem.IsChecked" Value="False" />
            </DataTrigger>
            <DataTrigger Value="Stop" Binding="{Binding Data.Transport.PlaybackBehaviorType, Source={StaticResource mediaActionMenuSourceProxy}}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
    <MenuItem HeaderStringFormat="{}{0}" ItemContainerStyle="{StaticResource SoftLoopDurationMenuItemStyle}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_PLAYBACK_SOFT_LOOP_title}" ItemsSource="{Binding Data.SoftLoopDurations, Source={StaticResource mediaActionMenuSourceProxy}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource VideoMediaMenuStyleBase}" TargetType="{x:Type MenuItem}">
          <Setter Property="MenuItem.IsChecked" Value="False" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding Data.Video.SoftLoop, Source={StaticResource mediaActionMenuSourceProxy}}">
              <Setter Property="MenuItem.IsChecked" Value="True" />
            </DataTrigger>
            <DataTrigger Value="Stop" Binding="{Binding Data.Transport.PlaybackBehaviorType, Source={StaticResource mediaActionMenuSourceProxy}}">
              <Setter Property="MenuItem.IsChecked" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </MenuItem>
  </MenuItem>
  <MenuItem Name="EndBehaviorHeader" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_END_BEHAVIOR_title}">
    <FrameworkElement.Style>
      <Style BasedOn="{StaticResource VideoMediaMenuStyleBase}" TargetType="{x:Type MenuItem}">
        <Setter Property="IsEnabled" Value="True" />
        <Style.Triggers>
          <DataTrigger Value="Loop" Binding="{Binding Data.Transport.PlaybackBehaviorType, Source={StaticResource mediaActionMenuSourceProxy}}">
            <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <MenuItem DataContext="{x:Static proSSAPI:EndBehaviorType.HoldLastFrame}" Style="{StaticResource EndBehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:EndBehaviorType.BlackAfterLastFrame}" Style="{StaticResource EndBehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:EndBehaviorType.ClearAfterLastFrame}" Style="{StaticResource EndBehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:EndBehaviorType.FadeToBlack}" Style="{StaticResource EndBehaviorMenuItemStyle}" />
    <MenuItem DataContext="{x:Static proSSAPI:EndBehaviorType.FadeToClear}" Style="{StaticResource EndBehaviorMenuItemStyle}" />
  </MenuItem>
</components:FrameworkCollection>