<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.MediaLibrary.MediaImportDownloadDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.SendKeyEventsToMainWindow="False" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" Title="{mex:Localized MEDIA_IMPORT_PLAYLIST_SELECTOR_WINDOW_IMPORT_title}">
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource {x:Type windowing:ChromedWindow}}" TargetType="{x:Type windowing:ChromedWindow}">
      <Setter Property="Window.Title" Value="{mex:Localized MEDIA_IMPORT_PLAYLIST_SELECTOR_WINDOW_IMPORT_title}" />
      <Style.Triggers>
        <DataTrigger Value="true" Binding="{Binding IsDownload}">
          <Setter Property="Window.Title" Value="{mex:Localized MEDIA_IMPORT_PLAYLIST_SELECTOR_WINDOW_DOWNLOAD_title}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="HideIfNotNullVisibilityConvetrer" IsCollapsing="False" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0,0,0,15">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized MEDIA_PLAYLIST_SELECTOR_PLAYLIST_label}" />
      <local:MediaLibrarySelectionControl Grid.Column="1" Width="300" Height="22" NoSelectionTranslationKey="MEDIA_PLAYLIST_SELECTOR_NEW_PLAYLIST_MENU_ITEM_title" Playlists="{Binding Playlists, Mode=OneWay}" SelectedPlaylist="{Binding SelectedPlaylist, Mode=TwoWay}" />
      <TextBlock Grid.Row="1" Margin="0,5,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized MEDIA_PLAYLIST_SELECTOR_NEW_PLAYLIST_NAME_label}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPlaylist}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <commonControls:PlaceholderTextBox Grid.Row="1" Grid.Column="1" Width="300" Height="22" Margin="0,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" PlaceholderText="{mex:Localized MEDIA_PLAYLIST_SELECTOR_NEW_PLAYLIST_MENU_ITEM_placeholder}" Text="{Binding NewPlaylistName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SelectedPlaylist, Converter={StaticResource HideIfNotNullVisibilityConvetrer}}" />
    </Grid>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Height="21" MinWidth="80" Margin="0,0,8,0" Padding="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" Click="Cancel_Click" />
      <Button Grid.Column="1" Height="21" MinWidth="80" Padding="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsDefault="True" IsEnabled="{Binding IsValidLibrarySelected}" Click="Download_Click">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
            <Setter Property="Content" Value="{mex:Localized MEDIA_IMPORT_PLAYLIST_SELECTOR_WINDOW_IMPORT_BUTTON_title}" />
            <Style.Triggers>
              <DataTrigger Value="true" Binding="{Binding IsDownload}">
                <Setter Property="Content" Value="{mex:Localized MEDIA_IMPORT_PLAYLIST_SELECTOR_WINDOW_DOWNLOAD_BUTTON_title}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Button>
    </Grid>
  </Grid>
</windowing:ChromedWindow>