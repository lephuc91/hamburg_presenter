<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.MediaLibrary.MediaPlaylistView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:controls="clr-namespace:ProPresenter.UI.Controls" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cueInspector="clr-namespace:ProPresenter.UI.CueInspector" xmlns:cues="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:do="clr-namespace:ProPresenter.DO;assembly=ProPresenter.DO" xmlns:floatingHeaders="clr-namespace:ProPresenter.UI.FloatingHeaders" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:liveVideo="clr-namespace:ProPresenter.DO.LiveVideo;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:presentationView="clr-namespace:ProPresenter.UI.PresentationView" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:thumbnails="clr-namespace:ProPresenter.UI.Thumbnails" xmlns:triggering="clr-namespace:Pro.DO.Triggering;assembly=Pro.DO" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <commonUtility:BindingProxy x:Key="mediaLibraryVMProxy" Data="{Binding}" />
      <commonUtility:BindingProxy x:Key="mediaBinProxy" Data="{Binding ElementName=mediaBin}" />
