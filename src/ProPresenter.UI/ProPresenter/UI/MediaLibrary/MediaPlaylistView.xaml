                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Value="False" Binding="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaCue.MediaAction.Media.IsValid, Source={StaticResource mediaLibraryVMProxy}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Value="False" Binding="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaCue.MediaAction.Media.IsValid, Source={StaticResource mediaLibraryVMProxy}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding Data.PlaylistVM.SelectedMediaCues, Source={StaticResource mediaLibraryVMProxy}, Converter={StaticResource CountToBoolConverter}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </MenuItem>
            <MenuItem Command="{Binding Data.OpenLiveVideoSetupCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized GLOBAL_VIDEO_INPUT_SETUP_BUTTON_title}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                  <Setter Property="Visibility" Value="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaCue.MediaAction.Media.MediaType, ConverterParameter={x:Static media:MediaType.LiveVideo}, Source={StaticResource mediaLibraryVMProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Data.PlaylistVM.SelectedMediaCues, Source={StaticResource mediaLibraryVMProxy}, Converter={StaticResource CountToBoolConverter}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </MenuItem>
            <MenuItem Style="{StaticResource LinkMenuItemStyle}" Command="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaOverlayVM.RelinkCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_LINK_MEDIA_win_title}" />
            <MenuItem Style="{StaticResource LinkMenuItemStyle}" Command="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaOverlayVM.DownloadCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_DOWNLOAD_MEDIA_title}" />
            <MenuItem Style="{StaticResource LinkMenuItemStyle}" Command="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaOverlayVM.CancelDownloadCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_CANCEL_DOWNLOAD_title}" />
            <MenuItem Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_CLEAN_UP_BY_title}" Click="Sort_Click">
              <ItemsControl.ItemsSource>
                <CompositeCollection>
                  <media:VisualSortType>Type</media:VisualSortType>
                  <media:VisualSortType>Name</media:VisualSortType>
                  <media:VisualSortType>Path</media:VisualSortType>
                  <media:VisualSortType>Kind</media:VisualSortType>
                  <media:VisualSortType>Duration</media:VisualSortType>
                  <media:VisualSortType>Format</media:VisualSortType>
                  <media:VisualSortType>Length</media:VisualSortType>
                </CompositeCollection>
              </ItemsControl.ItemsSource>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </MenuItem>
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
      <CollectionViewSource x:Key="AvailableInputs" Source="{Binding Data.PlaylistVM.AvailableVideoInputs, Source={StaticResource mediaLibraryVMProxy}}" />
      <CompositeCollection x:Key="AddVideoInputCollection">
        <CollectionContainer Collection="{Binding Source={StaticResource AvailableInputs}}" />
        <Separator />
        <MenuItem Command="{Binding Data.OpenLiveVideoSetupCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized MEDIA_BIN_TOOLBAR_NEW_MENU_VIDEO_INPUT_CONFIG_title}" />
      </CompositeCollection>
      <CompositeCollection x:Key="AddMediaCueCollection">
        <MenuItem Command="{Binding Data.AddNewMediaCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized MEDIA_BIN_TOOLBAR_NEW_MENU_FROM_FINDER_windows_title}" />
        <MenuItem UsesItemContainerTemplate="True" Header="{mex:Localized MEDIA_BIN_TOOLBAR_NEW_MENU_FROM_VIDEO_INPUT_title}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type liveVideo:LiveVideoInput}}">
                <MenuItem Command="{Binding Data.PlaylistVM.AddLiveVideoMediaCommand, Source={StaticResource mediaLibraryVMProxy}}" CommandParameter="{Binding}">
                  <HeaderedItemsControl.Header>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding LongName}" />
                  </HeaderedItemsControl.Header>
                </MenuItem>
              </ItemContainerTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.ItemsSource>
            <CompositeCollection>
              <CollectionContainer Collection="{Binding Source={StaticResource AvailableInputs}}" />
              <Separator />
              <MenuItem Command="{Binding Data.OpenLiveVideoSetupCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized MEDIA_BIN_TOOLBAR_NEW_MENU_VIDEO_INPUT_CONFIG_title}" />
            </CompositeCollection>
          </ItemsControl.ItemsSource>
        </MenuItem>
      </CompositeCollection>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="27" />
    </Grid.RowDefinitions>
    <Grid Row="0" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <floatingHeaders:FlatFloatingHeaderControl Grid.Row="0">
        <thumbnails:MediaThumbnailPanel x:Name="ThumbnailView" RequestBringIntoView="Control_RequestBringIntoView" ClearSelectionOnActivation="False" DisplayMode="Content" ThumbnailContextMenu="{StaticResource VisualMediaContextMenu}" ActiveItem="{Binding PlaylistVM.ActiveMediaItem}" ActiveItems="{Binding PlaylistVM.ActiveMediaItems}" AddFilesCommand="{Binding AddFilesCommand}" CopyCommand="{Binding CopyCommand}" CutCommand="{Binding CutCommand}" DeleteCommand="{Binding DeleteCommand}" DropProContentAssetCommand="{Binding DropProContentAssetCommand}" DuplicateCommand="{Binding DuplicateCommand}" ItemActivatedCommand="{Binding TriggerMediaItemCommand}" Items="{Binding PlaylistVM.MediaCues}" OutputController="{Binding OutputController}" PasteCommand="{Binding PasteCommand}" RowCapacity="{Binding RowCapacity, Mode=OneWay}" SelectedItem="{Binding PlaylistVM.SelectedPlaylistItem, Mode=TwoWay}" SelectedItems="{Binding PlaylistVM.SelectedPlaylistItems}" SelectedPlaylist="{Binding PlaylistVM.ActivePlaylist}" Visibility="{Binding ViewType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:PanelViewType.Thumbnail}}">
          <FrameworkElement.ContextMenu>
            <ContextMenu>
              <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Paste}" />
              <MenuItem Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_CLEAN_UP_BY_title}" Click="Sort_Click">
                <ItemsControl.ItemsSource>
                  <CompositeCollection>
                    <media:VisualSortType>Type</media:VisualSortType>
                    <media:VisualSortType>Name</media:VisualSortType>
                    <media:VisualSortType>Path</media:VisualSortType>
                    <media:VisualSortType>Kind</media:VisualSortType>
                    <media:VisualSortType>Duration</media:VisualSortType>
                    <media:VisualSortType>Format</media:VisualSortType>
                    <media:VisualSortType>Length</media:VisualSortType>
                  </CompositeCollection>
                </ItemsControl.ItemsSource>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </MenuItem>
            </ContextMenu>
          </FrameworkElement.ContextMenu>
        </thumbnails:MediaThumbnailPanel>
      </floatingHeaders:FlatFloatingHeaderControl>
      <local:MediaCueListView x:Name="TableView" RequestBringIntoView="Control_RequestBringIntoView" Grid.Row="0" MediaContextMenu="{StaticResource VisualMediaContextMenu}" ActiveMediaItems="{Binding PlaylistVM.ActiveMediaItems}" AddFilesCommand="{Binding AddFilesCommand}" CopyCommand="{Binding CopyCommand}" CutCommand="{Binding CutCommand}" DeleteCommand="{Binding DeleteCommand}" DuplicateCommand="{Binding DuplicateCommand}" MediaItems="{Binding PlaylistVM.MediaCues}" OutputController="{Binding OutputController}" PasteCommand="{Binding PasteCommand}" RowCapacity="{Binding RowCapacity}" SelectedMediaItem="{Binding PlaylistVM.SelectedPlaylistItem, Mode=TwoWay}" SelectedMediaItems="{Binding PlaylistVM.SelectedPlaylistItems}" SelectedPlaylist="{Binding PlaylistVM.ActivePlaylist}" TriggerThumbnailCommand="{Binding TriggerMediaItemCommand}" Visibility="{Binding ViewType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:PanelViewType.List}}" />
      <controls:ImageTextButton Grid.Row="0">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type controls:ImageTextButton}">
            <Setter Property="controls:ImageTextButton.Command" Value="{Binding AddNewMediaCommand}" />
            <Setter Property="controls:ImageTextButton.ImageSource" Value="{StaticResource {x:Static themes:Icons.EmptyImport}}" />
            <Setter Property="controls:ImageTextButton.Text" Value="{mex:Localized MEDIA_WINDOW_IMPORT_MEDIA_label}" />
            <Setter Property="Visibility" Value="{Binding PlaylistVM.ActivePlaylist.Count, Converter={StaticResource InvertedCountToVisibilityConverter}}" />
            <Setter Property="uiUtility:ContextMenuHelper.OpenOnLeftClick" Value="False" />
            <Style.Triggers>
              <DataTrigger Value="Group" Binding="{Binding PlaylistVM.ActivePlaylist.Type}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Value="Download" Binding="{Binding PlaylistVM.ActivePlaylist.Type}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Value="Smart" Binding="{Binding PlaylistVM.ActivePlaylist.Type}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Value="LiveVideo" Binding="{Binding PlaylistVM.ActivePlaylist.Type}">
                <Setter Property="controls:ImageTextButton.ImageSource" Value="{StaticResource {x:Static themes:Icons.EmptyAdd}}" />
                <Setter Property="controls:ImageTextButton.Text" Value="{mex:Localized MEDIA_BIN_ADD_VIDEO_INPUT_label}" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="LiveVideo" Binding="{Binding PlaylistVM.ActivePlaylist.Type}" />
                  <Condition Value="True" Binding="{Binding PlaylistVM.HasAvailableVideoInputs}" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                  <Setter Property="controls:ImageTextButton.Command" Value="{x:Null}" />
                  <Setter Property="uiUtility:ContextMenuHelper.OpenOnLeftClick" Value="True" />
                  <Setter Property="FrameworkElement.ContextMenu">
                    <Setter.Value>
                      <ContextMenu ItemsSource="{StaticResource AddVideoInputCollection}" UsesItemContainerTemplate="True">
                        <FrameworkElement.Resources>
                          <ResourceDictionary>
                            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type liveVideo:LiveVideoInput}}">
                              <MenuItem Command="{Binding Data.PlaylistVM.AddLiveVideoMediaCommand, Source={StaticResource mediaLibraryVMProxy}}" CommandParameter="{Binding}">
                                <HeaderedItemsControl.Header>
                                  <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding LongName}" />
                                </HeaderedItemsControl.Header>
                              </MenuItem>
                            </ItemContainerTemplate>
                            <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                              <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                            </Style>
                          </ResourceDictionary>
                        </FrameworkElement.Resources>
                      </ContextMenu>
                    </Setter.Value>
                  </Setter>
                </MultiDataTrigger.Setters>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="LiveVideo" Binding="{Binding PlaylistVM.ActivePlaylist.Type}" />
                  <Condition Value="False" Binding="{Binding PlaylistVM.HasAvailableVideoInputs}" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                  <Setter Property="controls:ImageTextButton.Command" Value="{Binding Data.OpenLiveVideoSetupCommand, Source={StaticResource mediaLibraryVMProxy}}" />
                </MultiDataTrigger.Setters>
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </controls:ImageTextButton>
    </Grid>
    <Grid Row="1" uiUtility:UIElementHelper.Palette="{Binding PRESENTATION_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <commonControls:BorderlessPathButton Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" PathType="Plus" ToolTip="{mex:Localized MEDIA_BIN_TOOLBAR_NEW_BUTTON_tooltip}">
        <FrameworkElement.ContextMenu>
          <ContextMenu UsesItemContainerTemplate="True">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type liveVideo:LiveVideoInput}}">
                  <MenuItem Command="{Binding Data.PlaylistVM.AddLiveVideoMediaCommand, Source={StaticResource mediaLibraryVMProxy}}" CommandParameter="{Binding}">
                    <HeaderedItemsControl.Header>
                      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding LongName}" />
                    </HeaderedItemsControl.Header>
                  </MenuItem>
                </ItemContainerTemplate>
                <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type ContextMenu}}" TargetType="{x:Type ContextMenu}">
                <Setter Property="ItemsSource" Value="{StaticResource AddMediaCueCollection}" />
                <Style.Triggers>
                  <DataTrigger Value="LiveVideo" Binding="{Binding Data.PlaylistVM.ActivePlaylist.Type, Source={StaticResource mediaLibraryVMProxy}}">
                    <Setter Property="ItemsSource" Value="{StaticResource AddVideoInputCollection}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ContextMenu>
        </FrameworkElement.ContextMenu>
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessPathButton}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="Group" Binding="{Binding PlaylistVM.ActivePlaylist.Type}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Value="Download" Binding="{Binding PlaylistVM.ActivePlaylist.Type}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
              <DataTrigger Value="Smart" Binding="{Binding PlaylistVM.ActivePlaylist.Type}">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:BorderlessPathButton>
      <Separator Name="divider" Grid.Column="1" Margin="6,7,6,7" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" />
      <presentationView:ViewerStatusBar x:Name="PresentationDockingPanel" Grid.Column="2" IsListViewAvailable="True" IsThumbnailViewAvailable="True" IsViewOptionPopupAvailable="False" MaxRowCapacity="12" MinRowCapacity="1" TransitionDisplayMode="Background" RowCapacity="{Binding RowCapacity, Mode=TwoWay}" SelectedViewType="{Binding ViewType}" TransitionControl="{Binding}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type presentationView:ViewerStatusBar}">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
              <DataTrigger Value="Collapsed" Binding="{Binding ElementName=divider, Path=Visibility}">
                <Setter Property="Margin" Value="8,0,0,0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <commonControls:FilterBox Width="200" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" PlaceholderText="{mex:Localized GLOBAL_FILTER_FIELD_placeholder}" Text="{Binding PlaylistVM.SearchText, UpdateSourceTrigger=PropertyChanged}" />
      </presentationView:ViewerStatusBar>
    </Grid>
  </Grid>
</UserControl>