      <commonConverters:CountToBoolConverter x:Key="CountToBoolConverter" Value="1" />
      <commonConverters:CountToBoolConverter x:Key="CountToBoolGreaterThanZeroConverter" Value="0" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <Style x:Key="CommandTargetStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.CommandTarget" Value="{Binding Data.MediaContextMenuPlacementTarget, Source={StaticResource mediaBinProxy}}" />
      </Style>
      <Style x:Key="LinkMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Visibility" Value="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ValueToVisibilityConverter}}" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Data.PlaylistVM.SelectedMediaCues, Source={StaticResource mediaLibraryVMProxy}, Converter={StaticResource CountToBoolConverter}}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <local:MediaActionMenuSource x:Key="MediaActionMenuSource" MediaAction="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaCue.MediaAction, Source={StaticResource mediaLibraryVMProxy}}" SetAlphaTypeCommand="{Binding Data.PlaylistVM.SetAlphaTypeCommand, Source={StaticResource mediaLibraryVMProxy}}" SetEndBehaviorTypeCommand="{Binding Data.PlaylistVM.SetEndBehaviorTypeCommand, Source={StaticResource mediaLibraryVMProxy}}" SetMediaScaleBehaviorCommand="{Binding Data.PlaylistVM.SetMediaScaleBehaviorCommand, Source={StaticResource mediaLibraryVMProxy}}" SetMediaTargetLayerCommand="{Binding Data.PlaylistVM.SetMediaTargetLayerCommand, Source={StaticResource mediaLibraryVMProxy}}" SetPlaybackBehaviorCommand="{Binding Data.PlaylistVM.SetPlaybackCommand, Source={StaticResource mediaLibraryVMProxy}}" SetSoftLoopDurationCommand="{Binding Data.PlaylistVM.SetSoftLoopDurationCommand, Source={StaticResource mediaLibraryVMProxy}}" />
      <ContextMenu x:Key="VisualMediaContextMenu" PlacementTarget="{Binding Data.MediaContextMenuPlacementTarget, Mode=OneWayToSource, Source={StaticResource mediaBinProxy}}">
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <commonControls:RoutedMenuItem Command="{Binding ProCommon.OpenMediaInspector.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_INSPECTOR_title}">
              <MenuItem.CommandParameter>
                <MultiBinding Converter="{di:DIMarkup {x:Type converters:MediaInspectorConverter}}">
                  <Binding Path="Data.PlaylistVM.SelectedMediaCues" Source="{StaticResource mediaLibraryVMProxy}" />
                  <Binding Source="{x:Static cueInspector:InspectorOptions.SupportsTransition}" />
                </MultiBinding>
              </MenuItem.CommandParameter>
            </commonControls:RoutedMenuItem>
            <MenuItem Click="Transitions_Click">
              <HeaderedItemsControl.Header>
                <TextBlock Foreground="{Binding SUBHEADERCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized MEDIA_BIN_CONTEXT_MENU_TRANSITIONS_title}" />
              </HeaderedItemsControl.Header>
            </MenuItem>
            <Separator />
            <CollectionContainer Collection="{StaticResource MediaActionMenuSource}" />
            <Separator Visibility="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaCue.MediaAction.Media.MediaType, ConverterParameter={x:Static media:MediaType.LiveVideo}, Source={StaticResource mediaLibraryVMProxy}, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
            <MenuItem Header="{mex:Localized MEDIA_BIN_CONTEXT_MENU_NEXT_CUE_title}" Visibility="{Binding Data.PlaylistVM.SelectedPlaylistItem.MediaCue.MediaAction.Media.MediaType, ConverterParameter={x:Static media:MediaType.LiveVideo}, Source={StaticResource mediaLibraryVMProxy}, Converter={StaticResource InvertedValueToVisibilityConverter}}">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <DataTemplate x:Key="{DataTemplateKey {x:Type cues:MediaCue}}" DataType="{x:Type cues:MediaCue}">
