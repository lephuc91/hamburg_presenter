                  </DataTemplate>
                  <CollectionViewSource x:Key="availableCompletionCues" Source="{Binding Data.PlaylistVM.AvailableCompletionCues, Source={StaticResource mediaLibraryVMProxy}}" />
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <ItemsControl.ItemsSource>
                <CompositeCollection>
                  <MenuItem DataContext="{x:Static triggering:CompletionTargetType.None}" Command="{Binding Data.PlaylistVM.SetCompletionTargetCommand, Source={StaticResource mediaLibraryVMProxy}}" CommandParameter="{Binding}" Header="{Binding Converter={StaticResource EnumToContentConverter}}" />
                  <Separator />
                  <MenuItem DataContext="{x:Static triggering:CompletionTargetType.Next}" Command="{Binding Data.PlaylistVM.SetCompletionTargetCommand, Source={StaticResource mediaLibraryVMProxy}}" CommandParameter="{Binding}" Header="{Binding Converter={StaticResource EnumToContentConverter}}" />
                  <MenuItem DataContext="{x:Static triggering:CompletionTargetType.Random}" Command="{Binding Data.PlaylistVM.SetCompletionTargetCommand, Source={StaticResource mediaLibraryVMProxy}}" CommandParameter="{Binding}" Header="{Binding Converter={StaticResource EnumToContentConverter}}" />
                  <MenuItem DataContext="{x:Static triggering:CompletionTargetType.First}" Command="{Binding Data.PlaylistVM.SetCompletionTargetCommand, Source={StaticResource mediaLibraryVMProxy}}" CommandParameter="{Binding}" Header="{Binding Converter={StaticResource EnumToContentConverter}}" />
                  <Separator />
                  <CollectionContainer Collection="{Binding Source={StaticResource availableCompletionCues}}" />
                </CompositeCollection>
              </ItemsControl.ItemsSource>
              <ItemsControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                  <Setter Property="MenuItem.Command" Value="{Binding Data.PlaylistVM.SetCompletionCueCommand, Source={StaticResource mediaLibraryVMProxy}}" />
                  <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                  <Setter Property="MenuItem.IsChecked">
                    <Setter.Value>
                      <MultiBinding Mode="OneWay" Converter="{StaticResource CheckCompletionTargetConverter}">
                        <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="Data.PlaylistVM.CueCompletionTargetType" Source="{StaticResource mediaLibraryVMProxy}" />
                        <Binding Path="Data.PlaylistVM.CueCompletionTargetCueID" Source="{StaticResource mediaLibraryVMProxy}" />
                      </MultiBinding>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ItemsControl.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.CutCommand}" Style="{StaticResource CommandTargetStyle}" />
            <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Copy}" Style="{StaticResource CommandTargetStyle}" />
            <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Paste}" Style="{StaticResource CommandTargetStyle}" />
            <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Duplicate}" Style="{StaticResource CommandTargetStyle}" />
            <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Rename}" Style="{StaticResource CommandTargetStyle}" />
            <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" Style="{StaticResource CommandTargetStyle}" />
            <Separator />
            <MenuItem Command="{Binding Data.PlaylistVM.ShowInFileExplorerCommand, Source={StaticResource mediaLibraryVMProxy}}" Header="{mex:Localized GLOBAL_SHOW_IN_FINDER_MENU_ITEM_windows_title}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                  <Setter Property="Visibility" Value="Visible" />
