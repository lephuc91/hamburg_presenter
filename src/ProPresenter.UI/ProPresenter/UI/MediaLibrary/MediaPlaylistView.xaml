      <local:TimeSliceToTotalSecondsConverter x:Key="TimeSliceToTotalSecondsConverter" />
      <local:CheckCompletionTargetConverter x:Key="CheckCompletionTargetConverter" />
      <local:TargetLayerVisibilityConverter x:Key="TargetLayerVisibilityConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
