<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.MediaLibrary.MediaPlaylistOutlineViewHeader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proUIThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:medialibrary="clr-namespace:ProPresenter.UI.MediaLibrary;assembly=ProPresenter.UI">
  <Grid Margin="0,2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image Grid.Column="0" Height="22" HorizontalAlignment="Left" Source="{StaticResource {x:Static proUIThemes:Icons.MediaBinPlaylistHeader}}" />
    <TextBlock Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="{mex:Localized LIBRARY_PLAYLIST_EXPORT_MULTIPLE_PLAYLISTS_SAVE_NAME_title}" />
    <commonControls:BorderlessPathButton Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Focusable="False" PathType="Plus" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource AncestorType=Grid}}">
      <FrameworkElement.ContextMenu>
        <ContextMenu Focusable="False" Placement="Top">
          <MenuItem Command="{Binding NewPlaylistCommand}" Header="{mex:Localized PLAYLIST_GLOBAL_ADD_PLAYLIST_MENU_ITEM_title}">
            <MenuItem.Icon>
              <Image Source="{StaticResource {x:Static proUIThemes:Icons.MediaBinPlaylist}}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding NewHotFolderCommand}" Header="{mex:Localized PLAYLIST_GLOBAL_ADD_SMART_PLAYLIST_MENU_ITEM_title}">
            <MenuItem.Icon>
              <Image Source="{StaticResource {x:Static proUIThemes:Icons.MediaBinSmartPlaylist}}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="{Binding NewGroupFolderCommand}" Header="{mex:Localized PLAYLIST_GLOBAL_ADD_PLAYLIST_FOLDER_MENU_ITEM_title}">
            <MenuItem.Icon>
              <Image Source="{StaticResource {x:Static proUIThemes:Icons.MediaBinFolder}}" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </FrameworkElement.ContextMenu>
    </commonControls:BorderlessPathButton>
  </Grid>
</UserControl>