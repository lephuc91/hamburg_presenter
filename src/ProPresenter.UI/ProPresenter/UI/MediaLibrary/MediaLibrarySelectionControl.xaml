<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.MediaLibrary.MediaLibrarySelectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:do="clr-namespace:ProPresenter.DO.Playlists;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:proUIThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:IsNotNullToVisibilityConverter x:Key="IsNullToVisibilityConverter" IsInverted="True" />
      <commonConverters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:LocalizedStringConverter x:Key="LocalizedStringConverter" />
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MediaLibrarySelectionControl}}}" />
      <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <commonControls:DropDownButton>
    <commonControls:DropDownButton.CustomContent>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Margin="2" Visibility="{Binding Data.SelectedPlaylist, Source={StaticResource proxy}, Converter={StaticResource IsNotNullToVisibilityConverter}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.MediaBinPlaylist}}" />
              <Style.Triggers>
                <DataTrigger Value="{x:Type do:AudioPlaylist}" Binding="{Binding Data.SelectedPlaylist, Source={StaticResource proxy}, Converter={StaticResource TypeOfConverter}}">
                  <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.AudioPlaylist}}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Image>
        <TextBlock Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Binding Data.SelectedPlaylist.Name, Source={StaticResource proxy}}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Data.SelectedPlaylist, Source={StaticResource proxy}}" Value="{x:Null}">
                  <Setter Property="Text" Value="{Binding Data.NoSelectionTranslationKey, Source={StaticResource proxy}, Converter={StaticResource LocalizedStringConverter}}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
    </commonControls:DropDownButton.CustomContent>
    <commonControls:DropDownButton.CustomContextMenu>
      <ContextMenu Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <CollectionContainer Collection="{Binding Data.Playlists, Source={StaticResource proxy}}" />
            <Separator>
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" TargetType="{x:Type Separator}">
                  <Setter Property="Visibility" Value="{Binding Data.NoSelectionTranslationKey, Source={StaticResource proxy}, Converter={StaticResource IsNotNullToVisibilityConverter}}" />
                  <Style.Triggers>
                    <DataTrigger Value="False" Binding="{Binding Data.CanAddPlaylist, Source={StaticResource proxy}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Separator>
            <MenuItem Command="{Binding Data.SelectPlaylistCommand, Source={StaticResource proxy}}" CommandParameter="{x:Null}" Header="{Binding Data.NoSelectionTranslationKey, Source={StaticResource proxy}, Converter={StaticResource LocalizedStringConverter}}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                  <Setter Property="Visibility" Value="{Binding Data.NoSelectionTranslationKey, Source={StaticResource proxy}, Converter={StaticResource IsNotNullToVisibilityConverter}}" />
                  <Style.Triggers>
                    <DataTrigger Value="False" Binding="{Binding Data.CanAddPlaylist, Source={StaticResource proxy}}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </MenuItem>
          </CompositeCollection>
        </ItemsControl.ItemsSource>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type do:VisualPlaylist}}">
              <MenuItem Command="{Binding Data.SelectPlaylistCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}" Header="{Binding Name}">
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding />
                    <Binding Path="Data.SelectedPlaylist" Source="{StaticResource proxy}" />
                  </MultiBinding>
                </MenuItem.IsChecked>
                <MenuItem.Icon>
                  <Image Margin="2" Source="{StaticResource {x:Static proUIThemes:Icons.MediaBinPlaylist}}" />
                </MenuItem.Icon>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="Smart" Binding="{Binding Type}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Value="LiveVideo" Binding="{Binding Type}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </MenuItem>
            </ItemContainerTemplate>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type do:AudioPlaylist}}">
              <MenuItem Command="{Binding Data.SelectPlaylistCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}" Header="{Binding Name}">
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding />
                    <Binding Path="Data.SelectedPlaylist" Source="{StaticResource proxy}" />
                  </MultiBinding>
                </MenuItem.IsChecked>
                <MenuItem.Icon>
                  <Image Margin="2" Source="{StaticResource {x:Static proUIThemes:Icons.AudioPlaylist}}" />
                </MenuItem.Icon>
              </MenuItem>
            </ItemContainerTemplate>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type do:VisualGroupPlaylist}}">
              <MenuItem UsesItemContainerTemplate="True" Header="{Binding Name}" ItemsSource="{Binding Children}">
                <MenuItem.Icon>
                  <Image Margin="2" Source="{StaticResource {x:Static proUIThemes:Icons.MediaBinFolder}}" />
                </MenuItem.Icon>
              </MenuItem>
            </ItemContainerTemplate>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type do:AudioGroupPlaylist}}">
              <MenuItem UsesItemContainerTemplate="True" Header="{Binding Name}" ItemsSource="{Binding Children}">
                <MenuItem.Icon>
                  <Image Margin="2" Source="{StaticResource {x:Static proUIThemes:Icons.PlaylistFolder}}" />
                </MenuItem.Icon>
              </MenuItem>
            </ItemContainerTemplate>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type do:SmartPlaylist}}">
              <MenuItem Visibility="Collapsed" />
            </ItemContainerTemplate>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type do:LiveVideoPlaylist}}">
              <MenuItem Visibility="Collapsed" />
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ContextMenu>
    </commonControls:DropDownButton.CustomContextMenu>
  </commonControls:DropDownButton>
</UserControl>