<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.MediaLibrary.MediaCueListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cues="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:thumbnailOverlay="clr-namespace:ProPresenter.UI.ThumbnailOverlay" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="mediaCueListView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="dependencyProperties" Data="{Binding ElementName=mediaCueListView}" />
      <commonConverters:TimeSliceToStringConverter x:Key="TimeSliceToStringConverter" />
      <local:FileExtensionToFormatConverter x:Key="FileExtensionToFormatConverter" />
      <converters:CollectionContainsConverter x:Key="CollectionContainsConverter" />
      <Style x:Key="DataGridCellStyle" BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridCell}">
              <Grid Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ToolTipService.Placement" Value="Mouse" />
      </Style>
      <Style x:Key="RowStyle" BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="{x:Type DataGridRow}">
        <Setter Property="FrameworkElement.ContextMenu" Value="{Binding MediaContextMenu, ElementName=mediaCueListView}" />
        <Setter Property="proUtility:UIElementHelper.Palette" Value="{Binding MEDIAGRIDROW_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
        <Style.Triggers>
          <DataTrigger Value="True">
            <DataTrigger.Binding>
              <MultiBinding Converter="{StaticResource CollectionContainsConverter}">
                <Binding />
                <Binding ElementName="mediaCueListView" Path="ActiveMediaItems" />
              </MultiBinding>
            </DataTrigger.Binding>
            <Setter Property="Background" Value="{Binding MEDIAGRIDACTIVEITEM, Source={x:Static theming:AppTheme.Active}}" />
            <Setter Property="BorderBrush" Value="{Binding THUMBNAILPRESENTATION, Source={x:Static theming:AppTheme.Active}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="HeaderStyle" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <local:MediaCueDataGrid x:Name="CueList" uiUtility:ColumnVisibility.ToggleColumnVisibility="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="False" RowStyle="{StaticResource RowStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Style="{StaticResource {x:Type DataGrid}}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" uiUtility:UIElementHelper.Palette="{Binding MEDIAGRID_PALETTE, Source={x:Static theming:AppTheme.Active}}" AddFilesCommand="{Binding AddFilesCommand, ElementName=mediaCueListView}" CopyCommand="{Binding CopyCommand, ElementName=mediaCueListView}" DeleteItemCommand="{Binding DeleteCommand, ElementName=mediaCueListView}" HorizontalGridLinesBrush="{Binding (proUtility:UIElementHelper.Palette).Standard.Border, RelativeSource={RelativeSource Self}}" SelectedPlaylist="{Binding SelectedPlaylist, ElementName=mediaCueListView}" TriggerThumbnailCommand="{Binding TriggerThumbnailCommand, ElementName=mediaCueListView}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="DetailViewTextBlockStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <DataGrid.Columns>
      <DataGridTextColumn MinWidth="40" CanUserResize="False" CellStyle="{StaticResource DataGridCellStyle}" HeaderStyle="{StaticResource HeaderStyle}" Binding="{Binding Index}" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_INDEX_title}" />
      <DataGridTemplateColumn MinWidth="40" CanUserResize="False" CellStyle="{StaticResource DataGridCellStyle}" IsReadOnly="True" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_LAYER_title}">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <StackPanel>
              <Image>
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Image}">
                    <Setter Property="Source" Value="../Resources/Icons/Actions/actionBackgroundMedia.png" />
                    <Style.Triggers>
                      <DataTrigger Value="Foreground" Binding="{Binding MediaCue.MediaAction.TriggerLayer}">
                        <Setter Property="Source" Value="../Resources/Icons/Actions/actionForegroundMedia.png" />
                      </DataTrigger>
                      <DataTrigger Value="Input" Binding="{Binding MediaCue.MediaAction.TriggerLayer}">
                        <Setter Property="Source" Value="../Resources/Icons/ClearLayer/clearButtonVideoInput.png" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Image>
            </StackPanel>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn CanUserResize="False" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True" MinWidth="{Binding Data.MaximumPreviewImageWidth, Source={StaticResource dependencyProperties}}" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_THUMBNAIL_title}">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Grid Width="{Binding Data.MaximumPreviewImageWidth, Source={StaticResource dependencyProperties}}" Height="{Binding Data.MaximumPreviewImageHeight, Source={StaticResource dependencyProperties}}">
              <local:MediaPreview x:Name="mediaPreview" Media="{Binding MediaCue.MediaAction.Media}" />
              <thumbnailOverlay:MediaOverlay x:Name="overlay" AllowOpenVideoInputSetup="False" ShowText="False" Width="{Binding ElementName=mediaPreview, Path=ActualWidth}" Height="{Binding ElementName=mediaPreview, Path=ActualHeight}" BackgroundControl="{Binding ElementName=mediaPreview}" DataContext="{Binding MediaOverlayVM}" />
            </Grid>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn MinWidth="40" CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DetailViewTextBlockStyle}" IsReadOnly="True" Binding="{Binding MediaCue.MediaAction.SelectedTransition.Name}" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_TRANSITION_title}" />
      <DataGridTemplateColumn IsReadOnly="False" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_NAME_title}">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate DataType="{x:Type cues:MediaCue}">
            <TextBlock VerticalAlignment="Center" Text="{Binding MediaCue.MediaAction.Name}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
        <DataGridTemplateColumn.CellEditingTemplate>
          <DataTemplate DataType="{x:Type cues:MediaCue}">
            <TextBox Name="edit" VerticalAlignment="Center" Text="{Binding MediaCue.MediaAction.Name}" Loaded="CueNameTextBox_OnLoaded" />
          </DataTemplate>
        </DataGridTemplateColumn.CellEditingTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn ElementStyle="{StaticResource DetailViewTextBlockStyle}" IsReadOnly="True" Binding="{Binding MediaCue.MediaAction.Media.SourceFile.FullPath}" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_PATH_title}" />
      <DataGridTextColumn CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DetailViewTextBlockStyle}" IsReadOnly="True" Binding="{Binding MediaCue.MediaAction.MediaDuration, Converter={StaticResource TimeSliceToStringConverter}}" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_DURATION_title}" />
      <DataGridTextColumn CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DetailViewTextBlockStyle}" IsReadOnly="True" Binding="{Binding MediaCue.MediaAction.Media.SourceFile.Extension, Converter={StaticResource FileExtensionToFormatConverter}}" Header="{mex:Localized MEDIA_BIN_TABLE_VIEW_COLUMN_FORMAT_title}" />
    </DataGrid.Columns>
  </local:MediaCueDataGrid>
</UserControl>