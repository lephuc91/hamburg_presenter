<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.EditorPreviewItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:localConverters="clr-namespace:ProPresenter.UI.SlideEditor.Converters" xmlns:propresenterUI="clr-namespace:ProPresenter.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="self" xmlns:slideeditor="clr-namespace:ProPresenter.UI.SlideEditor">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="selfProxy" Data="{Binding ElementName=self}" />
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <localConverters:SlideCueLiveVideoConverter x:Key="SlideCueLiveVideoConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Grid.Row="0" Padding="10,10,10,0">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Setter Property="Background">
          <Setter.Value>
            <SolidColorBrush Opacity="0.2" Color="{Binding Data.GroupLabelColor, Source={StaticResource selfProxy}}" />
          </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="1" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsSelected, ElementName=self}">
            <Setter Property="Background" Value="{Binding SECONDARY, Source={x:Static theming:AppTheme.Active}}" />
          </DataTrigger>
          <DataTrigger Value="False" Binding="{Binding IsSourceEnabled, ElementName=self}">
            <Setter Property="UIElement.Opacity" Value="0.5" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <propresenterUI:SlidePreview x:Name="SlidePreview" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="3" ForceBackgroundDraw="True" RenderOptions.BitmapScalingMode="Fant" RenderTransparencyCheckerboard="True" IncludeBackground="{Binding ElementName=self, Path=IncludeBackground}" IncludeTextPlaceholder="{Binding IncludeTextPlaceholder, ElementName=self}" LiveVideoInput="{Binding SlideCue, ElementName=self, Converter={StaticResource SlideCueLiveVideoConverter}}" OverlayVM="{Binding ElementName=self, Path=OverlayVM}" PrimaryCheckerboardBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" SecondaryBackgroundColor="{Binding SecondaryBackgroundColor, ElementName=self}" SecondaryCheckerboardBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" Source="{Binding Source, ElementName=self}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type propresenterUI:SlidePreview}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsActive, ElementName=self}">
                <Setter Property="BorderBrush" Value="#FFFFFF00" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </propresenterUI:SlidePreview>
      <Grid Row="1" Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Stretch" Effect="{StaticResource DefaultDropShadowEffect}" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Index, ElementName=self, StringFormat={}{0:0'.'}}" />
        <commonControls:EditableTextBlock Grid.Column="1" Margin="5,0,0,0" Padding="5,0" HorizontalAlignment="Left" FontWeight="Bold" Background="{Binding LabelColor, ElementName=self, Converter={StaticResource ColorToBrushConverter}}" CanEdit="{Binding CanRename, ElementName=self}" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" Text="{Binding LabelText, ElementName=self}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>