<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.GridSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:slideeditor="clr-namespace:ProPresenter.UI.SlideEditor" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type commonControls:DoubleUpDown}" BasedOn="{StaticResource {x:Type commonControls:DoubleUpDown}}" TargetType="{x:Type commonControls:DoubleUpDown}">
        <Setter Property="NumericUpDown.FormatString" Value="F0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Width" Value="60" />
      </Style>
      <Style x:Key="{x:Type commonControls:IntegerUpDown}" BasedOn="{StaticResource {x:Type commonControls:IntegerUpDown}}" TargetType="{x:Type commonControls:IntegerUpDown}">
        <Setter Property="NumericUpDown.FormatString" Value="F0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Width" Value="60" />
      </Style>
      <Style x:Key="{x:Type commonControls:ColorPicker}" BasedOn="{StaticResource {x:Type commonControls:ColorPicker}}" TargetType="{x:Type commonControls:ColorPicker}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="50" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderBrush="#FFA9A9A9" BorderThickness="1">
    <Grid Margin="15,5">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="40" />
        <RowDefinition Height="40" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{mex:Localized EDITOR_GRID_ENABLED_HEADER_label}" />
      <CheckBox Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Enable" IsChecked="{Binding ShowCanvasGrid, Mode=TwoWay}" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{mex:Localized EDITOR_GRID_COLOR_label}" />
      <commonControls:ColorPicker Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" SelectedColor="{Binding CanvasGridColor, Mode=TwoWay}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,0,10" Text="{mex:Localized EDITOR_GRID_SPACING_label}" />
      <commonControls:DoubleUpDown Grid.Row="2" Grid.Column="1" Maximum="10000" Minimum="5" Value="{Binding CanvasGridSpacing, Mode=TwoWay}" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="{mex:Localized EDITOR_GRID_SUBDIVISIONS_label}" />
      <commonControls:IntegerUpDown Grid.Row="3" Grid.Column="1" Maximum="10" Minimum="1" Value="{Binding CanvasGridSubdivisions, Mode=TwoWay}" />
    </Grid>
  </Border>
</UserControl>