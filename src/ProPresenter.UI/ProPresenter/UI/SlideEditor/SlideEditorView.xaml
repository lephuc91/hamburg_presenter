          <Button Height="22" MinWidth="50" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding TriggerSelectedSlideCommand}" Content="{mex:Localized EDITOR_SHOW_BUTTON_title}" ToolTip="{mex:Localized EDITOR_SHOW_BUTTON_tooltip}" Visibility="{Binding EditMode, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static do:EditMode.Stage}}" />
          <Button Height="22" MinWidth="50" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Content="{mex:Localized EDITOR_SHOW_BUTTON_title}" IsEnabled="{Binding ContextMenu.HasItems, RelativeSource={RelativeSource Self}}" ToolTip="{mex:Localized EDITOR_SHOW_BUTTON_tooltip}" Visibility="{Binding EditMode, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:EditMode.Stage}}">
            <FrameworkElement.ContextMenu>
              <ContextMenu Placement="Right" ItemsSource="{Binding Data.ScreenConfigVM.StageArrangementScreens, Source={StaticResource mainLayoutVM}}">
                <ItemsControl.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="MenuItem.Command" Value="{Binding Data.ShowStageLayoutToTargetScreenCommand, Source={StaticResource proxy}}" />
                    <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                    <Setter Property="Header" Value="{Binding Name}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
          <ToggleButton Height="22" MinWidth="90" Padding="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{mex:Localized EDITOR_PRESENTATION_SLIDE_NOTES_BUTTON_title}" IsChecked="{Binding SlideNotesVisible, Mode=TwoWay}" ToolTip="{mex:Localized EDITOR_PRESENTATION_SLIDE_NOTES_BUTTON_tooltip}" Visibility="{Binding EditMode, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:EditMode.Presentation}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>