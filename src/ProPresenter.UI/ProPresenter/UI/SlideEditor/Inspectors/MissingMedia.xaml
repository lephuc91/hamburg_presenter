<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.MissingMedia" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:thumbnailVM="clr-namespace:ProPresenter.UI.ViewModels.Thumbnails" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Grid.Row="1" Visibility="{Binding IsValid.Value, Converter={StaticResource InvertedValueToVisibilityConverter}}">
    <ProgressBar Height="5" Margin="0,5" Value="{Binding DownloadProgress.Value.PercentComplete, Mode=OneWay}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ProgressBar}}" TargetType="{x:Type ProgressBar}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding DownloadProgress.Value, Converter={StaticResource IsNotNullToBoolConverter}}" />
                <Condition Value="Active" Binding="{Binding DownloadProgress.Value.Status}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ProgressBar>
    <Button Margin="0,5" Command="{Binding RelinkCommand}" Content="{mex:Localized PRESENTATION_CONTEXT_MENU_LINK_MEDIA_win_title}" Visibility="{Binding InvalidMediaType.Value, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Local}}" />
    <Button Margin="0,5">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding DownloadCommand}" />
          <Setter Property="Content" Value="{mex:Localized PRESENTATION_CONTEXT_MENU_DOWNLOAD_MEDIA_title}" />
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding DownloadProgress.Value, Converter={StaticResource IsNotNullToBoolConverter}}" />
                <Condition Value="Active" Binding="{Binding DownloadProgress.Value.Status}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Command" Value="{Binding CancelDownloadCommand}" />
              <Setter Property="Content" Value="{mex:Localized PRESENTATION_CONTEXT_MENU_CANCEL_DOWNLOAD_title}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Visible" Binding="{Binding InvalidMediaType.Value, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Remote}}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
    <StackPanel>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type StackPanel}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Visible" Binding="{Binding InvalidMediaType.Value, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Remote}}" />
                <Condition Value="Visible" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <ProgressBar Height="5" Margin="4" IsIndeterminate="True" />
      <TextBlock Text="{mex:Localized THUMBNAIL_OVERLAY_DOWNLOAD_IN_PROGRESS_title}" />
    </StackPanel>
  </StackPanel>
</UserControl>