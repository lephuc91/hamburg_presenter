<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Fills.Media" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cueInspector="clr-namespace:ProPresenter.UI.CueInspector" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:fills="clr-namespace:ProPresenter.DO.Slide.Custom.Elements.Fills;assembly=ProPresenter.DO" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:localConverters="clr-namespace:ProPresenter.UI.SlideEditor.Converters" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:ui1="clr-namespace:ProPresenter.UI" x:Name="mediaFill" xmlns:fills1="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Fills">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="pack://application:,,,/ProPresenter.UI;component/Resources/Paths/Paths.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:IsNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpaceConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter" />
      <localConverters:FilenameToBitmapConverter x:Key="FilenameToBitmapConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <Style x:Key="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <system1:Boolean x:Key="False" xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib">False</system1:Boolean>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5" VerticalAlignment="Center" Orientation="Horizontal">
      <commonControls:DownloadInProgressIndicator Width="18" Margin="0,0,5,0" VerticalAlignment="Center" UseSmallRing="True" ToolTip="{mex:Localized PRESENTATION_MEDIA_ACTION_DOWNLOAD_IN_PROGRESS_tooltip}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type commonControls:DownloadInProgressIndicator}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding Fill.IsRemoteMedia}" />
                  <Condition Value="{x:Static media:MediaAvailability.Missing}" Binding="{Binding Fill.Availability}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
              <DataTrigger Value="{x:Static media:MediaAvailability.Downloading}" Binding="{Binding Fill.Availability}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Value="Collapsed" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:DownloadInProgressIndicator>
      <Path Margin="0,0,5,0" Data="{StaticResource Image}" Fill="{Binding MENU_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding Fill.IsValid, Converter={StaticResource ValueToVisibilityConverter}}" />
      <Image Width="16" Height="24" Margin="0,0,5,0" Source="../../../Resources/Icons/WarningIcon.png">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Image}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="False" Binding="{Binding Fill.IsValid}" />
                  <Condition Value="Collapsed" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="{x:Static media:MediaAvailability.Missing}" Binding="{Binding Fill.Availability}" />
                  <Condition Value="False" Binding="{Binding Fill.IsRemoteMedia}" />
                  <Condition Value="Visible" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Image>
      <TextBlock Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Text" Value="{Binding Fill.Media.SourceFile.FullPath, Converter={StaticResource FilePathToFileNameConverter}, TargetNullValue={mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_FILL_NO_URL_placeholder}}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Fill.Media}" Value="{x:Null}">
                <Setter Property="Text" Value="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_CHOOSE_FILE_BUTTON_title}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <Button Margin="2,0,0,0" HorizontalAlignment="Right" Background="#00FFFFFF" BorderThickness="0" Command="{Binding ShowInFileExplorerCommand}">
        <Control.Template>
          <ControlTemplate>
            <commonControls:PathControl Width="12" Height="12" Fill="#00FFFFFF" PathType="Magnifier" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
          </ControlTemplate>
        </Control.Template>
      </Button>
    </StackPanel>
    <Button Grid.Row="1" Margin="0,0,2,5" Command="{Binding ProCommon.OpenMediaInspector.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Content="{mex:Localized GLOBAL_INSPECTOR_BUTTON_title}">
      <ButtonBase.CommandParameter>
        <MultiBinding Converter="{di:DIMarkup {x:Type converters:MediaInspectorConverter}}">
          <Binding Path="SelectedMedia" />
          <Binding Source="{x:Static cueInspector:InspectorOptions.SupportsRetriggerBehavior}" />
        </MultiBinding>
      </ButtonBase.CommandParameter>
    </Button>
    <Button Grid.Row="1" Grid.Column="1" Margin="2,0,0,5" Command="{Binding CreateMediaFillCommand, ElementName=mediaFill}" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_REPLACE_FILE_BUTTON_title}" />
    <ComboBox Grid.Row="2" Grid.Column="0" Height="22" Margin="0,0,2,0" VerticalAlignment="Center" VerticalContentAlignment="Center" SelectedValue="{Binding Fill.ScaleType}">
      <ItemsControl.ItemsSource>
        <ui1:ScaleBehaviorItemsSource />
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ContentPresenter Content="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding FillType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static fills:FillType.Media}}" />
                <Condition Value="True" Binding="{Binding Fill.Media.SourceFile.FullPath, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}, UpdateSourceTrigger=PropertyChanged}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ComboBox>
    <Button Grid.Row="2" Grid.Column="1" Margin="2,0,0,0" Command="{Binding EditMediaCommand, ElementName=mediaFill}" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_EDIT_SCALE_BUTTON_title}" />
  </Grid>
</UserControl>