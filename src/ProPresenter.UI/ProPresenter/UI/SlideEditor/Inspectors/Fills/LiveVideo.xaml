<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Fills.LiveVideo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cueInspector="clr-namespace:ProPresenter.UI.CueInspector" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:livevideo="clr-namespace:ProPresenter.UI.LiveVideo" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:ui="clr-namespace:ProPresenter.UI" x:Name="liveVideo" xmlns:fills="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Fills">
  <FrameworkElement.Resources>
    <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    <system1:Boolean x:Key="False" xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib">False</system1:Boolean>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <livevideo:VideoInputSelector Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="22" Margin="0,0,0,5" AvailableInputs="{Binding AvailableInputs, ElementName=liveVideo}" LiveVideoInput="{Binding LiveVideoMedia.LiveVideo.Input, ElementName=liveVideo}" OpenSetupCommand="{Binding OpenSetupCommand, ElementName=liveVideo}" />
    <Button Grid.Row="1" Height="22" Command="{Binding ProCommon.OpenMediaInspector.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Content="{mex:Localized GLOBAL_INSPECTOR_BUTTON_title}">
      <ButtonBase.CommandParameter>
        <MultiBinding Converter="{di:DIMarkup {x:Type converters:MediaInspectorConverter}}">
          <Binding Path="SelectedMedia" />
          <Binding Source="{x:Static cueInspector:InspectorOptions.None}" />
        </MultiBinding>
      </ButtonBase.CommandParameter>
    </Button>
    <ComboBox Grid.Row="1" Grid.Column="1" Height="22" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedValue="{Binding LiveVideoMedia.Drawing.ScaleBehavior, ElementName=liveVideo}">
      <ItemsControl.ItemsSource>
        <ui:ScaleBehaviorItemsSource SupportsCustomScale="False" />
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
  </Grid>
</UserControl>