<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Fills.HTMLFill" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Name="htmlFillSelf" xmlns:fills="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Fills;assembly=ProPresenter.UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <commonControls:PlaceholderTextBox Name="UrlInputTextBox" Height="22" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" IsTextBindingExplicit="True" TextContentHorizontalAlignment="Left" PlaceholderForeground="{Binding Foreground, ElementName=htmlFillSelf}" PlaceholderText="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_FILL_NO_URL_placeholder}" Text="{Binding Fill.WebMedia.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <Button Grid.Column="1" Height="22" Margin="5,0,0,0" Background="#00FFFFFF" BorderThickness="0" Focusable="True" Click="WebAddressNavigate">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
          <Setter Property="IsEnabled" Value="True" />
          <Style.Triggers>
            <DataTrigger xmlns:system="clr-namespace:System;assembly=System.Private.CoreLib" Value="{x:Static system:String.Empty}" Binding="{Binding Fill.WebMedia.Url}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Control.Template>
        <ControlTemplate>
          <commonControls:PathControl Width="12" Height="12" Fill="#00FFFFFF" PathType="Magnifier" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </ControlTemplate>
      </Control.Template>
    </Button>
  </Grid>
</UserControl>