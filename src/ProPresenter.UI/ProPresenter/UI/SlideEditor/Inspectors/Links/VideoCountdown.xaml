<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.VideoCountdown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:links="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links" xmlns:linksDO="clr-namespace:ProPresenter.DO.Slide.Links;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ObjectDataProvider x:Key="Source" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension Type="{x:Type linksDO:SourceType}" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <TextBlock Margin="0,0,7,7" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_LINKED_PRESENTATION_label}" />
    <ComboBox Grid.Column="1" Height="22" Margin="0,0,0,7" VerticalAlignment="Center" DataContext="{Binding CountdownSourceVM}" ItemsSource="{Binding Source={StaticResource Source}}" SelectedItem="{Binding Source}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,7" HorizontalAlignment="Left" DataContext="{Binding IgnoreLoopVM}" IsChecked="{Binding IgnoreLooping, Mode=TwoWay}">
      <TextBlock Style="{StaticResource {x:Type TextBlock}}" TextWrapping="Wrap" Text="{mex:Localized TEXT_LINK_VIDEO_COUNTDOWN_IGNORE_LOOPING_VIDEO_OPTION_title}" />
    </CheckBox>
    <links:Timer Grid.Row="2" Grid.ColumnSpan="2" DataContext="{Binding FormatDataVM}" />
  </Grid>
</UserControl>