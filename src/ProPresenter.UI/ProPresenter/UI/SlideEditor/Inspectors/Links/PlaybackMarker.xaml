<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.PlaybackMarker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:playbackMarkerDO="clr-namespace:ProPresenter.DO.Slide.Links;assembly=ProPresenter.DO" xmlns:proPUI="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links" xmlns:proUI="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ObjectDataProvider x:Key="PlaybackMarkerIdentifierType" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension Type="{x:Type playbackMarkerDO:PlaybackMarkerIdentifierType}" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="PlaybackMarkerIdentifierDestination" MethodName="GetValues" ObjectType="{x:Type Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension Type="{x:Type playbackMarkerDO:PlaybackMarkerIdentifierDestination}" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="PlaybackMarkerTextType" MethodName="GetValues" ObjectType="{x:Type Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension Type="{x:Type playbackMarkerDO:PlaybackMarkerTextType}" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized PLAYBACK_MARKER_DATA_LINK_DESTINATION_title}" />
    <ComboBox Grid.Row="0" Grid.Column="1" Height="22" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource PlaybackMarkerIdentifierDestination}}" SelectedItem="{Binding PlaybackMarkerIdentifierDestination}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Row="1" Grid.Column="0" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized PLAYBACK_MARKER_DATA_LINK_TYPE_title}" />
    <ComboBox Name="IdentifierType" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,5,0,0" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource PlaybackMarkerIdentifierType}}" SelectedItem="{Binding PlaybackMarkerIdentifierType}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <proUI:PlaceholderTextBox Grid.Row="2" Grid.Column="1" Height="22" Margin="0,5,0,0" VerticalAlignment="Center" PlaceholderText="{mex:Localized PLAYBACK_MARKERS_DATA_LINK_NAME_placeholder}" Text="{Binding PlaybackMarkerIdentifierName}" Visibility="{Binding PlaybackMarkerIdentifierType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static playbackMarkerDO:PlaybackMarkerIdentifierType.Name}}" />
    <CheckBox Grid.Row="3" Grid.Column="1" Height="22" Margin="0,5,0,0" VerticalAlignment="Center" Content="{mex:Localized PLAYBACK_MARKER_DATA_LINK_USE_MARKER_COLOR_title}" IsChecked="{Binding PlaybackMarkerUsesMarkerColor}" Visibility="{Binding Path=IsText, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <TextBlock Grid.Row="4" Grid.Column="0" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized PLAYBACK_MARKER_DATA_LINK_TEXT_TYPE_label}" Visibility="{Binding Path=IsText, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <ComboBox Grid.Row="4" Grid.Column="1" Height="22" Margin="0,5,0,0" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource PlaybackMarkerTextType}}" SelectedItem="{Binding PlaybackMarkerTextType}" Visibility="{Binding Path=IsText, Converter={StaticResource ValueToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Row="5" Grid.Column="0" Height="22" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_LINKED_TIMER_FORMAT_label}" Visibility="{Binding PlaybackMarkerTextType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static playbackMarkerDO:PlaybackMarkerTextType.Time}}" />
    <proPUI:TimerFormatSelector Grid.Row="5" Grid.Column="1" Height="22" Margin="0,5,0,0" VerticalAlignment="Center" AvailableHourFormats="{Binding PlaybackMarkerTimerFormat.AvailableHourFormats}" AvailableMillisecondFormats="{Binding PlaybackMarkerTimerFormat.AvailableMillisecondFormats}" AvailableMinuteFormats="{Binding PlaybackMarkerTimerFormat.AvailableMinuteFormats}" AvailableSecondFormats="{Binding PlaybackMarkerTimerFormat.AvailableSecondFormats}" SecondsEnabled="{Binding PlaybackMarkerTimerFormat.SecondsAvailable}" Visibility="{Binding PlaybackMarkerTextType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static playbackMarkerDO:PlaybackMarkerTextType.Time}}">
      <proPUI:TimerFormatSelector.SelectedHourFormat>
        <PriorityBinding>
          <Binding Mode="TwoWay" Path="HourFormat" />
        </PriorityBinding>
      </proPUI:TimerFormatSelector.SelectedHourFormat>
      <proPUI:TimerFormatSelector.SelectedMinuteFormat>
        <PriorityBinding>
          <Binding Mode="TwoWay" Path="MinuteFormat" />
        </PriorityBinding>
      </proPUI:TimerFormatSelector.SelectedMinuteFormat>
      <proPUI:TimerFormatSelector.SelectedSecondFormat>
        <PriorityBinding>
          <Binding Mode="TwoWay" Path="SecondFormat" />
        </PriorityBinding>
      </proPUI:TimerFormatSelector.SelectedSecondFormat>
      <proPUI:TimerFormatSelector.SelectedMillisecondFormat>
        <PriorityBinding>
          <Binding Mode="TwoWay" Path="MillisecondFormat" />
        </PriorityBinding>
      </proPUI:TimerFormatSelector.SelectedMillisecondFormat>
    </proPUI:TimerFormatSelector>
  </Grid>
</UserControl>