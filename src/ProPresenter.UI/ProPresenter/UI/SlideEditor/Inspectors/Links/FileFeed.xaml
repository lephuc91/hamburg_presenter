<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.FileFeed" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="fileFeed" xmlns:links="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Column="0" Margin="0,5,0,0" HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding SourceFile.Filename}" Visibility="{Binding SourceFile.IsValid, Converter={StaticResource ValueToVisibilityConverter}}" />
      <TextBlock Grid.Column="0" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_NO_FILE_SELECTED_label}" Visibility="{Binding SourceFile.IsValid, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
      <commonControls:BorderlessButton Grid.Column="1" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding OpenFileLocationCommand}" ToolTip="{mex:Localized GLOBAL_SHOW_IN_FINDER_MENU_ITEM_windows_title}">
        <commonControls:ImageMask Width="16" Height="16" ImageSource="../../../Resources/Icons/spotlight.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
      </commonControls:BorderlessButton>
    </Grid>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Height="22" Margin="0,5,4,0" Command="{Binding OpenFileCommand}" Content="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_LINKED_FILE_PREVIEW_TEXT_title}" />
      <Button Grid.Column="1" Height="22" Margin="4,5,0,0" Command="{Binding AddFileSourceCommand}" Content="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_LINKED_FILE_SELECT_FILE_title}" />
    </Grid>
  </Grid>
</UserControl>