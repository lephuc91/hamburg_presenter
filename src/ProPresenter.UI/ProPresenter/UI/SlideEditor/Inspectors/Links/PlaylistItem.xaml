<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.PlaylistItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:linksDO="clr-namespace:ProPresenter.DO.Slide.Links;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:links="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ObjectDataProvider x:Key="PlaylistItemSourceType" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension Type="{x:Type linksDO:PlaylistItemSource}" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <ComboBox Grid.Column="1" Height="22" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource PlaylistItemSourceType}}" SelectedItem="{Binding PlaylistItemSource}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" VerticalAlignment="Center" Content="{mex:Localized TEXT_LINK_PLAYLIST_ITEM_SHOW_ARRANGEMENT_title}" IsChecked="{Binding ShowArrangement}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="Current" Binding="{Binding PlaylistItemSource}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Value="Next" Binding="{Binding PlaylistItemSource}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </CheckBox>
  </Grid>
</UserControl>