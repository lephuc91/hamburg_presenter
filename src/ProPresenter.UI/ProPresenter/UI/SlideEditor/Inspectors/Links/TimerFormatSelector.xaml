<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.TimerFormatSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links" xmlns:timerDO="clr-namespace:ProPresenter.DO.Timer;assembly=ProPresenter.DO" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="timerFormatSelector">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <local:TimerFormatStyleToStringConverter x:Key="HourTimerFormatStyleToStringConverter" LongString="hh" ShortString="h" />
      <local:TimerFormatStyleToStringConverter x:Key="MinuteTimerFormatStyleToStringConverter" LongString="mm" ShortString="m" />
      <local:TimerFormatStyleToStringConverter x:Key="SecondTimerFormatStyleToStringConverter" LongString="ss" ShortString="s" />
      <local:TimerFormatStyleToStringConverter x:Key="MillisecondTimerFormatStyleToStringConverter" LongString="ss" ShortString="s" />
      <commonUtility:BindingProxy x:Key="timerFormatSelectorProxy" Data="{Binding ElementName=timerFormatSelector}" />
      <local:TimerFormatStyleEnabledConverter x:Key="TimerFormatStyleEnabledConverter" />
      <local:TimerFormatStrikethroughConverter x:Key="TimerFormatStrikethroughConverter" />
      <ContextMenu x:Key="HourMenu">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectHourFormatCommand, Source={StaticResource timerFormatSelectorProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="HeaderTemplate">
              <Setter.Value>
                <DataTemplate>
                  <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding Converter={StaticResource HourTimerFormatStyleToStringConverter}}" TextDecorations="{Binding Converter={StaticResource TimerFormatStrikethroughConverter}}" />
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding Path="Data.SelectedHourFormat" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
            <Setter Property="IsEnabled">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource TimerFormatStyleEnabledConverter}">
                  <Binding Path="Data.AvailableHourFormats" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
      <ContextMenu x:Key="MinuteMenu">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectMinuteFormatCommand, Source={StaticResource timerFormatSelectorProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="HeaderTemplate">
              <Setter.Value>
                <DataTemplate>
                  <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding Converter={StaticResource MinuteTimerFormatStyleToStringConverter}}" TextDecorations="{Binding Converter={StaticResource TimerFormatStrikethroughConverter}}" />
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding Path="Data.SelectedMinuteFormat" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
            <Setter Property="IsEnabled">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource TimerFormatStyleEnabledConverter}">
                  <Binding Path="Data.AvailableMinuteFormats" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
      <ContextMenu x:Key="SecondMenu">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectSecondFormatCommand, Source={StaticResource timerFormatSelectorProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="HeaderTemplate">
              <Setter.Value>
                <DataTemplate>
                  <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding Converter={StaticResource SecondTimerFormatStyleToStringConverter}}" TextDecorations="{Binding Converter={StaticResource TimerFormatStrikethroughConverter}}" />
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding Path="Data.SelectedSecondFormat" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
            <Setter Property="IsEnabled">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource TimerFormatStyleEnabledConverter}">
                  <Binding Path="Data.AvailableSecondFormats" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
      <ContextMenu x:Key="MillisecondMenu">
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
            <Setter Property="MenuItem.Command" Value="{Binding Data.SelectMillisecondFormatCommand, Source={StaticResource timerFormatSelectorProxy}}" />
            <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
            <Setter Property="HeaderTemplate">
              <Setter.Value>
                <DataTemplate>
                  <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding Converter={StaticResource MillisecondTimerFormatStyleToStringConverter}}" TextDecorations="{Binding Converter={StaticResource TimerFormatStrikethroughConverter}}" />
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="MenuItem.IsChecked">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                  <Binding Path="Data.SelectedMillisecondFormat" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
            <Setter Property="IsEnabled">
              <Setter.Value>
                <MultiBinding Mode="OneWay" Converter="{StaticResource TimerFormatStyleEnabledConverter}">
                  <Binding Path="Data.AvailableMillisecondFormats" Source="{StaticResource timerFormatSelectorProxy}" />
                  <Binding />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ContextMenu>
      <Style x:Key="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" TargetType="{x:Type ContextMenu}">
        <Setter Property="ItemsSource">
          <Setter.Value>
            <CompositeCollection>
              <timerDO:TimerFormatStyle>None</timerDO:TimerFormatStyle>
              <timerDO:TimerFormatStyle>Short</timerDO:TimerFormatStyle>
              <timerDO:TimerFormatStyle>Long</timerDO:TimerFormatStyle>
              <timerDO:TimerFormatStyle>ShortTruncated</timerDO:TimerFormatStyle>
              <timerDO:TimerFormatStyle>LongTruncated</timerDO:TimerFormatStyle>
            </CompositeCollection>
          </Setter.Value>
        </Setter>
        <Setter Property="ContextMenu.Placement" Value="Bottom" />
      </Style>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Button uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ContextMenu="{StaticResource HourMenu}">
      <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding SelectedHourFormat, ElementName=timerFormatSelector, Converter={StaticResource HourTimerFormatStyleToStringConverter}}" TextDecorations="{Binding SelectedHourFormat, ElementName=timerFormatSelector, Converter={StaticResource TimerFormatStrikethroughConverter}}" />
    </Button>
    <TextBlock Grid.Column="1" Text=":" />
    <Button Grid.Column="2" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ContextMenu="{StaticResource MinuteMenu}">
      <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding SelectedMinuteFormat, ElementName=timerFormatSelector, Converter={StaticResource MinuteTimerFormatStyleToStringConverter}}" TextDecorations="{Binding SelectedMinuteFormat, ElementName=timerFormatSelector, Converter={StaticResource TimerFormatStrikethroughConverter}}" />
    </Button>
    <TextBlock Grid.Column="3" Text=":" />
    <Button Grid.Column="4" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ContextMenu="{StaticResource SecondMenu}">
      <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding SelectedSecondFormat, ElementName=timerFormatSelector, Converter={StaticResource SecondTimerFormatStyleToStringConverter}}" TextDecorations="{Binding SelectedSecondFormat, ElementName=timerFormatSelector, Converter={StaticResource TimerFormatStrikethroughConverter}}" />
    </Button>
    <TextBlock Grid.Column="5" VerticalAlignment="Bottom" Text="." Visibility="{Binding SupportsMilliseconds, ElementName=timerFormatSelector, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Button Grid.Column="6" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ContextMenu="{StaticResource MillisecondMenu}" Visibility="{Binding SupportsMilliseconds, ElementName=timerFormatSelector, Converter={StaticResource ValueToVisibilityConverter}}">
      <TextBlock Style="{StaticResource {x:Type TextBlock}}" Text="{Binding SelectedMillisecondFormat, ElementName=timerFormatSelector, Converter={StaticResource MillisecondTimerFormatStyleToStringConverter}}" TextDecorations="{Binding SelectedMillisecondFormat, ElementName=timerFormatSelector, Converter={StaticResource TimerFormatStrikethroughConverter}}" />
    </Button>
  </Grid>
</UserControl>