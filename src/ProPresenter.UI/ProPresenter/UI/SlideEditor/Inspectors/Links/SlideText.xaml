<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.SlideText" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:links="clr-namespace:ProPresenter.DO.Slide.Links;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" x:Name="self" xmlns:links1="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <ObjectDataProvider x:Key="SlideTextSourceMode" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="links:SlideTextSourceMode" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="TextTransforms" MethodName="GetValues" ObjectType="{x:Type Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="links:TextTransform" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <ComboBox Name="SourceMode" Grid.Column="1" Margin="0,0,0,7" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource SlideTextSourceMode}}" SelectedItem="{Binding SlideTextSourceMode}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,7" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="{mex:Localized TEXT_LINK_SLIDE_NOTES_PRESERVE_FORMAT_title}" IsChecked="{Binding PreserveNotesFormat}" Visibility="{Binding SlideTextSourceMode, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static links:SlideTextSourceMode.Notes}}" />
    <TextBlock Grid.Row="1" Margin="0,0,7,7" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_NAME}" Visibility="{Binding SlideTextSourceMode, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static links:SlideTextSourceMode.ElementMatch}}" />
    <commonControls:PlaceholderTextBox Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,0,7" IsTextBindingExplicit="True" PlaceholderText="{mex:Localized TEXT_LINK_ELEMENT_MATCHING_NAME_PLACEHOLDER_title}" Text="{Binding ElementMatchPattern}" Visibility="{Binding SlideTextSourceMode, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static links:SlideTextSourceMode.ElementMatch}}" />
  </Grid>
</UserControl>