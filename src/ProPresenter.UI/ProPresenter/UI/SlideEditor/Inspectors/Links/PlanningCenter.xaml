<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.PlanningCenter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:pco="clr-namespace:ProPresenter.DO.PCO;assembly=ProPresenter.DO" xmlns:system="clr-namespace:System;assembly=mscorlib" Width="185" xmlns:links="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    <ObjectDataProvider x:Key="PCOLiveThemes" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:TypeExtension Type="{x:Type pco:PCOLiveTheme}" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="PCOLiveCountdownTypes" MethodName="GetValues" ObjectType="{x:Type Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:TypeExtension Type="{x:Type pco:PCOLiveCountdownType}" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,7,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{mex:Localized FILL_LINK_PLANNING_CENTER_THEME_title}" />
    <ComboBox Grid.Row="0" Grid.Column="1" Height="22" Margin="0,7,0,0" VerticalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource PCOLiveThemes}}" SelectedItem="{Binding PCOLiveTheme, Mode=TwoWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,7,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{mex:Localized FILL_LINK_PLANNING_CENTER_TIME_FORMAT_title}" />
    <ComboBox Grid.Row="1" Grid.Column="1" Height="22" Margin="0,7,0,0" VerticalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource PCOLiveCountdownTypes}}" SelectedItem="{Binding PCOLiveCountdownType, Mode=TwoWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
  </Grid>
</UserControl>