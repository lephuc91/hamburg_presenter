<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.Timer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="self">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="vmProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <TextBlock Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_LINKED_TIMER_FORMAT_label}" />
    <local:TimerFormatSelector Grid.Column="1" AvailableHourFormats="{Binding TimerFormatData.AvailableHourFormats}" AvailableMillisecondFormats="{Binding TimerFormatData.AvailableMillisecondFormats}" AvailableMinuteFormats="{Binding TimerFormatData.AvailableMinuteFormats}" AvailableSecondFormats="{Binding TimerFormatData.AvailableSecondFormats}" SecondsEnabled="{Binding TimerFormatData.SecondsAvailable}" SelectedHourFormat="{Binding SelectedHourFormat, Mode=TwoWay}" SelectedMillisecondFormat="{Binding SelectedMillisecondFormat, Mode=TwoWay}" SelectedMinuteFormat="{Binding SelectedMinuteFormat, Mode=TwoWay}" SelectedSecondFormat="{Binding SelectedSecondFormat, Mode=TwoWay}" />
    <local:TimerTokenTextBox Grid.Row="1" Grid.ColumnSpan="2" MinHeight="45" MaxHeight="65" Margin="0,7,0,0" Text="{Binding DisplayFormatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tokens="{Binding TimerTokens}" />
    <StackPanel Grid.Row="2" Margin="0,7" Orientation="Horizontal">
      <commonControls:BorderlessPathButton VerticalAlignment="Center" PathType="Plus" Command="{Binding ColorTriggersVM.AddColorTriggerCommand}" />
      <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource {x:Type TextBlock}}" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_LINKED_TIMER_COLOR_TRIGGERS_label}" />
    </StackPanel>
    <commonControls:BorderlessButton Grid.Row="2" Grid.Column="1" Margin="0,7" HorizontalAlignment="Right" VerticalAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Content="{DynamicResource GearControl}">
      <FrameworkElement.ContextMenu>
        <ContextMenu Placement="Bottom">
          <MenuItem Command="{Binding Data.ColorTriggersVM.SaveAsDefaultColorTriggersCommand, Source={StaticResource vmProxy}}" Header="{mex:Localized GLOBAL_SAVE_AS_DEFAULT_title}" />
          <MenuItem Command="{Binding Data.ColorTriggersVM.ResetToDefaultColorTriggersCommand, Source={StaticResource vmProxy}}" Header="{mex:Localized GLOBAL_RESET_TO_DEFAULT_title}" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
    </commonControls:BorderlessButton>
    <local:ColorTriggerDataGrid x:Name="ColorTriggersDataGrid" Grid.Row="3" Grid.ColumnSpan="2" MinHeight="31" MaxHeight="150" AutoGenerateColumns="False" BorderThickness="1" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="True" ColumnWidth="*" GridLinesVisibility="Horizontal" HeadersVisibility="None" Style="{StaticResource {x:Type DataGrid}}" VirtualizingPanel.ScrollUnit="Pixel" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding RemoveColorTriggersCommand}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}" DataContext="{Binding ColorTriggersVM}" ItemsSource="{Binding ColorTriggers}" SelectedDataGridItems="{Binding SelectedItems}">
      <DataGrid.Columns>
        <DataGridTemplateColumn>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <commonControls:TimeSliceTextBox MaxWidth="75" Margin="0,4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#01000000" BorderThickness="0" ShowHours="False" Style="{StaticResource {x:Type TextBox}}" TimeValue="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <commonControls:ColorPicker Margin="0,4" HorizontalAlignment="Stretch" SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
      <DataGrid.RowStyle>
        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="{x:Type DataGridRow}">
          <Setter Property="FrameworkElement.ContextMenu">
            <Setter.Value>
              <ContextMenu>
                <MenuItem Command="{Binding Data.ColorTriggersVM.RemoveColorTriggersCommand, Source={StaticResource vmProxy}}" Header="{mex:Localized GLOBAL_DELETE_title}" />
              </ContextMenu>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.RowStyle>
    </local:ColorTriggerDataGrid>
  </Grid>
</UserControl>