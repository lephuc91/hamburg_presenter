<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.VisibilityVideoInputSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtitlity="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:liveVideo="clr-namespace:ProPresenter.DO.LiveVideo;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="visibilityVideoInputSelector" xmlns:links="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtitlity:BindingProxy x:Key="visibilityVideoInputSelectorProxy" Data="{Binding ElementName=visibilityVideoInputSelector}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized VISIBILITY_LINK_CONDITION_VIDEO_INPUT_CHOOSE_INPUT_title}" />
    <commonControls:DropDownButton Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
      <commonControls:DropDownButton.CustomContent>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Data.VideoInputName, Source={StaticResource visibilityVideoInputSelectorProxy}}" />
      </commonControls:DropDownButton.CustomContent>
      <commonControls:DropDownButton.CustomContextMenu>
        <ContextMenu Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Data.AvailableLiveVideoInputs, Source={StaticResource visibilityVideoInputSelectorProxy}}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type liveVideo:LiveVideoInput}}">
                <MenuItem Header="{Binding LongName}" Click="SelectInput_Click">
                  <MenuItem.IsChecked>
                    <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                      <Binding Path="Index" />
                      <Binding Path="Data.VideoInputIndex" Source="{StaticResource visibilityVideoInputSelectorProxy}" />
                    </MultiBinding>
                  </MenuItem.IsChecked>
                </MenuItem>
              </ItemContainerTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </ContextMenu>
      </commonControls:DropDownButton.CustomContextMenu>
    </commonControls:DropDownButton>
  </Grid>
</UserControl>