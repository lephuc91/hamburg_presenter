<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Links.Visibility" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:links="clr-namespace:ProPresenter.DO.Slide.Links;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Links" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="visibilityLinkVMProxy" Data="{Binding}" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <ObjectDataProvider x:Key="VisibilityCriterions" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension Type="{x:Type links:VisibilityCriterion}" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_VISIBILITY_SHOWN_WHEN_label}" />
    <ComboBox Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource VisibilityCriterions}}" SelectedItem="{Binding Criterion}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <Separator Grid.Row="2" Margin="-10,10" />
    <ItemsControl Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" ItemsSource="{Binding Conditions}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <local:VisibilityConditionTemplate Margin="0,0,0,5" AddConditionCommand="{Binding Data.AddConditionCommand, Source={StaticResource visibilityLinkVMProxy}}" AvailableElementsCollection="{Binding Data.AvailableElementsCollection, Source={StaticResource visibilityLinkVMProxy}}" AvailableLiveVideoInputs="{Binding Data.AvailableLiveVideoInputs, Source={StaticResource visibilityLinkVMProxy}}" AvailableTimerCollection="{Binding Data.AvailableTimerCollection, Source={StaticResource visibilityLinkVMProxy}}" CanRemoveCondition="{Binding Data.CanRemoveCondition, Source={StaticResource visibilityLinkVMProxy}}" RemoveConditionCommand="{Binding Data.RemoveConditionCommand, Source={StaticResource visibilityLinkVMProxy}}" SetAudioCountdownVisibilityLinkCommand="{Binding Data.SetAudioCountdownVisibilityLinkCommand, Source={StaticResource visibilityLinkVMProxy}}" SetCaptureSessionVisibilityLinkCommand="{Binding Data.SetCaptureSessionVisibilityLinkCommand, Source={StaticResource visibilityLinkVMProxy}}" SetElementVisibilityLinkCommand="{Binding Data.SetElementVisibilityLinkCommand, Source={StaticResource visibilityLinkVMProxy}}" SetTimerVisibilityLinkCommand="{Binding Data.SetTimerVisibilityLinkCommand, Source={StaticResource visibilityLinkVMProxy}}" SetVideoCountdownVisibilityLinkCommand="{Binding Data.SetVideoCountdownVisibilityLinkCommand, Source={StaticResource visibilityLinkVMProxy}}" SetVideoInputVisibilityLinkCommand="{Binding Data.SetVideoInputVisibilityLinkCommand, Source={StaticResource visibilityLinkVMProxy}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>