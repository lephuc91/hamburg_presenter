<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.PropSlideInspector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:props="clr-namespace:ProPresenter.UI.Props" xmlns:transitions="clr-namespace:ProPresenter.UI.Transitions" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="self" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="PropsInspectorVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="False" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:FormattedLocalizedStringConverter x:Key="FormattedLocalizedStringConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,5,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_NAME}" />
    <TextBox Grid.Row="0" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Text="{Binding SelectedProp.Name, UpdateSourceTrigger=PropertyChanged}" />
    <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="-10,10" />
    <CheckBox Grid.Row="2" Grid.Column="0" Margin="0,0,0,10" Content="{mex:Localized EDITOR_PROP_INSPECTOR_BACKGROUND_title}" IsChecked="{Binding UseBackgroundColor, Mode=TwoWay}" />
    <commonControls:ColorPicker Grid.Row="2" Grid.Column="1" Width="50" Height="22" Margin="0,0,0,10" HorizontalAlignment="Right" VerticalAlignment="Center" ColorChangeFinishedCommand="{Binding ColorChangeFinishedCommand}" ColorChangeStartedCommand="{Binding ColorChangeStartedCommand}" SelectedColor="{Binding BackgroundColor}" Visibility="{Binding UseBackgroundColor, Converter={StaticResource ValueToVisibilityConverter}}" />
    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top" Text="{mex:Localized EDITOR_PROP_INSPECTOR_SIZE_title}" />
    <ui:SizeSelector Grid.Row="3" Grid.Column="1" Target="{Binding Data.Slide, Source={StaticResource PropsInspectorVMProxy}}" />
    <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="-10,10" />
    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10" HorizontalAlignment="Left" Text="{mex:Localized EDITOR_PROP_INSPECTOR_TRANSITION_title}" />
    <transitions:ButtonSelector Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,0,5" HorizontalAlignment="Stretch" SelectorButtonContentType="LongChooseAndName" OutputController="{Binding OutputController}" SelectedTransition="{Binding SelectedTransition}" TransitionHandler="{Binding TransitionHandler}" />
    <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Height="22" Margin="10,0,0,0" HorizontalAlignment="Stretch" Command="{Binding RemoveTransitionCommand}" Content="{mex:Localized GLOBAL_REMOVE_title}" Visibility="{Binding SelectedTransition, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Null}}" />
    <Separator Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="-10,10" />
    <TextBlock Grid.Row="9" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized PROP_EDITOR_AUTO_CLEAR_INSPECTOR_title}" />
    <commonControls:DropDownButton Grid.Row="9" Grid.Column="1">
      <commonControls:DropDownButton.CustomContent>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Binding SelectedProp.SlideAction.AutoClearDuration, ConverterParameter=PROP_CONTROL_DECK_CONTEXTUAL_MENU_AUTO_CLEAR_SECONDS_title, Converter={StaticResource FormattedLocalizedStringConverter}}" />
              <Style.Triggers>
                <DataTrigger Value="0" Binding="{Binding SelectedProp.SlideAction.AutoClearDuration}">
                  <Setter Property="Text" Value="{mex:Localized PROP_CONTROL_DECK_CONTEXTUAL_MENU_AUTO_CLEAR_NEVER_title}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </commonControls:DropDownButton.CustomContent>
      <commonControls:DropDownButton.CustomContextMenu>
        <ContextMenu>
          <ItemsControl.ItemsSource>
            <props:AutoClearDurationMenuSource AutoClearDuration="{Binding Data.SelectedProp.SlideAction.AutoClearDuration, Source={StaticResource PropsInspectorVMProxy}}" SetAutoClearCommand="{Binding Data.SetAutoClearCommand, Source={StaticResource PropsInspectorVMProxy}}" SetCustomAutoClearCommand="{Binding Data.SetCustomAutoClearCommand, Source={StaticResource PropsInspectorVMProxy}}" />
          </ItemsControl.ItemsSource>
        </ContextMenu>
      </commonControls:DropDownButton.CustomContextMenu>
    </commonControls:DropDownButton>
  </Grid>
</UserControl>