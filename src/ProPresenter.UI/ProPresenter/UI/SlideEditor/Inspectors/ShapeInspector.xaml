      </commonControls:DoubleUpDown>
      <commonControls:DoubleUpDown Grid.Row="0" Grid.Column="4" HorizontalAlignment="Right" FormatString="F0" LargeIncrement="10" Value="{Binding Top, Mode=TwoWay}">
        <Interaction.Behaviors xmlns="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
          <behaviors:DoubleUpDownMathExpressionBehavior />
        </Interaction.Behaviors>
      </commonControls:DoubleUpDown>
      <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,0,5" HorizontalAlignment="Center" Style="{StaticResource LabelStyle}" Text="{mex:Localized GLOBAL_X_COORDINATE}" />
      <TextBlock Grid.Row="1" Grid.Column="4" Margin="0,0,0,5" HorizontalAlignment="Center" Style="{StaticResource LabelStyle}" Text="{mex:Localized GLOBAL_Y_COORDINATE}" />
      <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_SIZE_label}" />
      <commonControls:DoubleUpDown Grid.Row="2" Grid.Column="2" FormatString="F0" LargeIncrement="10" Maximum="10000" IsEnabled="{Binding IsWidthSupported}" Value="{Binding Width, Mode=TwoWay, Converter={StaticResource RoundedDoubleConverter}}">
        <Interaction.Behaviors xmlns="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
          <behaviors:DoubleUpDownMathExpressionBehavior />
        </Interaction.Behaviors>
      </commonControls:DoubleUpDown>
      <commonControls:BorderlessToggleButton Grid.Row="2" Grid.Column="3" Margin="5,0" IsChecked="{Binding IsAspectRatioLocked}" ToolTip="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_ASPECT_RATIO_LOCK_BUTTON_tooltip}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessToggleButton}}" TargetType="{x:Type commonControls:BorderlessToggleButton}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate>
                  <commonControls:ImageMask HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding BUTTON_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type commonControls:ImageMask}">
                        <Style.Triggers>
                          <DataTrigger Value="False" Binding="{Binding IsAspectRatioLocked}">
                            <Setter Property="commonControls:ImageMask.ImageSource" Value="/ProPresenter.UI;component/Resources/Icons/Inspector Assets/Shape/Lock/unlock.png" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding IsAspectRatioLocked}">
                            <Setter Property="commonControls:ImageMask.ImageSource" Value="/ProPresenter.UI;component/Resources/Icons/Inspector Assets/Shape/Lock/lock.png" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </commonControls:ImageMask>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsAspectRatioLockForced}">
                <Setter Property="ToggleButton.IsChecked" Value="True" />
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:BorderlessToggleButton>
      <commonControls:DoubleUpDown Grid.Row="2" Grid.Column="4" FormatString="F0" LargeIncrement="10" Maximum="10000" IsEnabled="{Binding IsHeightSupported}" Value="{Binding Height, Mode=TwoWay, Converter={StaticResource RoundedDoubleConverter}}">
        <Interaction.Behaviors xmlns="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
          <behaviors:DoubleUpDownMathExpressionBehavior />
        </Interaction.Behaviors>
      </commonControls:DoubleUpDown>
      <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,0,0,5" HorizontalAlignment="Center" Style="{StaticResource LabelStyle}" Text="{mex:Localized GLOBAL_WIDTH}" />
      <TextBlock Grid.Row="3" Grid.Column="4" Margin="0,0,0,5" HorizontalAlignment="Center" Style="{StaticResource LabelStyle}" Text="{mex:Localized GLOBAL_HEIGHT}" />
      <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_TRANSFORM_label}" />
      <StackPanel Grid.Row="4" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding ShowFullInspector, Converter={StaticResource ValueToVisibilityConverter}}">
        <ToggleButton Padding="3,0" IsChecked="{Binding FlipHorizontally}" ToolTip="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_FLIP_HORIZONTALLY_BUTTON_tooltip}">
          <Image Source="/ProPresenter.UI;component/Resources/Icons/Inspector Assets/Flip/vertical.png" />
        </ToggleButton>
        <ToggleButton Padding="3,0" IsChecked="{Binding FlipVertically}" ToolTip="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_FLIP_VERTICALLY_BUTTON_tooltip}">
          <Image Source="/ProPresenter.UI;component/Resources/Icons/Inspector Assets/Flip/flipVertical.png" />
        </ToggleButton>
      </StackPanel>
      <commonControls:RotatorUpDownPicker Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Angle="{Binding Rotation, Mode=TwoWay}" IsEnabled="{Binding IsRotationSupported}" />
      <TextBlock Grid.Row="5" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LabelStyle}" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_ROTATION_CONTROL_title}" />
    </Grid>
    <Separator Grid.Row="5" Margin="-10,10" Visibility="{Binding ShowFullInspector, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid Row="6" Visibility="{Binding ShowFullInspector, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_OPACITY_label}" />
      <commonControls:UnitsSlider Grid.Column="1" Grid.ColumnSpan="2" Margin="20,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" FillMode="Opacity" IsSnapToTickEnabled="True" LargeChange="20" Maximum="100" Minimum="0" SmallChange="1" TickFrequency="1" Units="%" Value="{Binding Opacity, Mode=TwoWay, Converter={commonConverters:PercentageConverter}}" />
    </Grid>
    <Separator Grid.Row="7" Margin="-10,10" Visibility="{Binding ShowFullInspector, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid Row="8" Visibility="{Binding ShowFullInspector, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <CheckBox Name="fillCheck" Grid.Row="0" Grid.Column="0" Height="22" Margin="0,0,14,0" VerticalAlignment="Top" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_FILL_label}" IsChecked="{Binding IsFillVisible, Mode=TwoWay}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding IsFillSupported}">
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </CheckBox>
      <Button Name="FillSelector" Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ContextMenu="{Binding Source={StaticResource FillMenus}}" IsEnabled="{Binding IsFillSupported}" Visibility="{Binding IsChecked, ElementName=fillCheck, Converter={StaticResource ValueToVisibilityConverter}}">
        <Grid Width="{Binding ActualWidth, ElementName=FillSelector}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                <Setter Property="Text">
                  <Setter.Value>
                    <MultiBinding Converter="{StaticResource SelectedFillNameConverter}">
                      <Binding Path="Data.FillType" Source="{StaticResource shapeInspectorVMProxy}" />
                      <Binding Path="Data.FillLinkVM.LinkedFillType" Source="{StaticResource shapeInspectorVMProxy}" />
                      <Binding Path="Data.FillLinkVM.ElementFillLinkVM.LinkedElement" Source="{StaticResource shapeInspectorVMProxy}" />
                      <Binding Path="Data.FillLinkVM.SlideImageLinkVM.SlideTargetSourceMode" Source="{StaticResource shapeInspectorVMProxy}" />
                      <Binding Path="Data.FillLinkVM.OutputScreenLinkVM.SelectedScreen" Source="{StaticResource shapeInspectorVMProxy}" />
                    </MultiBinding>
                  </Setter.Value>
                </Setter>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
        </Grid>
      </Button>
      <ContentControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Visibility="{Binding IsChecked, ElementName=fillCheck, Converter={StaticResource ValueToVisibilityConverter}}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type ContentControl}">
            <Setter Property="Content" Value="{x:Null}" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="{x:Static doFills:FillType.Solid}" Binding="{Binding FillType}" />
                  <Condition Value="None" Binding="{Binding FillLinkVM.LinkedFillType}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Content">
                  <Setter.Value>
                    <fills:SolidColors Margin="0,5,0,0" HorizontalAlignment="Right" />
                  </Setter.Value>
                </Setter>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="{x:Static doFills:FillType.Gradient}" Binding="{Binding FillType}" />
                  <Condition Value="None" Binding="{Binding FillLinkVM.LinkedFillType}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Content">
                  <Setter.Value>
                    <fills:GradientColors Margin="0,5,0,0" HorizontalAlignment="Right" />
                  </Setter.Value>
                </Setter>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="{x:Static doFills:FillType.Media}" Binding="{Binding FillType}" />
                  <Condition Value="None" Binding="{Binding FillLinkVM.LinkedFillType}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Content">
                  <Setter.Value>
                    <fills:Media Margin="0,5,0,0" HorizontalAlignment="Stretch" CreateMediaFillCommand="{Binding CreateMediaFillCommand}" EditMediaCommand="{Binding Data.EditMediaCommand, Source={StaticResource shapeInspectorProxy}}" />
                  </Setter.Value>
                </Setter>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="{x:Static doFills:FillType.Live}" Binding="{Binding FillType}" />
                  <Condition Value="None" Binding="{Binding FillLinkVM.LinkedFillType}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Content">
                  <Setter.Value>
                    <fills:LiveVideo Margin="0,5,0,0" HorizontalAlignment="Stretch" AvailableInputs="{Binding AvailableInputs}" LiveVideoMedia="{Binding Fill.LiveVideo}" OpenSetupCommand="{Binding OpenSetupCommand}" />
                  </Setter.Value>
                </Setter>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="{x:Static doFills:FillType.HTML}" Binding="{Binding FillType}" />
                  <Condition Value="None" Binding="{Binding FillLinkVM.LinkedFillType}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Content">
                  <Setter.Value>
                    <fills:HTMLFill Margin="0,5,0,0" HorizontalAlignment="Stretch" />
                  </Setter.Value>
                </Setter>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="{x:Static doFills:FillType.BackgroundEffectBlur}" Binding="{Binding FillType}" />
                  <Condition Value="None" Binding="{Binding FillLinkVM.LinkedFillType}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Content">
                  <Setter.Value>
                    <fills:BackgroundEffectBlur Margin="5,10,0,0" Slide="{Binding SelectedSlide}" />
                  </Setter.Value>
                </Setter>
              </MultiDataTrigger>
              <DataTrigger Value="{x:Static links:LinkedFillType.PCOLive}" Binding="{Binding FillLinkVM.LinkedFillType}">
                <Setter Property="Content">
                  <Setter.Value>
                    <linkUIs:PlanningCenter Margin="0,5,0,0" HorizontalAlignment="Right" DataContext="{Binding Data.FillLinkVM.PCOLinkVM, Source={StaticResource shapeInspectorVMProxy}}" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
              <DataTrigger Value="{x:Static links:LinkedFillType.GroupColor}" Binding="{Binding FillLinkVM.LinkedFillType}">
                <Setter Property="Content">
                  <Setter.Value>
                    <linkUIs:GroupColor Margin="0,5,0,0" HorizontalAlignment="Right" DataContext="{Binding Data.FillLinkVM.GroupColorFillLinkVM, Source={StaticResource shapeInspectorVMProxy}}" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
              <DataTrigger Value="{x:Static links:LinkedFillType.SlideLabelColor}" Binding="{Binding FillLinkVM.LinkedFillType}">
                <Setter Property="Content">
                  <Setter.Value>
                    <linkUIs:SlideLabelColor Margin="0,5,0,0" HorizontalAlignment="Right" DataContext="{Binding Data.FillLinkVM.SlideLabelColorFillLinkVM, Source={StaticResource shapeInspectorVMProxy}}" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
              <DataTrigger Value="{x:Static links:LinkedFillType.PlaybackMarkerColor}" Binding="{Binding FillLinkVM.LinkedFillType}">
                <Setter Property="Content">
                  <Setter.Value>
                    <linkUIs:PlaybackMarker Margin="45,5,0,0" HorizontalAlignment="Stretch" IsText="False" DataContext="{Binding Data.FillLinkVM.PlaybackMarkerColorFillLinkVM, Source={StaticResource shapeInspectorVMProxy}}" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ContentControl>
    </Grid>
    <Separator Grid.Row="9" Margin="-10,10" Visibility="{Binding ShowStroke, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid Row="10" Visibility="{Binding ShowStroke, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <CheckBox Name="strokeCheck" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_STROKE_label}" IsChecked="{Binding IsStrokeVisible, Mode=TwoWay}" />
      <ContentControl Grid.Row="1" Margin="0,5,0,0" Visibility="{Binding IsChecked, ElementName=strokeCheck, Converter={StaticResource ValueToVisibilityConverter}}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type ContentControl}">
            <Setter Property="Content" Value="{x:Null}" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsChecked, ElementName=strokeCheck}">
                <Setter Property="Content">
                  <Setter.Value>
                    <strokes:Strokes HorizontalAlignment="Right" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ContentControl>
    </Grid>
    <Separator Grid.Row="11" Margin="-10,10" Visibility="{Binding ShowShadow, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid Row="12" Visibility="{Binding ShowShadow, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <CheckBox Name="shadowCheck" Grid.Row="0" VerticalAlignment="Center" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_SHADOW_label}" IsChecked="{Binding IsShadowVisible, Mode=TwoWay}" />
      <ContentControl Grid.Row="1">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type ContentControl}">
            <Setter Property="Content" Value="{x:Null}" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsChecked, ElementName=shadowCheck}">
                <Setter Property="Content">
                  <Setter.Value>
                    <shadows:DropShadows Margin="0,5,0,0" HorizontalAlignment="Right" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ContentControl>
    </Grid>
    <Separator Grid.Row="13" Margin="-10,10" Visibility="{Binding ShowFeatheringOption, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid Row="14" Visibility="{Binding ShowFeatheringOption, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <CheckBox Name="featheringCheckBox" Grid.Column="0" VerticalAlignment="Center" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_FEATHERING_label}" IsChecked="{Binding FeatherEnabled, Mode=TwoWay}" />
      <ContentControl Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsChecked, ElementName=featheringCheckBox, Converter={StaticResource ValueToVisibilityConverter}}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type ContentControl}">
            <Setter Property="Content" Value="{x:Null}" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsChecked, ElementName=featheringCheckBox}">
                <Setter Property="Content">
                  <Setter.Value>
                    <commonControls:UnitsSlider Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" FillMode="Feather" IsSnapToTickEnabled="True" LargeChange="20" Maximum="100" Minimum="0" SmallChange="1" TickFrequency="1" Units="%" Value="{Binding FeatherRadius, Mode=TwoWay, Converter={commonConverters:PercentageConverter}}" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ContentControl>
    </Grid>
    <Separator Grid.Row="15" Margin="-10,10" Visibility="{Binding ShowVisibility, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid Row="16" Visibility="{Binding ShowVisibility, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <CheckBox Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_VISIBILITY_label}" IsChecked="{Binding VisibilityLinkVM.IsVisibilityLinkEnabled, Mode=TwoWay}" />
      <linkUIs:Visibility Grid.Row="1" Margin="0,5,0,0" DataContext="{Binding VisibilityLinkVM}" Visibility="{Binding IsVisibilityLinkEnabled, Converter={StaticResource ValueToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>