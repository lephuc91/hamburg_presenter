<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.MaskInspector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:ui="clr-namespace:ProPresenter.UI" x:Name="self" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="mProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,5,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_NAME}" />
    <TextBox Grid.Row="0" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Text="{Binding SelectedItemName, ElementName=self, UpdateSourceTrigger=PropertyChanged}" />
    <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="-10,10" />
    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized EDITOR_MASK_INSPECTOR_SIZE_title}" />
    <ui:SizeSelector Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Target="{Binding Data.SelectedSlide, Source={StaticResource mProxy}}" />
  </Grid>
</UserControl>