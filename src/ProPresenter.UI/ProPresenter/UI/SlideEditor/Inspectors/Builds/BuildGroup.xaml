<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Builds.BuildGroup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Builds" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="buildGroup" Background="#00FFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="buildGroupProxy" Data="{Binding ElementName=buildGroup}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="GroupBorder" Margin="0,4" BorderThickness="1" CornerRadius="5" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding TABITEM_BORDER, Source={x:Static theming:AppTheme.Active}}">
    <ItemsControl xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib" AlternationCount="{x:Static system1:Int32.MaxValue}" ItemsSource="{Binding Builds, ElementName=buildGroup}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <local:BuildStep Build="{Binding}" BuildVM="{Binding Data.BuildVM, Source={StaticResource buildGroupProxy}}" Index="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContentPresenter}}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>