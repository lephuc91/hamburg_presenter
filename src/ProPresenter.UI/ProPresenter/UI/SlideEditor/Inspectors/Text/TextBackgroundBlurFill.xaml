<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Text.TextBackgroundBlurFill" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:text="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Text" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="{StaticResource {x:Static themes:Constants.ColumnItemHorizontalWidth}}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="{StaticResource {x:Static themes:Constants.RowItemVerticalHeight}}" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="{StaticResource {x:Static themes:Constants.RowItemVerticalHeight}}" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{markupExtensions:Localized GRAPHIC_FILL_BACKGROUND_EFFECT_BLUR_SATURATION_title}" />
    <controls:UnitsSlider Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" FillMode="None" IsSnapToTickEnabled="True" LargeChange="20" Maximum="100" Minimum="-100" SmallChange="1" TickFrequency="1" Units="%" Value="{Binding Saturation, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type text:TextBackgroundBlurFill}}, Converter={converters:PercentageConverter}}" />
    <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{markupExtensions:Localized GRAPHIC_FILL_BACKGROUND_EFFECT_BLUR_AMOUNT_title}" />
    <controls:UnitsSlider Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" FillMode="None" IsSnapToTickEnabled="True" LargeChange="20" Maximum="100" Minimum="0" SmallChange="1" TickFrequency="1" Units="%" Value="{Binding BlurAmount, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type text:TextBackgroundBlurFill}}, Converter={converters:PercentageConverter}}" />
    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" FontSize="7" Text="{markupExtensions:Localized GRAPHIC_FILL_BACKGROUND_EFFECT_BLUR_AMOUNT_WARNING_title}" />
  </Grid>
</UserControl>