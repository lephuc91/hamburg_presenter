<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.StageLayoutInspector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:ui="clr-namespace:ProPresenter.UI" x:Name="self" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonUtility:BindingProxy x:Key="stageLayoutProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,5,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="{mex:Localized GLOBAL_NAME}" />
    <TextBox Grid.Row="0" Grid.Column="1" Height="22" VerticalContentAlignment="Center" Text="{Binding SlideCue.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="-10,10" />
    <CheckBox Grid.Row="2" Content="{mex:Localized EDITOR_STAGE_LAYOUT_INSPECTOR_BACKGROUND_title}" IsChecked="{Binding SlideCue.SlideAction.Slide.UseBackgroundColor}" />
    <commonControls:ColorPicker Grid.Row="2" Grid.Column="1" Width="50" Height="22" HorizontalAlignment="Right" ColorChangeFinishedCommand="{Binding ColorChangeFinishedCommand}" SelectedColor="{Binding SlideCue.SlideAction.Slide.BackgroundColor}" Visibility="{Binding SlideCue.SlideAction.Slide.UseBackgroundColor, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="-10,10" />
    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,3,10,0" VerticalAlignment="Top" Text="{mex:Localized EDITOR_STAGE_LAYOUT_INSPECTOR_SIZE_title}" />
    <ui:SizeSelector Grid.Row="4" Grid.Column="1" ScreenTargetType="Stage" Target="{Binding Data.SlideCue.SlideAction.Slide, Source={StaticResource stageLayoutProxy}}" />
  </Grid>
</UserControl>