            <TextBlock FontWeight="SemiBold" Text="U" TextDecorations="Underline" />
          </ToggleButton>
          <ToggleButton Grid.Column="3" Height="22" BorderThickness="0,1,1,1" IsChecked="{Binding IsStrikethroughEnabled, Mode=TwoWay, ElementName=textInspector}">
