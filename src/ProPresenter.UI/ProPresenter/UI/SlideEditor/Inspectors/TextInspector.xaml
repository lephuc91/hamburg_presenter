      <Style x:Key="IntegerUpdownControlStyle" BasedOn="{StaticResource {x:Type commonControls:IntegerUpDown}}" TargetType="{x:Type commonControls:IntegerUpDown}">
        <Setter Property="Height" Value="22" />
