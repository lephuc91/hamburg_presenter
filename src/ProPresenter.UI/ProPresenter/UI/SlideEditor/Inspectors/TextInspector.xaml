                      <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,7" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_LINE_HEIGHT_label}" />
                      <commonControls:DoubleUpDown Grid.Row="4" Grid.Column="2" Margin="0,0,0,7" FormatString="F1" Increment="0.5" Maximum="10" Minimum="0.1" Style="{StaticResource DoubleUpdownControlStyle}" Value="{Binding Data.LineSpacing, Source={StaticResource selfTextInspector}, Mode=TwoWay}" />
                      <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,7" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_LINE_SPACING_label}" />
                      <commonControls:DoubleUpDown Grid.Row="5" Grid.Column="2" Margin="0,0,0,7" FormatString="F1" Increment="0.5" Maximum="100" Minimum="0.0" Style="{StaticResource DoubleUpdownControlStyle}" Value="{Binding Data.AdditionalLineSpacing, Source={StaticResource selfTextInspector}}" />
