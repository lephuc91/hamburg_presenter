        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="{Binding ShowTextStyleControls, ElementName=textInspector, Converter={StaticResource ValueToVisibilityConverter}}">
        <Button Width="110" Height="22" CommandParameter="{x:Static vm:TargetStrategy.SelectedElements}" Command="{Binding EditMenu.CopyTextStyle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Content="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_COPY_STYLE_BUTTON_title}" Loaded="InvalidateCommand" />
        <Button Width="110" Height="22" Margin="14,0,0,0" CommandParameter="{x:Static vm:TargetStrategy.SelectedElements}" Command="{Binding EditMenu.PasteTextStyle.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Content="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_PASTE_STYLE_BUTTON_title}" Loaded="InvalidateCommand" />
      </StackPanel>
      <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="-10,10" IsEnabled="{Binding PreserveFormat, Converter={StaticResource InvertedBooleanConverter}, ElementName=textInspector}" Visibility="{Binding ShowTextStyleControls, ElementName=textInspector, Converter={StaticResource ValueToVisibilityConverter}}" />
      <commonControls:FontSelector Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,7" IsEditorMode="True" FontFamilyDropDownOpen="{Binding IsFontFamilySelectionOpen, ElementName=textInspector, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PreserveFormat, Converter={StaticResource InvertedBooleanConverter}, ElementName=textInspector}" MissingFont="{Binding MissingFont, ElementName=textInspector, Mode=OneWay}" SelectedCharacterSize="{Binding CharacterSize, Mode=TwoWay, ElementName=textInspector}" SelectedFontGroup="{Binding FontGroup, ElementName=textInspector, Mode=TwoWay}" SelectedFontInfo="{Binding Font, ElementName=textInspector, Mode=TwoWay}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type commonControls:FontSelector}">
            <Style.Triggers>
              <DataTrigger Value="UpOrDown" Binding="{Binding ScaleBehavior, ElementName=textInspector}">
                <Setter Property="commonControls:FontSelector.CharacterSizeEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:FontSelector>
      <Grid Row="3" Margin="0,0,0,7" IsEnabled="{Binding PreserveFormat, Converter={StaticResource InvertedBooleanConverter}, ElementName=textInspector}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <ToggleButton Height="22" BorderThickness="1,1,0,1" Content="B" FontWeight="Bold" IsChecked="{Binding IsBoldEnabled, Mode=TwoWay, ElementName=textInspector}" IsEnabled="{Binding CanToggleBold, ElementName=textInspector}" />
          <ToggleButton Grid.Column="1" Height="22" Content="I" FontStyle="Italic" FontWeight="SemiBold" IsChecked="{Binding IsItalicEnabled, Mode=TwoWay, ElementName=textInspector}" IsEnabled="{Binding CanToggleItalic, ElementName=textInspector}" />
