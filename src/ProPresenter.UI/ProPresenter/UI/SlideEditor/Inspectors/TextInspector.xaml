                            <TextBlock Typography.Variants="Subscript" Text="{Binding Data.SubscriptLevel, Source={StaticResource selfTextInspector}}" />
                          </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" BorderThickness="0,1,1,1" IsChecked="{Binding Data.IsSuperscript, Source={StaticResource selfTextInspector}}" Click="Superscript_Click">
