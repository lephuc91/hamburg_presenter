            <ContextMenu Placement="Bottom" Style="{StaticResource {x:Type ContextMenu}}">
              <Control.Template>
                <ControlTemplate>
                  <Border BorderThickness="1" Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding POPUPBORDER, Source={x:Static theming:AppTheme.Active}}" TextElement.Foreground="{Binding POPUPCONTENT, Source={x:Static theming:AppTheme.Active}}">
