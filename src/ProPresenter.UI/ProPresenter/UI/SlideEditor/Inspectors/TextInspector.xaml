                          </StackPanel>
                        </ToggleButton>
                      </Grid>
                      <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,7" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_CHARACTER_SPACING_label}" />
