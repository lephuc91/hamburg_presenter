              <text:CapitalizationType>StartCase</text:CapitalizationType>
            </CompositeCollection>
          </ItemsControl.ItemsSource>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
      </Grid>
