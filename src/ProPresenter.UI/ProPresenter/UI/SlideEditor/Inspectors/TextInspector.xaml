          <x:TypeExtension TypeName="text:CapitalizationType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="FontScaleBehaviorTypes" MethodName="GetValues" ObjectType="{x:Type Enum}">
