                      <TextBlock Grid.Row="7" Margin="0,0,7,7" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_MARGINS_label}" />
                      <commonControls:DoubleUpDown Grid.Row="7" Grid.Column="1" FormatString="F1" Increment="1.0" Maximum="300" Minimum="0" Style="{StaticResource DoubleUpdownControlStyle}" Value="{Binding Data.MarginLeft, Source={StaticResource selfTextInspector}}" />
                      <commonControls:DoubleUpDown Grid.Row="7" Grid.Column="2" FormatString="F1" Increment="1.0" Maximum="300" Minimum="0" Style="{StaticResource DoubleUpdownControlStyle}" Value="{Binding Data.MarginTop, Source={StaticResource selfTextInspector}}" />
                      <TextBlock Grid.Row="8" Grid.Column="1" Width="60" Margin="0,0,0,7" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" TextAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_MARGINS_LEFT_label}" />
                      <TextBlock Grid.Row="8" Grid.Column="2" Width="60" Margin="0,0,0,7" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" TextAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_MARGINS_TOP_label}" />
                      <commonControls:DoubleUpDown Grid.Row="9" Grid.Column="1" FormatString="F1" Increment="1.0" Maximum="300" Minimum="0" Style="{StaticResource DoubleUpdownControlStyle}" Value="{Binding Data.MarginBottom, Source={StaticResource selfTextInspector}}" />
                      <commonControls:DoubleUpDown Grid.Row="9" Grid.Column="2" FormatString="F1" Increment="1.0" Maximum="300" Minimum="0" Style="{StaticResource DoubleUpdownControlStyle}" Value="{Binding Data.MarginRight, Source={StaticResource selfTextInspector}}" />
                      <TextBlock Grid.Row="10" Grid.Column="1" Width="60" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" TextAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_MARGINS_BOTTOM_label}" />
                      <TextBlock Grid.Row="10" Grid.Column="2" Width="60" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" TextAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_POPOVER_MARGINS_RIGHT_label}" />
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Control.Template>
            </ContextMenu>
          </FrameworkElement.ContextMenu>
        </Button>
