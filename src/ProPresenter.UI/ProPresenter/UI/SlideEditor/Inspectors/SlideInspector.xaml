<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.SlideInspector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:livevideo="clr-namespace:ProPresenter.UI.LiveVideo" xmlns:local="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors" xmlns:math="http://hexinnovation.com/math" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:slideEditor="clr-namespace:ProPresenter.UI.SlideEditor" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:thumbnailVM="clr-namespace:ProPresenter.UI.ViewModels.Thumbnails" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="self">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="pack://application:,,,/ProPresenter.UI;component/Resources/Paths/Paths.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:ChordChartToBitmapConverter x:Key="ChordChartToBitmapConverter" />
      <commonConverters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverter" />
      <converters:KeyToStringConverter x:Key="KeyToStringConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:IsNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpaceConverter" />
      <commonConverters:FilePathToFileNameConverter x:Key="FilePathToFileNameConverter" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <Style x:Key="{x:Type local:CloudMissingMedia}" TargetType="{x:Type local:CloudMissingMedia}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="Collapsed" Binding="{Binding DataContext.GraphicMediaAction.FileMedia.Availability, ElementName=MediaActionContainer, ConverterParameter={x:Static media:MediaAvailability.Ready}, Converter={StaticResource ValueToVisibilityConverter}}" />
              <Condition Value="Visible" Binding="{Binding Source={mex:FeatureFlag Cloud}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type local:MissingMedia}" TargetType="{x:Type local:MissingMedia}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="False" Binding="{Binding DataContext.GraphicMediaAction.FileMedia.IsValid, ElementName=MediaActionContainer}" />
              <Condition Value="Collapsed" Binding="{Binding Source={mex:FeatureFlag Cloud}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <CheckBox Grid.Row="0" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_ENABLED_BUTTON_title}" IsChecked="{Binding ItemEnabled}" />
    <Separator Grid.Row="1" Margin="-10,10" />
    <TextBlock Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_HOTKEY_label}" />
    <TextBox Grid.Row="2" Width="50" Height="22" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CharacterCasing="Upper" MaxLength="1" Text="{Binding Hotkey, Converter={StaticResource KeyToStringConverter}, UpdateSourceTrigger=LostFocus}" KeyUp="HotkeyTextBox_KeyUp" PreviewTextInput="HotkeyTextBox_ValidateTextInput" />
    <Separator Grid.Row="3" Margin="-10,10" />
    <StackPanel Grid.Row="4">
      <TextBlock Margin="0,0,0,5" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_LABEL_label}" />
      <slideEditor:SlideLabelSelector Margin="0,0,0,5" DataContext="{Binding LabelEditorVM}" />
    </StackPanel>
    <Separator Grid.Row="5" Margin="-10,10" />
    <Grid Row="6">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <CheckBox HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_BACKGROUND_BUTTON_title}" IsChecked="{Binding SelectedSlide.UseBackgroundColor}" />
      <commonControls:ColorPicker Width="50" Height="22" HorizontalAlignment="Right" ColorChangeFinishedCommand="{Binding SlideColorChangedCommand}" SelectedColor="{Binding SelectedSlide.BackgroundColor}" Visibility="{Binding SelectedSlide.UseBackgroundColor, Converter={StaticResource ValueToVisibilityConverter}}" />
      <TextBlock Grid.Row="1" Margin="22,5,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized EDITOR_PRESENTATION_PRESENTATION_INSPECTOR_BACKGROUND_INFORMATIVE_TEXT_label}">
        <UIElement.Visibility>
          <ConvertExtension p22:ConvertExtension.x="{Binding SelectedSlide.UseBackgroundColor}" p22:ConvertExtension.y="{Binding IgnoreBackgroundColors}" xmlns:p22="clr-namespace:HexInnovation;assembly=MathConverter" xmlns="clr-namespace:HexInnovation;assembly=MathConverter">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">And(x==true,y) ? `Visible` : `Collapsed`</Ctor>
          </ConvertExtension>
        </UIElement.Visibility>
      </TextBlock>
    </Grid>
    <Separator Grid.Row="7" Margin="-10,10" />
    <Grid Row="8">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_CHORD_CHART_HEADER_label}" />
      <Grid Name="chordChartArea" Row="1" AllowDrop="True" Background="#00FFFFFF">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <commonControls:BorderlessButton Grid.Row="0" Grid.Column="0">
          <FrameworkElement.ContextMenu>
            <ContextMenu Visibility="{Binding SelectedSlide.ChordChart, Converter={StaticResource IsNotNullToVisibilityConverter}}">
              <MenuItem Command="{Binding ShowCordChartInFileExplorerCommand}" Header="{mex:Localized GLOBAL_SHOW_IN_FINDER_MENU_ITEM_windows_title}" />
            </ContextMenu>
          </FrameworkElement.ContextMenu>
          <Border Width="53" Height="53" HorizontalAlignment="Left" Background="#FFA9A9A9" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="6">
            <Image RenderOptions.BitmapScalingMode="Fant" Source="{Binding SelectedSlide.ChordChart, Converter={StaticResource ChordChartToBitmapConverter}}" />
          </Border>
        </commonControls:BorderlessButton>
        <Button Grid.Row="0" Grid.Column="1" Height="22" Margin="10,0,0,0" Padding="10,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Command="{Binding ChangeChordChartCommand}" Content="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_CHORD_CHART_CHOOSE_BUTTON_title}" ToolTip="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_CHORD_CHART_CHOOSE_BUTTON_tooltip}" />
        <Button Grid.Row="0" Grid.Column="1" Height="22" Margin="10,0,0,0" Padding="10,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Command="{Binding RemoveChordChartCommand}" Content="{mex:Localized GLOBAL_REMOVE_title}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="4" TextTrimming="CharacterEllipsis" Text="{Binding SelectedSlide.ChordChartFileName}" ToolTip="{Binding SelectedSlide.ChordChartFileName}" Visibility="{Binding SelectedSlide.ChordChart, Converter={StaticResource IsNotNullToVisibilityConverter}}" />
      </Grid>
    </Grid>
    <Separator Grid.Row="9" Margin="-10,10" />
    <Grid Row="10" Margin="0,0,0,5">
      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_MEDIA_ACTION_HEADER_title}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <commonControls:BorderlessPathButton Height="22" VerticalAlignment="Center" Cursor="Hand" PathType="Plus" StrokeThickness="2" Command="{Binding AddMediaActionCommand}" Visibility="{Binding GraphicMediaActionPresent, Converter={StaticResource InvertedValueToVisibilityConverter}, Mode=OneWay}" />
        <commonControls:BorderlessButton Height="22" VerticalAlignment="Center" Cursor="Hand" Command="{Binding RemoveMediaActionCommand}" Visibility="{Binding GraphicMediaActionPresent, Converter={StaticResource ValueToVisibilityConverter}, Mode=OneWay}">
          <commonControls:ImageMask ImageSource="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/Transitions/trash.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
        </commonControls:BorderlessButton>
      </StackPanel>
    </Grid>
    <Grid Name="MediaActionContainer" Row="11" Visibility="{Binding GraphicMediaActionPresent, Converter={StaticResource ValueToVisibilityConverter}}">
      <FrameworkElement.Resources>
        <ui:SharedResourceDictionary>
          <Style x:Key="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </ui:SharedResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5" VerticalAlignment="Center" Orientation="Horizontal">
        <commonControls:DownloadInProgressIndicator Width="18" Margin="0,0,5,8" VerticalAlignment="Center" UseSmallRing="True" DataContext="{Binding OverlayVM}" ToolTip="{mex:Localized PRESENTATION_MEDIA_ACTION_DOWNLOAD_IN_PROGRESS_tooltip}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type commonControls:DownloadInProgressIndicator}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="Visible" Binding="{Binding InvalidMediaType.Value, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Remote}}" />
                    <Condition Value="{x:Static media:MediaAvailability.Missing}" Binding="{Binding CloudMediaAvailability.Value}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Value="{x:Static media:MediaAvailability.Downloading}" Binding="{Binding CloudMediaAvailability.Value}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="Collapsed" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:DownloadInProgressIndicator>
        <Image Width="18" Height="18" Margin="0,0,5,0" Source="{StaticResource {x:Static themesUI:Icons.ProContent}}" Visibility="{Binding OverlayVM.InvalidMediaType.Value, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Remote}}" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding OverlayVM.InvalidMediaType.Value, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Remote}}">
          <Path Margin="0,0,5,0" Data="{StaticResource Image}" Fill="{Binding MENU_PALETTE.Standard.Content, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding GraphicMediaAction.FileMedia.IsValid, Converter={StaticResource ValueToVisibilityConverter}}" />
          <Image Width="18" Height="18" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="Fant" Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/WarningIcon.png" Visibility="{Binding GraphicMediaAction.FileMedia.IsValid, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        </StackPanel>
        <TextBlock Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding GraphicMediaAction.FileMedia.SourceFile.FullPath, Converter={StaticResource FilePathToFileNameConverter}}" />
        <Button Margin="2,0,0,0" HorizontalAlignment="Right" Background="#00FFFFFF" BorderThickness="0" Command="{Binding ShowInFileExplorerCommand}" Visibility="{Binding GraphicMediaAction.FileMedia.IsValid, Converter={StaticResource ValueToVisibilityConverter}}">
          <Control.Template>
            <ControlTemplate>
              <commonControls:PathControl Width="12" Height="12" Fill="#00FFFFFF" PathType="Magnifier" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
            </ControlTemplate>
          </Control.Template>
        </Button>
      </StackPanel>
      <StackPanel Grid.Row="1" Visibility="{Binding GraphicMediaAction.FileMedia.IsValid, Converter={StaticResource ValueToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Margin="0,0,2,5" Command="{Binding ProCommon.OpenMediaInspector.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding GraphicMediaAction, Converter={di:DIMarkup {x:Type converters:MediaInspectorConverter}}}" Content="{mex:Localized GLOBAL_INSPECTOR_BUTTON_title}" />
          <Button Grid.Column="1" Margin="2,0,0,5" Command="{Binding ChooseGraphicMediaFileCommand}" Content="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_CHOOSE_FILE_BUTTON_title}" />
        </Grid>
        <TextBlock Margin="0,10,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_BEHAVIOR_label}" />
        <ComboBox Margin="0,0,0,10" SelectedItem="{Binding GraphicMediaAction.TriggerLayer, Mode=TwoWay}">
          <ItemsControl.ItemsSource>
            <CompositeCollection>
              <media:TriggerLayer>Background</media:TriggerLayer>
              <media:TriggerLayer>Foreground</media:TriggerLayer>
            </CompositeCollection>
          </ItemsControl.ItemsSource>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
        <TextBlock Margin="0,10,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_RETRIGGER_BEHAVIOR_label}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="{Binding TransportMedia, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
              <Style.Triggers>
                <DataTrigger Value="Foreground" Binding="{Binding GraphicMediaAction.TriggerLayer}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
        <ComboBox Margin="0,0,0,10" SelectedItem="{Binding TransportMedia.Transport.RetriggerBehavior, Mode=TwoWay}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
              <Setter Property="ItemsSource">
                <Setter.Value>
                  <CompositeCollection>
                    <media:RetriggerBehavior>Always</media:RetriggerBehavior>
                    <media:RetriggerBehavior>Never</media:RetriggerBehavior>
                    <media:RetriggerBehavior>Automatic</media:RetriggerBehavior>
                  </CompositeCollection>
                </Setter.Value>
              </Setter>
              <Setter Property="Visibility" Value="{Binding TransportMedia, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
              <Style.Triggers>
                <DataTrigger Value="Foreground" Binding="{Binding GraphicMediaAction.TriggerLayer}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <local:CloudMissingMedia Grid.Row="1" DataContext="{Binding OverlayVM}" />
      <local:MissingMedia Grid.Row="1" DataContext="{Binding OverlayVM}" />
    </Grid>
    <Separator Grid.Row="12" Margin="-10,10" />
    <Grid Row="13" Margin="0,0,0,5">
      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_VIDEO_INPUT_ACTION_HEADER_title}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <commonControls:BorderlessPathButton Height="22" VerticalAlignment="Center" Cursor="Hand" PathType="Plus" StrokeThickness="2" Command="{Binding AddVideoInputActionCommand}" Visibility="{Binding VideoInputMediaActionPresent, Converter={StaticResource InvertedValueToVisibilityConverter}, Mode=OneWay}" />
        <commonControls:BorderlessButton Height="22" VerticalAlignment="Center" Cursor="Hand" Command="{Binding RemoveVideoInputActionCommand}" Visibility="{Binding VideoInputMediaActionPresent, Converter={StaticResource ValueToVisibilityConverter}, Mode=OneWay}">
          <commonControls:ImageMask ImageSource="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/Transitions/trash.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
        </commonControls:BorderlessButton>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="14" Visibility="{Binding VideoInputMediaActionPresent, Converter={StaticResource ValueToVisibilityConverter}}">
      <FrameworkElement.Resources>
        <ui:SharedResourceDictionary>
          <Style x:Key="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </ui:SharedResourceDictionary>
      </FrameworkElement.Resources>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Width="22" Height="22" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="Fant" Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/WarningIcon.png" Visibility="{Binding VideoInputMediaAction.LiveVideo.IsValid, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        <livevideo:VideoInputSelector Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,5" HorizontalAlignment="Stretch" AvailableInputs="{Binding AvailableInputs}" LiveVideoInput="{Binding VideoInputMediaAction.LiveVideo.LiveVideo.Input}" OpenSetupCommand="{Binding OpenLiveVideoSetupCommand}" />
        <Button Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,5" HorizontalAlignment="Stretch" Command="{Binding ProCommon.OpenMediaInspector.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding VideoInputMediaAction, Converter={di:DIMarkup {x:Type converters:MediaInspectorConverter}}}" Content="{mex:Localized GLOBAL_INSPECTOR_BUTTON_title}" />
      </Grid>
      <TextBlock Margin="0,10,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SLIDE_INSPECTOR_VIDEO_INPUT_BEHAVIOR_title}" />
      <ComboBox Margin="0,0,0,10" SelectedItem="{Binding VideoInputMediaAction.TriggerLayer, Mode=TwoWay}">
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <media:TriggerLayer>Background</media:TriggerLayer>
            <media:TriggerLayer>Foreground</media:TriggerLayer>
            <media:TriggerLayer>Input</media:TriggerLayer>
          </CompositeCollection>
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
    </StackPanel>
  </Grid>
</UserControl>