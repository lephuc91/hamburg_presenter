<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Strokes.Strokes" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Strokes" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:stroke="clr-namespace:ProPresenter.DO.Slide.Custom.Elements.Strokes;assembly=ProPresenter.DO" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:text="clr-namespace:Pro.Text;assembly=Pro.Text" xmlns:theming="clr-namespace:ProPresenter.UI.Theming">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <ObjectDataProvider x:Key="StrokeStyles" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension Type="{x:Type stroke:StrokeStyle}" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <local:StrokeTypeToDashStyleConverter x:Key="StrokeTypeToDashStyleConverter" />
      <DataTemplate x:Key="StrokeTypeItemDataTemplate">
        <Image Width="70" Height="18">
          <Image.Source>
            <DrawingImage>
              <DrawingImage.Drawing>
                <GeometryDrawing>
                  <GeometryDrawing.Geometry>
                    <LineGeometry StartPoint="0,9" EndPoint="38,9" />
                  </GeometryDrawing.Geometry>
                  <GeometryDrawing.Pen>
                    <Pen DashCap="Flat" Thickness="1" Brush="{Binding LISTITEM_CONTENT, Source={x:Static theming:AppTheme.Active}}" DashStyle="{Binding Converter={StaticResource StrokeTypeToDashStyleConverter}}" />
                  </GeometryDrawing.Pen>
                </GeometryDrawing>
              </DrawingImage.Drawing>
            </DrawingImage>
          </Image.Source>
        </Image>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <ComboBox Grid.Row="0" Grid.Column="0" Width="60" Height="22" ItemTemplate="{StaticResource StrokeTypeItemDataTemplate}" ItemsSource="{Binding Source={StaticResource StrokeStyles}}" SelectedItem="{Binding StrokeStyle, Mode=TwoWay}" />
    <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_STROKE_STYLE_label}" />
    <commonControls:DoubleUpDown Grid.Row="0" Grid.Column="1" Width="60" Height="22" Margin="10,0,0,0" Maximum="{x:Static text:ArrangedText.MAXIMUM_STROKE_THICKNESS}" Minimum="0" Value="{Binding StrokeThickness, Mode=TwoWay}" />
    <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Center" Text="{mex:Localized EDITOR_PRESENTATION_SHAPE_INSPECTOR_STROKE_WIDTH_label}" />
    <commonControls:ColorPicker Grid.Row="0" Grid.Column="2" Width="60" Height="22" Margin="10,0,0,0" SelectedColor="{Binding StrokeColor, Mode=TwoWay}" />
  </Grid>
</UserControl>