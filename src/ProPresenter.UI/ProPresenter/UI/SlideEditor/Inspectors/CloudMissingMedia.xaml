<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.CloudMissingMedia" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:thumbnailVM="clr-namespace:ProPresenter.UI.ViewModels.Thumbnails" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <Button Margin="0,5" Command="{Binding RelinkCommand}" Content="{mex:Localized PRESENTATION_CONTEXT_MENU_LINK_MEDIA_win_title}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Button}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Visible" Binding="{Binding InvalidMediaType.Value, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Local}}" />
                <Condition Value="{x:Static media:MediaAvailability.Missing}" Binding="{Binding CloudMediaAvailability.Value}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </StackPanel>
</UserControl>