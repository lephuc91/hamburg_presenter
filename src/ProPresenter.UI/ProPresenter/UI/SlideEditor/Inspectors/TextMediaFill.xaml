<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.TextMediaFill" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cueInspector="clr-namespace:ProPresenter.UI.CueInspector" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proSSAPI="clr-namespace:Pro.ssAPI;assembly=Pro.ssAPI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="mediaFillSelf">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="pack://application:,,,/ProPresenter.UI;component/Resources/Paths/Paths.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <system1:Boolean x:Key="False" xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib">False</system1:Boolean>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Row="0" Column="0" ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" commonControls:ItemSpacingHelper.ItemSpacing="4" Orientation="Horizontal">
        <commonControls:DownloadInProgressIndicator Width="18" VerticalAlignment="Center" UseSmallRing="True" ToolTip="{mex:Localized PRESENTATION_MEDIA_ACTION_DOWNLOAD_IN_PROGRESS_tooltip}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type commonControls:DownloadInProgressIndicator}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding Media.MediaAction.FileMedia.IsRemoteMedia, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type inspectors:TextMediaFill}}}" />
                    <Condition Value="{x:Static media:MediaAvailability.Missing}" Binding="{Binding Media.MediaAction.FileMedia.Availability, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type inspectors:TextMediaFill}}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Value="{x:Static media:MediaAvailability.Downloading}" Binding="{Binding Media.MediaAction.FileMedia.Availability, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type inspectors:TextMediaFill}}}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="Collapsed" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:DownloadInProgressIndicator>
        <commonControls:Icon IconSize="Small" Source="{StaticResource {x:Static themes:Icons.Warning}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type commonControls:Icon}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="False" Binding="{Binding Media.MediaAction.IsValid, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type inspectors:TextMediaFill}}}" />
                    <Condition Value="Collapsed" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="{x:Static media:MediaAvailability.Missing}" Binding="{Binding Media.MediaAction.FileMedia.Availability, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type inspectors:TextMediaFill}}}" />
                    <Condition Value="False" Binding="{Binding Media.MediaAction.FileMedia.IsRemoteMedia, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type inspectors:TextMediaFill}}}" />
                    <Condition Value="Visible" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:Icon>
        <commonControls:Icon IconSize="Small" Source="{StaticResource {x:Static themes:Icons.MediaBin}}" />
      </StackPanel>
      <TextBlock Grid.Column="2" Margin="0,8" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding ElementName=mediaFillSelf, Path=Media.MediaAction.Media.SourceFile.Name}" />
      <commonControls:BorderlessButton Grid.Column="3" VerticalAlignment="Center" Click="ReplaceMedia_Click">
        <commonControls:ImageMask Width="14" Height="14" Margin="0,0,4,0" ImageSource="../../../Resources/Icons/GearIcon.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
      </commonControls:BorderlessButton>
      <commonControls:BorderlessButton Grid.Column="4" VerticalAlignment="Center" Command="{Binding Path=CommonInputActions.Open.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding ElementName=mediaFillSelf, Path=Media}">
        <commonControls:PathControl Width="12" Height="12" Fill="#00FFFFFF" PathType="Magnifier" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
      </commonControls:BorderlessButton>
    </Grid>
    <Button Grid.Row="1" Margin="0,0,4,0" Command="{Binding ProCommon.OpenMediaInspector.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Content="{mex:Localized GLOBAL_INSPECTOR_BUTTON_title}">
      <ButtonBase.CommandParameter>
        <MultiBinding Converter="{di:DIMarkup {x:Type converters:MediaInspectorConverter}}">
          <Binding ElementName="mediaFillSelf" Path="Media" />
          <Binding Source="{x:Static cueInspector:InspectorOptions.SupportsRetriggerBehavior}" />
        </MultiBinding>
      </ButtonBase.CommandParameter>
    </Button>
    <ComboBox Grid.Row="1" Grid.Column="1" Height="22" Margin="4,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" SelectedValue="{Binding ElementName=mediaFillSelf, Path=Media.MediaAction.VisualMedia.Drawing.ScaleBehavior}">
      <ItemsControl.ItemsSource>
        <CompositeCollection>
          <proSSAPI:ScaleBehavior>ScaleToFit</proSSAPI:ScaleBehavior>
          <proSSAPI:ScaleBehavior>ScaleToFill</proSSAPI:ScaleBehavior>
          <proSSAPI:ScaleBehavior>StretchToFill</proSSAPI:ScaleBehavior>
        </CompositeCollection>
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ContentPresenter Content="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
  </Grid>
</UserControl>