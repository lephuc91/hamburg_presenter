<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.BuildOrderInspector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:builds="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors.Builds" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverter="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonResources="clr-namespace:Pro.UI.Resources;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:do="clr-namespace:ProPresenter.DO;assembly=ProPresenter.DO" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors" xmlns:localConverters="clr-namespace:ProPresenter.UI.SlideEditor.Converters" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:settings="clr-namespace:ProPresenter.DO.Settings;assembly=ProPresenter.DO" xmlns:slideDO="clr-namespace:ProPresenter.DO.Slide;assembly=ProPresenter.DO" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:transitions="clr-namespace:ProPresenter.UI.Transitions" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="buildInspectorSelf" Focusable="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="dataContextProxy" Data="{Binding}" />
      <commonConverter:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverter:TimeSliceToDoubleSecondConverter x:Key="TimeSliceToDoubleSecondConverter" RoundDecimalPlace="1" />
      <commonConverter:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverter:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverter:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <localConverters:BuildToStartModeTextConverter x:Key="BuildToStartModeTextConverter" />
      <ObjectDataProvider x:Key="RevealTypeEnum" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="slideDO:RevealType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="{x:Static settings:Layout.EditorBuildOrderInspectorTopRowMinHeight}" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="{x:Static settings:Layout.EditorBuildOrderInspectorBottomRowMinHeight}" />
    </Grid.RowDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid Background="#00FFFFFF">
        <StackPanel Visibility="{Binding IsBuild, Converter={StaticResource ValueToVisibilityConverter}}">
          <Grid Margin="7,0" Visibility="{Binding BuildInTransition, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Null}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_BUILD_IN_title}" />
            <ToggleButton Name="AddBuildInButton" Grid.Column="1" Height="22" Content="{mex:Localized EDITOR_BUILD_ADD_BUILD_BUTTON_title}" />
          </Grid>
          <StackPanel Visibility="{Binding BuildInTransition, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Null}}">
            <transitions:InlineSelector Margin="7,0" Label="{mex:Localized EDITOR_BUILD_IN_title}" OutputController="{Binding OutputController}" SelectedTransition="{Binding BuildInTransition, Mode=TwoWay}" TransitionHandler="{Binding BuildInTransitionHandler}" />
            <StackPanel Margin="5,0,0,0" Visibility="{Binding ShowDelivery, Converter={StaticResource ValueToVisibilityConverter}}">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_BUILD_DELIVERY_label}" Visibility="{Binding EditMode, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static do:EditMode.CCLITemplate}}" />
              <Button Grid.Column="1" Height="22" Margin="7,5,7,0" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Visibility="{Binding EditMode, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static do:EditMode.CCLITemplate}}">
                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Delivery, Converter={StaticResource EnumToContentConverter}}" />
                  <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
                <FrameworkElement.ContextMenu>
                  <ContextMenu Placement="Bottom" ItemsSource="{Binding Source={StaticResource RevealTypeEnum}}">
                    <ItemsControl.ItemContainerStyle>
                      <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                        <Setter Property="MenuItem.Command" Value="{Binding Data.ChangeDeliveryCommand, Source={StaticResource dataContextProxy}}" />
                        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                        <Setter Property="Header" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
                        <Setter Property="MenuItem.IsChecked">
                          <Setter.Value>
                            <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                              <Binding />
                              <Binding Path="Data.Delivery" Source="{StaticResource dataContextProxy}" />
                            </MultiBinding>
                          </Setter.Value>
                        </Setter>
                        <Setter Property="Width" Value="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                  </ContextMenu>
                </FrameworkElement.ContextMenu>
              </Button>
              <Grid Margin="7,5,7,0" Visibility="{Binding ShowBuildFrom, Converter={StaticResource ValueToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="{mex:Localized EDITOR_BUILD_DELIVERY_FROM_title}" />
                <Button Grid.Column="1" Height="22" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Visibility="{Binding EditMode, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:EditMode.Template}}">
                  <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedTemplateBuildName}" />
                    <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  <FrameworkElement.ContextMenu>
                    <ContextMenu Placement="Bottom" ItemsSource="{Binding RevealFromIndexMenuItems}">
                      <ItemsControl.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                          <Setter Property="MenuItem.Command" Value="{Binding Command}" />
                          <Setter Property="MenuItem.CommandParameter" Value="{Binding Index}" />
                          <Setter Property="Header" Value="{Binding FormattedHeader}" />
                          <Setter Property="MenuItem.IsChecked" Value="{Binding IsChecked}" />
                          <Setter Property="Width" Value="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                </Button>
                <Button Grid.Column="1" Height="22" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Visibility="{Binding EditMode, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static do:EditMode.Template}}">
                  <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <TextBlock.Text>
                        <PriorityBinding>
                          <Binding Path="SelectedBuildFromPoint.DisplayName" />
                          <Binding Path="SelectedBuildFromPoint.Name" />
                        </PriorityBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <commonControls:PathControl Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" HorizontalAlignment="Right" PathType="DownArrow" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Grid>
                  <FrameworkElement.ContextMenu>
                    <ContextMenu Placement="Bottom" ItemsSource="{Binding BuildFromPoints}">
                      <ItemsControl.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                          <Setter Property="MenuItem.Command" Value="{Binding Data.ChangeRevealFromIndexCommand, Source={StaticResource dataContextProxy}}" />
                          <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                          <Setter Property="Header">
                            <Setter.Value>
                              <PriorityBinding>
                                <Binding Path="DisplayName" />
                                <Binding Path="Name" />
                              </PriorityBinding>
                            </Setter.Value>
                          </Setter>
                          <Setter Property="HeaderTemplate">
                            <Setter.Value>
                              <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding}" />
                              </DataTemplate>
                            </Setter.Value>
                          </Setter>
                          <Setter Property="MenuItem.IsChecked">
                            <Setter.Value>
                              <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                                <Binding />
                                <Binding Path="Data.SelectedBuildFromPoint" Source="{StaticResource dataContextProxy}" />
                              </MultiBinding>
                            </Setter.Value>
                          </Setter>
                          <Setter Property="Width" Value="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                </Button>
              </Grid>
            </StackPanel>
          </StackPanel>
          <Separator Margin="0,5" />
          <Grid Margin="7,0" Visibility="{Binding BuildOutTransition, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Null}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_BUILD_OUT_title}" />
            <ToggleButton Name="AddBuildOutButton" Grid.Column="1" Height="22" Content="{mex:Localized EDITOR_BUILD_ADD_BUILD_BUTTON_title}" />
          </Grid>
          <transitions:InlineSelector Margin="7,0" Label="{mex:Localized EDITOR_BUILD_OUT_title}" OutputController="{Binding OutputController}" SelectedTransition="{Binding BuildOutTransition, Mode=TwoWay}" TransitionHandler="{Binding BuildOutTransitionHandler}" Visibility="{Binding BuildOutTransition, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Null}}" />
        </StackPanel>
        <transitions:InlineSelector Margin="7,0" VerticalAlignment="Top" OutputController="{Binding OutputController}" SelectedTransition="{Binding SelectedSlide.SelectedTransition, Mode=TwoWay}" TransitionHandler="{Binding SlideTransitionHandler}" Visibility="{Binding IsBuild, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
      </Grid>
    </ScrollViewer>
    <GridSplitter Grid.Row="1" Height="{x:Static commonResources:LayoutConstants.GridSplitterThickness}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding IsBuild, Converter={StaticResource ValueToVisibilityConverter}}" />
    <Grid Row="2" Visibility="{Binding IsBuild, Converter={StaticResource ValueToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{mex:Localized EDITOR_BUILD_ORDER_label}" />
      <builds:BuildGroupList Grid.Row="1" />
      <Separator Grid.Row="2" Margin="0,5" />
      <Grid Row="3" VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Button Height="22" Padding="5,0" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" IsEnabled="{Binding AnySelectedBuilds}">
          <FrameworkElement.ContextMenu>
            <ContextMenu Placement="Bottom" ItemsSource="{Binding Data.AvailableStartMode, Source={StaticResource dataContextProxy}}">
              <ItemsControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                  <Setter Property="MenuItem.Command" Value="{Binding Data.SelectStartModeCommand, Source={StaticResource dataContextProxy}}" />
                  <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                  <Setter Property="MenuItem.IsChecked">
                    <Setter.Value>
                      <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                        <Binding />
                        <Binding Path="Data.Start" Source="{StaticResource dataContextProxy}" />
                      </MultiBinding>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource BuildToStartModeTextConverter}">
                        <Binding Path="Data.SelectedBuilds" Source="{StaticResource dataContextProxy}" />
                        <Binding Path="Data.BuildIndexMap" Source="{StaticResource dataContextProxy}" />
                        <Binding />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ContextMenu>
          </FrameworkElement.ContextMenu>
          <Grid>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource BuildToStartModeTextConverter}">
                  <Binding Path="SelectedBuilds" />
                  <Binding Path="BuildIndexMap" />
                  <Binding Path="Start" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <commonControls:PathControl Width="8" Margin="2,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" PathType="DownArrow" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
          </Grid>
        </Button>
        <commonControls:DoubleUpDown Grid.Column="2" FormatString="F1" Increment=".1" Minimum="0" IsEnabled="{Binding AnySelectedBuilds}" Value="{Binding Delay, Converter={StaticResource TimeSliceToDoubleSecondConverter}, Mode=TwoWay}" />
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" Text="{mex:Localized EDITOR_BUILD_START_TYPE_label}" />
        <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" Text="{mex:Localized EDITOR_BUILD_DELAY_label}" />
      </Grid>
    </Grid>
    <commonControls:AnchoredPopup Name="BuildInTransitionPopup" HorizontalAlignment="Center" AllowsTransparency="True" Placement="Top" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=AddBuildInButton}" PlacementTarget="{Binding ElementName=AddBuildInButton}">
      <Border Padding="0,0,5,5" Effect="{StaticResource ControlDropShadowEffect}">
        <transitions:ExtendedSelector OutputController="{Binding Data.OutputController, Source={StaticResource dataContextProxy}}" TransitionHandler="{Binding Data.BuildInTransitionHandler, Source={StaticResource dataContextProxy}}" />
      </Border>
    </commonControls:AnchoredPopup>
    <commonControls:AnchoredPopup Name="BuilOutTransitionPopup" HorizontalAlignment="Center" AllowsTransparency="True" Placement="Top" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=AddBuildOutButton}" PlacementTarget="{Binding ElementName=AddBuildOutButton}">
      <Border Padding="0,0,5,5" Effect="{StaticResource ControlDropShadowEffect}">
        <transitions:ExtendedSelector OutputController="{Binding Data.OutputController, Source={StaticResource dataContextProxy}}" TransitionHandler="{Binding Data.BuildOutTransitionHandler, Source={StaticResource dataContextProxy}}" />
      </Border>
    </commonControls:AnchoredPopup>
  </Grid>
</UserControl>