<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.Inspectors.Gradient" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="gradientSelf" xmlns:inspectors="clr-namespace:ProPresenter.UI.SlideEditor.Inspectors;assembly=ProPresenter.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <commonControls:ColorPicker Grid.Column="1" Margin="0,0,0,7" HorizontalAlignment="Left" SelectedColor="{Binding StartColor, ElementName=gradientSelf, Mode=TwoWay}" />
    <commonControls:BorderlessButton Grid.Column="2" Width="22" Height="22" Margin="3.5,0,3.5,7" HorizontalAlignment="Center" Command="{Binding SwapColorsCommand, ElementName=gradientSelf}">
      <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/Inspector Assets/Gradient/Swapicon.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </commonControls:BorderlessButton>
    <commonControls:ColorPicker Grid.Column="3" Margin="0,0,0,7" HorizontalAlignment="Right" SelectedColor="{Binding EndColor, ElementName=gradientSelf, Mode=TwoWay}" />
    <commonControls:RotatorUpDownPicker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" Angle="{Binding Angle, ElementName=gradientSelf, Mode=TwoWay}" />
    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,0,18,7" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Text="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_GRADIENT_ANGLE_CONTROL_title}" />
    <CheckBox Grid.Row="3" Grid.ColumnSpan="4" HorizontalAlignment="Right" Content="{mex:Localized EDITOR_PRESENTATION_TEXT_INSPECTOR_GRADIENT_STRETCH_TO_DOCUMENT_label}" IsChecked="{Binding StretchToDocumentBounds, ElementName=gradientSelf, Mode=TwoWay}" />
  </Grid>
</UserControl>