<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.SlideElementItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" x:Name="self" xmlns:slideeditor="clr-namespace:ProPresenter.UI.SlideEditor;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <Style x:Key="HiddenButtonStyle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Grid Background="#00FFFFFF">
                <commonControls:PathControl Width="18" Height="18" PathType="Eye" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="False" Binding="{Binding IsHidden}" />
              <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
          <DataTrigger Value="True" Binding="{Binding IsHidden}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate>
                  <Grid Background="#00FFFFFF">
                    <commonControls:PathControl Width="18" Height="18" PathType="EyeDisabled" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="LockedButtonStyle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="False" Binding="{Binding IsLocked}" />
              <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
          <DataTrigger Value="True" Binding="{Binding IsLocked}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="LockedTemplate">
        <Grid Background="#00FFFFFF">
          <Rectangle Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Rectangle}">
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding IsLocked}">
                    <Setter Property="UIElement.OpacityMask">
                      <Setter.Value>
                        <ImageBrush ImageSource="/ProPresenter.UI;component/Resources/Icons/Inspector Assets/Shape/Lock/unlock.png" />
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding IsLocked}">
                    <Setter Property="UIElement.OpacityMask">
                      <Setter.Value>
                        <ImageBrush ImageSource="/ProPresenter.UI;component/Resources/Icons/Inspector Assets/Shape/Lock/lock.png" />
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Rectangle>
        </Grid>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Height="30" Background="#00FFFFFF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="30" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image Margin="0,3" RenderTransformOrigin="0.5 0.5" Source="{Binding PreviewImage, ElementName=self}">
      <UIElement.RenderTransform>
        <RotateTransform Angle="{Binding PreviewImageAngle, ElementName=self}" />
      </UIElement.RenderTransform>
    </Image>
    <TextBlock Margin="0,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" Text="T" Visibility="{Binding IsTextShape, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}}" />
    <commonControls:EditableTextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <ToggleButton Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource HiddenButtonStyle}" IsChecked="{Binding IsHidden, Mode=TwoWay}" />
      <ToggleButton Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource LockedButtonStyle}" Template="{StaticResource LockedTemplate}" IsChecked="{Binding IsLocked, Mode=TwoWay}" />
    </StackPanel>
  </Grid>
</UserControl>