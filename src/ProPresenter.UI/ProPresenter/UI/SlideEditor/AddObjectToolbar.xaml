          <Border Grid.Column="15" Margin="5,0,5,0" VerticalAlignment="Center" Style="{StaticResource {x:Static themes:Styles.ToolBarSeparator}}" />
          <commonControls:ToolBarToggleButton Grid.Column="16" Margin="0,0,5,0" utility:ContextMenuHelper.OpenOnLeftClick="True" ToolTip="{mex:Localized TOOLBAR_EDITOR_MORE_tooltip}">
            <Grid>
              <commonControls:Icon HorizontalAlignment="Center" VerticalAlignment="Center" IconSize="Medium" Source="{StaticResource {x:Static themes:Icons.EditorToolbarEllipsis}}" />
              <commonControls:Icon Margin="0,0,-15,2" HorizontalAlignment="Right" VerticalAlignment="Center" IconSize="XXSmall" Source="{StaticResource {x:Static themes:Icons.DownArrow}}" />
            </Grid>
            <FrameworkElement.ContextMenu>
              <ContextMenu Placement="Bottom">
                <MenuItem CommandParameter="{StaticResource Toolbar}" Command="{Binding AddChordChartElementCommand}" Header="{mex:Localized EDITOR_MENU_INSERT_CHORD_CHART_title}" />
                <MenuItem CommandParameter="{StaticResource Toolbar}" Command="{Binding AddMessageCommand}" Header="{mex:Localized EDITOR_MENU_INSERT_STAGE_MESSAGE_title}" />
                <MenuItem CommandParameter="{StaticResource Toolbar}" Command="{Binding AddPCOLiveElementCommand}" Header="{mex:Localized EDITOR_MENU_INSERT_PLANNING_CENTER_LIVE_title}" />
                <Separator />
                <commonControls:RoutedMenuItem CommandParameter="{StaticResource Toolbar}" Command="{Binding EditorMenu.InsertTimecode.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
                <MenuItem Header="{mex:Localized TEXT_LINK_GROUP_NAME_title}">
                  <MenuItem Command="{Binding AddGroupElementCommand}" Header="{mex:Localized TEXT_LINK_GROUP_NAME_CURRENT_SLIDE_title}">
                    <MenuItem.CommandParameter>
                      <MultiBinding Converter="{StaticResource AddElementCommandParametersConverter}">
                        <Binding Source="{x:Static links:GroupSourceType.CurrentSlide}" />
                        <Binding Source="{StaticResource Toolbar}" />
                      </MultiBinding>
                    </MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Command="{Binding AddGroupElementCommand}" Header="{mex:Localized TEXT_LINK_GROUP_NAME_NEXT_SLIDE_title}">
                    <MenuItem.CommandParameter>
                      <MultiBinding Converter="{StaticResource AddElementCommandParametersConverter}">
                        <Binding Source="{x:Static links:GroupSourceType.NextSlide}" />
                        <Binding Source="{StaticResource Toolbar}" />
                      </MultiBinding>
                    </MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Command="{Binding AddGroupElementCommand}" Header="{mex:Localized TEXT_LINK_GROUP_NAME_NEXT_GROUP_title}">
                    <MenuItem.CommandParameter>
                      <MultiBinding Converter="{StaticResource AddElementCommandParametersConverter}">
                        <Binding Source="{x:Static links:GroupSourceType.NextGroup}" />
                        <Binding Source="{StaticResource Toolbar}" />
                      </MultiBinding>
                    </MenuItem.CommandParameter>
                  </MenuItem>
                </MenuItem>
                <MenuItem Header="{mex:Localized EDITOR_MENU_INSERT_SLIDE_LABEL_title}">
                  <MenuItem Command="{Binding AddSlideLabelElementCommand}" Header="{mex:Localized TEXT_LINK_SLIDE_LABEL_CURRENT_SLIDE_title}">
                    <MenuItem.CommandParameter>
                      <MultiBinding Converter="{StaticResource AddElementCommandParametersConverter}">
                        <Binding Source="{x:Static links:SlideTargetSourceMode.Current}" />
                        <Binding Source="{StaticResource Toolbar}" />
                      </MultiBinding>
                    </MenuItem.CommandParameter>
                  </MenuItem>
                  <MenuItem Command="{Binding AddSlideLabelElementCommand}" Header="{mex:Localized TEXT_LINK_SLIDE_LABEL_NEXT_SLIDE_title}">
                    <MenuItem.CommandParameter>
                      <MultiBinding Converter="{StaticResource AddElementCommandParametersConverter}">
                        <Binding Source="{x:Static links:SlideTargetSourceMode.Next}" />
                        <Binding Source="{StaticResource Toolbar}" />
                      </MultiBinding>
                    </MenuItem.CommandParameter>
                  </MenuItem>
                </MenuItem>
                <MenuItem CommandParameter="{StaticResource Toolbar}" Command="{Binding AddCaptureStatusElementCommand}" Header="{mex:Localized EDITOR_MENU_INSERT_CAPTURE_STATUS_title}" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </commonControls:ToolBarToggleButton>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>