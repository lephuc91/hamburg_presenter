<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlideEditor.OverlayEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonResources="clr-namespace:Pro.UI.Resources;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:slideeditor="clr-namespace:ProPresenter.UI.SlideEditor">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Visibility="{Binding Show, Converter={StaticResource ValueToVisibilityConverter}}">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="400" MinHeight="100" />
    </Grid.RowDefinitions>
    <GridSplitter Grid.Row="1" Height="{x:Static commonResources:LayoutConstants.GridSplitterThickness}" HorizontalAlignment="Stretch" />
    <Grid Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
        <TextBlock MaxWidth="300" Margin="7" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <TextBlock Margin="7" Text="{mex:Localized EDITOR_PRESENTATION_LINE_TRANSFORM_SCALE_label}" />
          <commonControls:FillSlider Width="150" Margin="7" VerticalAlignment="Center" IsMoveToPointEnabled="True" Maximum="1" Minimum="0.1" Value="{Binding ZoomFactor}" />
          <Button Margin="7" Padding="10,0" Command="{Binding DoneCommand}" Content="{mex:Localized GLOBAL_DONE}" />
        </StackPanel>
      </Grid>
      <Grid Row="1" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <commonControls:FormattedTextBox Name="textBox" VerticalAlignment="Top" AutoSizeHeight="True" CanTransform="False" ClipToBounds="True" ActiveRunSettings="{Binding ActiveRunSettings, Mode=OneWayToSource}" CaretIndex="{Binding CaretIndex, Mode=OneWayToSource}" Document="{Binding Text}" SelectionRanges="{Binding SelectionRanges, Mode=OneWayToSource}" ZoomLevel="{Binding ZoomFactor}" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>