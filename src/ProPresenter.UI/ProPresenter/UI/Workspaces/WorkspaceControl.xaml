<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Workspaces.WorkspaceControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.Workspaces" xmlns:workspaces="clr-namespace:ProPresenter.UI.Workspaces" x:Name="workspaceControl" DataContext="{di:DIMarkup {x:Type viewModels:IWorkspacesVM}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ui:InterfaceItemContainerTemplateSelector x:Key="WorkspaceTemplateSelector" />
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <utility:BindingProxy x:Key="proxy" Data="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type workspaces:WorkspaceControl}}}" />
      <utility:BindingProxy x:Key="dependencyProperties" Data="{Binding ElementName=workspaceControl}" />
      <Style x:Key="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <controls:BorderlessDropDownButton>
    <controls:BorderlessDropDownButton.CustomContent>
      <TextBlock Margin="0,0,5,0" Text="{Binding SelectedWorkspace.Name}" />
    </controls:BorderlessDropDownButton.CustomContent>
    <controls:BorderlessDropDownButton.CustomContextMenu>
      <ContextMenu ItemContainerTemplateSelector="{StaticResource WorkspaceTemplateSelector}" Placement="Bottom" UsesItemContainerTemplate="True" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <CollectionContainer Collection="{Binding Data.Workspaces, Source={StaticResource proxy}}" />
            <Separator Visibility="{Binding Data.ShowExtraMenuItems, Source={StaticResource dependencyProperties}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <MenuItem Command="{Binding ManageWorkspacesCommand}" Header="{markupExtensions:Localized LOCALWORKSPACE_MANAGER_WORKSPACES_MENU_ITEM_title}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="{DataTemplateKey {x:Type viewModels:IWorkspaceItemVM}}" DataType="{x:Type viewModels:IWorkspaceItemVM}">
              <MenuItem Command="{Binding Data.SelectWorkspaceCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}" Header="{Binding Name}">
                <HeaderedItemsControl.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" />
                  </DataTemplate>
                </HeaderedItemsControl.HeaderTemplate>
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding />
                    <Binding Path="Data.SelectedWorkspace" Source="{StaticResource proxy}" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
            </DataTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ContextMenu>
    </controls:BorderlessDropDownButton.CustomContextMenu>
  </controls:BorderlessDropDownButton>
</UserControl>