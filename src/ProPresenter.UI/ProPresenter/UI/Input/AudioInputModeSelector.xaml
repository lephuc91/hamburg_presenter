<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Input.AudioInputModeSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:audio="clr-namespace:ProPresenter.DO.Audio;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.Input" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="self">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="selfProxy" Data="{Binding ElementName=self}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" IsCollapsing="False" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <local:IsLiveVideoInputLinkedConverter x:Key="IsLiveVideoInputLinkedConverter" Data="{Binding Data.LinkedVideoInputs, Source={StaticResource selfProxy}}" />
      <Style x:Key="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid HorizontalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <UniformGrid Columns="4">
      <RadioButton BorderThickness="0" Content="{mex:Localized INPUT_PREFERENCES_AUDIO_MODE_OFF_label}" IsChecked="{Binding BehaviorMode, ElementName=self, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static audio:BehaviorMode.Off}}" />
      <RadioButton BorderThickness="1,0,0,0" Content="{mex:Localized INPUT_PREFERENCES_AUDIO_MODE_ON_label}" IsChecked="{Binding BehaviorMode, ElementName=self, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static audio:BehaviorMode.On}}" />
      <RadioButton BorderThickness="1,0,0,0" Content="{mex:Localized SETTINGS_INPUTS_AUDIO_MODE_AUTO_OFF_label}" IsChecked="{Binding BehaviorMode, ElementName=self, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static audio:BehaviorMode.AutoOff}}" />
      <RadioButton BorderThickness="1,0,0,0" Content="{mex:Localized SETTINGS_INPUTS_AUDIO_MODE_AUTO_ON_label}" IsChecked="{Binding BehaviorMode, ElementName=self, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static audio:BehaviorMode.AutoOn}}" />
    </UniformGrid>
    <ToggleButton Name="optionsButton" Grid.Column="1" Height="22" Margin="15,0,0,0" Padding="10,0" Content="{mex:Localized AUDIO_INPUT_ACTION_POPOVER_OPTIONS_BUTTON_title}" Visibility="{Binding BehaviorMode, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static audio:BehaviorMode.AutoOn}}" />
    <commonControls:AnchoredPopup Name="linkedVideoInputsPopup" HorizontalAlignment="Center" Placement="Bottom" IsOpen="{Binding IsChecked, Mode=OneWay, ElementName=optionsButton}" PlacementTarget="{Binding ElementName=optionsButton}" VerticalOffset="{Binding VerticalOffset, ElementName=self}" Closed="OnLinkedVideoInputsPopupClosed" Opened="OnLinkedVideoInputsPopupOpened">
      <Border Width="200" Height="300" BorderThickness="1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
          <StackPanel Orientation="Vertical">
            <TextBlock Margin="10,4,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Medium" Text="{mex:Localized INPUT_PREFERENCES_AUDIO_MODE_OPTIONS_POPUP_label}" />
            <Separator Margin="0,2" />
            <ItemsControl FocusVisualStyle="{x:Null}" ItemsSource="{Binding Data.VideoInputs, Source={StaticResource selfProxy}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Vertical">
                    <Grid Height="24">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding Data.ToggleLinkedVideoInputCommand, Source={StaticResource selfProxy}}" CommandParameter="{Binding}" IsChecked="{Binding Converter={StaticResource IsLiveVideoInputLinkedConverter}, Mode=OneWay}" />
                      <TextBlock Grid.Column="1" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding LongName}" />
                    </Grid>
                    <Separator Margin="0,2" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </commonControls:AnchoredPopup>
  </Grid>
</UserControl>