<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Capture.CapturePresetSelectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:capture="clr-namespace:ProPresenter.UI.Capture" xmlns:captureDO="clr-namespace:ProPresenter.DO.Capture;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <commonControls:DropDownButton>
    <commonControls:DropDownButton.CustomContent>
      <Grid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Binding Data.ActivePreset.Name, Source={StaticResource proxy}}" />
              <Style.Triggers>
                <DataTrigger Value="False" Binding="{Binding Data.ExistingPresetSelected, Source={StaticResource proxy}}">
                  <Setter Property="Text" Value="{mex:Localized RECORDING_WINDOW_NO_PRESET_label}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </Grid>
    </commonControls:DropDownButton.CustomContent>
    <commonControls:DropDownButton.CustomContextMenu>
      <ContextMenu Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem Command="{Binding Data.NoPresetCommand, Source={StaticResource proxy}}" Header="{mex:Localized RECORDING_WINDOW_NO_PRESET_label}" IsChecked="{Binding ExistingPresetSelected, Converter={StaticResource InvertedBooleanConverter}, Mode=OneWay}" />
            <Separator Visibility="{Binding AnyPresets, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <CollectionContainer Collection="{Binding Data.Presets, Source={StaticResource proxy}}" />
            <Separator />
            <MenuItem Command="{Binding Data.SaveAsPresetCommand, Source={StaticResource proxy}}" Header="{mex:Localized GLOBAL_SAVE_AS_title}" />
            <MenuItem Command="{Binding Data.RenamePresetCommand, Source={StaticResource proxy}}" Header="{mex:Localized RECORDING_WINDOW_RENAME_PRESET_MENU_ITEM_title}" Visibility="{Binding ExistingPresetSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <MenuItem Command="{Binding Data.DeletePresetCommand, Source={StaticResource proxy}}" Header="{mex:Localized GLOBAL_DELETE_title}" Visibility="{Binding ExistingPresetSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type captureDO:CapturePreset}}">
              <MenuItem Command="{Binding Data.SelectPresetCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}" Header="{Binding Name}">
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding Path="Data.ActivePreset.ID" Source="{StaticResource proxy}" />
                    <Binding Path="ID" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ContextMenu>
    </commonControls:DropDownButton.CustomContextMenu>
  </commonControls:DropDownButton>
</UserControl>