<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Capture.ResiEventDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:icons="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Capture" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" MaxHeight="280" uiUtility:WindowHelper.ChildOf="MainWindow" CanClose="False" CanMaximize="False" CanMinimize="False" SizeToContent="Width" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" Title="{mex:Localized RECORDING_RESI_BEGIN_STREAM_EVENT_WINDOW_title}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Width="140" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static icons:Icons.ResiBrandLogo}}" Stretch="Uniform" />
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,5,0" HorizontalAlignment="Right" Text="{mex:Localized RESI_EVENT_NAME_title}" />
    <commonControls:PlaceholderTextBox Grid.Row="1" Grid.Column="1" Width="240" Height="22" FocusOnVisible="True" MaxLength="128" Background="{Binding TEXTBOX_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" PlaceholderText="{mex:Localized RESI_EVENT_OPTIONAL_NAME_title}" Text="{Binding Name, Mode=TwoWay}" />
    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,5,0" HorizontalAlignment="Right" Text="{mex:Localized RESI_SOCIAL_DESCRIPTION_title}" />
    <commonControls:PlaceholderTextBox Grid.Row="2" Grid.Column="1" Width="240" Height="55" Margin="0,8,0,0" AcceptsReturn="True" MaxLength="256" MinLines="3" TextContentVerticalAlignment="Top" TextWrapping="Wrap" Background="{Binding TEXTBOX_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" PlaceholderText="{mex:Localized RESI_SOCIAL_DESCRIPTION_OPTIONAL_NAME_title}" Text="{Binding Description, Mode=TwoWay}" />
    <Grid Row="3" Column="0" ColumnSpan="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Height="22" MinWidth="140" HorizontalAlignment="Center" Command="{Binding CancelStreamCommand}" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      <Button Grid.Column="1" Height="22" MinWidth="140" HorizontalAlignment="Center" IsDefault="True" Command="{Binding StartStreamCommand}" Content="{Binding StreamButtonContent}" />
    </Grid>
  </Grid>
</windowing:ChromedWindow>