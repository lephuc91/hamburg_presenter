<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Capture.CaptureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:behaviors="clr-namespace:Pro.UI.Behaviors;assembly=Pro.UI" xmlns:capture="clr-namespace:ProPresenter.UI.Capture" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:outputDO="clr-namespace:ProPresenter.DO.OutputConfiguration;assembly=ProPresenter.DO" xmlns:recordingDO="clr-namespace:ProPresenter.DO.Capture;assembly=ProPresenter.DO" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Width="525" MinHeight="290" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.SendKeyEventsToMainWindow="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanClose="True" CanMaximize="False" CanMinimize="False" RenderOptions.BitmapScalingMode="Fant" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" Title="{mex:Localized RECORDING_WINDOW_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="recordingVMProxy" Data="{Binding}" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="22" />
      </Style>
      <Style x:Key="{x:Type commonControls:DropDownButton}" TargetType="{x:Type commonControls:DropDownButton}">
        <Setter Property="Height" Value="22" />
      </Style>
      <Style x:Key="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="22" />
      </Style>
      <ContextMenu x:Key="ScreensMenu" Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="HeaderMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="MenuItem.IsCheckable" Value="False" />
              <Setter Property="IsEnabled" Value="False" />
            </Style>
            <CollectionViewSource x:Key="AudienceScreenCollection" Source="{Binding Data.AudienceScreens, Source={StaticResource recordingVMProxy}}" />
            <CollectionViewSource x:Key="StageScreenCollection" Source="{Binding Data.StageScreens, Source={StaticResource recordingVMProxy}}" />
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type outputDO:ScreenArrangementBase}}">
              <MenuItem Command="{Binding Data.SelectScreenCommand, Source={StaticResource recordingVMProxy}}" CommandParameter="{Binding}">
                <HeaderedItemsControl.HeaderTemplate>
                  <DataTemplate>
                    <Grid>
                      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" Visibility="{Binding SupportsHdr, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
                      <StackPanel Orientation="Horizontal" Visibility="{Binding SupportsHdr, Converter={StaticResource ValueToVisibilityConverter}}">
                        <Image Width="14" Height="14" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="Fant" Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/WarningIcon.png" />
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
                        <TextBlock Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontStyle="Italic" Text="{mex:Localized RECORDING_WINDOW_HDR_CAPTURE_NOT_AVAILABLE_label}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </HeaderedItemsControl.HeaderTemplate>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="MenuItem.IsChecked">
                      <Setter.Value>
                        <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                          <Binding Path="DataContext.ID" RelativeSource="{RelativeSource Self}" />
                          <Binding Path="Data.ScreenID" Source="{StaticResource recordingVMProxy}" />
                        </MultiBinding>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </FrameworkElement.Style>
              </MenuItem>
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem Style="{StaticResource HeaderMenuItemStyle}" Header="{mex:Localized GLOBAL_AUDIENCE_title}" />
            <CollectionContainer Collection="{Binding Source={StaticResource AudienceScreenCollection}}" />
            <MenuItem Style="{StaticResource HeaderMenuItemStyle}" Header="{mex:Localized GLOBAL_STAGE_title}" />
            <CollectionContainer Collection="{Binding Source={StaticResource StageScreenCollection}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="20,20,20,0" HorizontalAlignment="Stretch" IsSharedSizeScope="True">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLive}">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="0,0,0,5" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition SharedSizeGroup="CaptureLabelColumn" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized RECORDING_WINDOW_PRESET_label}" />
        <capture:CapturePresetSelectionControl Grid.Column="1" Height="22" DataContext="{Binding PresetVM}" />
      </Grid>
      <Separator Grid.Row="1" Margin="0,0,0,5" />
      <Grid Row="2" Margin="0,0,0,5" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition SharedSizeGroup="CaptureLabelColumn" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized RECORDING_WINDOW_SOURCE_label}" />
        <commonControls:DropDownButton Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" CustomContextMenu="{StaticResource ScreensMenu}">
          <commonControls:DropDownButton.CustomContent>
            <Grid>
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding ScreenName}" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding Data.SelectedScreenSupportsHdr, Source={StaticResource recordingVMProxy}, Converter={StaticResource ValueToVisibilityConverter}}">
                <Image Width="14" Height="14" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="Fant" Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/WarningIcon.png" />
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding ScreenName}" />
                <TextBlock Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontStyle="Italic" Text="{mex:Localized RECORDING_WINDOW_HDR_CAPTURE_NOT_AVAILABLE_label}" />
              </StackPanel>
            </Grid>
          </commonControls:DropDownButton.CustomContent>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </commonControls:DropDownButton>
      </Grid>
      <Grid Row="3" Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition SharedSizeGroup="CaptureLabelColumn" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{mex:Localized RECORDING_WINDOW_DESTINATION_label}" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Destinations}">
          <behaviors1:Interaction.Behaviors xmlns:behaviors1="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
            <behaviors:CommandableComboboxBehaviour ChangeItemCommand="{Binding ChangeDestinationCommand}" SelectedItem="{Binding Destination}" />
          </behaviors1:Interaction.Behaviors>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Margin="0" HorizontalAlignment="Left" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
      </Grid>
      <Separator Grid.Row="4" Margin="0,0,0,5" />
      <Border Grid.Row="5" Visibility="{Binding Destination, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static recordingDO:DestinationType.Disk}}">
        <capture:DiskCapture DataContext="{Binding DiskVM}" />
      </Border>
      <Border Grid.Row="5" Visibility="{Binding Destination, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static recordingDO:DestinationType.RTMP}}">
        <capture:RtmpCapture DataContext="{Binding RtmpVM}" />
      </Border>
      <Border Grid.Row="5" Visibility="{Binding Destination, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static recordingDO:DestinationType.Resi}}">
        <capture:ResiCapture DataContext="{Binding ResiVM}" />
      </Border>
    </Grid>
    <Separator Grid.Row="1" Margin="0,0,0,5" />
    <Button Grid.Row="2" MinWidth="200" Margin="0,5,0,10" Padding="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsDefault="True" Content="{Binding StartStopButtonLabel}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
          <Setter Property="Command" Value="{Binding StartCaptureCommand}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsLive}">
              <Setter Property="Command" Value="{Binding StopCaptureCommand}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </Grid>
</windowing:ChromedWindow>