<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Capture.ResiUploadStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverter="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Title="ResiUploadStatusWindow" MaxWidth="470" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" ShowInTaskbar="False" ShowTitle="False" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" xmlns:capture="clr-namespace:ProPresenter.UI.Capture;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverter:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverter:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverter:EnumToContentConverter x:Key="EnumToContentConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="60" Height="60" Margin="0,0,10,0" VerticalAlignment="Center" Source="{StaticResource {x:Static themesUI:Icons.AppIcon}}" Stretch="Uniform" />
    <Grid Row="0" Column="1">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{mex:Localized RESI_FILE_UPLOAD_ALERT_UPLOADING_FILES_title}" />
      <ProgressBar Grid.Row="1" Width="362" Height="20" Maximum="1" Value="{Binding UploadInfo.Progress, Mode=OneWay}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type ProgressBar}}" TargetType="{x:Type ProgressBar}">
            <Setter Property="ProgressBar.IsIndeterminate" Value="False" />
            <Style.Triggers>
              <DataTrigger Value="-1" Binding="{Binding UploadInfo.Progress}">
                <Setter Property="ProgressBar.IsIndeterminate" Value="True" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </ProgressBar>
      <TextBlock Grid.Row="2" Grid.Column="1">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} of {1}">
            <Binding Path="UploadInfo.Current" />
            <Binding Path="UploadInfo.TotalFiles" />
          </MultiBinding>
        </TextBlock.Text>
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="-1" Binding="{Binding UploadInfo.Progress}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
    </Grid>
    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
      <Button Height="22" MinWidth="80" Margin="10,0,0,0" Padding="4,0" Command="{Binding AbortUploadCommand}" Content="{mex:Localized RESI_FILE_UPLOAD_ALERT_UPLOADING_FILES_ABORT_BUTTON_title}" />
    </StackPanel>
  </Grid>
</windowing:ChromedWindow>