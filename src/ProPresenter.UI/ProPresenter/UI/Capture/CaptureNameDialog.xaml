<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Capture.CaptureNameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Title="CaptureNameDialog" Height="110" VerticalAlignment="Top" CanClose="False" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" ShowInTaskbar="False" ShowTitlebar="False" SizeToContent="Width" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:capture="clr-namespace:ProPresenter.UI.Capture;assembly=ProPresenter.UI">
  <Grid Margin="20" VerticalAlignment="Top">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox Name="PresetTextBox" Grid.Row="0" Width="250" Height="22" VerticalContentAlignment="Center" Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
      <Button MinWidth="100" Margin="0,0,6,0" IsCancel="True" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" />
      <Button MinWidth="100" Margin="6,0,0,0" IsDefault="True" Command="{Binding SetPresetNameCommand}" Content="{mex:Localized GLOBAL_OK_BUTTON_title}" />
    </StackPanel>
  </Grid>
</windowing:ChromedWindow>