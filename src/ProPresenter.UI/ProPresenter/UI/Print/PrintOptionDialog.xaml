<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Print.PrintOptionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="self" Height="240" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.SendKeyEventsToMainWindow="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Width" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:print="clr-namespace:ProPresenter.UI.Print;assembly=ProPresenter.UI" Title="{mex:Localized PRINT_OPTIONS_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="OutlineViewCheckboxStyle" BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="10,7,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding PrintOptions.IsOutline, ElementName=self}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="OptionCheckboxStyle" BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="10,7,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="PrintSettingsButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="Padding" Value="10,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition MinWidth="150" />
        <ColumnDefinition MinWidth="150" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Row="0" Margin="0,5,0,0" Orientation="Vertical">
        <RadioButton Name="ThumbnailViewButton" Margin="10,0,0,0" Content="{mex:Localized PRINT_OPTIONS_THUMBNAIL_VIEW_title}" IsChecked="{Binding PrintOptions.IsThumbnail, ElementName=self}" />
        <RadioButton Name="OutlineViewButton" Margin="10,5,0,0" Content="{mex:Localized PRINT_OPTIONS_OUTLINE_VIEW_title}" IsChecked="{Binding PrintOptions.IsOutline, ElementName=self}" />
      </StackPanel>
      <CheckBox Grid.Row="1" Grid.Column="0" Style="{StaticResource OptionCheckboxStyle}" Content="{mex:Localized PRINT_OPTIONS_PRESENTATION_INFORMATION_title}" IsChecked="{Binding PrintOptions.ShowMetaData, ElementName=self}" />
      <CheckBox Grid.Row="2" Grid.Column="0" Style="{StaticResource OptionCheckboxStyle}" Content="{mex:Localized PRINT_OPTIONS_PRESENTATION_NOTES_title}" IsChecked="{Binding PrintOptions.ShowNotes, ElementName=self}" />
      <CheckBox Grid.Row="3" Grid.Column="0" Style="{StaticResource OptionCheckboxStyle}" Content="{mex:Localized PRINT_OPTIONS_PRESENTATION_CURRENT_DATE_title}" IsChecked="{Binding PrintOptions.ShowCurrentDate, ElementName=self}" />
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding ElementName=OutlineViewButton, Path=IsChecked}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <ComboBox Width="50" Height="22" SelectedValue="{Binding PrintOptions.PrintColumns, ElementName=self}">
          <ItemsControl.Items>
            <system1:Int32 xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib">1</system1:Int32>
            <Int32 xmlns="clr-namespace:System;assembly=System.Private.CoreLib">2</Int32>
            <Int32 xmlns="clr-namespace:System;assembly=System.Private.CoreLib">3</Int32>
            <Int32 xmlns="clr-namespace:System;assembly=System.Private.CoreLib">4</Int32>
            <Int32 xmlns="clr-namespace:System;assembly=System.Private.CoreLib">5</Int32>
          </ItemsControl.Items>
        </ComboBox>
        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{mex:Localized PRINT_OPTIONS_COLUMNS_label}" />
      </StackPanel>
      <CheckBox Grid.Row="1" Grid.Column="1" Style="{StaticResource OutlineViewCheckboxStyle}" Content="{mex:Localized PRINT_OPTIONS_SLIDE_NUMBERS_title}" IsChecked="{Binding PrintOptions.ShowSlideNumbers, ElementName=self}" />
      <CheckBox Grid.Row="2" Grid.Column="1" Style="{StaticResource OutlineViewCheckboxStyle}" Content="{mex:Localized PRINT_OPTIONS_SLIDE_LABELS_title}" IsChecked="{Binding PrintOptions.ShowSlideLabels, ElementName=self}" />
      <CheckBox Grid.Row="3" Grid.Column="1" Style="{StaticResource OutlineViewCheckboxStyle}" Content="{mex:Localized PRINT_OPTIONS_SLIDE_NOTES_title}" IsChecked="{Binding PrintOptions.ShowSlideNotes, ElementName=self}" />
      <CheckBox Grid.Row="4" Grid.Column="1" Margin="10,5,0,5" Style="{StaticResource OutlineViewCheckboxStyle}" Content="{mex:Localized PRINT_OPTIONS_DISABLED_SLIDE_title}" IsChecked="{Binding PrintOptions.DisableSlides, ElementName=self}" />
    </Grid>
    <Grid Row="2" Margin="0,0,0,10" VerticalAlignment="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Button Name="SettingButton" Grid.Column="0" Style="{StaticResource PrintSettingsButtonStyle}" Command="{Binding OpenPrintSettingCommand, ElementName=self}" Content="{mex:Localized PRINT_OPTIONS_PRINT_BUTTON_title}" />
      <Button Name="PreviewButton" Grid.Column="1" Style="{StaticResource PrintSettingsButtonStyle}" Command="{Binding OpenPreviewCommand, ElementName=self}" Content="{mex:Localized PRINT_OPTIONS_PREVIEW_BUTTON_title}" />
      <Button Name="DoneButton" Grid.Column="2" IsDefault="True" Style="{StaticResource PrintSettingsButtonStyle}" Content="{mex:Localized GLOBAL_DONE}" Click="DoneButton_Click" />
    </Grid>
  </Grid>
</windowing:ChromedWindow>