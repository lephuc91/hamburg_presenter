                  <MultiDataTrigger.Conditions>
                    <Condition Value="PCO" Binding="{Binding Type}" />
                    <Condition Value="Header" Binding="{Binding PCOItemType}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource HeaderContextMenu}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="PCO" Binding="{Binding Type}" />
                    <Condition Value="MediaLinked" Binding="{Binding PCOAction.LinkedObjectType}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource MediaContextMenu}" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </local:CueListBox>
        <commonControls:BorderlessButton Grid.Row="2" HorizontalAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Resources="{commonConverters:FormattedLocalizedStringConverter Key=FormattedLocalizedStringConverter}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
              <Setter Property="Content" Value="{Binding HiddenCueCollectionView.Count, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=LIBRARY_PLAYLIST_ITEMS_HIDDEN_ITEMS_BUTTON_PLURAL_title}" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="0" Binding="{Binding HiddenCueCollectionView.Count}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="1" Binding="{Binding HiddenCueCollectionView.Count}">
                  <Setter Property="Content" Value="{Binding HiddenCueCollectionView.Count, Converter={StaticResource FormattedLocalizedStringConverter}, ConverterParameter=LIBRARY_PLAYLIST_ITEMS_HIDDEN_ITEMS_BUTTON_title}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <FrameworkElement.ContextMenu>
            <ContextMenu>
              <MenuItem UsesItemContainerTemplate="True" Header="{mex:Localized LIBRARY_PLAYLIST_ITEMS_HIDDEN_ITEMS_BUTTON_CONTEXTUAL_MENU_UNHIDE_ITEM_title}" ItemsSource="{Binding Data.HiddenCueCollectionView, Source={StaticResource proxy}}">
                <MenuItem.ItemContainerTemplateSelector>
                  <ui1:InterfaceItemContainerTemplateSelector />
                </MenuItem.ItemContainerTemplateSelector>
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <DataTemplate x:Key="{DataTemplateKey {x:Type cueVms:IProPresenterCueVM}}" DataType="{x:Type cueVms:IProPresenterCueVM}">
                      <MenuItem Command="{Binding Data.ShowItemCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}" Header="{Binding Name}">
                        <MenuItem.Icon>
                          <Image Style="{StaticResource CueIconStyle}" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </DataTemplate>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </MenuItem>
              <MenuItem Command="{Binding Data.UnhideAllItemsCommand, Source={StaticResource proxy}}" Header="{mex:Localized LIBRARY_PLAYLIST_ITEMS_HIDDEN_ITEMS_BUTTON_CONTEXTUAL_MENU_UNHIDE_ALL_ITEMS_title}" />
            </ContextMenu>
          </FrameworkElement.ContextMenu>
        </commonControls:BorderlessButton>
        <commonControls:FilterBox Grid.Row="3" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" PlaceholderText="{mex:Localized GLOBAL_FILTER_FIELD_placeholder}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
    </Grid>
    <Grid Row="1" Height="22" VerticalAlignment="Top" Background="#00FFFFFF" PreviewMouseDown="Grid_PreviewMouseDown">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource HeaderGridStyle}" TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding LibraryCollapsed, Source={x:Static settings:Layout.Settings}}">
              <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Column="0" Margin="8,0,0,0" HorizontalAlignment="Left" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Background="#00FFFFFF" Visibility="{Binding LibraryCollapsed, Source={x:Static settings:Layout.Settings}, Converter={StaticResource ValueToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="10*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FrameworkElement.ContextMenu>
          <ContextMenu ItemsSource="{StaticResource LibraryPlaylistCollection}" Placement="Bottom" UsesItemContainerTemplate="True" Opened="ContextMenu_Opened">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ui1:SharedResourceDictionary Source="../LibraryPlaylistResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style x:Key="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                  <Style.Triggers>
                    <Trigger Property="MenuItem.IsChecked" Value="True">
                      <Setter Property="IsEnabled" Value="False" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
                <DataTemplate x:Key="{DataTemplateKey {x:Type librarian:ILibrary}}" DataType="{x:Type librarian:ILibrary}">
                  <MenuItem Command="{Binding Data.SelectLibraryCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}">
                    <HeaderedItemsControl.Header>
                      <StackPanel Margin="8,0,0,0" Orientation="Horizontal">
                        <Image Width="18" Height="18" RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.Library}}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Text="{Binding Name}" />
                      </StackPanel>
                    </HeaderedItemsControl.Header>
                    <MenuItem.IsChecked>
                      <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                        <Binding />
                        <Binding Path="Data.ActiveLibrary" Source="{StaticResource proxy}" />
                      </MultiBinding>
                    </MenuItem.IsChecked>
                  </MenuItem>
                </DataTemplate>
                <DataTemplate x:Key="{DataTemplateKey {x:Type playlist:GeneralPlaylist}}" DataType="{x:Type playlist:GeneralPlaylist}">
                  <MenuItem Command="{Binding Data.SelectPlaylistCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}">
                    <HeaderedItemsControl.Header>
                      <StackPanel Orientation="Horizontal" Margin="{Binding Converter={StaticResource PlaylistMarginConverter}}">
                        <ContentPresenter Content="{DynamicResource PlaylistIcon}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Text="{Binding Name}" />
                      </StackPanel>
                    </HeaderedItemsControl.Header>
                    <MenuItem.IsChecked>
                      <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                        <Binding />
                        <Binding Path="Data.ActivePlaylist" Source="{StaticResource proxy}" />
                      </MultiBinding>
                    </MenuItem.IsChecked>
                  </MenuItem>
                </DataTemplate>
                <DataTemplate x:Key="{DataTemplateKey {x:Type playlist:PCOPlaylist}}" DataType="{x:Type playlist:PCOPlaylist}">
                  <MenuItem Command="{Binding Data.SelectPlaylistCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}">
                    <HeaderedItemsControl.Header>
                      <StackPanel Orientation="Horizontal" Margin="{Binding Converter={StaticResource PlaylistMarginConverter}}">
                        <ContentPresenter Content="{DynamicResource PlaylistIcon}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Text="{Binding Name}" />
                      </StackPanel>
                    </HeaderedItemsControl.Header>
                    <MenuItem.IsChecked>
                      <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                        <Binding />
                        <Binding Path="Data.ActivePlaylist" Source="{StaticResource proxy}" />
                      </MultiBinding>
                    </MenuItem.IsChecked>
                  </MenuItem>
                </DataTemplate>
                <DataTemplate x:Key="{DataTemplateKey {x:Type playlist:GeneralGroupPlaylist}}" DataType="{x:Type playlist:GeneralGroupPlaylist}">
                  <MenuItem IsEnabled="False">
                    <HeaderedItemsControl.Header>
                      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Margin="{Binding Converter={StaticResource PlaylistMarginConverter}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Text="{Binding Name}" />
                    </HeaderedItemsControl.Header>
                  </MenuItem>
                </DataTemplate>
                <DataTemplate x:Key="{DataTemplateKey {x:Type TextBlock}}" DataType="{x:Type TextBlock}">
                  <MenuItem FontWeight="Bold" IsEnabled="False" Header="{Binding Text}" />
                </DataTemplate>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <MenuBase.ItemContainerTemplateSelector>
              <ui1:InterfaceItemContainerTemplateSelector />
            </MenuBase.ItemContainerTemplateSelector>
          </ContextMenu>
        </FrameworkElement.ContextMenu>
        <commonControls:Icon Grid.Column="0" Source="{Binding ActiveItemType, Converter={commonConverters:SelectedLibraryIconConverter}}" />
        <commonControls:EditableTextBlock Name="ActiveItemTb" Grid.Column="1" VerticalAlignment="Center" ClickToEdit="False" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource Self}}" Text="{Binding ActiveItemName, Mode=TwoWay}" />
        <commonControls:PathControl Grid.Column="2" Width="12" Height="12" Margin="8,0,0,0" HorizontalAlignment="Left" PathType="DownArrow" Fill="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource AncestorType=Grid}}" Stroke="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource AncestorType=Grid}}" />
      </Grid>
      <Grid Column="1" Margin="0,0,8,0" HorizontalAlignment="Right">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <commonControls:BorderlessPathButton Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Focusable="False" PathType="Plus">
          <FrameworkElement.ContextMenu>
            <ContextMenu Focusable="False" Placement="Bottom">
              <MenuItem Command="{Binding Data.NewLibraryCommand, Source={StaticResource proxy}}" Header="{mex:Localized LIBRARY_PLAYLIST_OUTLINE_NEW_MENU_NEW_LIBRARY_title}" Click="OnNewLibraryClick">
                <MenuItem.Icon>
                  <Image RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.Library}}" />
                </MenuItem.Icon>
              </MenuItem>
              <commonControls:RoutedMenuItem Command="{Binding FileMenu.NewPresentation.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized LIBRARY_PLAYLIST_OUTLINE_NEW_MENU_NEW_PRESENTATION_title}" Click="OnNewPresentationClick">
                <MenuItem.Icon>
                  <Image RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.PresentationIcon}}" />
                </MenuItem.Icon>
              </commonControls:RoutedMenuItem>
              <Separator />
              <MenuItem Command="{Binding Data.NewPlaylistCommand, Source={StaticResource proxy}}" Header="{mex:Localized PLAYLIST_GLOBAL_ADD_PLAYLIST_MENU_ITEM_title}" Click="OnNewGeneralPlaylistClick">
                <MenuItem.Icon>
                  <Image RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.LibraryPlaylist}}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem UsesItemContainerTemplate="True" Header="{mex:Localized LIBRARY_PLAYLIST_CREATE_PLAYLIST_FROM_TEMPLATE_title}" Click="OnNewPlaylistFromTemplateClick">
                <MenuItem.Icon>
                  <Image RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.LibraryPlaylist}}" />
                </MenuItem.Icon>
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type playlist:GeneralPlaylist}}">
                      <MenuItem Command="{Binding Data.AddPlaylistFromTemplateCommand, Source={StaticResource proxy}}" CommandParameter="{Binding}" Header="{Binding Name}">
                        <MenuItem.Icon>
                          <Image RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.LibraryPlaylist}}" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ItemContainerTemplate>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <ItemsControl.ItemsSource>
                  <CompositeCollection>
                    <CollectionContainer Collection="{Binding Data.PlaylistTemplatesVM.Templates, Source={StaticResource proxy}}" />
                    <Separator />
                    <MenuItem Command="{Binding Data.PlaylistTemplatesVM.EditTemplatesCommand, Source={StaticResource proxy}}" Header="{mex:Localized LIBRARY_PLAYLIST_EDIT_PLAYLIST_TEMPLATES_title}" />
                  </CompositeCollection>
                </ItemsControl.ItemsSource>
              </MenuItem>
              <MenuItem Command="{Binding Data.NewGroupFolderCommand, Source={StaticResource proxy}}" Header="{mex:Localized LIBRARY_PLAYLIST_OUTLINE_NEW_MENU_NEW_PLAYLIST_FOLDER_title}" Click="OnNewGroupPlaylistClick">
                <MenuItem.Icon>
                  <Image RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.PlaylistFolder}}" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <commonControls:RoutedMenuItem Command="{Binding ProCommon.NewPCOPlaylist.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Visibility="{Binding ShowPCOPlaylistAddMenu, Converter={StaticResource ValueToVisibilityConverter}}" Click="OnNewPCOPlaylistClick">
                <MenuItem.Icon>
                  <Image RenderOptions.BitmapScalingMode="Fant" Source="{StaticResource {x:Static themes:Icons.PCOPlaylist}}" />
                </MenuItem.Icon>
              </commonControls:RoutedMenuItem>
            </ContextMenu>
          </FrameworkElement.ContextMenu>
        </commonControls:BorderlessPathButton>
        <commonControls:ExpanderToggleButton Grid.Column="1" HorizontalAlignment="Right" CollapsedPathType="VDownArrow" ExpandedPathType="VUpArrow" ShouldFill="False" IsChecked="{Binding LibraryCollapsed, Source={x:Static settings:Layout.Settings}, Mode=TwoWay, Converter={StaticResource InvertedBooleanConverter}}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>