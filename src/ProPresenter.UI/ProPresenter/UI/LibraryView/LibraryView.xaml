                            <Style.Triggers>
                              <DataTrigger Value="1" Binding="{Binding Data.SelectedLibraries.Count, Source={StaticResource proxy}}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </MenuItem>
                      <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" />
                    </ContextMenu>
                  </Setter.Value>
                </Setter>
                <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding SOURCELISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
