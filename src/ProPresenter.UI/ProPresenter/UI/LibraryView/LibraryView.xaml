        </MenuItem>
        <MenuItem Command="{Binding Data.PlaylistTemplatesVM.SaveAsTemplateCommand, Source={StaticResource proxy}}" CommandParameter="{Binding Data.ActivePlaylist, Source={StaticResource proxy}}" Header="{mex:Localized LIBRARY_PLAYLIST_CREATE_PLAYLIST_TEMPLATE_title}" Visibility="{Binding Data.ActivePlaylist.Type, ConverterParameter={x:Static playlist:PlaylistType.Group}, Converter={StaticResource InvertedValueToVisibilityConverter}, Source={StaticResource proxy}}" />
