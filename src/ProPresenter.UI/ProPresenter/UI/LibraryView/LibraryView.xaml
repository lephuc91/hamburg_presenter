        <MenuItem uiUtility:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" Command="{Binding FileMenu.ExportPlaylist.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding Data.ActivePlaylist, Source={StaticResource proxy}}" Header="{mex:Localized EXPORT_BUTTON_title}" />
        <MenuItem uiUtility:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" Command="{Binding FileMenu.Print.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding Data.ActivePlaylist, Source={StaticResource proxy}}" Visibility="{Binding Data.ActivePlaylist.Type, ConverterParameter={x:Static playlist:PlaylistType.Group}, Converter={StaticResource InvertedValueToVisibilityConverter}, Source={StaticResource proxy}}" />
        <Separator />
