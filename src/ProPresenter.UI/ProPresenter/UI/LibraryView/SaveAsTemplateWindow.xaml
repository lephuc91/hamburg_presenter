<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.LibraryView.SaveAsTemplateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="saveAsTemplateWindow" Width="300" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:libraryview="clr-namespace:ProPresenter.UI.LibraryView;assembly=ProPresenter.UI" Title="{mex:Localized LIBRARY_PLAYLIST_CREATE_PLAYLIST_TEMPLATE_DIALOG_title}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Right" Text="{mex:Localized LIBRARY_PLAYLIST_CREATE_PLAYLIST_TEMPLATE_DIALOG_SAVE_AS_label}" />
      <TextBox Name="templateName" Grid.Column="1" Height="22" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" PreviewKeyDown="TemplateName_PreviewKeyDown" />
    </Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Height="22" MinWidth="60" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" Click="Cancel_Click" />
      <Button Height="22" MinWidth="60" HorizontalAlignment="Right" VerticalAlignment="Center" IsDefault="True" Content="{mex:Localized GLOBAL_SAVE}" Click="Save_Click">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
              <DataTrigger xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib" Value="{x:Static system1:String.Empty}" Binding="{Binding Text, ElementName=templateName}">
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Button>
    </StackPanel>
  </Grid>
</windowing:ChromedWindow>