<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Templates.TemplateSlideMenuItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" x:Name="self" Margin="0,3" xmlns:templates="clr-namespace:ProPresenter.UI.Templates">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ui:SlidePreview Grid.Column="0" Width="107" Height="60" IncludeTextPlaceholder="True" RenderTransparencyCheckerboard="True" PrimaryCheckerboardBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" SecondaryCheckerboardBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" Source="{Binding Slide}" />
    <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, ElementName=self}" Text="{Binding Name}" />
  </Grid>
</UserControl>