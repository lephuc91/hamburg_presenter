<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Templates.FolderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Templates" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="folderView">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:InvertedBooleanConverter x:Key="InvertedBoolConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,4,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="8,0,0,4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="{Binding ElementName=folderView, Path=ShowRecents, Converter={StaticResource ValueToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Row="0" Visibility="{Binding RecentThemes.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="6,8,0,8" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource {x:Static themes:Brushes.ControlForegroundSubdued}}" Text="{mex:Localized THEMES_POPOVER_RECENTS_title}" />
            <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" ItemsSource="{Binding RecentThemes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <local:ThemeThumbnail FocusVisualStyle="{x:Null}" IsMediaActionEnabled="{Binding ElementName=folderView, Path=IsMediaActionEnabled}" SelectThemeCommand="{Binding ElementName=folderView, Path=SelectThemeCommand}" SelectedTemplateSlide="{Binding ElementName=folderView, Path=SelectedTemplate}" ShowThemeNotificationIndicator="{Binding HasThemeDetailsBeenAcknowledgedByUser, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}" Theme="{Binding}">
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <utility:BindingProxy x:Key="DeleteCommandProxy" Data="{Binding ElementName=folderView, Path=DeleteThemeCommand}" />
                        <utility:BindingProxy x:Key="EnableContextMenuOptionProxy" Data="{Binding ElementName=folderView, Path=EnableContextMenuOptions}" />
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                    <FrameworkElement.ContextMenu>
                      <ContextMenu Visibility="{Binding Data, Source={StaticResource EnableContextMenuOptionProxy}, Converter={StaticResource ValueToVisibilityConverter}}">
                        <MenuItem Command="{Binding Data, Source={StaticResource DeleteCommandProxy}}" CommandParameter="{Binding}" Header="{mex:Localized THEMES_MENU_REMOVE_THEME_title}" />
                      </ContextMenu>
                    </FrameworkElement.ContextMenu>
                  </local:ThemeThumbnail>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <Separator Grid.Row="1" Visibility="{Binding RecentThemes.Count, Converter={StaticResource CountToVisibilityConverter}}" />
        </Grid>
        <local:ThemeList Grid.Row="1" DeleteThemeCommand="{Binding ElementName=folderView, Path=DeleteThemeCommand}" EnableContextMenuOptions="{Binding ElementName=folderView, Path=EnableContextMenuOptions}" FocusVisualStyle="{x:Null}" IsMediaActionEnabled="{Binding ElementName=folderView, Path=IsMediaActionEnabled}" SelectThemeCommand="{Binding ElementName=folderView, Path=SelectThemeCommand}" SelectedTemplate="{Binding ElementName=folderView, Path=SelectedTemplate}" Themes="{Binding ElementName=folderView, Path=Themes}" />
        <Separator Grid.Row="2" Margin="8,0" Visibility="{Binding ElementName=folderView, Path=SubFolders.Count, Converter={StaticResource CountToVisibilityConverter}}" />
        <ItemsControl Grid.Row="3" Margin="0,8" ItemsSource="{Binding ElementName=folderView, Path=SubFolders}" Visibility="{Binding ElementName=folderView, Path=SubFolders.Count, Converter={StaticResource CountToVisibilityConverter}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:FolderMenuButton Grid.Row="0" Height="22" Margin="8,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="#00FFFFFF" Command="{Binding ElementName=folderView, Path=SelectThemeFolderCommand}" CommandParameter="{Binding}" Content="{Binding Name}" Foreground="{Binding ONPRIMARY, Source={x:Static theming:AppTheme.Active}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>