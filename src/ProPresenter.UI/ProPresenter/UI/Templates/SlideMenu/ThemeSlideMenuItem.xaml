<?xml version="1.0" encoding="utf-8"?>
<MenuItem x:Class="ProPresenter.UI.Templates.SlideMenu.ThemeSlideMenuItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:ProPresenter.UI.Commands" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.Templates" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:slideMenu="clr-namespace:ProPresenter.UI.Templates.SlideMenu" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:themes="clr-namespace:ProPresenter.UI.Themes" xmlns:themesDO="clr-namespace:ProPresenter.DO.Themes;assembly=ProPresenter.DO" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiUtitlity="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.Themes" x:Name="themeSlideMenuItem" Style="{StaticResource {x:Type MenuItem}}" UsesItemContainerTemplate="True" DataContext="{di:DIMarkup {x:Type viewModels:IThemeSlideMenuVM}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_THEMES_title}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../Themes/Controls/Template/ThemeSlidePreview.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="themeSlideMenuItemProxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type slideMenu:ThemeSlideMenuItem}}}" />
      <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
      <commonConverters:CountToBoolConverter x:Key="CountToBoolConverter" Value="0" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <system1:Double x:Key="ThemeThumbnailMinHeight" xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib">56</system1:Double>
      <Double x:Key="ThemeThumbnailMinWidth" xmlns="clr-namespace:System;assembly=System.Private.CoreLib">97</Double>
      <system1:Boolean x:Key="TrueKey" xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib">True</system1:Boolean>
      <DataTemplate x:Key="ThemeContainerDataTemplate" DataType="{x:Type themesDO:ThemeContainer}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <commonControls:LoadingIndicator Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" DisplayMode="Spinner" Visibility="{Binding ElementName=ThumbnailControl, Path=HasThumbnail, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          <local:ThemeThumbnail x:Name="ThumbnailControl" Grid.Column="0" ShowMouseHoverPreview="False" Style="{StaticResource {x:Static themes:Styles.ThemeSlidePreview}}" IsMediaActionEnabled="{Binding Data.DataContext.MediaActionEnabled, Source={StaticResource themeSlideMenuItemProxy}}" Theme="{Binding Theme}" />
          <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Theme.Name}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ThemeDataTemplate" DataType="{x:Type themesDO:Theme}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <commonControls:LoadingIndicator Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" DisplayMode="Spinner" Visibility="{Binding ElementName=ThemeCollectionThumbnailControl, Path=HasThumbnail, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          <local:ThemeThumbnail x:Name="ThemeCollectionThumbnailControl" ShowMouseHoverPreview="False" MinWidth="{StaticResource ThemeThumbnailMinWidth}" MinHeight="{StaticResource ThemeThumbnailMinHeight}" Style="{StaticResource {x:Static themes:Styles.ThemeSlidePreview}}" IsMediaActionEnabled="{Binding Data.DataContext.MediaActionEnabled, Source={StaticResource themeSlideMenuItemProxy}}" Theme="{Binding}" />
          <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="TemplateSlideDataTemplate" DataType="{x:Type themesDO:TemplateSlide}">
        <Grid MinHeight="{StaticResource ThemeThumbnailMinHeight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <commonControls:LoadingIndicator Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" DisplayMode="Spinner" Visibility="{Binding ElementName=ThemeSlideThumbnailControl, Path=HasThumbnail, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
          <local:ThemeSlideThumbnail x:Name="ThemeSlideThumbnailControl" Grid.Column="0" Style="{StaticResource {x:Static themes:Styles.ThemeSlidePreview}}" IsMediaActionEnabled="{Binding Data.DataContext.MediaActionEnabled, Source={StaticResource themeSlideMenuItemProxy}}" TemplateSlide="{Binding}" />
          <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
        </Grid>
      </DataTemplate>
      <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type themesDO:ThemeContainer}}">
        <MenuItem UsesItemContainerTemplate="True" Header="{Binding}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <commonUtility:BindingProxy x:Key="themeContainerProxy" Data="{Binding}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
              <Setter Property="HeaderTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Theme}" Value="{x:Null}" />
                    <Condition Value="True" Binding="{Binding Children, Converter={StaticResource CountToBoolConverter}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="ItemsSource">
                    <Setter.Value>
                      <CompositeCollection>
                        <CollectionContainer Collection="{Binding Data, Source={StaticResource themeContainerProxy}, Converter={slideMenu:ThemeContainerToChildrenConverter}}" />
                        <Separator />
                        <CollectionContainer Collection="{Binding Data, Source={StaticResource themeContainerProxy}, Converter={slideMenu:ThemeContainerToChildrenConverter}, ConverterParameter={StaticResource TrueKey}}" />
                      </CompositeCollection>
                    </Setter.Value>
                  </Setter>
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding Theme, Converter={StaticResource IsNotNullToBoolConverter}}" />
                    <Condition Value="False" Binding="{Binding Children, Converter={StaticResource CountToBoolConverter}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="HeaderTemplate" Value="{StaticResource ThemeContainerDataTemplate}" />
                  <Setter Property="ItemsSource">
                    <Setter.Value>
                      <CompositeCollection>
                        <CollectionContainer Collection="{Binding Data.Theme, Source={StaticResource themeContainerProxy}}" />
                        <Separator />
                        <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.EditTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding Data.Theme, Source={StaticResource themeContainerProxy}}" />
                        <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.AddSelectionToTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding Data.Theme, Source={StaticResource themeContainerProxy}}" />
                      </CompositeCollection>
                    </Setter.Value>
                  </Setter>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </MenuItem>
      </ItemContainerTemplate>
      <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type themesDO:Theme}}">
        <MenuItem UsesItemContainerTemplate="True" HeaderTemplate="{StaticResource ThemeDataTemplate}" Header="{Binding}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <commonUtility:BindingProxy x:Key="themeContainerProxy" Data="{Binding}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.ItemsSource>
            <CompositeCollection>
              <CollectionContainer Collection="{Binding Data, Source={StaticResource themeContainerProxy}}" />
              <Separator />
              <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.EditTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding Data, Source={StaticResource themeContainerProxy}}" />
              <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.AddSelectionToTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding Data, Source={StaticResource themeContainerProxy}}" />
            </CompositeCollection>
          </ItemsControl.ItemsSource>
        </MenuItem>
      </ItemContainerTemplate>
      <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type themesDO:TemplateSlide}}">
        <MenuItem HeaderTemplate="{StaticResource TemplateSlideDataTemplate}" Command="{Binding Data.SelectTemplateCommand, Source={StaticResource themeSlideMenuItemProxy}}" CommandParameter="{Binding}" Header="{Binding}" />
      </ItemContainerTemplate>
      <CompositeCollection x:Key="WithThemes">
        <MenuItem IsEnabled="False" Header="{mex:Localized THEMES_MENU_RECENTS_title}" Visibility="{Binding Data.RecentThemes.Count, Source={StaticResource themeSlideMenuItemProxy}, Converter={StaticResource CountToVisibilityConverter}}" />
        <CollectionContainer Collection="{Binding Data.RecentThemes, Source={StaticResource themeSlideMenuItemProxy}}" />
        <Separator Margin="0,4" Visibility="{Binding Data.RecentThemes.Count, Source={StaticResource themeSlideMenuItemProxy}, Converter={StaticResource CountToVisibilityConverter}}" />
        <CollectionContainer Collection="{Binding Data.Themes, Source={StaticResource themeSlideMenuItemProxy}}" />
        <Separator Margin="0,4" Visibility="{Binding Data.Themes.Count, Source={StaticResource themeSlideMenuItemProxy}, Converter={StaticResource CountToVisibilityConverter}}" />
        <CollectionContainer Collection="{Binding Data.SubFolders, Source={StaticResource themeSlideMenuItemProxy}}" />
        <Separator Margin="0,4" Visibility="{Binding Data.SubFolders.Count, Source={StaticResource themeSlideMenuItemProxy}, Converter={StaticResource CountToVisibilityConverter}}" />
        <MenuItem>
          <HeaderedItemsControl.Header>
            <CheckBox Content="{mex:Localized THEMES_MENU_APPLY_MEDIA_ACTION_title}" IsChecked="{Binding MediaActionEnabled, Mode=TwoWay}" />
          </HeaderedItemsControl.Header>
        </MenuItem>
        <Separator Margin="0,4" />
        <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.NewTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Visibility="{Binding Data.CanAddNewTheme, Source={StaticResource themeSlideMenuItemProxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
        <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.AddSelectionToNewTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      </CompositeCollection>
      <CompositeCollection x:Key="NoThemes">
        <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.NewTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
        <MenuItem uiUtitlity:CommandTargets.Assign="{x:Static commands:CommandTargetType.MainWindow}" uiUtitlity:CommandTargets.Default="False" Command="{Binding ProCommon.AddSelectionToNewTheme.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
      </CompositeCollection>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
</MenuItem>