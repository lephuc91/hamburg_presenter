<?xml version="1.0" encoding="utf-8"?>
<commonControls:BorderlessButton x:Class="ProPresenter.UI.Templates.TemplateButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.Templates" xmlns:proUI="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:themes="clr-namespace:ProPresenter.UI.Themes" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="templateButton" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" PreviewMouseDown="TemplateButton_PreviewMouseDown">
  <FrameworkElement.Resources>
    <proUI:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <proUI:SharedResourceDictionary Source="../Themes/Controls/Template/ThemeSlidePreview.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="templateButtonSelf" Data="{Binding ElementName=templateButton}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <ControlTemplate x:Key="DefaultButtonTemplate">
        <ui:SlidePreviewSelector Width="80" Height="40" RenderTransparencyCheckerboard="True" LabelText="{Binding Data.SelectedTemplate.Name, Source={StaticResource templateButtonSelf}}" ShowLabel="{Binding Data.ShowLabel, Source={StaticResource templateButtonSelf}}" Source="{Binding Data.SelectedTemplate.Slide, Source={StaticResource templateButtonSelf}}" />
      </ControlTemplate>
      <ControlTemplate x:Key="SmallTemplate">
        <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
          <Image Width="24" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Image}">
                <Setter Property="Source" Value="../Resources/Icons/TemplateIcon.png" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Data.SelectedTemplate, Source={StaticResource templateButtonSelf}}" Value="{x:Null}">
                    <Setter Property="Source" Value="../Resources/Icons/NoneIcon.png" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Image>
        </Border>
      </ControlTemplate>
      <ControlTemplate x:Key="AddSlideTemplate">
        <commonControls:PathControl PathType="Plus" StrokeThickness="2" Width="{StaticResource {x:Static uiThemes:Constants.BorderlessPathButtonPathDefaultSize}}" Height="{StaticResource {x:Static uiThemes:Constants.BorderlessPathButtonPathDefaultSize}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
      </ControlTemplate>
      <local:ThemePicker x:Key="ThemePickerUI" CanDeleteTheme="False" AllowCreateAndEditTheme="{Binding Data.AllowCreateAndEditTheme, Source={StaticResource templateButtonSelf}}" CanRemoveSelectedTemplate="{Binding Data.ShowNoneOption, Source={StaticResource templateButtonSelf}}" ContextGroup="{Binding Data.ContextGroup, Mode=TwoWay, Source={StaticResource templateButtonSelf}}" IsMediaActionEnabled="{Binding Data.IsMediaActionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={StaticResource templateButtonSelf}}" IsOpen="{Binding Data.IsThemeUIOpen, Mode=TwoWay, Source={StaticResource templateButtonSelf}}" RemoveSelectedTemplateHeader="{Binding Data.DefaultTemplateHeader, Source={StaticResource templateButtonSelf}}" SelectTemplateCommand="{Binding Data.SelectTemplateCommand, Source={StaticResource templateButtonSelf}}" SelectedTemplate="{Binding Data.SelectedTemplate, Source={StaticResource templateButtonSelf}}" ShowMediaActionButton="{Binding Data.ShowMediaActionButton, Source={StaticResource templateButtonSelf}}" ShowOptions="{Binding Data.ShowOptions, Source={StaticResource templateButtonSelf}}" TemplateSlideTooltipText="{Binding Data.TemplateSlideTooltipText, Source={StaticResource templateButtonSelf}}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type local:ThemePicker}">
            <Style.Triggers>
              <DataTrigger Value="AddSlide" Binding="{Binding Data.TemplateButtonType, Source={StaticResource templateButtonSelf}}">
                <Setter Property="local:ThemePicker.AddNewSlideTemplate" Value="{Binding Data.DefaultTemplate, Source={StaticResource templateButtonSelf}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </local:ThemePicker>
      <ControlTemplate x:Key="ThemeUIPickerTemplate">
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <local:ThemeSlideThumbnail Style="{StaticResource {x:Static themes:Styles.ThemeSlidePreview}}" IsMediaActionEnabled="{Binding DataContext.PickerSettings.MediaActionEnabled, Source={StaticResource ThemePickerUI}}" SupportsMediaActionThumbnail="{Binding IsMediaActionEnabled, ElementName=templateButton}" TemplateSlide="{Binding Data.SelectedTemplate, Source={StaticResource templateButtonSelf}}" />
          <commonControls:PathControl Width="8" Height="8" VerticalAlignment="Center" PathType="DownArrow" Fill="{Binding Foreground, ElementName=templateButton}" Stroke="{Binding Foreground, ElementName=templateButton}" />
          <commonControls:AnchoredPopup HorizontalAlignment="Left" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" Child="{StaticResource ThemePickerUI}" IsOpen="{Binding Data.IsThemeUIOpen, Mode=TwoWay, Source={StaticResource templateButtonSelf}}" PlacementTarget="{Binding Data, Source={StaticResource templateButtonSelf}}" />
        </StackPanel>
      </ControlTemplate>
      <ControlTemplate x:Key="ThemeUIPickerSmallTemplate">
        <Grid VerticalAlignment="Center">
          <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Background="{Binding PRIMARYLIGHT, Source={x:Static theming:AppTheme.Active}}">
            <Image Width="24" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Image}">
                  <Setter Property="Source" Value="../Resources/Icons/TemplateIcon.png" />
                  <Style.Triggers>
                    <DataTrigger Value="False">
                      <DataTrigger.Binding>
                        <MultiBinding Mode="OneWay" Converter="{local:DoesTemplateSlideExistConverter}">
                          <Binding Path="Data.SelectedTemplate" Source="{StaticResource templateButtonSelf}" />
                          <Binding Path="CurrentThemeContainer" Source="{StaticResource ThemePickerUI}" />
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter Property="Source" Value="../Resources/Icons/NoneIcon.png" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Image>
          </Border>
          <commonControls:AnchoredPopup HorizontalAlignment="Left" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" Child="{StaticResource ThemePickerUI}" IsOpen="{Binding Data.IsThemeUIOpen, Mode=TwoWay, Source={StaticResource templateButtonSelf}}" PlacementTarget="{Binding Data, Source={StaticResource templateButtonSelf}}" />
        </Grid>
      </ControlTemplate>
      <ControlTemplate x:Key="ThemeUIPickerAddSlideTemplate">
        <Grid VerticalAlignment="Center">
          <Border Background="#00FFFFFF">
            <commonControls:PathControl PathType="Plus" StrokeThickness="2" Width="{StaticResource {x:Static uiThemes:Constants.BorderlessPathButtonPathDefaultSize}}" Height="{StaticResource {x:Static uiThemes:Constants.BorderlessPathButtonPathDefaultSize}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
          </Border>
          <commonControls:AnchoredPopup HorizontalAlignment="Left" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" Child="{StaticResource ThemePickerUI}" IsOpen="{Binding Data.IsThemeUIOpen, Mode=TwoWay, Source={StaticResource templateButtonSelf}}" PlacementTarget="{Binding Data, Source={StaticResource templateButtonSelf}}" />
        </Grid>
      </ControlTemplate>
    </proUI:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type local:TemplateButton}">
      <Setter Property="Template" Value="{StaticResource DefaultButtonTemplate}" />
      <Setter Property="FrameworkElement.ToolTip" Value="{Binding Data.SelectedTemplate.Name, Source={StaticResource templateButtonSelf}}" />
      <Style.Triggers>
        <DataTrigger Value="Small" Binding="{Binding Data.TemplateButtonType, Source={StaticResource templateButtonSelf}}">
          <Setter Property="Template" Value="{StaticResource SmallTemplate}" />
        </DataTrigger>
        <DataTrigger Value="AddSlide" Binding="{Binding Data.TemplateButtonType, Source={StaticResource templateButtonSelf}}">
          <Setter Property="Template" Value="{StaticResource AddSlideTemplate}" />
        </DataTrigger>
        <DataTrigger Value="Thumbnail" Binding="{Binding Data.TemplateButtonType, Source={StaticResource templateButtonSelf}}">
          <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
          <Setter Property="Template" Value="{StaticResource ThemeUIPickerTemplate}" />
        </DataTrigger>
        <DataTrigger Value="Small" Binding="{Binding Data.TemplateButtonType, Source={StaticResource templateButtonSelf}}">
          <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
          <Setter Property="Template" Value="{StaticResource ThemeUIPickerSmallTemplate}" />
        </DataTrigger>
        <DataTrigger Value="AddSlide" Binding="{Binding Data.TemplateButtonType, Source={StaticResource templateButtonSelf}}">
          <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
          <Setter Property="Template" Value="{StaticResource ThemeUIPickerAddSlideTemplate}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
</commonControls:BorderlessButton>