<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ProPresenter.UI.Resi.ResiWebStartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverter="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" MaxWidth="500" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.UseGlobalStyle="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" xmlns:resi="clr-namespace:ProPresenter.UI.Resi;assembly=ProPresenter.UI" Title="{mex:Localized RESI_CONTROL_ACTIVATE_STREAM_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverter:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverter:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverter:EnumToContentConverter x:Key="EnumToContentConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="60" Height="60" Margin="0,0,10,0" VerticalAlignment="Center" Source="{StaticResource {x:Static themesUI:Icons.AppIcon}}" Stretch="Uniform" />
    <TextBlock Grid.Row="0" Grid.Column="1" MinHeight="35" TextWrapping="WrapWithOverflow" Text="{Binding Message}" />
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
      <Button Height="22" MinWidth="80" Margin="10,0,0,0" Padding="4,0" Command="{Binding AbortCommand}" Content="{Binding AbortButtonText}" />
      <Button Height="22" MinWidth="80" Margin="10,0,0,0" Padding="4,0" IsDefault="True" Command="{Binding BeginCommand}" Content="{Binding BeginButtonText}" />
    </StackPanel>
  </Grid>
</Window>