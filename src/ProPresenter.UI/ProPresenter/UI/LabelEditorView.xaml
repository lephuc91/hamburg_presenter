<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.LabelEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Label" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Height="20" Margin="0,-6,0,0" Background="#00FFFFFF">
      <commonControls:PathControl Width="30" Height="30" HorizontalAlignment="Center" PathType="UpArrow" Fill="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" Stroke="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" />
    </Grid>
    <Border Grid.Row="1" Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <local:LabelSelector Width="300" />
        <CheckBox Grid.Row="1" Margin="0,14,0,0" Content="{Binding SaveLabel}" IsChecked="{Binding SaveToPreferences}" Visibility="{Binding CanSaveToPreferences, Converter={StaticResource ValueToVisibilityConverter}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>