<?xml version="1.0" encoding="utf-8"?>
<ContentControl x:Class="ProPresenter.UI.Playlist.PlaylistTreeViewItemContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:playlist="clr-namespace:ProPresenter.DO.Playlists;assembly=ProPresenter.DO" xmlns:proUIThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:playlist1="clr-namespace:ProPresenter.UI.Playlist;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Image}">
          <Style.Triggers>
            <DataTrigger Value="{x:Type playlist:VisualPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Margin" Value="4" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.MediaBinPlaylist}}" />
              <Setter Property="Width" Value="14" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:AudioPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Height" Value="20" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.AudioPlaylist}}" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:SmartPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Margin" Value="4" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.MediaBinSmartPlaylist}}" />
              <Setter Property="Width" Value="14" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:GeneralPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Height" Value="20" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.LibraryPlaylist}}" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:PCOPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Height" Value="20" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.PCOPlaylist}}" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:GeneralGroupPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Height" Value="20" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.PlaylistFolder}}" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:AudioGroupPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Height" Value="20" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.PlaylistFolder}}" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:VisualGroupPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Margin" Value="4" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.MediaBinFolder}}" />
              <Setter Property="Width" Value="14" />
            </DataTrigger>
            <DataTrigger Value="{x:Type playlist:LiveVideoPlaylist}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
              <Setter Property="Margin" Value="4" />
              <Setter Property="Source" Value="{StaticResource {x:Static proUIThemes:Icons.MediaBinVideoInputPlaylist}}" />
              <Setter Property="Width" Value="14" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Image>
    <commonControls:EditableTextBlock Name="PlaylistNameTextBlock" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <commonControls:BorderlessButton Grid.Column="2" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ViewMenu.Calendar.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" CommandParameter="{Binding}">
      <commonControls:ImageMask Width="16" Height="16" ImageSource="../Resources/Icons/Outline/Playlist/Calendar.png" Fill="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="Custom" Binding="{Binding Type}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Value="PCO" Binding="{Binding Type}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Custom" Binding="{Binding Type}" />
                <Condition Value="0" Binding="{Binding Events.Count}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="PCO" Binding="{Binding Type}" />
                <Condition Value="0" Binding="{Binding Events.Count}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </commonControls:BorderlessButton>
  </Grid>
</ContentControl>