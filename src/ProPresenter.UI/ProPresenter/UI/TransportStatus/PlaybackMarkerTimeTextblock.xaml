<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TransportStatus.PlaybackMarkerTimeTextblock" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="this" xmlns:transportstatus="clr-namespace:ProPresenter.UI.TransportStatus;assembly=ProPresenter.UI">
  <Grid Background="#00FFFFFF">
    <TextBlock FontSize="{Binding FontSize, ElementName=this}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="Text" Value="{Binding PrimaryText, ElementName=this}" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding DisplayAltText, ElementName=this}" />
                <Condition Value="True" Binding="{Binding CanUseAlt, ElementName=this}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Foreground" Value="{Binding AltFill, ElementName=this}" />
              <Setter Property="Text" Value="{Binding AltText, ElementName=this}" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
  </Grid>
</UserControl>