<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.TransportStatus.TransportStatusControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.TransportStatus" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="transportStatus" Background="{Binding OUTLINEDETAIL, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:TimeSliceToStringConverter x:Key="TimeSliceToStringConverter" DisplayMilliseconds="False" />
      <commonConverters:ValueToVisibilityConverter x:Key="HideValueToVisibilityConverter" IsCollapsing="False" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <Style x:Key="TransportButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding CLEARBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="27" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" BorderThickness="0,0,0,1" Background="{Binding OUTLINEDETAILHEADER, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" RenderOptions.BitmapScalingMode="Fant">
        <commonControls:BorderlessRadioToggleButton uiUtility:UIElementHelper.Palette="{Binding TRANSPORTCONTROLBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" IsChecked="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:TransportStatusView.Presentation}, Mode=TwoWay}" ToolTip="{mex:Localized TRANSPORT_PRESENTATION_TAB_tooltip}">
          <commonControls:ImageMask ImageSource="../Resources/Icons/ClearLayer/clearButtonPresentationForeground.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessRadioToggleButton}}" />
        </commonControls:BorderlessRadioToggleButton>
        <commonControls:BorderlessRadioToggleButton Margin="10,0" uiUtility:UIElementHelper.Palette="{Binding TRANSPORTCONTROLBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" IsChecked="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:TransportStatusView.Announcement}, Mode=TwoWay}" ToolTip="{mex:Localized TRANSPORT_ANNOUNCEMENTS_TAB_tooltip}">
          <commonControls:ImageMask ImageSource="../Resources/Icons/ClearLayer/clearButtonAnnouncements.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessRadioToggleButton}}" />
        </commonControls:BorderlessRadioToggleButton>
        <commonControls:BorderlessRadioToggleButton uiUtility:UIElementHelper.Palette="{Binding TRANSPORTCONTROLBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" IsChecked="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:TransportStatusView.Audio}, Mode=TwoWay}" ToolTip="{mex:Localized TRANSPORT_AUDIO_TAB_tooltip}">
          <commonControls:ImageMask ImageSource="../Resources/Icons/ClearLayer/clearButtonAudio.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessRadioToggleButton}}" />
        </commonControls:BorderlessRadioToggleButton>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="Presentation" Binding="{Binding View}">
              <Setter Property="Text" Value="{Binding PresentationStatusVM.MediaName}" />
            </DataTrigger>
            <DataTrigger Value="Announcement" Binding="{Binding View}">
              <Setter Property="Text" Value="{Binding AnnouncementStatusVM.MediaName}" />
            </DataTrigger>
            <DataTrigger Value="Audio" Binding="{Binding View}">
              <Setter Property="Text" Value="{Binding AudioStatusVM.MediaName}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <local:PlaybackControl IsVisibleChanged="PlaybackControl_IsVisibleChanged" Grid.Row="2" DataContext="{Binding PresentationStatusVM}" Visibility="{Binding DataContext.View, ElementName=transportStatus, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static local:TransportStatusView.Presentation}}" />
    <local:PlaybackControl IsVisibleChanged="PlaybackControl_IsVisibleChanged" Grid.Row="2" DataContext="{Binding AnnouncementStatusVM}" Visibility="{Binding DataContext.View, ElementName=transportStatus, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static local:TransportStatusView.Announcement}}" />
    <local:PlaybackControl IsVisibleChanged="PlaybackControl_IsVisibleChanged" Grid.Row="2" DataContext="{Binding AudioStatusVM}" Visibility="{Binding DataContext.View, ElementName=transportStatus, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static local:TransportStatusView.Audio}}" />
    <Grid Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Margin="8,0" HorizontalContentAlignment="Left" Command="{Binding CancelGotoNextCommand}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource TransportButtonStyle}" TargetType="{x:Type Button}">
            <Style.Triggers>
              <DataTrigger Value="Presentation" Binding="{Binding View}">
                <Setter Property="Visibility" Value="{Binding PresentationStatusVM.WillAutoAdvance, Converter={StaticResource HideValueToVisibilityConverter}}" />
              </DataTrigger>
              <DataTrigger Value="Announcement" Binding="{Binding View}">
                <Setter Property="Visibility" Value="{Binding AnnouncementStatusVM.WillAutoAdvance, Converter={StaticResource HideValueToVisibilityConverter}}" />
              </DataTrigger>
              <DataTrigger Value="Audio" Binding="{Binding View}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <StackPanel Margin="5,0,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
          <commonControls:PieProgress Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type commonControls:PieProgress}">
                <Style.Triggers>
                  <DataTrigger Value="Presentation" Binding="{Binding View}">
                    <Setter Property="commonControls:PieProgress.Value" Value="{Binding PresentationStatusVM.AutoAdvanceProgress}" />
                  </DataTrigger>
                  <DataTrigger Value="Announcement" Binding="{Binding View}">
                    <Setter Property="commonControls:PieProgress.Value" Value="{Binding AnnouncementStatusVM.AutoAdvanceProgress}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </commonControls:PieProgress>
          <TextBlock VerticalAlignment="Center" Text="{mex:Localized SIDEBAR_AUTOMATIC_ADVANCE_BUTTON_title}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Margin="0,0,8,0" HorizontalContentAlignment="Left" Style="{StaticResource TransportButtonStyle}" Command="{Binding CancelSlideOnStageDisplayOnlyCommand}" Visibility="{Binding SlideOnStageDisplayOnly, Converter={StaticResource HideValueToVisibilityConverter}}">
        <StackPanel Margin="5,0,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
          <Image Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Source="../Resources/Icons/eyeWithSlash.png" />
          <TextBlock VerticalAlignment="Center" Text="{mex:Localized SIDEBAR_SLIDE_ON_STAGE_ONLY_BUTTON_title}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</UserControl>