<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Search.QuickSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:do="clr-namespace:ProPresenter.DO;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.Search" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="QSWindow" Title="QuickSearchWindow" Width="275" Height="425" MinWidth="275" MinHeight="425" uiUtility:CommandTargets.Register="{x:Static uiCommands:CommandTargetType.QuickSearchWindow}" ShowInTaskbar="False" ShowTitlebar="False" Style="{StaticResource {x:Type windowing:ChromedWindow}}" Topmost="True" WindowStartupLocation="CenterScreen" uiUtility:UIElementHelper.Palette="{Binding QUICKSEARCH_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" BorderBrush="{Binding (uiUtility:UIElementHelper.Palette).Standard.Border, RelativeSource={RelativeSource Self}}" EdgeColor="{Binding (uiUtility:UIElementHelper.Palette).Standard.BorderColor, RelativeSource={RelativeSource Self}}">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <commonConverters:IsNotNullToBoolConverter x:Key="IsNotNullToBoolConverter" />
        <commonUtility:BindingProxy x:Key="dataContext" Data="{Binding}" />
        <commonUtility:BindingProxy x:Key="QuickSearchWindowElementProxy" Data="{Binding ElementName=QSWindow}" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <commonControls:PathControl Grid.Column="0" Width="18" Height="18" Margin="5,0" VerticalAlignment="Center" Fill="#00FFFFFF" PathType="Magnifier" StrokeThickness="2" Stroke="{Binding HEADERCONTENT, Source={x:Static theming:AppTheme.Active}}" />
      <commonControls:SearchBox Name="SearchBox" Grid.Column="1" Height="30" VerticalAlignment="Center" BorderThickness="0" EscapeToClearInput="False" FontSize="15" FontWeight="SemiBold" KeepFocus="True" PlaceholderPathType="{x:Null}" PlaceholderText="{Binding ActivePage.PlaceholderSearchText}" Text="{Binding SearchText, Delay=250}" />
    </Grid>
    <Border Grid.Row="1" BorderThickness="0,1" BorderBrush="{Binding BorderBrush, ElementName=QSWindow}">
      <windowing:Caption Background="{Binding Background, ElementName=QSWindow}">
        <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding AvailablePages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <commonControls:BorderlessRadioToggleButton Height="28" Margin="2" Command="{Binding Data.SelectPageCommand, Source={StaticResource dataContext}}" CommandParameter="{Binding}">
                <ToggleButton.IsChecked>
                  <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                    <Binding Path="." />
                    <Binding Path="Data.ActivePage" Source="{StaticResource dataContext}" />
                  </MultiBinding>
                </ToggleButton.IsChecked>
                <commonControls:ImageMask Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessRadioToggleButton}}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type commonControls:ImageMask}">
                      <Style.Triggers>
                        <DataTrigger Value="{x:Static do:QuickSearchType.Library}" Binding="{Binding SearchType}">
                          <Setter Property="commonControls:ImageMask.ImageSource" Value="{StaticResource {x:Static themes:Icons.LibraryIcon}}" />
                        </DataTrigger>
                        <DataTrigger Value="{x:Static do:QuickSearchType.SongSelect}" Binding="{Binding SearchType}">
                          <Setter Property="commonControls:ImageMask.ImageSource" Value="{StaticResource {x:Static themes:Icons.SongSelectIcon}}" />
                        </DataTrigger>
                        <DataTrigger Value="{x:Static do:QuickSearchType.MultiTracks}" Binding="{Binding SearchType}">
                          <Setter Property="commonControls:ImageMask.ImageSource" Value="{StaticResource {x:Static themes:Icons.MultiTracksIcon}}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </commonControls:ImageMask>
              </commonControls:BorderlessRadioToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </windowing:Caption>
    </Border>
    <local:ItemListBox x:Name="items" Grid.Row="2" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding ActivePage.Items, IsAsync=True}" SelectedListItem="{Binding ActivePage.SelectedItem}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type local:ItemListBox}">
          <Setter Property="commonControls:ListBoxBase.SelectedListItems" Value="{Binding ActivePage.SelectedItems}" />
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding ActivePage.CanMultiSelect}">
              <Setter Property="commonControls:ListBoxBase.SelectedListItems" Value="{x:Null}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <DataTemplate x:Key="CueTemplate">
            <ui:CueTemplate CanRename="False" ShowArrangementName="True" ShowIcon="False">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ui:CueTemplate}">
                  <Setter Property="ui:CueTemplate.ShowItemDetails" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Value="1" Binding="{Binding Count, Source={x:Static do:DataVault.LibraryCollection}}">
                      <Setter Property="ui:CueTemplate.ShowItemDetails" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ui:CueTemplate>
          </DataTemplate>
          <DataTemplate x:Key="SongSelectTemplate">
            <Grid Margin="8,3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
              <TextBlock Grid.Row="1" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Authors}" />
            </Grid>
          </DataTemplate>
          <DataTemplate x:Key="MultiTracksTemplate">
            <Grid Margin="8,3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
              <TextBlock Grid.Row="1" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} - {1}">
                    <Binding Mode="OneWay" Path="Artist" />
                    <Binding Mode="OneWay" Path="Album" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ResourceDictionary>
      </FrameworkElement.Resources>
    </local:ItemListBox>
    <Grid Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" Visibility="{Binding DisplayIndexingIndicator, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <ProgressBar Grid.Row="0" Width="192" Height="10" Margin="0,7,0,0" HorizontalAlignment="Stretch" Foreground="#FF007AFF" Maximum="{Binding IndexingTotalCount, Mode=OneWay}" Value="{Binding IndexingProgress, Mode=OneWay}" />
      <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{mex:Localized PRESENTATION_QUICK_SEARCH_PREVIEW_LIBRARY_INDEXING_Label}" />
    </Grid>
    <TextBlock Grid.Row="3" Margin="0,7" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource Self}}" Text="{Binding ActivePage.FooterText}" />
    <commonControls:AnchoredPopup Name="lyricPreview" ActivateParentOnClose="False" Placement="Right" ShareParentSpace="True" ShowActivated="False" StaysOpen="True" PlacementTarget="{Binding ElementName=items}" Closed="OnLyricPreviewClosed" PopupDeactivated="OnLyricPreviewPopupDeactivated">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type commonControls:AnchoredPopup}">
          <Setter Property="commonControls:AnchoredPopup.IsOpen" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Data.ActivePage.PreviewVM.ShowPreview, Source={StaticResource dataContext}, Mode=OneWay}" />
                <Condition Value="Visible" Binding="{Binding Visibility, ElementName=QSWindow, Mode=OneWay}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="commonControls:AnchoredPopup.IsOpen" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <local:SearchPreview DataContext="{Binding Data.ActivePage.PreviewVM, Source={StaticResource dataContext}}" />
    </commonControls:AnchoredPopup>
  </Grid>
</windowing:ChromedWindow>