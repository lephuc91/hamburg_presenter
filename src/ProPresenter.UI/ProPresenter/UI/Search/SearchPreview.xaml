<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Search.SearchPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:do="clr-namespace:ProPresenter.DO;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.Search" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="self" Width="516" uiUtility:UIElementHelper.Palette="{Binding QUICKSEARCH_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource Self}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
      <commonConverters:IsNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpaceConverter" />
      <converters:CollectionContainsConverter x:Key="CollectionContainsConverter" Type="Visibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource {x:Type UserControl}}" TargetType="{x:Type UserControl}">
      <Setter Property="Height" Value="454" />
      <Style.Triggers>
        <DataTrigger Value="{x:Static do:QuickSearchPreviewType.FeaturedImage}" Binding="{Binding SelectedPreview}">
          <Setter Property="Height" Value="300" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Value="{x:Static do:QuickSearchPreviewType.FeaturedImage}" Binding="{Binding SelectedPreview}" />
            <Condition Value="False" Binding="{Binding Content, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}}" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Height" Value="175" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
  <Border Padding="12,12,12,0" BorderThickness="1" BorderBrush="{Binding (uiUtility:UIElementHelper.Palette).Standard.Border, RelativeSource={RelativeSource Self}}">
    <Grid>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Width="100" Height="100" Source="{Binding Image}" Visibility="{Binding SelectedPreview, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:QuickSearchPreviewType.FeaturedImage}}" />
        <StackPanel Grid.Column="1" Margin="7,0,0,0">
          <TextBlock HorizontalAlignment="Right" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource Self}}" Text="{Binding ID}" />
          <TextBlock HorizontalAlignment="Left" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
          <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource Self}}" Text="{Binding Subtitle1}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding Subtitle1, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource Self}}" Text="{Binding Subtitle2}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding Subtitle2, Converter={StaticResource IsNotNullOrWhiteSpaceConverter}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </StackPanel>
        <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Margin="7,5,0,0">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ContentControl}">
              <Setter Property="Grid.RowSpan" Value="1" />
              <Style.Triggers>
                <DataTrigger Value="{x:Static do:QuickSearchPreviewType.Text}" Binding="{Binding SelectedPreview}">
                  <Setter Property="Content">
                    <Setter.Value>
                      <local:TextPreview />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
                <DataTrigger Value="{x:Static do:QuickSearchPreviewType.Thumbnail}" Binding="{Binding SelectedPreview}">
                  <Setter Property="Content">
                    <Setter.Value>
                      <local:PresentationThumbnailPreview />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
                <DataTrigger Value="{x:Static do:QuickSearchPreviewType.FeaturedImage}" Binding="{Binding SelectedPreview}">
                  <Setter Property="Content">
                    <Setter.Value>
                      <local:MultiTracksPreview />
                    </Setter.Value>
                  </Setter>
                  <Setter Property="Grid.RowSpan" Value="2" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ContentControl>
        <Grid Row="2" ColumnSpan="2" VerticalAlignment="Bottom">
          <StackPanel Margin="0,7" Orientation="Horizontal">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type StackPanel}">
                <Style.Triggers>
                  <DataTrigger Value="1" Binding="{Binding AvailablePreviews.Count}">
                    <Setter Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <commonControls:BorderlessRadioToggleButton Margin="7,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SelectedPreview, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static do:QuickSearchPreviewType.Text}}">
              <UIElement.Visibility>
                <MultiBinding Converter="{StaticResource CollectionContainsConverter}" Mode="OneWay">
                  <Binding Source="{x:Static do:QuickSearchPreviewType.Text}" />
                  <Binding Path="AvailablePreviews" />
                </MultiBinding>
              </UIElement.Visibility>
              <commonControls:ImageMask ImageSource="../Resources/Icons/Footer/Easy.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessRadioToggleButton}}" />
            </commonControls:BorderlessRadioToggleButton>
            <commonControls:BorderlessRadioToggleButton Margin="7,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SelectedPreview, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static do:QuickSearchPreviewType.Thumbnail}}">
              <UIElement.Visibility>
                <MultiBinding Converter="{StaticResource CollectionContainsConverter}" Mode="OneWay">
                  <Binding Source="{x:Static do:QuickSearchPreviewType.Thumbnail}" />
                  <Binding Path="AvailablePreviews" />
                </MultiBinding>
              </UIElement.Visibility>
              <commonControls:ImageMask ImageSource="../Resources/Icons/Footer/Grid.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessRadioToggleButton}}" />
            </commonControls:BorderlessRadioToggleButton>
            <commonControls:FillSlider Width="80" Margin="7,0,0,0" VerticalAlignment="Center" IsDirectionReversed="True" Maximum="4" Minimum="1" Visibility="{Binding SelectedPreview, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:QuickSearchPreviewType.Thumbnail}}">
              <RangeBase.Value>
                <PriorityBinding>
                  <Binding Path="RowCapacity" />
                </PriorityBinding>
              </RangeBase.Value>
            </commonControls:FillSlider>
          </StackPanel>
          <ItemsControl Margin="0,7" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding CommandVMs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Height="22" MinWidth="80" uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.QuickSearchWindow}" uiUtility:CommandTargets.Default="False" Command="{Binding BindCommand}" Content="{Binding Text}" Visibility="{Binding IsVisible, Converter={StaticResource ValueToVisibilityConverter}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>