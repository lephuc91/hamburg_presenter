<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Search.TextPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:multiTracks="clr-namespace:ProPresenter.UI.MultiTracks" xmlns:search="clr-namespace:ProPresenter.UI.Search">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <TextBlock TextWrapping="Wrap" Text="{Binding Content, IsAsync=True}" />
    </ScrollViewer>
    <multiTracks:MultiTracksUnauthorizedOverlay IsMultiTracksAvailable="{Binding IsAvailable}" OpenWebsiteCommand="{Binding OpenWebsiteCommand}" RetryAuthorizationCommand="{Binding RetryAuthorizationCommand}" SelectedPresentation="{Binding SelectedPresentation}" />
  </Grid>
</UserControl>