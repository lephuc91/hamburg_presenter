<?xml version="1.0" encoding="utf-8"?>
<components:FrameworkCollection x:Class="ProPresenter.UI.Preview.ScreenSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:components="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:vms="clr-namespace:ProPresenter.UI.ViewModels.Preview" x:Name="screenSelector" xmlns:preview="clr-namespace:ProPresenter.UI.Preview" DataContext="{Binding Source={di:DIMarkup {x:Type vms:IScreenSelectorVM}}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="ScreenSelectorProxy" Data="{Binding ElementName=screenSelector}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <Style x:Key="PreviewHeaderMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MenuItem.IsCheckable" Value="False" />
        <Setter Property="IsEnabled" Value="False" />
      </Style>
      <Style x:Key="ScreenMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.SelectScreenCommand, Source={StaticResource ScreenSelectorProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
        <Setter Property="Header" Value="{Binding Name}" />
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
              <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
              <Binding Path="Data.SelectedScreen" Source="{StaticResource ScreenSelectorProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <MenuItem Style="{StaticResource PreviewHeaderMenuItemStyle}" Header="{mex:Localized GLOBAL_AUDIENCE_title}" />
  <components:FrameworkCollectionWrapper BoundCollection="{Binding Path=AudienceScreens}">
    <components:FrameworkCollectionWrapper.BoundDataTemplate>
      <DataTemplate>
        <MenuItem Style="{StaticResource ScreenMenuItemStyle}" />
      </DataTemplate>
    </components:FrameworkCollectionWrapper.BoundDataTemplate>
  </components:FrameworkCollectionWrapper>
  <MenuItem Style="{StaticResource PreviewHeaderMenuItemStyle}" Header="{mex:Localized GLOBAL_STAGE_title}" />
  <components:FrameworkCollectionWrapper BoundCollection="{Binding Path=StageScreens}">
    <components:FrameworkCollectionWrapper.BoundDataTemplate>
      <DataTemplate>
        <MenuItem Style="{StaticResource ScreenMenuItemStyle}" />
      </DataTemplate>
    </components:FrameworkCollectionWrapper.BoundDataTemplate>
  </components:FrameworkCollectionWrapper>
</components:FrameworkCollection>