<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CloudOnboarding.CloudOnboardingLocalWorkspacesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:dependencyInjection="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.CloudOnboarding" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Background="#00FFFFFF" xmlns:cloudonboarding="clr-namespace:ProPresenter.UI.CloudOnboarding" DataContext="{dependencyInjection:DIMarkup {x:Type viewModels:ICloudOnboardingLocalWorkspacesVM}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CloudOnboardingResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource CloudOnboarding.TextBlockStyle}" TargetType="{x:Type TextBlock}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7*" />
        <ColumnDefinition Width="26*" />
        <ColumnDefinition Width="7*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,48,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource CloudOnboarding.TitleBrush}" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_CONVERT_TO_CLOUD_title}" />
        <TextBlock Margin="55,8,55,36" FontSize="16" Foreground="{StaticResource CloudOnboarding.SubtleBrush}" TextWrapping="Wrap" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_CONVERT_TO_CLOUD_message}" />
      </StackPanel>
      <Grid Row="1" Column="0" ColumnSpan="3" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="10*" />
          <ColumnDefinition Width="80*" />
          <ColumnDefinition Width="10*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Source="pack://application:,,,/ProPresenter.UI;component/Resources/Icons/CloudOnboarding/CloudOnboardingLocalWorkspaces.png" Stretch="Uniform" />
      </Grid>
    </Grid>
    <Grid Row="1">
      <Border Height="56" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{StaticResource CloudOnboarding.BottomStripeBrush}" />
      <DockPanel LastChildFill="False">
        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Orientation="Horizontal">
          <commonControls:BorderlessButton Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" FontSize="14" Command="{Binding BackCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Foreground="{Binding TOGGLESWITCH_PALETTE.Checked.Background, Source={x:Static theming:AppTheme.Active}}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <commonControls:ImageMask Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" ImageSource="../Resources/Icons/LeftArrow.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
              <TextBlock VerticalAlignment="Center" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_BACK_button}" />
            </StackPanel>
          </commonControls:BorderlessButton>
        </StackPanel>
        <StackPanel Margin="16,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Padding="16,6" IsDefault="True" Command="{Binding ContinueCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_GET_STARTED}" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>