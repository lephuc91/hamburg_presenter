<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CloudOnboarding.CloudOnboardingPricingOptionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:dependencyInjection="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.CloudOnboarding" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Background="#00FFFFFF" xmlns:cloudonboarding="clr-namespace:ProPresenter.UI.CloudOnboarding" DataContext="{dependencyInjection:DIMarkup {x:Type viewModels:ICloudOnboardingPricingVM}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CloudOnboardingResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource CloudOnboarding.TextBlockStyle}" TargetType="{x:Type TextBlock}" />
      <Style x:Key="{x:Type Hyperlink}" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{StaticResource CloudOnboarding.HyperlinkBrush}" />
      </Style>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7*" />
        <ColumnDefinition Width="26*" />
        <ColumnDefinition Width="7*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Margin="0,48,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <TextBlock FontSize="44" FontWeight="Bold" Foreground="{StaticResource CloudOnboarding.TitleBrush}" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_OPTIONS_PAGE_title}" />
        <TextBlock MaxWidth="900" Margin="0,8,0,0" FontSize="16" Foreground="{StaticResource CloudOnboarding.SubtleBrush}" TextWrapping="Wrap" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_OPTIONS_PAGE_description}" />
        <TextBlock Margin="0,48,0,10" FontSize="20" TextWrapping="Wrap" Text="{Binding IntroMessage}" />
        <Border Margin="0,16,0,0" HorizontalAlignment="Center" Background="{StaticResource CloudOnboarding.PlanCardStripeBrush}" BorderBrush="{StaticResource CloudOnboarding.PlanStrokeBrush}" BorderThickness="2" CornerRadius="10" SnapsToDevicePixels="True">
          <Border ClipToBounds="True" CornerRadius="8">
            <Grid Width="600">
              <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="20,8,20,6" ZIndex="1" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold">
                  <Run FontWeight="Bold" Text="{Binding RecommendedPlanStorageGb, StringFormat={}{0}GB, Mode=OneWay}" /> <Run Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_PRICING_CLOUD_STORAGE_label}" /></TextBlock>
                <Image Height="22" Margin="0,0,100,0" VerticalAlignment="Center" DockPanel.Dock="Right" Source="{StaticResource {x:Static themes:Icons.CloudWorkspaceLogo}}" Stretch="Uniform" />
              </DockPanel>
              <Grid Row="1" ZIndex="2" Background="{StaticResource CloudOnboarding.PlanCardBackgroundBrush}">
                <TextBlock Margin="20,12,20,20" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16" TextAlignment="Left" TextWrapping="Wrap">
                  <Run Text="{Binding PricingMessage, Mode=OneWay}" />
                </TextBlock>
              </Grid>
            </Grid>
          </Border>
        </Border>
        <TextBlock MaxWidth="760" Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource CloudOnboarding.SubtleBrush}" TextWrapping="Wrap" Text="{Binding DisclaimerMessage, Mode=OneWay}" />
        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12">
          <Hyperlink Command="{Binding OpenLearnMoreCommand}">
            <Run Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_OPTIONS_PAGE_learn_more}" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>
    <Grid Row="1">
      <Border Height="56" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{StaticResource CloudOnboarding.BottomStripeBrush}" />
      <DockPanel LastChildFill="False">
        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Orientation="Horizontal">
          <commonControls:BorderlessButton Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" FontSize="14" Command="{Binding BackCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Foreground="{Binding TOGGLESWITCH_PALETTE.Checked.Background, Source={x:Static theming:AppTheme.Active}}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <commonControls:ImageMask Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" ImageSource="../Resources/Icons/LeftArrow.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
              <TextBlock VerticalAlignment="Center" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_BACK_button}" />
            </StackPanel>
          </commonControls:BorderlessButton>
        </StackPanel>
        <StackPanel Margin="16,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Margin="0,0,12,0" Padding="16,6" Command="{Binding ContinueWithoutCloudCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_CONTINUE_WITHOUT_CLOUD_button}" />
          <Button Padding="16,6" IsDefault="True" Command="{Binding ConvertToCloudCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_CONVERT_TO_CLOUD_button}" />
          <commonControls:LoadingIndicator Width="20" Height="20" Margin="12,0,0,0" VerticalAlignment="Center" DisplayMode="Spinner" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>