            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,0,0,36" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
      <commonControls:LoadingIndicator Width="40" Height="40" HorizontalAlignment="Center" DisplayMode="Spinner" />
      <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource CloudOnboarding.SubtleBrush}" TextAlignment="Center" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_CLOUD_WORKSPACE_UPLOADING_label}" />
    </StackPanel>
    <Grid Row="2" Visibility="{Binding ShowGetStarted, Converter={StaticResource BoolToVis}}">
      <Border Height="56" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{StaticResource CloudOnboarding.BottomStripeBrush}" />
      <DockPanel LastChildFill="False">
        <StackPanel Margin="16,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Padding="16,6" IsDefault="True" Command="{Binding GetStartedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:ICloseable}}}" Content="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_GET_STARTED}" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>