<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CloudOnboarding.CloudOnboardingDoneView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:dependencyInjection="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.CloudOnboarding;assembly=ProPresenter.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" Background="#00FFFFFF" xmlns:cloudonboarding="clr-namespace:ProPresenter.UI.CloudOnboarding;assembly=ProPresenter.UI" DataContext="{dependencyInjection:DIMarkup {x:Type viewModels:ICloudOnboardingDoneVM}}">
