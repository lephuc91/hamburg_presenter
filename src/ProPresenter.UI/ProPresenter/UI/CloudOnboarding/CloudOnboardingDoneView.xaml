                    </DrawingImage>
                  </Image.Source>
                </Image>
              </Grid>
              <TextBlock Grid.Row="2" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_LEARN_COLLABORATION_title}" />
              <TextBlock Grid.Row="4" Margin="0,4,0,0" FontSize="14" Foreground="{StaticResource CloudOnboarding.BodyBrush}" TextWrapping="Wrap" Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_LEARN_COLLABORATION_message}" />
