<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.CloudWorkspaces.CloudWorkspaceCollaboratorsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dependencyInjection="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.Workspaces" x:Name="Self" xmlns:cloudworkspaces="clr-namespace:ProPresenter.UI.CloudWorkspaces" DataContext="{dependencyInjection:DIMarkup {x:Type viewModels:IWorkspacesVM}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="proxy" Data="{Binding DataContext, ElementName=Self}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" FontSize="12" FontWeight="Bold" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{markupExtensions:Localized CLOUDWORKSPACE_COLLABORATORS_label}" />
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Collaborators}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Margin="5">
              <Shape.Fill>
                <SolidColorBrush Color="#FF28CD41" />
              </Shape.Fill>
            </Ellipse>
            <TextBlock Margin="5" Foreground="#FFF0FFFF" Text="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </Grid>
</UserControl>