<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Stage.ScreenMapSelectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:converters="clr-namespace:ProPresenter.UI.Converters" xmlns:cue="clr-namespace:ProPresenter.DO.Cues;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:propresenterUI="clr-namespace:ProPresenter.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="mapControlSelf" xmlns:stage="clr-namespace:ProPresenter.UI.Stage" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="mapControlSelfProxy" Data="{Binding ElementName=mapControlSelf}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <converters:CustomSlideConverter x:Key="CustomSlideConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Vertical">
      <commonControls:EditableTextBlock Grid.Column="0" Text="{Binding StageScreen.Name, ElementName=mapControlSelf, Mode=TwoWay}" ToolTip="{Binding StageScreen.Name, ElementName=mapControlSelf}" />
      <TextBlock Margin="0,5,0,0" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding SelectedLayout.Name, ElementName=mapControlSelf}" ToolTip="{Binding SelectedLayout.Name, ElementName=mapControlSelf}" />
    </StackPanel>
    <commonControls:BorderlessButton Grid.Column="1" HorizontalAlignment="Right" uiUtility:ContextMenuHelper.OpenOnLeftClick="True">
      <FrameworkElement.ContextMenu>
        <ContextMenu Placement="Bottom" UsesItemContainerTemplate="True">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <CollectionViewSource x:Key="StageLayoutItems" Source="{Binding Data.StageLayouts, Source={StaticResource mapControlSelfProxy}}" />
              <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type cue:SlideCue}}">
                <MenuItem HorizontalContentAlignment="Left" Click="Select_Layout">
                  <MenuItem.IsChecked>
                    <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                      <Binding Path="Data.SelectedLayout.ID" Source="{StaticResource mapControlSelfProxy}" />
                      <Binding Path="ID" />
                    </MultiBinding>
                  </MenuItem.IsChecked>
                  <HeaderedItemsControl.Header>
                    <Grid Margin="5" HorizontalAlignment="Left">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <propresenterUI:ScaleToFitSlidePreview Grid.Column="0" Width="92.44" Height="52" RenderTransparencyCheckerboard="True" PrimaryCheckerboardBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" SecondaryCheckerboardBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" Source="{Binding SlideAction.Slide, Converter={StaticResource CustomSlideConverter}}" />
                      <TextBlock Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Text="{Binding Name}" />
                    </Grid>
                  </HeaderedItemsControl.Header>
                </MenuItem>
              </ItemContainerTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.ItemsSource>
            <CompositeCollection>
              <MenuItem Header="{mex:Localized GLOBAL_NONE}" Visibility="{Binding Data.AddBlankItem, Source={StaticResource mapControlSelfProxy}, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter=true}" Click="Clear_SelectedLayout">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                    <Setter Property="MenuItem.IsChecked" Value="False" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Data.SelectedLayout, Source={StaticResource mapControlSelfProxy}}" Value="{x:Null}">
                        <Setter Property="MenuItem.IsChecked" Value="True" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </MenuItem>
              <Separator Visibility="{Binding Data.AddBlankItem, Source={StaticResource mapControlSelfProxy}, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter=true}" />
              <MenuItem Command="{Binding Data.EditLayoutsCommand, Source={StaticResource mapControlSelfProxy}}" CommandParameter="{Binding Data.StageScreen, Source={StaticResource mapControlSelfProxy}}" Header="{mex:Localized MAIN_MENU_SCREEN_EDIT_STAGE_SELECTED_LAYOUT_title}" />
              <Separator />
              <CollectionContainer Collection="{Binding Source={StaticResource StageLayoutItems}}" />
            </CompositeCollection>
          </ItemsControl.ItemsSource>
        </ContextMenu>
      </FrameworkElement.ContextMenu>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <propresenterUI:ScaleToFitSlidePreview Grid.Column="0" Width="92.44" Height="52" RenderTransparencyCheckerboard="True" PrimaryCheckerboardBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" SecondaryCheckerboardBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" Source="{Binding SelectedLayout.SlideAction.Slide, Converter={StaticResource CustomSlideConverter}, ElementName=mapControlSelf}" />
        <StackPanel Grid.Column="1" Margin="2,0" VerticalAlignment="Center">
          <commonControls:PathControl Width="10" Height="10" Fill="#00FFFFFF" PathType="VUpArrow" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
          <commonControls:PathControl Width="10" Height="10" Fill="#00FFFFFF" PathType="VDownArrow" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        </StackPanel>
      </Grid>
    </commonControls:BorderlessButton>
  </Grid>
</UserControl>