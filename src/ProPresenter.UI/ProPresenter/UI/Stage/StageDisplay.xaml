<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Stage.StageDisplay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:controls="clr-namespace:ProPresenter.UI.Controls" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.Stage" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:outputConfig="clr-namespace:ProPresenter.UI.OutputConfiguration" xmlns:outputDO="clr-namespace:ProPresenter.DO.OutputConfiguration;assembly=ProPresenter.DO" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" x:Name="stage">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <utility:BindingProxy x:Key="stageVMProxy" Data="{Binding}" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="true" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" IsCollapsing="False" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverterCollapsing" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsCollapsing="False" IsInverted="True" />
      <outputConfig:DeviceSelector x:Key="DeviceSelector" CanOpenScreenConfig="True" Placement="Bottom" AddCombinedScreenCommand="{Binding Data.DeviceSelectorVM.AddCombinedScreenCommand, Source={StaticResource stageVMProxy}}" AddEdgeBlendScreenCommand="{Binding Data.DeviceSelectorVM.AddEdgeBlendScreenCommand, Source={StaticResource stageVMProxy}}" AssignDeviceCommand="{Binding Data.DeviceSelectorVM.AssignDeviceCommand, Source={StaticResource stageVMProxy}}" AttachedPhysicalDevices="{Binding Data.DeviceSelectorVM.AttachedPhysicalDevices, Source={StaticResource stageVMProxy}}" ClearScreenIdentifyCommand="{Binding Data.DeviceSelectorVM.ClearScreenIdentifyCommand, Source={StaticResource stageVMProxy}}" Devices="{Binding Data.DeviceSelectorVM.OutputConfiguration.Devices, Source={StaticResource stageVMProxy}}" IdentifyScreenCommand="{Binding Data.DeviceSelectorVM.IdentifyScreenCommand, Source={StaticResource stageVMProxy}}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" Background="{Binding (uiUtility:UIElementHelper.Palette).Standard.Background, RelativeSource={RelativeSource Self}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Height="22" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.Content, RelativeSource={RelativeSource AncestorType=Grid}}" Text="{mex:Localized STAGE_HEADER_title}" />
        <StackPanel Grid.Column="1" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <commonControls:BorderlessButton Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Command="{Binding EditLayoutsCommand}" ToolTip="{mex:Localized STAGE_WINDOW_EDIT_STAGE_SCREEN_tooltip}">
            <commonControls:ImageMask ImageSource="{StaticResource {x:Static uiThemes:Icons.Editor}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=commonControls:BorderlessButton}}" />
          </commonControls:BorderlessButton>
          <commonControls:BorderlessButton uiUtility:ContextMenuHelper.OpenOnLeftClick="True" DataContext="{x:Static outputDO:ScreenTargetType.Stage}" ToolTip="{mex:Localized STAGE_WINDOW_ADD_STAGE_SCREEN_tooltip}" Visibility="{Binding Data.StageScreens.Count, Converter={StaticResource CountToVisibilityConverter}, Source={StaticResource stageVMProxy}}">
            <FrameworkElement.ContextMenu>
              <ContextMenu>
                <ItemsControl.ItemsSource>
                  <CompositeCollection>
                    <outputConfig:DeviceSelectorMenuItem CanOpenScreenConfig="True" AddCombinedScreenCommand="{Binding Data.DeviceSelectorVM.AddCombinedScreenCommand, Source={StaticResource stageVMProxy}}" AddEdgeBlendScreenCommand="{Binding Data.DeviceSelectorVM.AddEdgeBlendScreenCommand, Source={StaticResource stageVMProxy}}" AssignDeviceCommand="{Binding Data.DeviceSelectorVM.AssignDeviceCommand, Source={StaticResource stageVMProxy}}" AttachedPhysicalDevices="{Binding Data.DeviceSelectorVM.AttachedPhysicalDevices, Source={StaticResource stageVMProxy}}" ClearScreenIdentifyCommand="{Binding Data.DeviceSelectorVM.ClearScreenIdentifyCommand, Source={StaticResource stageVMProxy}}" Devices="{Binding Data.DeviceSelectorVM.OutputConfiguration.Devices, Source={StaticResource stageVMProxy}}" Header="{mex:Localized STAGE_WINDOW_ADD_STAGE_SCREEN_label}" IdentifyScreenCommand="{Binding Data.DeviceSelectorVM.IdentifyScreenCommand, Source={StaticResource stageVMProxy}}" />
                    <commonControls:RoutedMenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" Command="{Binding ScreensMenu.ConfigureScreens.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
                  </CompositeCollection>
                </ItemsControl.ItemsSource>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
            <commonControls:PathControl Width="14" Height="14" PathType="Plus" Fill="{Binding Foreground, RelativeSource={RelativeSource Self}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
          </commonControls:BorderlessButton>
        </StackPanel>
      </Grid>
      <local:StageLayoutAssignmentList x:Name="ScreenLayoutsControl" Grid.Row="1" MinHeight="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderThickness="0" DeselectOnLostFocus="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectItemsOnSelfDrop="False" SelectionMode="Extended" Style="{StaticResource {x:Type ListBox}}" VirtualizingPanel.ScrollUnit="Pixel" uiUtility:UIElementHelper.Palette="{Binding SOURCELIST_PALETTE, Source={x:Static theming:AppTheme.Active}}" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding DeleteStageScreenCommand}" ActiveItem="{Binding ActiveItem}" ItemsSource="{Binding StageScreens}" SelectedListItem="{Binding SelectedItem}" SelectedListItems="{Binding SelectedItems}" Visibility="{Binding StageScreens.Count, Converter={StaticResource CountToVisibilityConverter}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#00FFFFFF" BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
              <local:ScreenMapSelectionControl Margin="8,5" AddBlankItem="False" ChangeLayoutCommand="{Binding Data.ChangeLayoutCommand, Source={StaticResource stageVMProxy}}" EditLayoutsCommand="{Binding Data.EditLayoutsCommand, Source={StaticResource stageVMProxy}}" ScreenLayoutMap="{Binding Data.ScreenLayoutMap, Source={StaticResource stageVMProxy}}" StageLayouts="{Binding Data.StageLayouts, Source={StaticResource stageVMProxy}}" StageScreen="{Binding}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <ItemsControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type commonControls:ListBoxItem}">
            <Setter Property="FrameworkElement.ContextMenu">
              <Setter.Value>
                <ContextMenu>
                  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Rename}" Header="{mex:Localized GLOBAL_RENAME_MENU_ITEM_title}" />
                  <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" Header="{mex:Localized GLOBAL_DELETE_title}" />
                  <Separator />
                  <commonControls:RoutedMenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" Command="{Binding ScreensMenu.ConfigureScreens.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
                </ContextMenu>
              </Setter.Value>
            </Setter>
            <Setter Property="commonControls:ListBoxItem.FocusOnContextMenuClose" Value="False" />
            <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding SOURCELISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <FrameworkElement.ContextMenu>
          <ContextMenu>
            <commonControls:RoutedMenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" Command="{Binding ScreensMenu.ConfigureScreens.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
          </ContextMenu>
        </FrameworkElement.ContextMenu>
      </local:StageLayoutAssignmentList>
      <controls:ImageTextButton Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" ButtonBackground="#80707070" ButtonHeight="80" ButtonWidth="80" ContextMenu="{StaticResource DeviceSelector}" DataContext="{x:Static outputDO:ScreenTargetType.Stage}" ImageSource="{StaticResource {x:Static uiThemes:Icons.EmptyAdd}}" Text="{mex:Localized STAGE_WINDOW_ADD_STAGE_SCREEN_label}" Visibility="{Binding Data.StageScreens.Count, Converter={StaticResource InvertedCountToVisibilityConverter}, Source={StaticResource stageVMProxy}}" />
    </Grid>
    <Grid Row="1" VerticalAlignment="Bottom" Visibility="{Binding StageScreens.Count, Converter={StaticResource CountToVisibilityConverterCollapsing}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" MinHeight="30" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{Binding HEADER, Source={x:Static theming:AppTheme.Active}}">
        <TextBlock Margin="8,2,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized STAGE_WINDOW_STAGE_MESSAGE_label}" />
      </Border>
      <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="60" Margin="8,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AcceptsReturn="True" MaxLength="1024" TextWrapping="Wrap" Text="{Binding StageMessage, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{mex:Localized STAGE_WINDOW_STAGE_MESSAGE_NOTE_label}" />
      <Button Grid.Row="2" Grid.Column="1" Height="22" MinWidth="80" Margin="0,0,8,5" HorizontalAlignment="Right" Command="{Binding HideMessageCommand}" Content="{mex:Localized STAGE_WINDOW_HIDE_STAGE_MESSAGE_BUTTON_title}" Visibility="{Binding MessageShown, Converter={StaticResource ValueToVisibilityConverter}}" />
      <Button Grid.Row="2" Grid.Column="1" Height="22" MinWidth="80" Margin="0,0,8,5" HorizontalAlignment="Right" Command="{Binding ShowMessageCommand}" Content="{mex:Localized STAGE_WINDOW_SHOW_STAGE_MESSAGE_BUTTON_title}" Visibility="{Binding MessageShown, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>