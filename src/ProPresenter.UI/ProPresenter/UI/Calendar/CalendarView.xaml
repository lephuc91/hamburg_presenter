<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Calendar.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:calendarDO="clr-namespace:ProPresenter.DO.Calendar;assembly=ProPresenter.DO" xmlns:captureAction="clr-namespace:ProPresenter.DO.Actions.Capture;assembly=ProPresenter.DO" xmlns:commonCommands="clr-namespace:Pro.UI.Commands;assembly=Pro.UI" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:floatingHeaders="clr-namespace:ProPresenter.UI.FloatingHeaders" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:local="clr-namespace:ProPresenter.UI.Calendar" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" xmlns:uiBehaviors="clr-namespace:Pro.UI.Behaviors;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="calendarView" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <commonUtility:BindingProxy x:Key="vmProxy" Data="{Binding}" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <local:CheckEventDayConverter x:Key="CheckEventDayConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
      <Style x:Key="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="50" />
      </Style>
      <ObjectDataProvider x:Key="CaptureType" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="captureAction:CaptureType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <DataTemplate x:Key="EventTemplate">
        <Grid Margin="-4,-1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Margin="17,4,10,0" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Name}" ToolTip="{Binding Name}" />
          <TextBlock Grid.Row="1" Margin="17,2,4,4" FontSize="12" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Text="{Binding TriggerDate, StringFormat={x:Static local:CalendarView.DateFormat}}" />
        </Grid>
      </DataTemplate>
      <Style x:Key="EventContainerStyle" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FrameworkElement.ContextMenu">
          <Setter.Value>
            <ContextMenu>
              <MenuItem Command="{x:Static commonCommands:CommonApplicationCommands.Delete}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
          </Setter.Value>
        </Setter>
        <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding DETAILLISTITEM_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
      </Style>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,0.5" BorderBrush="{Binding LAYOUTSPLITTER_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
      <CheckBox Margin="0,5,10,5" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{mex:Localized CALENDAR_VIEW_ENABLED_title}" IsChecked="{Binding IsActive, Mode=TwoWay}" />
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Visibility="{Binding Events.Count, Converter={StaticResource InvertedCountToVisibilityConverter}}">
      <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="SemiBold" Text="{mex:Localized CALENDAR_VIEW_NO_EVENT_label}" />
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Visibility="{Binding Events.Count, Converter={StaticResource CountToVisibilityConverter}}">
      <ListBox Name="AllEvents" BorderThickness="0" ItemContainerStyle="{StaticResource EventContainerStyle}" ItemTemplate="{StaticResource EventTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding RemoveEventCommand}" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" Visibility="{Binding IsChecked, ElementName=ToggleRecurrences, Converter={StaticResource InvertedValueToVisibilityConverter}}">
        <behaviors:Interaction.Behaviors xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors">
          <uiBehaviors:ListBoxScrollIntoViewBehavior />
        </behaviors:Interaction.Behaviors>
      </ListBox>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Visibility="{Binding Events.Count, Converter={StaticResource CountToVisibilityConverter}}">
      <floatingHeaders:FlatFloatingHeaderControl Visibility="{Binding IsChecked, ElementName=ToggleRecurrences, Converter={StaticResource ValueToVisibilityConverter}}">
        <commonControls:FloatingHeaderControl.HeaderTemplates>
          <DataTemplate DataType="{x:Type local:PastEventsListBox}">
            <Border Margin="0,-1,0,0" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding Data.PastEvents.Count, Converter={StaticResource CountToVisibilityConverter}, Source={StaticResource vmProxy}}">
              <TextBlock Margin="10,5,0,5" Text="{mex:Localized CALENDAR_VIEW_PAST_title}" />
            </Border>
          </DataTemplate>
          <DataTemplate DataType="{x:Type local:CurrentEventsListBox}">
            <Border Margin="0,-1,0,0" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding Data.CurrentEvents.Count, Converter={StaticResource CountToVisibilityConverter}, Source={StaticResource vmProxy}}">
              <TextBlock Margin="10,5,0,5" Text="{mex:Localized CALENDAR_VIEW_CURRENT_title}" />
            </Border>
          </DataTemplate>
          <DataTemplate DataType="{x:Type local:UpcomingEventsListBox}">
            <Border Margin="0,-1,0,0" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Visibility="{Binding Data.UpcomingEvents.Count, Converter={StaticResource CountToVisibilityConverter}, Source={StaticResource vmProxy}}">
              <TextBlock Margin="10,5,0,5" Text="{mex:Localized CALENDAR_VIEW_UPCOMING_title}" />
            </Border>
          </DataTemplate>
        </commonControls:FloatingHeaderControl.HeaderTemplates>
        <local:PastEventsListBox Grid.Row="1" ItemContainerStyle="{StaticResource EventContainerStyle}" ItemTemplate="{StaticResource EventTemplate}" Style="{StaticResource {x:Type ListBox}}" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding RemoveEventCommand}" ItemsSource="{Binding Data.PastEvents, Source={StaticResource vmProxy}}" SelectedItem="{Binding Data.SelectedEvent, Mode=TwoWay, Source={StaticResource vmProxy}}" Visibility="{Binding Data.PastEvents.Count, Converter={StaticResource CountToVisibilityConverter}, Source={StaticResource vmProxy}}" />
        <local:CurrentEventsListBox Grid.Row="3" ItemContainerStyle="{StaticResource EventContainerStyle}" Style="{StaticResource {x:Type ListBox}}" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding RemoveEventCommand}" ItemsSource="{Binding Data.CurrentEvents, Source={StaticResource vmProxy}}" SelectedItem="{Binding Data.SelectedEvent, Mode=TwoWay, Source={StaticResource vmProxy}}" Visibility="{Binding Data.CurrentEvents.Count, Converter={StaticResource CountToVisibilityConverter}, Source={StaticResource vmProxy}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="-4,-1" Background="#FF753029">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="17,4,10,0" FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Grid.Row="1" Margin="17,2,4,4" FontSize="12" Foreground="{Binding (uiUtility:UIElementHelper.Palette).Standard.HelperContent, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Text="{Binding TriggerDate, StringFormat={x:Static local:CalendarView.DateFormat}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </local:CurrentEventsListBox>
        <local:UpcomingEventsListBox Grid.Row="5" ItemContainerStyle="{StaticResource EventContainerStyle}" ItemTemplate="{StaticResource EventTemplate}" Style="{StaticResource {x:Type ListBox}}" uiUtility:UIElementHelper.RegisterDeleteCommand="{Binding RemoveEventCommand}" ItemsSource="{Binding Data.UpcomingEvents, Source={StaticResource vmProxy}}" SelectedValue="{Binding Data.SelectedEvent, Mode=TwoWay, Source={StaticResource vmProxy}}" Visibility="{Binding Data.UpcomingEvents.Count, Converter={StaticResource CountToVisibilityConverter}, Source={StaticResource vmProxy}}" />
      </floatingHeaders:FlatFloatingHeaderControl>
    </Border>
    <Border Grid.Row="2" Grid.Column="0" BorderThickness="0,0.5,0,0" BorderBrush="{Binding LAYOUTSPLITTER_BACKGROUND, Source={x:Static theming:AppTheme.Active}}">
      <Grid Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <commonControls:BorderlessPathButton Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" PathType="Plus" Command="{Binding AddEventCommand}" />
        <commonControls:BorderlessButton Grid.Column="1" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding GotoCurrentEventCommand}">
          <commonControls:ImageMask ImageSource="../Resources/Icons/Calendar_GoToCurrent.png" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type commonControls:BorderlessButton}}}" />
        </commonControls:BorderlessButton>
        <commonControls:BorderlessToggleButton Name="ToggleRecurrences" Grid.Column="2" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShowRecurrences, Mode=TwoWay}">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessToggleButton}}" TargetType="{x:Type commonControls:BorderlessToggleButton}">
              <Setter Property="Content">
                <Setter.Value>
                  <Image RenderOptions.BitmapScalingMode="Fant" Source="../Resources/Icons/Calendar_ShowRecurrences.png" StretchDirection="DownOnly" />
                </Setter.Value>
              </Setter>
              <Setter Property="IsEnabled" Value="True" />
              <Style.Triggers>
                <DataTrigger Value="0" Binding="{Binding Events.Count}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter Property="Content">
                    <Setter.Value>
                      <Image RenderOptions.BitmapScalingMode="Fant" Source="../Resources/Icons/Calendar_ShowRecurrencesOff.png" StretchDirection="DownOnly" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </commonControls:BorderlessToggleButton>
      </Grid>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" />
    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Background="{Binding OUTLINEDETAIL, Source={x:Static theming:AppTheme.Active}}">
      <Grid>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <commonControls:EditableTextBlock Grid.Row="0" Margin="20,0" FontSize="20" FontWeight="SemiBold" Text="{Binding EventName, Mode=TwoWay}" />
        <commonControls:PlaceholderTextBox Grid.Row="1" Height="22" Margin="20,10,10,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" BorderBrush="#00FFFFFF" IsTextBindingExplicit="True" PlaceholderText="{mex:Localized CALENDAR_VIEW_EVENT_DESCRIPTION_placeholder}" Text="{Binding Description}" />
        <Border Grid.Row="2" Background="{Binding OUTLINESOURCE, Source={x:Static theming:AppTheme.Active}}">
          <Grid Margin="20,10,10,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20" FontSize="20" FontWeight="SemiBold" Text="{mex:Localized CALENDAR_VIEW_EVENT_SCHEDULE_title}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,5,5" HorizontalAlignment="Right" Text="{mex:Localized CALENDAR_VIEW_EVENT_STARTS_label}" />
            <commonControls:DateTimePicker Name="StartDateDatePicker" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,0,5" HorizontalAlignment="Left" Background="#00FFFFFF" BorderBrush="#00FFFFFF" xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib" DefaultValue="{x:Static system1:DateTime.Now}" Format="Custom" ShowButtonSpinner="False" ShowDropDownButton="False" UpdateValueOnEnterKey="True" FormatString="{Binding Source={x:Static local:CalendarView.DateFormat}}" Value="{Binding StartDate, Mode=TwoWay}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,5,10" HorizontalAlignment="Right" Text="{mex:Localized CALENDAR_VIEW_EVENT_REPEATS_label}" />
            <ItemsControl Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Left" HorizontalContentAlignment="Left" BorderBrush="{Binding BUTTON_BORDER, Source={x:Static theming:AppTheme.Active}}">
              <ItemsControl.ItemsSource>
                <CompositeCollection>
                  <calendarDO:EventDay>Sunday</calendarDO:EventDay>
                  <calendarDO:EventDay>Monday</calendarDO:EventDay>
                  <calendarDO:EventDay>Tuesday</calendarDO:EventDay>
                  <calendarDO:EventDay>Wednesday</calendarDO:EventDay>
                  <calendarDO:EventDay>Thursday</calendarDO:EventDay>
                  <calendarDO:EventDay>Friday</calendarDO:EventDay>
                  <calendarDO:EventDay>Saturday</calendarDO:EventDay>
                </CompositeCollection>
              </ItemsControl.ItemsSource>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton BorderThickness="1,1,0,1" Command="{Binding Data.SetDaysCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}" Content="{Binding Converter={StaticResource EnumToContentConverter}}">
                    <ToggleButton.IsChecked>
                      <MultiBinding Converter="{StaticResource CheckEventDayConverter}" Mode="OneWay">
                        <Binding Path="Data.RecurrenceDays" Source="{StaticResource vmProxy}" />
                        <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
                      </MultiBinding>
                    </ToggleButton.IsChecked>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
              <CheckBox Name="CheckBoxEndsOn" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="{mex:Localized CALENDAR_VIEW_EVENT_ENDS_label}" IsChecked="{Binding CanEnd, Mode=TwoWay}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                      <DataTrigger Value="Unknown" Binding="{Binding RecurrenceDays}">
                        <Setter Property="ToggleButton.IsChecked" Value="False" />
                        <Setter Property="IsEnabled" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </CheckBox>
              <commonControls:DateTimePicker Name="EndDateDatePicker" Height="22" HorizontalAlignment="Left" Background="#00FFFFFF" BorderBrush="#00FFFFFF" DefaultValue="{x:Static DateTime.Now}" Format="Custom" ShowButtonSpinner="False" ShowDropDownButton="False" UpdateValueOnEnterKey="True" FormatString="{Binding Source={x:Static local:CalendarView.DateFormat}}" IsEnabled="{Binding CanEnd}" Value="{Binding EndDate, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Row="3" Margin="20,10,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" FontSize="20" FontWeight="SemiBold" Text="{mex:Localized CALENDAR_VIEW_EVENT_ACTION_title}" />
          <Grid Row="1" Margin="30,0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:CalendarActionSelector Grid.Row="0" Grid.Column="0" DataContext="{Binding}" />
            <Button Grid.RowSpan="2" Grid.Column="1" Width="60" Height="22" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" Command="{Binding TestCommand}" Content="{mex:Localized CALENDAR_VIEW_EVENT_ACTION_TEST_BUTTON_title}" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>