<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PropGroups.PropCustomClearTime" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="propCustomClearTime" xmlns:propgroups="clr-namespace:ProPresenter.UI.PropGroups;assembly=ProPresenter.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" HorizontalAlignment="Center" Text="{mex:Localized PROP_CONTROL_DECK_CONTEXTUAL_MENU_AUTO_CLEAR_ALERT_message}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <commonControls:DoubleUpDown Name="TimeControl" Width="100" Height="22" Margin="0,10,0,0" HorizontalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Maximum="360" Minimum="0" ShowButtonSpinner="False" Text="{Binding CustomTime, ElementName=propCustomClearTime, StringFormat={}{0:F1}}" />
      <TextBlock Margin="4,6,0,0" VerticalAlignment="Center" Text="{mex:Localized PROP_EDITOR_AUTO_CLEAR_INSPECTOR_SECONDS_LABEL_title}" />
    </StackPanel>
  </Grid>
</UserControl>