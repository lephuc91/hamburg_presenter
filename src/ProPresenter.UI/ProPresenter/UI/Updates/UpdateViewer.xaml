<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Updates.UpdateViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:webView2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="updateViewer" Width="750" Height="600" uiUtility:WindowHelper.CanOwnWindows="True" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.HideOnClose="True" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" xmlns:updates="clr-namespace:ProPresenter.UI.Updates" Title="{mex:Localized UPDATES_NEW_VERSION_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:FormattedLocalizedStringMultiConverter x:Key="FormattedLocalizedStringMultiConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" />
      </Style>
      <Style x:Key="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="10,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Image Grid.Row="0" Grid.RowSpan="5" Grid.Column="0" Width="70" Height="70" Margin="0,0,20,0" VerticalAlignment="Top" Source="{StaticResource {x:Static themesUI:Icons.AppIcon}}" />
    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Text="{mex:Localized UPDATES_NEW_VERSION_AVAILABLE_label}" />
    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap">
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource FormattedLocalizedStringMultiConverter}" ConverterParameter="UPDATES_NEW_VERSION_DOWNLOAD_label">
          <Binding Path="NewVersion" />
          <Binding Path="InstalledVersion" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" Text="{mex:Localized UPDATES_NEW_VERSION_RELEASE_NOTES_label}" />
    <Grid Row="3" Column="1">
      <Border Margin="0,5" BorderThickness="1" BorderBrush="{Binding OUTLINEDETAIL, Source={x:Static theming:AppTheme.Active}}">
        <webView2:WebView2 Name="webView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      </Border>
    </Grid>
    <Grid Row="4" Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Name="btnSkipVersion" Grid.Column="0" HorizontalAlignment="Left" Command="{Binding SkipThisVersionCommand}" Content="{mex:Localized UPDATES_NEW_VERSION_SKIP_title}" Click="CloseDialog_Click" />
      <Button Name="btnRemindMeLater" Grid.Column="1" Margin="0,0,10,0" HorizontalAlignment="Right" Content="{mex:Localized UPDATES_NEW_VERSION_LATER_title}" Click="CloseDialog_Click" />
      <Button Name="btnIntallUpdate" Grid.Column="2" HorizontalAlignment="Right" IsDefault="True" Command="{Binding DownloadUpdateCommand}" Content="{mex:Localized UPDATES_NEW_VERSION_INSTALL_title}" Click="CloseDialog_Click" />
    </Grid>
  </Grid>
</windowing:ChromedWindow>