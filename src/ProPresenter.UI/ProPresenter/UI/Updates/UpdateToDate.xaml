<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Updates.UpdateToDate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="upToDate" Width="500" xmlns:updates="clr-namespace:ProPresenter.UI.Updates;assembly=ProPresenter.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Margin="0,10,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontWeight="Bold" Text="{mex:Localized UPDATES_UP_TO_DATE_label}" />
    <TextBlock Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Version, ElementName=upToDate}" />
  </Grid>
</UserControl>