<?xml version="1.0" encoding="utf-8"?>
<windowing:ChromedWindow x:Class="ProPresenter.UI.Updates.DownloadUpdate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPresenter.UI.Updates" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:windowing="clr-namespace:Pro.UI.Controls.Windowing;assembly=Pro.UI" x:Name="downloadUpdate" Width="500" uiUtility:WindowHelper.ChildOf="MainWindow" uiUtility:WindowHelper.UseGlobalStyle="True" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource {x:Type windowing:ChromedWindow}}" WindowStartupLocation="CenterOwner" Title="{mex:Localized UPDATES_DOWNLOAD_title}" Resources="{local:FormatDownloadedBytesConverter Key=FormatDownloadedBytesConverter}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Name="tbStatus" Grid.Row="0" Margin="0,10,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontWeight="Bold">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="Text" Value="{mex:Localized UPDATES_DOWNLOAD_DOWNLOADING_UPDATE_label}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding DownloadSuccessful}">
              <Setter Property="Text" Value="{mex:Localized UPDATES_DOWNLOAD_READY_TO_INSTALL_title}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <TextBlock Name="tbError" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" Visibility="Collapsed" Text="{mex:Localized UPDATES_DOWNLOAD_ERROR_label}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding DownloadSuccessful}" />
                <Condition Value="True" Binding="{Binding DownloadComplete}" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.Setters>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger.Setters>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <ProgressBar Name="pbDownload" Grid.Row="1" Height="20" Margin="0,0,0,10" HorizontalAlignment="Stretch" Maximum="100" Minimum="0" Value="{Binding PercentComplete, Mode=OneWay}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type ProgressBar}}" TargetType="{x:Type ProgressBar}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding DownloadSuccessful}" />
                <Condition Value="True" Binding="{Binding DownloadComplete}" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.Setters>
                <Setter Property="Visibility" Value="Collapsed" />
              </MultiDataTrigger.Setters>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ProgressBar>
    <TextBlock Name="tbDownloadStatus" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource FormatDownloadedBytesConverter}">
          <Binding Path="BytesDownloaded" />
          <Binding Path="TotalBytes" />
        </MultiBinding>
      </TextBlock.Text>
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding DownloadComplete}">
              <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Button Name="btnCancel" Grid.Row="3" Height="22" MinWidth="80" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CancelCommand}" Content="{mex:Localized GLOBAL_CANCEL_BUTTON_title}" Click="CloseDialog_Click">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding DownloadComplete}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
    <Button Name="btnInstall" Grid.Row="3" Height="22" MinWidth="80" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding InstallCommand}" Content="{mex:Localized UPDATES_DOWNLOAD_INSTALL_AND_RELAUNCH_title}" Click="CloseDialog_Click">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding DownloadSuccessful}">
              <Setter Property="Button.IsDefault" Value="True" />
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </Grid>
</windowing:ChromedWindow>