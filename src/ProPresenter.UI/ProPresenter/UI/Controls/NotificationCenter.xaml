<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Controls.NotificationCenter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:proConverters="clr-namespace:ProPresenter.UI.Converters" xmlns:proUIThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels.Notification" xmlns:controls1="clr-namespace:ProPresenter.UI.Controls" DataContext="{di:DIMarkup {x:Type viewModels:INotificationCollectionVM}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <converters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" IsInverted="True" />
      <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <CollectionViewSource x:Key="SortedNotifications" Source="{Binding Notifications}">
        <CollectionViewSource.SortDescriptions>
          <componentModel:SortDescription componentModel:SortDescription.Direction="Descending" componentModel:SortDescription.PropertyName="CreatedAt" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <controls:ToolBarToggleButton Name="NotificationsButton" IconSize="Large" IsChecked="{Binding IsPopUpOpen}" IsHitTestVisible="{Binding ElementName=NotificationsPopup, Path=IsOpen, Converter={StaticResource InvertedBooleanConverter}}" Label="{markupExtensions:Localized IN_APP_NOTIFICATIONS_title}" Visibility="{Binding AnyNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type controls:ToolBarToggleButton}}" TargetType="{x:Type controls:ToolBarToggleButton}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding UnreadNotifications}">
              <Setter Property="controls:ToolBarToggleButton.Icon" Value="{StaticResource {x:Static proUIThemes:Icons.NotificationsUnread}}" />
            </DataTrigger>
            <DataTrigger Value="False" Binding="{Binding UnreadNotifications}">
              <Setter Property="controls:ToolBarToggleButton.Icon" Value="{StaticResource {x:Static proUIThemes:Icons.Notifications}}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </controls:ToolBarToggleButton>
    <controls:AnchoredPopup Name="NotificationsPopup" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowsTransparency="True" HorizontalOffset="-200" Placement="Bottom" StaysOpen="False" IsOpen="{Binding IsPopUpOpen}" PlacementTarget="{Binding ElementName=NotificationsButton}">
      <Border Padding="10">
        <Border Width="270" BorderThickness="1" CornerRadius="5" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding PRIMARYLIGHT, Source={x:Static theming:AppTheme.Active}}">
          <UIElement.Effect>
            <DropShadowEffect Opacity="0.2" />
          </UIElement.Effect>
          <Grid Margin="5">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Row="0" Margin="8,8,8,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" FontWeight="Bold" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{markupExtensions:Localized IN_APP_NOTIFICATIONS_title}" />
              <controls:BorderlessButton Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Command="{Binding MarkAllAsReadCommand}">
                <TextBlock Text="{markupExtensions:Localized IN_APP_NOTIFICATIONS_MARK_ALL_READ_button}" />
              </controls:BorderlessButton>
            </Grid>
            <Border Grid.Row="1" MinHeight="250" Visibility="{Binding Notifications.Count, Converter={StaticResource InvertedCountToVisibilityConverter}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Foreground>
                  <SolidColorBrush Color="{StaticResource {x:Static proUIThemes:Colors.PrimaryLight}}" />
                </TextBlock.Foreground>
                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{markupExtensions:Localized IN_APP_NOTIFICATIONS_NO_NOTIFICATIONS_title}" />
                <TextBlock Margin="10" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{markupExtensions:Localized IN_APP_NOTIFICATIONS_NO_NOTIFICATIONS_label}" />
              </StackPanel>
            </Border>
            <ScrollViewer Name="NotificationsScrollViewer" Grid.Row="1" Height="320" VerticalScrollBarVisibility="Auto">
              <ItemsControl Name="NotificationsList" VerticalAlignment="Stretch" Background="#00FFFFFF" BorderBrush="#00FFFFFF" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Hidden" VirtualizingPanel.ScrollUnit="Pixel" ItemsSource="{Binding Source={StaticResource SortedNotifications}}" Visibility="{Binding Notifications, Converter={StaticResource InvertedCountToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="240">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                      </Grid.RowDefinitions>
                      <Ellipse Width="10" Height="10" Margin="5" Fill="#FF007AFF">
                        <FrameworkElement.Style>
                          <Style>
                            <Style.Triggers>
                              <DataTrigger Value="true" Binding="{Binding IsRead}">
                                <Setter Property="UIElement.Visibility" Value="Hidden" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Ellipse>
                      <TextBlock Grid.Row="0" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" FontWeight="Bold" TextWrapping="Wrap" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Header, Mode=OneTime}" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Margin="2" TextWrapping="Wrap" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding Body, Mode=OneTime}" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Margin="2" FontWeight="Bold" Visibility="{Binding UrlDisplayText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                        <Hyperlink Command="{Binding ShowLinkCommand}">
                          <TextBlock Text="{Binding UrlDisplayText}">
                            <TextBlock.Foreground>
                              <SolidColorBrush Color="{StaticResource {x:Static proUIThemes:Colors.Secondary}}" />
                            </TextBlock.Foreground>
                          </TextBlock>
                        </Hyperlink>
                      </TextBlock>
                      <TextBlock Grid.Row="3" Grid.Column="1" Margin="2" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding CreatedAt, Mode=OneTime, StringFormat=g}">
                        <TextBlock.Foreground>
                          <SolidColorBrush Color="{StaticResource {x:Static proUIThemes:Colors.PrimaryLight}}" />
                        </TextBlock.Foreground>
                      </TextBlock>
                      <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{proConverters:IsLastItemToVisibilityConverter}">
                            <Binding />
                            <Binding ElementName="NotificationsList" Path="ItemsSource" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Separator>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Border>
    </controls:AnchoredPopup>
  </Grid>
</UserControl>