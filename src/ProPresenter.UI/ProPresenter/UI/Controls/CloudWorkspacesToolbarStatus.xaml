<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Controls.CloudWorkspacesToolbarStatus" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:accountCenter="clr-namespace:ProPresenter.UI.ViewModels.AccountCenter" xmlns:cloudWorkspaces="clr-namespace:ProPresenter.UI.CloudWorkspaces" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:dependencyInjection="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:mediaService="clr-namespace:Pro.CoreApplication.Media.V1;assembly=Pro.CoreApplication" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:viewModels="clr-namespace:ProPresenter.UI.ViewModels" xmlns:controls1="clr-namespace:ProPresenter.UI.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:ValueToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" IsInverted="True" />
      <converters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <Style x:Key="SectionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource SectionTextStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,5,0,5" />
      </Style>
      <Style x:Key="PauseTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border MinWidth="200" Padding="10" BorderThickness="1" CornerRadius="5" Background="{Binding DETAILLIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" BorderBrush="{Binding PRIMARYLIGHT, Source={x:Static theming:AppTheme.Active}}">
    <UIElement.Effect>
      <DropShadowEffect Opacity="0.2" />
    </UIElement.Effect>
    <StackPanel>
      <Button Padding="0" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" Command="{Binding ShowRegistrationCommand, Source={dependencyInjection:DIMarkup {x:Type viewModels:IMainLayoutVM}}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}">
                  <Setter Property="Foreground" Value="{Binding SECONDARY, Source={x:Static theming:AppTheme.Active}}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <StackPanel Orientation="Horizontal">
          <Image Width="32" Height="32" Margin="0,0,10,0" Source="{Binding Icon.Value}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding ListItemTitle.Value}" />
            <TextBlock Text="{Binding ListItemSubscript.Value}" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Separator Margin="0,5" />
      <DockPanel Margin="0,5" LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTextStyle}" Text="{markupExtensions:Localized TOOLBAR_WORKSPACE_HEADER_title}" />
        <cloudWorkspaces:CloudWorkspaceControl HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" DockPanel.Dock="Right" />
      </DockPanel>
      <StackPanel Visibility="{Binding IsRegistered.Value, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Separator Margin="0,5" />
        <Grid Margin="0,5,0,0" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" Text="{markupExtensions:Localized CLOUDWORKSPACE_SYNC_STATUS_label}" />
          <cloudWorkspaces:SyncStatusIndicator Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right" DataContext="{Binding}" />
          <controls:HelpButton Grid.Row="0" Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center" HelpCommand="{Binding CloudTroubleShootingLinkCommand}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type commonControls:HelpButton}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="{x:Static accountCenter:SyncStatus.Offline}" Binding="{Binding CloudSyncStatus.Value}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </controls:HelpButton>
          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Text="{Binding LastActiveSync.Value}" Visibility="{Binding IsCloudSyncPaused.Value, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
        <controls:BorderlessDropDownButton HorizontalAlignment="Center" Visibility="{Binding IsCloudSyncPaused.Value, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
          <controls:BorderlessDropDownButton.CustomContent>
            <TextBlock Margin="2,0,5,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{markupExtensions:Localized CLOUDWORKSPACE_PAUSE_SYNC_title}" />
          </controls:BorderlessDropDownButton.CustomContent>
          <controls:BorderlessDropDownButton.CustomContextMenu>
            <ContextMenu ItemContainerStyle="{StaticResource {x:Type MenuItem}}" Placement="Bottom" Style="{StaticResource {x:Type ContextMenu}}" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
              <MenuItem CommandParameter="{x:Static mediaService:PauseGenerationOptions.ONE_HOUR}" Command="{Binding PauseCloudSyncCommand}" Header="{markupExtensions:Localized MEDIA_MANAGEMENT_PAUSE_ONE_HOUR_title}" />
              <MenuItem CommandParameter="{x:Static mediaService:PauseGenerationOptions.EOD}" Command="{Binding PauseCloudSyncCommand}" Header="{markupExtensions:Localized MEDIA_MANAGEMENT_PAUSE_UNTIL_EOD_title}" />
              <MenuItem CommandParameter="{x:Static mediaService:PauseGenerationOptions.TWENTY_FOUR_HOURS}" Command="{Binding PauseCloudSyncCommand}" Header="{markupExtensions:Localized MEDIA_MANAGEMENT_PAUSE_TWENTY_FOUR_HOURS_title}" />
            </ContextMenu>
          </controls:BorderlessDropDownButton.CustomContextMenu>
        </controls:BorderlessDropDownButton>
        <StackPanel Margin="0,5" Visibility="{Binding IsCloudSyncPaused.Value, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Separator Margin="0,0,0,5" />
          <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource PauseTextStyle}" Text="{markupExtensions:Localized CLOUDWORKSPACE_PAUSED_SYNC_title}" />
            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource PauseTextStyle}" Text="{Binding PausedSyncCountdown.Value}" />
            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0" Padding="5" Command="{Binding ResumeCloudSyncCommand}" Content="{markupExtensions:Localized CLOUDWORKSPACE_RESUME_SYNC_title}" />
          </Grid>
        </StackPanel>
        <StackPanel Visibility="{Binding IsCloudSyncPaused.Value, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
          <Separator Margin="0,5" />
          <cloudWorkspaces:CloudWorkspaceCollaboratorsControl Margin="0,5" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>