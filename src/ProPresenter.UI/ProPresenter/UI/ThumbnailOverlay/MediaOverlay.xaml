<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ThumbnailOverlay.MediaOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.ThumbnailOverlay" x:Name="mediaOverlay">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <DataTemplate x:Key="MissingMediaTemplate">
        <local:MissingMedia AllowOpenVideoInputSetup="{Binding ElementName=mediaOverlay, Path=AllowOpenVideoInputSetup}" RingGrid="{Binding ElementName=mediaOverlay, Path=RingGrid, Mode=TwoWay}" RingSize="{Binding ElementName=mediaOverlay, Path=RingSize}" ShowText="{Binding ElementName=mediaOverlay, Path=ShowText}" />
      </DataTemplate>
      <DataTemplate x:Key="CloudMissingMediaTemplate">
        <local:CloudMissingMedia AllowOpenVideoInputSetup="{Binding ElementName=mediaOverlay, Path=AllowOpenVideoInputSetup}" RingGrid="{Binding ElementName=mediaOverlay, Path=RingGrid, Mode=TwoWay}" RingSize="{Binding ElementName=mediaOverlay, Path=RingSize}" ShowText="{Binding ElementName=mediaOverlay, Path=ShowText}" />
      </DataTemplate>
      <DataTemplate x:Key="MissingIconOnlyTemplate">
        <local:MissingIconOnly RingGrid="{Binding ElementName=mediaOverlay, Path=RingGrid, Mode=TwoWay}" RingSize="{Binding ElementName=mediaOverlay, Path=RingSize}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FF000000" Opacity="0.5" Visibility="{Binding IsValid.Value, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
    <ContentControl Name="MainContent" Content="{Binding}" />
  </Grid>
</UserControl>