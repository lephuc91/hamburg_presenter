<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ThumbnailOverlay.MissingMediaRing" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ThumbnailOverlay" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:vm="clr-namespace:ProPresenter.UI.ViewModels.Thumbnails">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Image}">
          <Setter Property="Source" Value="{StaticResource {x:Static uiThemes:Icons.MissingFileRing}}" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="Remote" Binding="{Binding InvalidMediaType.Value}" />
                <Condition Value="False" Binding="{Binding Type, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:OverlayType.MissingIconWithScrim}}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Source" Value="{StaticResource {x:Static uiThemes:Icons.ProContentRingLarge}}" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Image>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="{x:Static local:OverlayGridHeightConstants.RingCenterMarginRowHeight}" />
        <RowDefinition Height="{x:Static local:OverlayGridHeightConstants.RingCenterRowHeight}" />
        <RowDefinition Height="{x:Static local:OverlayGridHeightConstants.RingCenterMarginRowHeight}" />
      </Grid.RowDefinitions>
      <commonControls:ImageMask Grid.Row="1" Fill="{Binding LIGHTCONTENT, Source={x:Static theming:AppTheme.Active}}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type commonControls:ImageMask}">
            <Setter Property="commonControls:ImageMask.ImageSource" Value="{StaticResource {x:Static uiThemes:Icons.QuestionMark}}" />
            <Style.Triggers>
              <DataTrigger Value="Remote" Binding="{Binding InvalidMediaType.Value}">
                <Setter Property="commonControls:ImageMask.ImageSource" Value="{StaticResource {x:Static uiThemes:Icons.DownloadArrow}}" />
              </DataTrigger>
              <DataTrigger Value="MissingIconWithScrim" Binding="{Binding Type}">
                <Setter Property="commonControls:ImageMask.ImageSource" Value="{StaticResource {x:Static uiThemes:Icons.QuestionMark}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:ImageMask>
    </Grid>
  </Grid>
</UserControl>