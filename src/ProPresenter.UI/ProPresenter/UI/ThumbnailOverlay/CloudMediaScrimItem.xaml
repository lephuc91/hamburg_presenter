<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ThumbnailOverlay.CloudMediaScrimItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ThumbnailOverlay" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=Propresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:thumbnailVM="clr-namespace:ProPresenter.UI.ViewModels.Thumbnails" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Height="16" Margin="0,1,1,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00FFFFFF" ToolTip="{mex:Localized PRESENTATION_MEDIA_ACTION_DOWNLOAD_IN_PROGRESS_tooltip}">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Grid}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="Visible" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}" />
              <Condition Value="{x:Static media:MediaAvailability.Downloading}" Binding="{Binding CloudMediaAvailability.Value}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="Visible" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}" />
              <Condition Value="Remote" Binding="{Binding InvalidMediaType.Value}" />
              <Condition Value="{x:Static media:MediaAvailability.Missing}" Binding="{Binding CloudMediaAvailability.Value}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <commonControls:DownloadInProgressIndicator UseSmallRing="True" />
  </Grid>
</UserControl>