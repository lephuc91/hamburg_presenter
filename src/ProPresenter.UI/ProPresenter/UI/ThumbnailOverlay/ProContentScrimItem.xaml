<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ThumbnailOverlay.ProContentScrimItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ThumbnailOverlay" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:thumbnailVM="clr-namespace:ProPresenter.UI.ViewModels.Thumbnails" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Width="20" Height="20" Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00FFFFFF">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Grid}">
        <Setter Property="FrameworkElement.ToolTip" Value="{mex:Localized PRESENTATION_MEDIA_ACTION_DOWNLOAD_PROCONTENT_tooltip}" />
        <Setter Property="Visibility" Value="{Binding IsValid.Value, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        <Style.Triggers>
          <DataTrigger Value="Active" Binding="{Binding DownloadProgress.Value.Status}">
            <Setter Property="FrameworkElement.ToolTip" Value="{mex:Localized PRESENTATION_MEDIA_ACTION_DOWNLOAD_IN_PROGRESS_tooltip}" />
          </DataTrigger>
          <DataTrigger Value="Visible" Binding="{Binding Mode=OneTime, Source={mex:FeatureFlag Cloud}}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <Grid>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="{Binding InvalidMediaType.Value, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static thumbnailVM:InvalidMediaType.Remote}}" />
          <Style.Triggers>
            <DataTrigger Value="Active" Binding="{Binding DownloadProgress.Value.Status}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Image Source="{StaticResource {x:Static themesUI:Icons.ProContentRingSmall}}" />
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" />
          <RowDefinition Height="4*" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Image Grid.Row="1" Source="{StaticResource {x:Static themesUI:Icons.DownloadArrow}}" />
      </Grid>
    </Grid>
    <local:ProContentDownloadProgress UseSmallRing="True" DownloadProgress="{Binding DownloadProgress.Value}" />
  </Grid>
</UserControl>