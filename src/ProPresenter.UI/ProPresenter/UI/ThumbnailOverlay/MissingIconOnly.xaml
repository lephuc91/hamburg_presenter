<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ThumbnailOverlay.MissingIconOnly" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ThumbnailOverlay">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="IconGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid.RowDefinitions>
      <RowDefinition local:RingGridRowHelper.RingRowMargin="{Binding Path=RingSize, RelativeSource={RelativeSource AncestorType={x:Type local:MissingIconOnly}}}" />
      <RowDefinition local:RingGridRowHelper.RingRow="{Binding Path=RingSize, RelativeSource={RelativeSource AncestorType={x:Type local:MissingIconOnly}}}" />
      <RowDefinition local:RingGridRowHelper.RingRowMargin="{Binding Path=RingSize, RelativeSource={RelativeSource AncestorType={x:Type local:MissingIconOnly}}}" />
    </Grid.RowDefinitions>
    <local:MissingMediaRing Grid.Row="1" Visibility="{Binding IsValid.Value, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
  </Grid>
</UserControl>