<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Welcome.CreateWorkspacePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:converters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:markupExtensions="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" Background="#00FFFFFF" xmlns:welcome="clr-namespace:ProPresenter.UI.Welcome;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ProPresenter.UI;component/CloudOnboarding/CloudOnboardingResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
        <TextBlock Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="36" FontWeight="Bold" Foreground="{StaticResource CloudOnboarding.TitleBrush}" TextWrapping="Wrap" Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_title}" />
        <TextBlock MaxWidth="600" Margin="0,0,0,30" HorizontalAlignment="Center" FontSize="20" Foreground="{StaticResource CloudOnboarding.BodyBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_subtitle}" />
        <Border Width="500" Margin="0,0,0,24" Padding="24" BorderBrush="{StaticResource CloudOnboarding.SubtleBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource CloudOnboarding.SubtleBrush}" Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_FIELD_title}" />
              <Border Grid.Column="1" Background="{StaticResource CloudOnboarding.InputBackgroundBrush}" BorderBrush="{StaticResource CloudOnboarding.SubtleBrush}" BorderThickness="1" CornerRadius="4">
                <TextBox Padding="10,6" Background="#00FFFFFF" BorderThickness="0" FontSize="16" Foreground="{StaticResource CloudOnboarding.PrimaryBrush}" MaxLength="248" IsEnabled="{Binding IsCreatingWorkspace, Converter={StaticResource InvertedBooleanConverter}}" Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" DataObject.Pasting="TextBox_Pasting" PreviewTextInput="TextBox_PreviewTextInput" />
              </Border>
            </Grid>
          </StackPanel>
        </Border>
        <Grid Width="650">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Grid.Column="0" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" Source="{StaticResource {x:Static themesUI:Icons.CloudWorkspace}}" Stretch="Uniform" />
          <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Left" Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_CLOUD_WORKSPACE_title}" />
            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource CloudOnboarding.BodyBrush}" TextAlignment="Left" TextWrapping="Wrap">
              <Run Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_CLOUD_WORKSPACE_NO_HYPERLINK_subtitle}" /> <Hyperlink Foreground="{StaticResource CloudOnboarding.HyperlinkBrush}" Command="{Binding OpenLearnMoreCommand}"><Run Text="{markupExtensions:Localized CLOUD_ONBOARDING_RETURNING_USERS_VALUE_PAGE_learn_more}" /></Hyperlink></TextBlock>
          </StackPanel>
          <Button Grid.Row="0" Grid.Column="4" Padding="10,4" VerticalAlignment="Center" IsDefault="True" Command="{Binding ContinueWithCloudCommand}" Content="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_CLOUD_WORKSPACE_BUTTON_title}" IsEnabled="{Binding CanCreateCloudWorkspace}" />
          <Image Grid.Row="2" Grid.Column="0" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" Source="{StaticResource {x:Static themesUI:Icons.LocalWorkspace}}" Stretch="Uniform" />
          <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="SemiBold" TextAlignment="Left" Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_LOCAL_WORKSPACE_title}" />
            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource CloudOnboarding.BodyBrush}" TextAlignment="Left" TextWrapping="Wrap" Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_LOCAL_WORKSPACE_subtitle}" />
          </StackPanel>
          <Button Grid.Row="2" Grid.Column="4" Padding="10,4" VerticalAlignment="Center" Command="{Binding ContinueWithLocalCommand}" Content="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_LOCAL_WORKSPACE_BUTTON_title}" IsEnabled="{Binding CanCreateLocalWorkspace}" />
        </Grid>
        <controls:LoadingIndicator Width="40" Height="40" Margin="0,20,0,0" HorizontalAlignment="Center" DisplayMode="Spinner" Visibility="{Binding IsCreatingWorkspace, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Margin="0,20,0,0" FontSize="14" Foreground="{StaticResource CloudOnboarding.SubtleBrush}" TextAlignment="Center">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsCreatingWorkspace}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Run Text="{markupExtensions:Localized ONBOARDING_CREATE_WORKSPACE_footer}" />
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>