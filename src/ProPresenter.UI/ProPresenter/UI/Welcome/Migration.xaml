<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Welcome.Migration" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Welcome" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
      <Style x:Key="MigrationCheckBoxStyle" BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Width="600" HorizontalAlignment="Center">
    <Grid Visibility="{Binding Status, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static local:MigrationStatus.Init}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,40" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" TextWrapping="Wrap" Text="{mex:Localized WELCOME_WINDOW_MIGRATE_label}" />
      <TextBlock Name="LabelLibraries" Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Text="{mex:Localized WELCOME_WINDOW_MIGRATE_LIBRARIES_label}" />
      <Border Grid.Row="2" Width="600" Height="162" Margin="0,0,0,30" BorderThickness="1" CornerRadius="8" BorderBrush="{Binding (uiUtility:UIElementHelper.Palette).Standard.Border, RelativeSource={RelativeSource Self}}">
        <ScrollViewer Margin="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Background="{Binding CONTAINER, Source={x:Static theming:AppTheme.Active}}" ItemsSource="{Binding Libraries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="0,0,0,1" BorderBrush="{Binding (uiUtility:UIElementHelper.Palette).Standard.Border, RelativeSource={RelativeSource Self}}">
                  <CheckBox Grid.Column="0" Margin="5" Content="{Binding SourceFolder}" IsChecked="{Binding ShouldImport, Mode=TwoWay}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <TextBlock Grid.Row="4" Margin="20,0,0,12" HorizontalAlignment="Center" FontSize="16" IsHitTestVisible="False" TextWrapping="Wrap" Text="{mex:Localized WELCOME_WINDOW_MIGRATE_SELECTED_LIBRARY_label}" />
      <StackPanel Grid.Row="5" HorizontalAlignment="Center" Orientation="Vertical">
        <CheckBox Margin="0,0,0,10" FontSize="16" Style="{StaticResource MigrationCheckBoxStyle}" Content="{mex:Localized WELCOME_WINDOW_MIGRATE_PLAYLISTS_label}" IsChecked="{Binding Playlists, Mode=TwoWay}" IsEnabled="{Binding CanMigrateLibraryPlaylists}" />
        <CheckBox Margin="0,0,0,10" FontSize="16" Style="{StaticResource MigrationCheckBoxStyle}" Content="{mex:Localized WELCOME_WINDOW_MIGRATE_MEDIA_label}" IsChecked="{Binding MediaBin, Mode=TwoWay}" />
        <CheckBox Margin="0,0,0,10" FontSize="16" Style="{StaticResource MigrationCheckBoxStyle}" Content="{mex:Localized WELCOME_WINDOW_MIGRATE_AUDIO_label}" IsChecked="{Binding AudioBin, Mode=TwoWay}" />
        <CheckBox FontSize="16" Style="{StaticResource MigrationCheckBoxStyle}" Content="{mex:Localized WELCOME_WINDOW_MIGRATE_SETTINGS_label}" IsChecked="{Binding SettingsSupportFiles, Mode=TwoWay}" />
      </StackPanel>
      <commonControls:BorderlessButton Grid.Row="6" Margin="0,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Hand" FontSize="20" Command="{Binding MigrationHelpCommand}" Foreground="{Binding TOGGLESWITCH_PALETTE.Checked.Background, Source={x:Static theming:AppTheme.Active}}">
        <TextBlock TextWrapping="Wrap" Text="{mex:Localized WELCOME_WINDOW_MIGRATE_HELP_LINK_title}" />
      </commonControls:BorderlessButton>
    </Grid>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding Status, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static local:MigrationStatus.Init}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" TextWrapping="Wrap" Text="{mex:Localized WELCOME_WINDOW_MIGRATE_label}" />
      <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Orientation="Vertical">
        <TextBlock Margin="0,0,0,5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{mex:Localized WELCOME_WINDOW_MIGRATE_IN_PROGRESS_label}" />
              <Style.Triggers>
                <DataTrigger Value="{x:Static local:MigrationStatus.Completed}" Binding="{Binding Status}">
                  <Setter Property="Text" Value="{mex:Localized WELCOME_WINDOW_MIGRATE_COMPLETE_label}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <ProgressBar HorizontalAlignment="Stretch" Value="100" />
        </TextBlock>
        <ProgressBar Height="5" Maximum="1.0" Minimum="0.0" Foreground="{Binding TOGGLESWITCH_PALETTE.Checked.Background, Source={x:Static theming:AppTheme.Active}}" Value="{Binding ImportProgress, Mode=OneWay}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>