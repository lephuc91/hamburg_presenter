<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Welcome.AdditionalResourceButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:proUIThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" x:Name="resourceButton" xmlns:welcome="clr-namespace:ProPresenter.UI.Welcome;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AdditionalResourceButton.BorderBrush" Color="{DynamicResource {x:Static proUIThemes:Colors.Shadow}}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Width="320" Height="140" Margin="15">
    <Border BorderBrush="{StaticResource AdditionalResourceButton.BorderBrush}" BorderThickness="1" CornerRadius="15" Background="{Binding BackgroundColor, ElementName=resourceButton}" Opacity="{Binding BackgroundOpacity, ElementName=resourceButton}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Setter Property="Background" Value="{Binding HoverBackgroundColor, ElementName=resourceButton}" />
              <Setter Property="UIElement.Opacity" Value="{Binding HoverBackgroundOpacity, ElementName=resourceButton}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Border>
    <commonControls:BorderlessButton Background="#00FFFFFF" Cursor="Hand" Command="{Binding Command, ElementName=resourceButton}">
      <Grid Margin="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <commonControls:ImageMask Grid.Column="0" Width="50" Height="50" Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding IconColor, ElementName=resourceButton}" ImageSource="{Binding Icon, ElementName=resourceButton}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontSize="18" FontWeight="SemiBold" TextAlignment="Left" TextWrapping="Wrap" Foreground="{Binding TitleForeground, ElementName=resourceButton}" Text="{Binding Title, ElementName=resourceButton}" />
          <TextBlock Margin="0,8,10,0" FontSize="13" TextAlignment="Left" TextWrapping="Wrap" Foreground="{Binding DescriptionForeground, ElementName=resourceButton}" Text="{Binding Description, ElementName=resourceButton}" />
        </StackPanel>
        <commonControls:ImageMask Grid.Column="2" Width="18" Height="18" Margin="20,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding AdditionalIconColor, ElementName=resourceButton}" ImageSource="{Binding AdditionalIcon, ElementName=resourceButton}" />
      </Grid>
    </commonControls:BorderlessButton>
  </Grid>
</UserControl>