<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Welcome.SampleContentPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:welcome="clr-namespace:ProPresenter.UI.Welcome">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
        <Style x:Key="{x:Type commonControls:BorderlessButton}" BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
          <Setter Property="FrameworkElement.Cursor" Value="Hand" />
          <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="30" Text="{mex:Localized WELCOME_WINDOW_START_CREATING_title}" />
    <Grid Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Row="1" Grid.Column="0" Margin="-60,30,0,10" Source="../Resources/Icons/Welcome/StartCreating.png" />
      <Grid Row="1" Column="1" Margin="10,0,25,0" VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,0,20" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" Text="{mex:Localized WELCOME_WINDOW_START_CREATING_EXPLORE_label}" />
        <Image Grid.Row="1" Margin="-30,0,0,20" Source="{StaticResource {x:Static themesUI:Icons.ProContentWordmark}}" />
        <commonControls:BorderlessButton Grid.Row="2" Margin="20,0,0,0" Cursor="Hand" FontSize="18" Command="{Binding OpenProContentCommand}" Foreground="{Binding TOGGLESWITCH_PALETTE.Checked.Background, Source={x:Static theming:AppTheme.Active}}">
          <TextBlock TextWrapping="Wrap" Text="{mex:Localized WELCOME_WINDOW_SCREEN_PROCONTENT_LINK_title}" />
        </commonControls:BorderlessButton>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
      <Button Width="420" Height="40" utility:UIElementHelper.CornerRadius="20" Command="{Binding GetSampleContentCommand}">
        <StackPanel Orientation="Horizontal">
          <commonControls:ImageMask Width="25" Height="25" Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" ImageSource="{StaticResource {x:Static themesUI:Icons.WelcomeDownload}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          <TextBlock VerticalAlignment="Center" FontSize="20" Text="{mex:Localized WELCOME_WINDOW_APPENDIX_SAMPLE_CONTENT_title}" />
          <commonControls:PieProgress Width="22" Height="22" Margin="20,0,0,0" HorizontalAlignment="Left" Fill="#cecece" Visibility="{Binding IsDownloading, Converter={StaticResource ValueToVisibilityConverter}}" Value="{Binding DownloadProgress}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>