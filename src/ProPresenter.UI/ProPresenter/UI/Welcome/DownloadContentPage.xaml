<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Welcome.DownloadContentPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" xmlns:utility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:welcome="clr-namespace:ProPresenter.UI.Welcome;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../CloudOnboarding/CloudOnboardingResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Margin="0,40,0,0" HorizontalAlignment="Center" FontSize="48" FontWeight="SemiBold" Foreground="{StaticResource CloudOnboarding.TitleBrush}" Text="{mex:Localized ONBOARDING_DOWNLOAD_CONTENT_title}" />
    <TextBlock Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="20" Foreground="{StaticResource CloudOnboarding.PrimaryBrush}" Text="{mex:Localized ONBOARDING_DOWNLOAD_CONTENT_subtitle}" />
    <Grid Row="2" Margin="0,40,0,40" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Margin="-60,0,0,10" Source="../Resources/Icons/Welcome/StartCreating.png" />
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Vertical">
        <Image Width="275" Margin="0,0,0,20" Source="{StaticResource {x:Static themesUI:Icons.ProContentWordmark}}" />
        <commonControls:BorderlessButton HorizontalAlignment="Center" Cursor="Hand" FontSize="16" Foreground="{StaticResource CloudOnboarding.HyperlinkBrush}" Command="{Binding OpenProContentCommand}">
          <TextBlock TextWrapping="Wrap" Text="{mex:Localized ONBOARDING_DOWNLOAD_CONTENT_LEARN_MORE_title}" />
        </commonControls:BorderlessButton>
      </StackPanel>
    </Grid>
    <Button Grid.Row="3" Width="300" Height="40" Margin="0,0,0,20" HorizontalAlignment="Center" utility:UIElementHelper.CornerRadius="10" Command="{Binding GetSampleContentCommand}">
      <StackPanel Orientation="Horizontal">
        <commonControls:ImageMask Width="20" Height="20" Margin="0,0,15,0" HorizontalAlignment="Center" VerticalAlignment="Center" ImageSource="{StaticResource {x:Static themesUI:Icons.WelcomeDownload}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <TextBlock VerticalAlignment="Center" FontSize="16" Text="{mex:Localized ONBOARDING_DOWNLOAD_CONTENT_DOWNLOAD_title}" />
        <commonControls:PieProgress Width="20" Height="20" Margin="15,0,0,0" HorizontalAlignment="Left" Fill="#cecece" Visibility="{Binding IsDownloading, Converter={StaticResource ValueToVisibilityConverter}}" Value="{Binding DownloadProgress}" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>