<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Welcome.Appendix" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.Welcome" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiThemes="clr-namespace:Pro.UI.Themes;assembly=Pro.UI">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="FontSize" Value="20" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="30" Text="{mex:Localized WELCOME_WINDOW_APPENDIX_title}" />
    <Grid Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <local:AppendixButton Grid.Row="0" Grid.Column="0" Icon="{StaticResource {x:Static uiThemes:Icons.WelcomeUserGroup}}" Title="{mex:Localized WELCOME_WINDOW_APPENDIX_FORUMS_title}" Command="{Binding UserGroupCommand}" />
      <local:AppendixButton Grid.Row="0" Grid.Column="1" Icon="{StaticResource {x:Static uiThemes:Icons.WelcomeTutorials}}" Title="{mex:Localized WELCOME_WINDOW_APPENDIX_TUTORIALS_title}" Command="{Binding TutorialsCommand}" />
      <local:AppendixButton Grid.Row="0" Grid.Column="2" Icon="{StaticResource {x:Static uiThemes:Icons.WelcomeKnowledgeBase}}" Title="{mex:Localized WELCOME_WINDOW_APPENDIX_KNOWLEDGE_BASE_title}" Command="{Binding KnowledgeBaseCommand}" />
      <local:AppendixButton Grid.Row="0" Grid.Column="3" Icon="{StaticResource {x:Static uiThemes:Icons.WelcomeBlog}}" Title="{mex:Localized WELCOME_WINDOW_APPENDIX_BLOG_title}" Command="{Binding BlogCommand}" />
    </Grid>
    <Grid Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center" Orientation="Horizontal">
        <commonControls:BorderlessButton Background="#00FFFFFF" Command="{Binding InstagramCommand}">
          <commonControls:ImageMask Width="45" Height="45" HorizontalAlignment="Center" VerticalAlignment="Center" ImageSource="{StaticResource {x:Static uiThemes:Icons.WelcomeInstagram}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </commonControls:BorderlessButton>
        <commonControls:BorderlessButton Margin="20,0,0,0" Background="#00FFFFFF" Command="{Binding FacebookCommand}">
          <commonControls:ImageMask Width="45" Height="45" HorizontalAlignment="Center" VerticalAlignment="Center" ImageSource="{StaticResource {x:Static uiThemes:Icons.WelcomeFacebook}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </commonControls:BorderlessButton>
      </StackPanel>
      <TextBlock Grid.Row="1" Foreground="#9a9a9a" Text="{mex:Localized WELCOME_WINDOW_APPENDIX_SOCIAL_MEDIA_label}" />
    </Grid>
  </Grid>
</UserControl>