<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Welcome.AppendixButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="appendixButton" xmlns:welcome="clr-namespace:ProPresenter.UI.Welcome;assembly=ProPresenter.UI">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type commonControls:BorderlessButton}" BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
          <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        </Style>
        <LinearGradientBrush x:Key="ButtonBackgroundUnselected" StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#FFA235" />
          <GradientStop Offset="1" Color="#FF6C1A" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonBackgroundSelected" StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#ffa280" />
          <GradientStop Offset="1" Color="#ff6c10" />
        </LinearGradientBrush>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <commonControls:BorderlessButton Width="100" Height="100" Margin="30,0" uiUtility:UIElementHelper.CornerRadius="20" Command="{Binding Command, ElementName=appendixButton}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
          <Setter Property="Background" Value="{StaticResource ButtonBackgroundUnselected}" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}">
              <Setter Property="Background" Value="{StaticResource ButtonBackgroundSelected}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Image Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Icon, ElementName=appendixButton}" />
    </commonControls:BorderlessButton>
    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="18" Text="{Binding Title, ElementName=appendixButton}" />
  </StackPanel>
</UserControl>