<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Messages.MessageTokenTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="self" xmlns:messages="clr-namespace:ProPresenter.UI.Messages;assembly=ProPresenter.UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text, ElementName=self}" />
    <Button Grid.Column="1" HorizontalContentAlignment="Center" uiUtility:ContextMenuHelper.OpenOnLeftClick="True" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" Cursor="Hand" ContextMenu="{Binding ContextMenu, ElementName=self}">
      <commonControls:PathControl Width="4" Height="4" PathType="DownArrow" Fill="{Binding Foreground, ElementName=self}" Stroke="{Binding Foreground, ElementName=self}" />
    </Button>
  </Grid>
</UserControl>