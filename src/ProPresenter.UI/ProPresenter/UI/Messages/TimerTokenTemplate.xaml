<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Messages.TimerTokenTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:timerDo="clr-namespace:ProPresenter.DO.Timer;assembly=ProPresenter.DO" xmlns:timerui="clr-namespace:ProPresenter.UI.Timer" x:Name="timerTokenSelf" xmlns:messages="clr-namespace:ProPresenter.UI.Messages" Foreground="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <commonConverters:TimeSliceToStringConverter x:Key="TimeSliceToStringConverter" DisplayMilliseconds="False" />
    <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
    <Style TargetType="{x:Type commonControls:PathControl}">
      <Setter Property="Height" Value="15" />
      <Setter Property="Width" Value="15" />
    </Style>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="5,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="WordEllipsis">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Text" Value="{Binding OriginalTimer.Name, ElementName=timerTokenSelf, StringFormat={}{0}}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding OriginalTimer, ElementName=timerTokenSelf}" Value="{x:Null}">
                <Setter Property="Text" Value="{Binding Timer.Name, ElementName=timerTokenSelf, StringFormat={}{0}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding ShowTimerControls, ElementName=timerTokenSelf, Converter={StaticResource ValueToVisibilityConverter}}">
        <Border Height="22" Margin="0,0,5,0" BorderThickness="0">
          <TextBlock Name="RunningTimeDisplay" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding OriginalTimer.Active.RunningTime, ElementName=timerTokenSelf, Converter={StaticResource TimeSliceToStringConverter}}" />
        </Border>
        <Grid Width="42">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <commonControls:BorderlessButton Grid.Column="0" Width="18" Margin="0,0,5,0" HorizontalAlignment="Right" ToolTip="{mex:Localized MESSAGES_WINDOW_TIMER_RESET_BUTTON_tooltip}" Click="ResetTimer">
            <commonControls:PathControl PathType="Beginning" Fill="{Binding Foreground, RelativeSource={RelativeSource Self}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
          </commonControls:BorderlessButton>
          <commonControls:BorderlessButton Grid.Column="1" Width="18" ToolTip="{mex:Localized MESSAGES_WINDOW_START_STOP_TIMER_BUTTON_STOPPED_tooltip}" Click="StartTimer">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type commonControls:BorderlessButton}}" TargetType="{x:Type commonControls:BorderlessButton}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="Reset" Binding="{Binding OriginalTimer.Active.State, ElementName=timerTokenSelf}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="Paused" Binding="{Binding OriginalTimer.Active.State, ElementName=timerTokenSelf}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <commonControls:PathControl PathType="Play" Fill="{Binding Foreground, RelativeSource={RelativeSource Self}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
          </commonControls:BorderlessButton>
          <commonControls:BorderlessButton Grid.Column="1" Width="18" ToolTip="{mex:Localized MESSAGES_WINDOW_START_STOP_TIMER_BUTTON_RUNNING_tooltip}" Visibility="{Binding OriginalTimer.Active.State, ElementName=timerTokenSelf, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static timerDo:TimerState.Started}}" Click="StopTimer">
            <commonControls:PathControl PathType="Stop" Fill="{Binding Foreground, RelativeSource={RelativeSource Self}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
          </commonControls:BorderlessButton>
        </Grid>
      </StackPanel>
    </Grid>
    <timerui:TimerDetails Grid.Row="1" Margin="8,0,0,0" EndTime="{Binding Timer.Source.EndTime, ElementName=timerTokenSelf, Mode=TwoWay}" Foreground="{Binding CONTENTSECONDARY, Source={x:Static theming:AppTheme.Active}}" Format="{Binding Format, ElementName=timerTokenSelf}" Overrun="{Binding Timer.Source.IsOverRunAllowed, ElementName=timerTokenSelf, Mode=TwoWay}" SelectedTimerType="{Binding SelectedTimerType, ElementName=timerTokenSelf, Mode=TwoWay}" ShowTimerFormat="{Binding ShowTimerFormat, ElementName=timerTokenSelf}" StartTime="{Binding Timer.Source.StartTime, ElementName=timerTokenSelf, Mode=TwoWay}">
      <timerui:TimerDetails.TimeFormat>
        <PriorityBinding>
          <Binding ElementName="timerTokenSelf" Mode="TwoWay" Path="Timer.Source.TimeFormat" />
        </PriorityBinding>
      </timerui:TimerDetails.TimeFormat>
      <timerui:TimerDetails.HasEndTime>
        <PriorityBinding>
          <Binding ElementName="timerTokenSelf" Mode="TwoWay" Path="Timer.Source.HasEndTime" />
        </PriorityBinding>
      </timerui:TimerDetails.HasEndTime>
    </timerui:TimerDetails>
  </Grid>
</UserControl>