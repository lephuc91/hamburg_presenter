<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.Messages.MessageTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" x:Name="messageTemplate" xmlns:messages="clr-namespace:ProPresenter.UI.Messages">
  <Border Height="22" Margin="0,-2" BorderThickness="2">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsActive, ElementName=messageTemplate}">
            <Setter Property="Background" Value="{Binding THUMBNAILLISTPRESENTATION, Source={x:Static theming:AppTheme.Active}}" />
            <Setter Property="BorderBrush" Value="{Binding THUMBNAILPRESENTATIONBORDER, Source={x:Static theming:AppTheme.Active}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <commonControls:EditableTextBlock Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name, Mode=TwoWay}" />
  </Border>
</UserControl>