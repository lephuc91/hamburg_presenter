<?xml version="1.0" encoding="utf-8"?>
<MenuItem x:Class="ProPresenter.UI.ActionsMenu.Capture.EditCaptureMenuItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:actionsDO="clr-namespace:ProPresenter.DO.Actions;assembly=ProPresenter.DO" xmlns:captureDO="clr-namespace:ProPresenter.DO.Capture;assembly=ProPresenter.DO" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.ActionsMenu.Capture" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" uiUtility:MenuItemHelper.InvokeCommandWithChildren="True" UsesItemContainerTemplate="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../AddEditActionMenuSourceStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="editCaptureMenuItemProxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:EditCaptureMenuItem}}}" />
      <Style x:Key="DataItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.AssignActionDataCommand, Source={StaticResource editCaptureMenuItemProxy}}" />
        <Setter Property="MenuItem.CommandParameter">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource ActionDataCommandParameterConverter}">
              <Binding Path="Data.EditAction" Source="{StaticResource editCaptureMenuItemProxy}" />
              <Binding />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="MenuItem.IsChecked">
          <Setter.Value>
            <MultiBinding Mode="OneWay" Converter="{StaticResource ActionDataIsCheckedConverter}">
              <Binding Path="Data.EditAction" Source="{StaticResource editCaptureMenuItemProxy}" />
              <Binding />
              <Binding Path="Data.RefreshActionData" Source="{StaticResource editCaptureMenuItemProxy}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
      <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type captureDO:CapturePreset}}">
        <MenuItem Style="{StaticResource DataItemStyle}" Header="{Binding Name}" />
      </ItemContainerTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource DataItemStyle}" TargetType="{x:Type MenuItem}">
      <Setter Property="Header" Value="{Binding Converter={StaticResource EnumToContentConverter}}" />
      <Setter Property="ItemsSource">
        <Setter.Value>
          <CompositeCollection>
            <MenuItem DataContext="{x:Static actionsDO:Identifier.Empty}" Style="{StaticResource DataItemStyle}" Header="{mex:Localized CAPTURE_ACTION_CAPTURE_START_ACTIVE_SETTINGS_title}" />
            <Separator />
            <CollectionContainer Collection="{Binding Data.CapturePresets, Source={StaticResource editCaptureMenuItemProxy}}" />
            <MenuItem IsEnabled="False" Visibility="{Binding Data.CapturePresets.Count, Source={StaticResource editCaptureMenuItemProxy}, Converter={StaticResource InvertedCountToVisibilityConverter}}">
              <HeaderedItemsControl.HeaderTemplate>
                <DataTemplate>
                  <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontStyle="Italic" Text="{mex:Localized CAPTURE_ACTION_NO_PRESETS_title}" />
                </DataTemplate>
              </HeaderedItemsControl.HeaderTemplate>
            </MenuItem>
          </CompositeCollection>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Value="Stop" Binding="{Binding}">
          <Setter Property="ItemsSource" Value="{x:Null}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </FrameworkElement.Style>
</MenuItem>