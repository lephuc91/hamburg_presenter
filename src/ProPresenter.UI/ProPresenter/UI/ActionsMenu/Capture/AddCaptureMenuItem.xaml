<?xml version="1.0" encoding="utf-8"?>
<MenuItem x:Class="ProPresenter.UI.ActionsMenu.Capture.AddCaptureMenuItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:captureAction="clr-namespace:ProPresenter.DO.Actions.Capture;assembly=ProPresenter.DO" xmlns:captureDO="clr-namespace:ProPresenter.DO.Capture;assembly=ProPresenter.DO" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:local="clr-namespace:ProPresenter.UI.ActionsMenu.Capture" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" x:Name="addCaptureMenuItem" UsesItemContainerTemplate="True" Header="{mex:Localized ACTION_TYPE_CAPTURE_title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ActionTargetCollectionResource.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="addCaptureMenuItemProxy" Data="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:AddCaptureMenuItem}}}" />
      <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type captureAction:CaptureType}}">
        <MenuItem UsesItemContainerTemplate="True" Command="{Binding Data.AddCaptureActionCommand, Source={StaticResource addCaptureMenuItemProxy}}" CommandParameter="{Binding}" DataContext="{Binding}" Header="{Binding Converter={StaticResource EnumToContentConverter}}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type captureDO:CapturePreset}}">
                <MenuItem Command="{Binding Data.AddCaptureActionWithPresetCommand, Source={StaticResource addCaptureMenuItemProxy}}" CommandParameter="{Binding}" Header="{Binding Name}" />
              </ItemContainerTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
              <Setter Property="ItemsSource">
                <Setter.Value>
                  <CompositeCollection>
                    <MenuItem Command="{Binding Data.AddCaptureActionWithPresetCommand, Source={StaticResource addCaptureMenuItemProxy}}" CommandParameter="{x:Null}" Header="{mex:Localized CAPTURE_ACTION_CAPTURE_START_ACTIVE_SETTINGS_title}" />
                    <Separator />
                    <CollectionContainer Collection="{Binding Data.CapturePresets, Source={StaticResource addCaptureMenuItemProxy}}" />
                    <MenuItem IsEnabled="False" Visibility="{Binding Data.CapturePresets.Count, Source={StaticResource addCaptureMenuItemProxy}, Converter={StaticResource InvertedCountToVisibilityConverter}}">
                      <HeaderedItemsControl.HeaderTemplate>
                        <DataTemplate>
                          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontStyle="Italic" Text="{mex:Localized CAPTURE_ACTION_NO_PRESETS_title}" />
                        </DataTemplate>
                      </HeaderedItemsControl.HeaderTemplate>
                    </MenuItem>
                  </CompositeCollection>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Value="Stop" Binding="{Binding}">
                  <Setter Property="ItemsSource" Value="{x:Null}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </MenuItem>
      </ItemContainerTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style BasedOn="{StaticResource CueMenuItemStyle}" TargetType="{x:Type MenuItem}">
      <Setter Property="ItemsSource" Value="{StaticResource CaptureTypeCollection}" />
    </Style>
  </FrameworkElement.Style>
</MenuItem>