<?xml version="1.0" encoding="utf-8"?>
<components:FrameworkCollection x:Class="ProPresenter.UI.ActionsMenu.RemoveActionMenuSource" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:actionsDO="clr-namespace:ProPresenter.DO.Actions;assembly=ProPresenter.DO" xmlns:clearGroupsUI="clr-namespace:ProPresenter.UI.ClearGroups" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:components="clr-namespace:Pro.UI.Components;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ActionsMenu" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:triggeringDO="clr-namespace:Pro.DO.Triggering;assembly=Pro.DO" x:Name="removeActionMenuSource">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="AddEditActionMenuSourceStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="actionMenuVMProxy" Data="{Binding}" />
      <Style x:Key="RemoveActionMenuItemStyle" BasedOn="{StaticResource ModifiyActionMenuItemStyle}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.RemoveActionCommand, Source={StaticResource actionMenuVMProxy}}" />
        <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
      </Style>
      <Style x:Key="RemoveAllActionMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="MenuItem.Command" Value="{Binding Data.RemoveAllActionsCommand, Source={StaticResource actionMenuVMProxy}}" />
        <Setter Property="Header" Value="{mex:Localized PRESENTATION_CONTEXT_MENU_REMOVE_ALL_title}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <MenuItem UsesItemContainerTemplate="True" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_REMOVE_ACTION_PLURAL_title}" Visibility="{Binding Data.ShowRemoveAllActions, Source={StaticResource actionMenuVMProxy}, Converter={StaticResource ValueToVisibilityConverter}}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <CollectionViewSource x:Key="RemovableActionTypes" Source="{Binding Data.RemovableActionTypes, Source={StaticResource actionMenuVMProxy}}" />
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type triggeringDO:ActionType}}">
          <MenuItem Style="{StaticResource CueMenuItemStyle}" Command="{Binding Data.RemoveActionTypeCommand, Source={StaticResource actionMenuVMProxy}}" CommandParameter="{Binding}" Header="{Binding Converter={StaticResource RemoveActionTypeToHeaderConverter}}" />
        </ItemContainerTemplate>
        <CollectionViewSource x:Key="RemovableMediaTypes" Source="{Binding Data.RemovableMediaTypes, Source={StaticResource actionMenuVMProxy}}" />
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type media:MediaType}}">
          <MenuItem Style="{StaticResource CueMenuItemStyle}" Command="{Binding Data.RemoveMediaTypeCommand, Source={StaticResource actionMenuVMProxy}}" CommandParameter="{Binding}" Header="{Binding Converter={StaticResource RemoveActionTypeToHeaderConverter}}" />
        </ItemContainerTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ItemsControl.ItemsSource>
      <CompositeCollection>
        <CollectionContainer Collection="{Binding Source={StaticResource RemovableActionTypes}}" />
        <CollectionContainer Collection="{Binding Source={StaticResource RemovableMediaTypes}}" />
        <Separator />
        <MenuItem Command="{Binding Data.RemoveAllActionsCommand, Source={StaticResource actionMenuVMProxy}}" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_REMOVE_ALL_title}" />
      </CompositeCollection>
    </ItemsControl.ItemsSource>
  </MenuItem>
  <MenuItem Icon="{StaticResource ActionRemoveEditIconStyle}" Command="{Binding Data.RemoveActionCommand, Source={StaticResource actionMenuVMProxy}}" CommandParameter="{Binding}" DataContext="{Binding Data.SingleRemoveAction, Source={StaticResource actionMenuVMProxy}}" Visibility="{Binding Data.ShowSingleRemoveAction, Source={StaticResource actionMenuVMProxy}, Converter={StaticResource ValueToVisibilityConverter}}">
    <HeaderedItemsControl.Header>
      <MultiBinding Converter="{StaticResource ActionToHeaderConverter}" ConverterParameter="{x:Static local:MenuItemHeaderType.Remove}" Mode="OneWay">
        <Binding Path="Data.SingleRemoveAction" Source="{StaticResource actionMenuVMProxy}" />
        <Binding Path="Data.RefreshActionData" Source="{StaticResource actionMenuVMProxy}" />
      </MultiBinding>
    </HeaderedItemsControl.Header>
  </MenuItem>
  <MenuItem ItemContainerStyle="{StaticResource RemoveActionMenuItemStyle}" UsesItemContainerTemplate="True" Header="{mex:Localized PRESENTATION_CONTEXT_MENU_REMOVE_ACTION_PLURAL_title}" Visibility="{Binding Data.ShowMultiRemoveAction, Source={StaticResource actionMenuVMProxy}, Converter={StaticResource ValueToVisibilityConverter}}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <CollectionViewSource x:Key="RemovableActions" Source="{Binding Data.RemovableActions, Source={StaticResource actionMenuVMProxy}}" />
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:AudienceLookAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:StageAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:SlideDestinationAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:TimerAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:MessageAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:PropAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:VisualPlaylistAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:AudioPlaylistAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:CommunicationAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:AudioInputAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}">
            <HeaderedItemsControl.Header>
              <PriorityBinding>
                <Binding Path="DefaultName" />
              </PriorityBinding>
            </HeaderedItemsControl.Header>
          </MenuItem>
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:MediaAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}">
            <HeaderedItemsControl.Header>
              <PriorityBinding>
                <Binding Path="LiveVideo.LiveVideo.Input.LongName" />
                <Binding Path="Name" />
              </PriorityBinding>
            </HeaderedItemsControl.Header>
          </MenuItem>
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:MacroAction}}">
          <MenuItem Icon="{StaticResource MacroActionIcon}" Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:ClearGroupAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}">
            <MenuItem.Icon>
              <clearGroupsUI:ClearGroupImageControl ClearGroup="{Binding Target}" />
            </MenuItem.Icon>
          </MenuItem>
        </ItemContainerTemplate>
        <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type actionsDO:CaptureAction}}">
          <MenuItem Style="{StaticResource RemoveActionMenuItemStyle}" Header="{Binding Name}" />
        </ItemContainerTemplate>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ItemsControl.ItemsSource>
      <CompositeCollection>
        <CollectionContainer Collection="{Binding Source={StaticResource RemovableActions}}" />
        <Separator />
        <MenuItem Style="{StaticResource RemoveAllActionMenuItemStyle}" />
      </CompositeCollection>
    </ItemsControl.ItemsSource>
  </MenuItem>
</components:FrameworkCollection>