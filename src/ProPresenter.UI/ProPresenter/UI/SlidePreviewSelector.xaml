<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.SlidePreviewSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:ProPresenter.UI" x:Name="self">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:SlidePreview Grid.Row="0" Grid.Column="0" PrimaryCheckerboardBrush="{Binding CHECKERBOARDPRIMARY, Source={x:Static theming:AppTheme.Active}}" RenderTransparencyCheckerboard="{Binding RenderTransparencyCheckerboard, ElementName=self}" SecondaryCheckerboardBrush="{Binding CHECKERBOARDSECONDARY, Source={x:Static theming:AppTheme.Active}}" Source="{Binding Source, ElementName=self}" />
    <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding LabelText, ElementName=self}" Visibility="{Binding ShowLabel, ElementName=self, Converter={StaticResource ValueToVisibilityConverter}}" />
    <commonControls:PathControl Grid.Row="0" Grid.Column="1" Width="8" Height="8" Margin="2,0,0,0" PathType="DownArrow" Fill="{Binding Foreground, ElementName=self}" Stroke="{Binding Foreground, ElementName=self}" />
  </Grid>
</UserControl>