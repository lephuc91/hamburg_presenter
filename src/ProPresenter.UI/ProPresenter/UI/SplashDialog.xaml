<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ProPresenter.UI.SplashDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themesUI="clr-namespace:Pro.UI.Themes;assembly=Pro.UI" x:Name="splashDialog" Title="SplashDialog" Width="800" Height="500" AllowsTransparency="True" Background="#dd000000" Focusable="False" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:ui="clr-namespace:ProPresenter.UI;assembly=ProPresenter.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Image Grid.Row="0" Margin="60,60,60,30" Source="{StaticResource {x:Static themesUI:Icons.AppWatermark}}" />
    <Grid Row="1" Margin="0,0,0,25" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
      <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="#FFFFFFFF" Text="{Binding AppVersion, ElementName=splashDialog}" />
    </Grid>
  </Grid>
</Window>