<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ClearGroups.ClearGroupIconSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:do="clr-namespace:ProPresenter.DO.ClearGroups;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:propresenterUI="clr-namespace:ProPresenter.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="clearGroupSelector" xmlns:cleargroups="clr-namespace:ProPresenter.UI.ClearGroups">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="ClearGroupIconTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ObjectDataProvider x:Key="ImageTypes" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="do:ImageType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Height="20" Background="#00FFFFFF">
      <commonControls:PathControl Width="30" Height="30" HorizontalAlignment="Center" PathType="UpArrow" Fill="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" Stroke="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}" />
    </Grid>
    <Border Grid.Row="1" BorderThickness="0" Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Height="150" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Width="150" Margin="10,10,0,0" HorizontalAlignment="Center" HorizontalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource ImageTypes}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <commonControls:BorderlessButton Grid.Column="0" Command="{Binding SelectIconCommand, ElementName=clearGroupSelector}" CommandParameter="{Binding}">
                  <commonControls:PathControl Width="22" Height="22" Stroke="#00FFFFFF" Style="{StaticResource IconPathStyle}" Fill="{Binding CONTENTPRIMARY, Source={x:Static theming:AppTheme.Active}}" />
                </commonControls:BorderlessButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type FrameworkElement}">
                <Setter Property="Margin" Value="4" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <propresenterUI:IconSelectorPanel Orientation="Horizontal" Width="{Binding Width, ElementName=clearGroupSelector}" Height="{Binding Height, ElementName=clearGroupSelector}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="1" Margin="0,5,0,10" Padding="5,0" HorizontalAlignment="Center" CommandParameter="{x:Static do:ImageType.Custom}" Command="{Binding SelectIconCommand, ElementName=clearGroupSelector}" Content="{mex:Localized CLEAR_GROUPS_IMPORT_ICON_title}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>