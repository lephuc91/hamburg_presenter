<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ClearGroups.ClearGroupImageControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:do="clr-namespace:ProPresenter.DO.ClearGroups;assembly=ProPresenter.DO" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="clearGroupImageControl" xmlns:cleargroups="clr-namespace:ProPresenter.UI.ClearGroups;assembly=ProPresenter.UI">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="ClearGroupIconTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="InvertedValueToVisibilityConverter" IsInverted="True" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid>
      <commonControls:PathControl Stroke="{DynamicResource ScrimItemBorder}" Style="{StaticResource ClearGroupIconPathStyle}" Width="{Binding ImageSize.X, ElementName=clearGroupImageControl}" Height="{Binding ImageSize.Y, ElementName=clearGroupImageControl}" DataContext="{Binding ClearGroup, ElementName=clearGroupImageControl}" Fill="{Binding ClearGroup.IconFill, Converter={StaticResource ColorToBrushConverter}, ElementName=clearGroupImageControl}" Visibility="{Binding ClearGroup.ImageType, Converter={StaticResource InvertedValueToVisibilityConverter}, ConverterParameter={x:Static do:ImageType.Custom}, ElementName=clearGroupImageControl}" />
      <Grid Visibility="{Binding ClearGroup.ImageType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static do:ImageType.Custom}, ElementName=clearGroupImageControl}">
        <commonControls:ImageMask Stroke="{DynamicResource ScrimItemBorder}" Width="{Binding ImageSize.X, ElementName=clearGroupImageControl}" Height="{Binding ImageSize.Y, ElementName=clearGroupImageControl}" DataContext="{Binding ClearGroup, ElementName=clearGroupImageControl}" Fill="{Binding ClearGroup.IconFill, Converter={StaticResource ColorToBrushConverter}, ElementName=clearGroupImageControl}" ImageSource="{Binding ClearGroup.Icon, ElementName=clearGroupImageControl}" Visibility="{Binding DiscardTint, ElementName=clearGroupImageControl, Converter={StaticResource InvertedValueToVisibilityConverter}}" />
        <Image Width="16" Height="16" Source="{Binding ClearGroup.Icon, ElementName=clearGroupImageControl}" Visibility="{Binding DiscardTint, ElementName=clearGroupImageControl, Converter={StaticResource ValueToVisibilityConverter}}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>