<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ClearGroups.ClearGroupItemTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:local="clr-namespace:ProPresenter.UI.ClearGroups" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" Height="22">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="ClearGroupIconTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonConverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <local:ClearGroupImageControl Grid.Column="0" Margin="8,0,0,0" ClearGroup="{Binding Item}" />
    <commonControls:EditableTextBlock Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name, Mode=TwoWay}" ValidationRule="{Binding NameValidationRule}" />
    <commonControls:PathControl Grid.Column="2" Width="18" Height="18" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" PathType="EyeDisabled" Stroke="{Binding Foreground, RelativeSource={RelativeSource Self}}" Visibility="{Binding IsHiddenInPreview, Converter={StaticResource ValueToVisibilityConverter}}" />
  </Grid>
</UserControl>