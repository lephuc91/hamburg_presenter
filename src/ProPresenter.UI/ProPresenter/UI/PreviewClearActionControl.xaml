<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.PreviewClearActionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:actionsDO="clr-namespace:ProPresenter.DO.Actions;assembly=ProPresenter.DO" xmlns:analytics="clr-namespace:ProPresenter.DO.Analytics;assembly=ProPresenter.DO" xmlns:clearGroupsDO="clr-namespace:ProPresenter.DO.ClearGroups;assembly=ProPresenter.DO" xmlns:clearGroupsUI="clr-namespace:ProPresenter.UI.ClearGroups" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:prouiUtility="clr-namespace:ProPresenter.UI.Utility" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="clearControl" xmlns:ui="clr-namespace:ProPresenter.UI" Background="{Binding HEADER, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="screenPreviewVMProxy" Data="{Binding}" />
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <clearGroupsUI:HightLightClearTargetConverter x:Key="HightLightClearTargetConverter" />
      <clearGroupsUI:HighLightClearButtonConverter x:Key="HighLightClearButtonConverter" />
      <Style x:Key="ClearButtonContentStyle" TargetType="{x:Type commonControls:ImageMask}">
        <Setter Property="commonControls:ImageMask.Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Width" Value="16" />
      </Style>
      <Style x:Key="ClearButtonStyleBase" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="uiUtility:UIElementHelper.Palette" Value="{Binding CLEARBUTTON_PALETTE, Source={x:Static theming:AppTheme.Active}}" />
        <Style.Triggers>
          <DataTrigger Value="False" Binding="{Binding (prouiUtility:UIHelper.ContentTriggered), RelativeSource={RelativeSource Self}}">
            <Setter Property="Background" Value="{Binding (uiUtility:UIElementHelper.Palette).Disabled.Background, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush" Value="{Binding (uiUtility:UIElementHelper.Palette).Disabled.Border, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground" Value="{Binding (uiUtility:UIElementHelper.Palette).Disabled.Content, RelativeSource={RelativeSource Self}}" />
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="True" Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" />
              <Condition Value="False" Binding="{Binding (prouiUtility:UIHelper.ContentTriggered), RelativeSource={RelativeSource Self}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Background" Value="{Binding TOOLBAR_PALETTE.Pressed.Background, Source={x:Static theming:AppTheme.Active}}" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ClearButtonStyle" BasedOn="{StaticResource ClearButtonStyleBase}" TargetType="{x:Type Button}">
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Value="True">
                <Condition.Binding>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource HightLightClearTargetConverter}">
                    <Binding />
                    <Binding ElementName="clearControl" Path="MouseOverClearGroup" />
                  </MultiBinding>
                </Condition.Binding>
              </Condition>
              <Condition Value="True" Binding="{Binding (prouiUtility:UIHelper.ContentTriggered), RelativeSource={RelativeSource Self}}" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Background" Value="{Binding (uiUtility:UIElementHelper.Palette).Hover.Background, RelativeSource={RelativeSource Self}}" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ClearGroupButtonStyle" BasedOn="{StaticResource ClearButtonStyleBase}" TargetType="{x:Type Button}">
        <Setter Property="prouiUtility:UIHelper.ContentTriggered" Value="False" />
        <Style.Triggers>
          <DataTrigger Value="True">
            <DataTrigger.Binding>
              <MultiBinding Mode="OneWay" Converter="{StaticResource HighLightClearButtonConverter}">
                <Binding Path="ClearTargets" />
                <Binding Path="Data.ActiveLayers" Source="{StaticResource screenPreviewVMProxy}" />
              </MultiBinding>
            </DataTrigger.Binding>
            <Setter Property="prouiUtility:UIHelper.ContentTriggered" Value="True" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ItemsControl Grid.Column="0" Width="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" AlternationCount="{Binding ClearGroups.Length, ElementName=clearControl}" ItemsSource="{Binding ClearGroups, ElementName=clearControl}" Visibility="{Binding ClearGroups.Length, ElementName=clearControl, Converter={StaticResource CountToVisibilityConverter}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type clearGroupsDO:ClearGroup}">
          <Button Grid.Row="0" Command="{Binding TriggerClearGroupCommand, ElementName=clearControl}" CommandParameter="{Binding}" ToolTip="{Binding Name}" MouseLeave="ClearGroupButton_MouseLeave" MouseMove="ClearGroupButton_MouseMove">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource ClearGroupButtonStyle}" TargetType="{x:Type Button}">
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Style.Triggers>
                  <DataTrigger Value="0" Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}">
                    <Setter Property="BorderThickness" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <clearGroupsUI:ClearGroupImageControl Margin="5,0" ClearGroup="{Binding}" />
            <FrameworkElement.ContextMenu>
              <ContextMenu>
                <commonControls:RoutedMenuItem CommandParameter="{x:Static analytics:ClearGroupShownSource.PreviewMenu}" Command="{Binding PresentationMenu.OpenClearGroups.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
    <Grid Column="1" Width="44">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Button Grid.Row="0" BorderThickness="0,0,0,1" DataContext="{x:Static actionsDO:ClearType.Audio}" Style="{StaticResource ClearButtonStyle}" prouiUtility:UIHelper.ContentTriggered="{Binding Data.IsMusicLayerActive, Source={StaticResource screenPreviewVMProxy}}" Command="{Binding ClearAudioCommand, ElementName=clearControl}" ToolTip="{mex:Localized SIDEBAR_CLEAR_AUDIO_BUTTON_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/ClearLayer/clearButtonAudio.png" Style="{StaticResource ClearButtonContentStyle}" />
      </Button>
      <Button Grid.Row="1" BorderThickness="0,0,0,1" DataContext="{x:Static actionsDO:ClearType.Messages}" Style="{StaticResource ClearButtonStyle}" prouiUtility:UIHelper.ContentTriggered="{Binding Data.IsMessageLayerActive, Source={StaticResource screenPreviewVMProxy}}" Command="{Binding ClearMessagesCommand, ElementName=clearControl}" ToolTip="{mex:Localized SIDEBAR_CLEAR_MESSAGES_BUTTON_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/ClearLayer/clearButtonMessages.png" Style="{StaticResource ClearButtonContentStyle}" />
      </Button>
      <Button Grid.Row="2" BorderThickness="0,0,0,1" DataContext="{x:Static actionsDO:ClearType.Props}" Style="{StaticResource ClearButtonStyle}" prouiUtility:UIHelper.ContentTriggered="{Binding Data.IsPropsLayerActive, Source={StaticResource screenPreviewVMProxy}}" Command="{Binding ClearPropsCommand, ElementName=clearControl}" ToolTip="{mex:Localized SIDEBAR_CLEAR_PROPS_BUTTON_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/ClearLayer/clearButtonProps.png" Style="{StaticResource ClearButtonContentStyle}" />
      </Button>
      <Button Grid.Row="3" BorderThickness="0,0,0,1" DataContext="{x:Static actionsDO:ClearType.Announcement}" Style="{StaticResource ClearButtonStyle}" prouiUtility:UIHelper.ContentTriggered="{Binding Data.IsAnnouncementLayerActive, Source={StaticResource screenPreviewVMProxy}}" Command="{Binding ClearAnnouncementCommand, ElementName=clearControl}" ToolTip="{mex:Localized SIDEBAR_CLEAR_ANNOUNCEMENTS_BUTTON_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/ClearLayer/clearButtonAnnouncements.png" Style="{StaticResource ClearButtonContentStyle}" />
      </Button>
      <Button Grid.Row="4" BorderThickness="0,0,0,1" DataContext="{x:Static actionsDO:ClearType.Slide}" Style="{StaticResource ClearButtonStyle}" prouiUtility:UIHelper.ContentTriggered="{Binding Data.IsSlideLayerActive, Source={StaticResource screenPreviewVMProxy}}" Command="{Binding ClearSlideCommand, ElementName=clearControl}" ToolTip="{mex:Localized SIDEBAR_CLEAR_PRESENTATION_FOREGROUND_BUTTON_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/ClearLayer/clearButtonPresentationForeground.png" Style="{StaticResource ClearButtonContentStyle}" />
      </Button>
      <Button Grid.Row="5" BorderThickness="0,0,0,1" DataContext="{x:Static actionsDO:ClearType.Background}" Style="{StaticResource ClearButtonStyle}" prouiUtility:UIHelper.ContentTriggered="{Binding Data.IsBackgroundLayerActive, Source={StaticResource screenPreviewVMProxy}}" Command="{Binding ClearBackgroundCommand, ElementName=clearControl}" ToolTip="{mex:Localized SIDEBAR_CLEAR_PRESENTATION_BACKGROUND_BUTTON_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/ClearLayer/clearButtonPresentationBackground.png" Style="{StaticResource ClearButtonContentStyle}" />
      </Button>
      <Button Grid.Row="6" BorderThickness="0" DataContext="{x:Static actionsDO:ClearType.LiveVideo}" Style="{StaticResource ClearButtonStyle}" prouiUtility:UIHelper.ContentTriggered="{Binding Data.IsLiveVideoLayerActive, Source={StaticResource screenPreviewVMProxy}}" Command="{Binding ClearVideoInputCommand, ElementName=clearControl}" ToolTip="{mex:Localized SIDEBAR_CLEAR_VIDEO_INPUT_BUTTON_tooltip}">
        <commonControls:ImageMask ImageSource="/ProPresenter.UI;component/Resources/Icons/ClearLayer/clearButtonVideoInput.png" Style="{StaticResource ClearButtonContentStyle}" />
      </Button>
    </Grid>
  </Grid>
</UserControl>