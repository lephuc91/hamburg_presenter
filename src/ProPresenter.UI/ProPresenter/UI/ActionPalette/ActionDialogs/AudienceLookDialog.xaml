<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.AudienceLookDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControl="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:looks="clr-namespace:ProPresenter.DO.Looks;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" Width="250" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <CollectionViewSource x:Key="AudienceLooks" Source="{Binding Data.AudienceLooks, Source={StaticResource proxy}}" />
      <ContextMenu x:Key="LooksMenu" Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type looks:AudienceLook}}">
              <MenuItem uiUtility:CommandHelper.CommandParameter="{Binding}" Command="{Binding Data.SelectAudienceLookCommand, Source={StaticResource proxy}}" Header="{Binding Name}">
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding Path="Data.Action.LookID" Source="{StaticResource proxy}" />
                    <Binding Path="ID" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem IsChecked="True" Header="{mex:Localized GLOBAL_NO_SELECTION}" Visibility="{Binding Data.Action.LookID, ConverterParameter={x:Static system1:Guid.Empty}, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
            <Separator Visibility="{Binding Data.Action.LookID, ConverterParameter={x:Static Guid.Empty}, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
            <CollectionContainer Collection="{Binding Source={StaticResource AudienceLooks}}" />
            <Separator />
            <commonControl:RoutedMenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" Command="{Binding ScreensMenu.EditLooks.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <commonControl:DropDownButton Grid.Column="1" VerticalAlignment="Center" CustomContextMenu="{StaticResource LooksMenu}">
    <FrameworkElement.Style>
      <Style TargetType="{x:Type commonControl:DropDownButton}">
        <Setter Property="commonControl:DropDownButton.CustomContent" Value="{Binding Action.LookName}" />
        <Style.Triggers>
          <DataTrigger Value="{x:Static Guid.Empty}" Binding="{Binding Action.LookID}">
            <Setter Property="commonControl:DropDownButton.CustomContent" Value="{mex:Localized GLOBAL_NO_SELECTION}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
  </commonControl:DropDownButton>
</UserControl>