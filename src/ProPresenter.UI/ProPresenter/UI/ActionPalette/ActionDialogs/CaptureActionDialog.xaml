<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.CaptureActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:captureAction="clr-namespace:ProPresenter.DO.Actions.Capture;assembly=ProPresenter.DO" xmlns:captureAnalytics="clr-namespace:ProPresenter.DO.Analytics.Events.Capture;assembly=ProPresenter.DO" xmlns:captureDO="clr-namespace:ProPresenter.DO.Capture;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" Width="250" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="captureActionDialogVMProxy" Data="{Binding}" />
      <commonConverters:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ComboBox Grid.Row="0" SelectedItem="{Binding CaptureType, Mode=TwoWay}">
      <ItemsControl.ItemsSource>
        <CompositeCollection>
          <captureAction:CaptureType>Start</captureAction:CaptureType>
          <captureAction:CaptureType>Stop</captureAction:CaptureType>
        </CompositeCollection>
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Margin="0" HorizontalAlignment="Left" Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
    <CheckBox Grid.Row="1" Margin="0,8,0,0" Content="{mex:Localized CAPTURE_ACTION_CAPTURE_STOP_SHOW_ALERT_title}" IsChecked="{Binding CaptureStop.ShowAlertBeforeStopping, Mode=TwoWay}" Visibility="{Binding CaptureType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static captureAction:CaptureType.Stop}}" />
    <commonControls:DropDownButton Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding CaptureType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static captureAction:CaptureType.Start}}">
      <commonControls:DropDownButton.CustomContent>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Binding CaptureStart.PresetIdentifier.Name}" />
              <Style.Triggers>
                <DataTrigger xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib" Value="{x:Static system1:Guid.Empty}" Binding="{Binding CaptureStart.PresetIdentifier.ID}">
                  <Setter Property="Text" Value="{mex:Localized CAPTURE_ACTION_CAPTURE_START_ACTIVE_SETTINGS_title}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </commonControls:DropDownButton.CustomContent>
      <commonControls:DropDownButton.CustomContextMenu>
        <ContextMenu Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type captureDO:CapturePreset}}">
                <MenuItem uiUtility:CommandHelper.CommandParameter="{Binding}" Command="{Binding Data.SelectPresetCommand, Source={StaticResource captureActionDialogVMProxy}}" Header="{Binding Name}">
                  <MenuItem.IsChecked>
                    <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                      <Binding Path="Data.CaptureStart.PresetIdentifier.ID" Source="{StaticResource captureActionDialogVMProxy}" />
                      <Binding Path="ID" />
                    </MultiBinding>
                  </MenuItem.IsChecked>
                </MenuItem>
              </ItemContainerTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.ItemsSource>
            <CompositeCollection>
              <MenuItem Command="{Binding Data.SelectActivePresetCommand, Source={StaticResource captureActionDialogVMProxy}}" Header="{mex:Localized CAPTURE_ACTION_CAPTURE_START_ACTIVE_SETTINGS_title}">
                <MenuItem.IsChecked>
                  <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                    <Binding Path="Data.CaptureStart.PresetIdentifier.ID" Source="{StaticResource captureActionDialogVMProxy}" />
                    <Binding Source="{x:Static Guid.Empty}" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
              <Separator />
              <CollectionContainer Collection="{Binding Data.Presets, Source={StaticResource captureActionDialogVMProxy}}" />
              <MenuItem IsEnabled="False" Visibility="{Binding Data.Presets.Count, Source={StaticResource captureActionDialogVMProxy}, Converter={StaticResource InvertedCountToVisibilityConverter}}">
                <HeaderedItemsControl.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontStyle="Italic" Text="{mex:Localized CAPTURE_ACTION_NO_PRESETS_title}" />
                  </DataTemplate>
                </HeaderedItemsControl.HeaderTemplate>
              </MenuItem>
              <Separator />
              <MenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" uiUtility:MenuItemHelper.GestureTextVisibility="Hidden" CommandParameter="{x:Static captureAnalytics:CaptureShownSource.ActionPopover}" Command="{Binding ScreensMenu.CaptureSettings.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized RECORDING_BUTTON_CONTEXT_MENU_CAPTURE_SETTINGS_title}" />
            </CompositeCollection>
          </ItemsControl.ItemsSource>
        </ContextMenu>
      </commonControls:DropDownButton.CustomContextMenu>
    </commonControls:DropDownButton>
  </Grid>
</UserControl>