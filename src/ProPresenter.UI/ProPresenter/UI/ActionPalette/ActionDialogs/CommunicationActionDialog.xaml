<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.CommunicationActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControl="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverter="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:communication="clr-namespace:ProPresenter.DO.Communication;assembly=ProPresenter.DO" xmlns:deviceDO="clr-namespace:ProPresenter.DO.Communication.Devices;assembly=ProPresenter.DO" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:local="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" Width="250" Foreground="{Binding POPUPCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <local:PitchToStringConverter x:Key="PitchToStringConverter" />
      <commonConverter:EnumToContentConverter x:Key="EnumToContentConverter" />
      <commonConverter:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverter:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <Style x:Key="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <ObjectDataProvider x:Key="MIDICommand" MethodName="GetValues" xmlns:system1="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system1:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="communication:MIDICommand" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ContextMenu x:Key="DevicesMenu" Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <CollectionViewSource x:Key="Devices" Source="{Binding Data.Devices, Source={StaticResource proxy}}" />
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type deviceDO:MIDIDevice}}">
              <MenuItem uiUtility:CommandHelper.CommandParameter="{Binding}" Command="{Binding Data.SetDeviceCommand, Source={StaticResource proxy}}" Header="{Binding Label}">
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding Path="Data.Action.DeviceID" Source="{StaticResource proxy}" />
                    <Binding Path="ID" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <CollectionContainer Collection="{Binding Source={StaticResource Devices}}" />
            <Separator />
            <commonControl:RoutedMenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" uiUtility:MenuItemHelper.GestureTextVisibility="Hidden" Command="{Binding ProMenu.Devices.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized ACTION_PALETTE_OPEN_DEVICES_title}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border BorderThickness="0" Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{mex:Localized ACTION_PALETTE_MIDI_DEVICE_SELECTION_FIELD_title}" />
        <commonControl:DropDownButton Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,5" CustomContextMenu="{StaticResource DevicesMenu}" CustomContent="{Binding Device.Label}" />
        <TextBlock Grid.Row="2" Text="{mex:Localized ACTION_PALETTE_MIDI_COMMAND_SELECTION_FIELD_title}" />
        <ComboBox Grid.Row="3" Grid.ColumnSpan="2" Margin="0,2,0,20">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToContentConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
              <Setter Property="IsEnabled" Value="True" />
              <Setter Property="ItemsSource" Value="{x:Null}" />
              <Style.Triggers>
                <DataTrigger Value="MIDI" Binding="{Binding Action.DeviceType}">
                  <Setter Property="ItemsSource" Value="{Binding Source={StaticResource MIDICommand}}" />
                  <Setter Property="Selector.SelectedItem" Value="{Binding Action.Command, Mode=TwoWay}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action.DeviceID}" Value="{x:Null}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ComboBox>
        <ContentControl Grid.Row="4" HorizontalAlignment="Right" Content="{Binding Action.DeviceType}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ContentControl}">
              <Setter Property="IsEnabled" Value="True" />
              <Style.Triggers>
                <DataTrigger Value="Unknown" Binding="{Binding Action.DeviceType}">
                  <Setter Property="ContentTemplate">
                    <Setter.Value>
                      <DataTemplate />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
                <DataTrigger Value="MIDI" Binding="{Binding Action.DeviceType}">
                  <Setter Property="ContentTemplate">
                    <Setter.Value>
                      <DataTemplate>
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="100" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Margin="0,0,5,2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized ACTION_PALETTE_MIDI_CHANNEL_SELECTION_FIELD_title}" />
                          <ComboBox Grid.Column="1" Margin="0,0,0,2" ItemsSource="{Binding Data.Channels, Source={StaticResource proxy}}" SelectedItem="{Binding Data.Action.Channel, Mode=TwoWay, Source={StaticResource proxy}}" />
                          <TextBlock Grid.Row="1" Margin="0,0,5,2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized ACTION_PALETTE_MIDI_NOTE_SELECTION_FIELD_title}" />
                          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2" AlternationCount="{Binding Data.Notes.Length, Source={StaticResource proxy}}" ItemsSource="{Binding Data.Notes, Source={StaticResource proxy}}" SelectedItem="{Binding Data.Action.Note, Mode=TwoWay, Source={StaticResource proxy}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource PitchToStringConverter}}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ComboBox>
                          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,5,2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{mex:Localized ACTION_PALETTE_MIDI_INTENSITY_SELECTION_FIELD_title}" Visibility="{Binding Data.Action.Command, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static communication:MIDICommand.NoteOn}}" />
                          <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2" ItemsSource="{Binding Data.Intensity, Source={StaticResource proxy}}" SelectedItem="{Binding Data.Action.Intensity, Mode=TwoWay, Source={StaticResource proxy}}" Visibility="{Binding Data.Action.Command, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static communication:MIDICommand.NoteOn}}" />
                        </Grid>
                      </DataTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Data.Action.DeviceID, Source={StaticResource proxy}}" Value="{x:Null}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ContentControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>