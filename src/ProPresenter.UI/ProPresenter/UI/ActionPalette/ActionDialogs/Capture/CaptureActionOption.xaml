<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.Capture.CaptureActionOption" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:captureAction="clr-namespace:ProPresenter.DO.Actions.Capture;assembly=ProPresenter.DO" xmlns:captureAnalytics="clr-namespace:ProPresenter.DO.Analytics.Events.Capture;assembly=ProPresenter.DO" xmlns:captureDO="clr-namespace:ProPresenter.DO.Capture;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" x:Name="captureActionOption" xmlns:capture="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs.Capture">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="captureActionOptionProxy" Data="{Binding ElementName=captureActionOption}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
      <commonConverters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Visibility="{Binding ElementName=captureActionOption, Path=CaptureAction, Converter={StaticResource IsNotNullToVisibilityConverter}}">
    <CheckBox Content="{mex:Localized CAPTURE_ACTION_CAPTURE_STOP_SHOW_ALERT_title}" IsChecked="{Binding CaptureStop.ShowAlertBeforeStopping, Mode=TwoWay, ElementName=captureActionOption}" Visibility="{Binding ElementName=captureActionOption, Path=CaptureAction.CaptureType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static captureAction:CaptureType.Stop}}" />
    <commonControls:DropDownButton Visibility="{Binding ElementName=captureActionOption, Path=CaptureAction.CaptureType, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter={x:Static captureAction:CaptureType.Start}}">
      <commonControls:DropDownButton.CustomContent>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
              <Setter Property="Text" Value="{Binding Data.CaptureStart.PresetIdentifier.Name, Source={StaticResource captureActionOptionProxy}}" />
              <Style.Triggers>
                <DataTrigger xmlns:system1="clr-namespace:System;assembly=System.Private.CoreLib" Value="{x:Static system1:Guid.Empty}" Binding="{Binding Data.CaptureStart.PresetIdentifier.ID, Source={StaticResource captureActionOptionProxy}}">
                  <Setter Property="Text" Value="{mex:Localized CAPTURE_ACTION_CAPTURE_START_ACTIVE_SETTINGS_title}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </commonControls:DropDownButton.CustomContent>
      <commonControls:DropDownButton.CustomContextMenu>
        <ContextMenu Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type captureDO:CapturePreset}}">
                <MenuItem uiUtility:CommandHelper.CommandParameter="{Binding}" Command="{Binding Data.SelectPresetCommand, Source={StaticResource captureActionOptionProxy}}" Header="{Binding Name}">
                  <MenuItem.IsChecked>
                    <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                      <Binding Path="Data.CaptureStart.PresetIdentifier.ID" Source="{StaticResource captureActionOptionProxy}" />
                      <Binding Path="ID" />
                    </MultiBinding>
                  </MenuItem.IsChecked>
                </MenuItem>
              </ItemContainerTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.ItemsSource>
            <CompositeCollection>
              <MenuItem Command="{Binding Data.SelectPresetCommand, Source={StaticResource captureActionOptionProxy}}" CommandParameter="{x:Null}" Header="{mex:Localized CAPTURE_ACTION_CAPTURE_START_ACTIVE_SETTINGS_title}">
                <MenuItem.IsChecked>
                  <MultiBinding Converter="{StaticResource MultiBindingEqualityConverter}" Mode="OneWay">
                    <Binding Path="Data.CaptureStart.PresetIdentifier.ID" Source="{StaticResource captureActionOptionProxy}" />
                    <Binding Source="{x:Static Guid.Empty}" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
              <Separator />
              <CollectionContainer Collection="{Binding Data.Presets, Source={StaticResource captureActionOptionProxy}}" />
              <MenuItem IsEnabled="False" Visibility="{Binding Data.Presets.Count, Source={StaticResource captureActionOptionProxy}, Converter={StaticResource InvertedCountToVisibilityConverter}}">
                <HeaderedItemsControl.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontStyle="Italic" Text="{mex:Localized CAPTURE_ACTION_NO_PRESETS_title}" />
                  </DataTemplate>
                </HeaderedItemsControl.HeaderTemplate>
              </MenuItem>
              <Separator />
              <MenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" uiUtility:MenuItemHelper.GestureTextVisibility="Hidden" CommandParameter="{x:Static captureAnalytics:CaptureShownSource.ActionPopover}" Command="{Binding ScreensMenu.CaptureSettings.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized RECORDING_BUTTON_CONTEXT_MENU_CAPTURE_SETTINGS_title}" />
            </CompositeCollection>
          </ItemsControl.ItemsSource>
        </ContextMenu>
      </commonControls:DropDownButton.CustomContextMenu>
    </commonControls:DropDownButton>
  </Grid>
</UserControl>