<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.ClearGroupActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:analytics="clr-namespace:ProPresenter.DO.Analytics;assembly=ProPresenter.DO" xmlns:clearGroupsDO="clr-namespace:ProPresenter.DO.ClearGroups;assembly=ProPresenter.DO" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" Width="250" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="TextStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}" />
        <Setter Property="Margin" Value="0,5" />
      </Style>
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <ContextMenu x:Key="ClearGroupsMenu" Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <CollectionViewSource x:Key="ClearGroups" Source="{Binding Data.ClearGroups, Source={StaticResource proxy}}" />
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type clearGroupsDO:ClearGroup}}">
              <MenuItem uiUtility:CommandHelper.CommandParameter="{Binding}" Command="{Binding Data.SelectClearGroupCommand, Source={StaticResource proxy}}" Header="{Binding Name}">
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding Path="Data.Action.GroupID" Source="{StaticResource proxy}" />
                    <Binding Path="ID" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem IsChecked="True" Header="{mex:Localized GLOBAL_NO_SELECTION}" Visibility="{Binding Data.Action.GroupID, ConverterParameter={x:Static system1:Guid.Empty}, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
            <Separator Visibility="{Binding Data.Action.GroupID, ConverterParameter={x:Static Guid.Empty}, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
            <CollectionContainer Collection="{Binding Source={StaticResource ClearGroups}}" />
            <Separator />
            <commonControls:RoutedMenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" uiUtility:MenuItemHelper.GestureTextVisibility="Hidden" CommandParameter="{x:Static analytics:ClearGroupShownSource.ActionMenu}" Command="{Binding PresentationMenu.OpenClearGroups.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock VerticalAlignment="Center" Style="{StaticResource TextStyle}" Text="{mex:Localized ACTION_PALETTE_CLEAR_GROUP_SELECTION_FIELD_title}" />
      <commonControls:DropDownButton Grid.Row="1" Margin="0,5" CustomContextMenu="{StaticResource ClearGroupsMenu}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type commonControls:DropDownButton}">
            <Setter Property="commonControls:DropDownButton.CustomContent" Value="{Binding Action.GroupName}" />
            <Style.Triggers>
              <DataTrigger Value="{x:Static Guid.Empty}" Binding="{Binding Action.GroupID}">
                <Setter Property="commonControls:DropDownButton.CustomContent" Value="{mex:Localized GLOBAL_NO_SELECTION}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:DropDownButton>
    </Grid>
  </Grid>
</UserControl>