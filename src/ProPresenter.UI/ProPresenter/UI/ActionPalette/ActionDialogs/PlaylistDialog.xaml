<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.PlaylistDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:localConverters="clr-namespace:ProPresenter.UI.Converters" xmlns:mediaLibrary="clr-namespace:ProPresenter.UI.MediaLibrary" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs">
  <Grid>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <localConverters:PlaylistMarginConverter x:Key="PlaylistMarginConverter" />
        <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
        <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Row="0" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
      <mediaLibrary:MediaLibrarySelectionControl Width="280" Height="22" Margin="0,0,0,10" CanAddPlaylist="False" NoSelectionTranslationKey="PLAYLIST_ACTION_NO_SELECTION_MENU_ITEM_title" Playlists="{Binding Playlists}" SelectedPlaylist="{Binding SelectedPlaylist, Mode=TwoWay}" />
    </Grid>
    <Grid Row="1" Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <CheckBox HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="{mex:Localized PLAYLIST_ACTION_ALWAYS_RETRIGGER_title}" IsChecked="{Binding PlaylistAction.AlwaysRetrigger}" />
    </Grid>
  </Grid>
</UserControl>