<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.MessageActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonControls="clr-namespace:Pro.UI.Controls;assembly=Pro.UI" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:di="clr-namespace:Pro.UI.DependencyInjection;assembly=Pro.UI" xmlns:inputActions="clr-namespace:ProPresenter.DO.InputActionMap;assembly=ProPresenter.DO" xmlns:messagesDO="clr-namespace:ProPresenter.DO.Messages;assembly=ProPresenter.DO" xmlns:messagesUI="clr-namespace:ProPresenter.UI.Messages" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:uiCommands="clr-namespace:ProPresenter.UI.Commands" xmlns:uiUtility="clr-namespace:Pro.UI.Utility;assembly=Pro.UI" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs" Foreground="{Binding POPUPCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonUtility:BindingProxy x:Key="proxy" Data="{Binding}" />
      <commonConverters:MultiBindingEqualityConverter x:Key="MultiBindingEqualityConverter" />
      <commonConverters:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
      <ContextMenu x:Key="MessagesMenu" Placement="Bottom" UsesItemContainerTemplate="True" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <CollectionViewSource x:Key="Messages" Source="{Binding Data.Messages, Source={StaticResource proxy}}" />
            <ItemContainerTemplate x:Key="{ItemContainerTemplateKey {x:Type messagesDO:Message}}">
              <MenuItem uiUtility:CommandHelper.CommandParameter="{Binding}" Command="{Binding Data.SelectMessageCommand, Source={StaticResource proxy}}" Header="{Binding Name}">
                <MenuItem.IsChecked>
                  <MultiBinding Mode="OneWay" Converter="{StaticResource MultiBindingEqualityConverter}">
                    <Binding Path="Data.Action.MessageID" Source="{StaticResource proxy}" />
                    <Binding Path="ID" />
                  </MultiBinding>
                </MenuItem.IsChecked>
              </MenuItem>
            </ItemContainerTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <ItemsControl.ItemsSource>
          <CompositeCollection>
            <MenuItem IsChecked="True" Header="{mex:Localized GLOBAL_NO_SELECTION}" Visibility="{Binding Data.Action.MessageID, ConverterParameter={x:Static system1:Guid.Empty}, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
            <Separator Visibility="{Binding Data.Action.MessageID, ConverterParameter={x:Static Guid.Empty}, Source={StaticResource proxy}, Converter={StaticResource ValueToVisibilityConverter}}" />
            <CollectionContainer Collection="{Binding Source={StaticResource Messages}}" />
            <Separator />
            <MenuItem uiUtility:CommandTargets.Assign="{x:Static uiCommands:CommandTargetType.MainWindow}" uiUtility:CommandTargets.Default="False" uiUtility:MenuItemHelper.GestureTextVisibility="Hidden" Command="{Binding ViewMenu.Messages.BindCommand, Source={di:DIMarkup {x:Type inputActions:IInputActions}}}" Header="{mex:Localized ACTION_PALETTE_OPEN_MESSAGES_title}" />
          </CompositeCollection>
        </ItemsControl.ItemsSource>
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="{mex:Localized ACTION_PALETTE_MESSAGE_SELECTION_FIELD_title}" />
      <commonControls:DropDownButton Grid.Column="1" Width="175" Margin="5,0,0,0" HorizontalAlignment="Left" CustomContextMenu="{StaticResource MessagesMenu}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type commonControls:DropDownButton}">
            <Setter Property="commonControls:DropDownButton.CustomContent" Value="{Binding Action.Name}" />
            <Style.Triggers>
              <DataTrigger Value="{x:Static Guid.Empty}" Binding="{Binding Action.MessageID}">
                <Setter Property="commonControls:DropDownButton.CustomContent" Value="{mex:Localized GLOBAL_NO_SELECTION}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </commonControls:DropDownButton>
      <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
        <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Width="420" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" BorderBrush="#00FFFFFF" Background="{Binding LIST_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" Foreground="{Binding LISTITEM_CONTENT, Source={x:Static theming:AppTheme.Active}}" ItemsSource="{Binding Action.Tokens}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="{DataTemplateKey {x:Type messagesDO:TextToken}}" DataType="{x:Type messagesDO:TextToken}">
                <Border BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
                  <messagesUI:TextTokenTemplate Margin="5" Text="{Binding Text}" TokenName="{Binding Content}" />
                </Border>
              </DataTemplate>
              <DataTemplate x:Key="{DataTemplateKey {x:Type messagesDO:TimerToken}}" DataType="{x:Type messagesDO:TimerToken}">
                <Border BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
                  <messagesUI:TimerTokenTemplate Margin="5" ShowTimerControls="False" ShowTimerFormat="False" Format="{Binding Format}" SelectedTimerType="{Binding SelectedTimerType, Mode=TwoWay}" Timer="{Binding Timer}" Timers="{Binding Data.Timers, Source={StaticResource proxy}}" />
                </Border>
              </DataTemplate>
              <DataTemplate x:Key="{DataTemplateKey {x:Type messagesDO:ClockToken}}" DataType="{x:Type messagesDO:ClockToken}">
                <Border BorderThickness="0,0,0,1" BorderBrush="{Binding DIVIDER, Source={x:Static theming:AppTheme.Active}}">
                  <messagesUI:ClockTokenTemplate Margin="5" ClockData="{Binding ClockData}" ClockName="{Binding Content}" />
                </Border>
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>