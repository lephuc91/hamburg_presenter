<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.LiveVideoActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:liveVideo="clr-namespace:ProPresenter.UI.LiveVideo" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" Width="250" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs" Foreground="{Binding POPUPCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <Grid>
    <Border Grid.Row="1" BorderThickness="0" Background="{Binding POPUP, Source={x:Static theming:AppTheme.Active}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <liveVideo:VideoInputSelector AvailableInputs="{Binding AvailableInputs}" LiveVideoInput="{Binding LiveVideoInput}" OpenSetupCommand="{Binding OpenSetupCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>