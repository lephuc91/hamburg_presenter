<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.SlideDestinationActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" MinWidth="350" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs" Foreground="{Binding POPUPCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <Border Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,10" FontWeight="Bold" Text="{mex:Localized ACTION_PALETTE_STAGE_CHANGE_SLIDE_DESTINATION_title}" />
      <StackPanel Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <ToggleButton Height="22" MinWidth="150" Padding="10,0" Command="{Binding StageOnlyCommand}" Content="{mex:Localized ACTION_PALETTE_STAGE_DESTINATION_STAGE_title}" IsChecked="{Binding StageOnly, Mode=OneWay}" />
        <ToggleButton Height="22" MinWidth="150" Padding="10,0" Command="{Binding StageAndAudienceCommand}" Content="{mex:Localized ACTION_PALETTE_STAGE_DESTINATION_STAGE_AND_AUDIENCE_title}" IsChecked="{Binding StageAndAudience, Mode=OneWay}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>