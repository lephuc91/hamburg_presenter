<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionDialogs.StageDisplayActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:mex="clr-namespace:Pro.UI.MarkupExtensions;assembly=Pro.UI" xmlns:stage="clr-namespace:ProPresenter.UI.Stage" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" MinWidth="350" xmlns:actiondialogs="clr-namespace:ProPresenter.UI.ActionPalette.ActionDialogs" Foreground="{Binding POPUPCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <commonConverters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <commonConverters:CountToVisibilityConverter x:Key="InvertedCountToVisibilityConverter" IsInverted="True" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{Binding PANEL, Source={x:Static theming:AppTheme.Active}}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock FontWeight="Bold" Text="{mex:Localized ACTION_PALETTE_STAGE_LAYOUTS_HEADER_title}" />
      <stage:StageScreenLayoutMapping Grid.Row="1" Width="320" Margin="15,0,0,10" Layouts="{Binding StageLayouts}" ScreenAssignments="{Binding Action.ScreenAssignments}" Visibility="{Binding Action.ScreenAssignments.Count, Converter={StaticResource CountToVisibilityConverter}}" />
      <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{mex:Localized ACTION_PALETTE_STAGE_NO_STAGE_SCREENS_CONFIGURED_title}" Visibility="{Binding Action.ScreenAssignments.Count, Converter={StaticResource InvertedCountToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>