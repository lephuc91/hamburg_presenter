<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ProPresenter.UI.ActionPalette.ActionPaletteItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:actions="clr-namespace:Pro.DO.Triggering;assembly=Pro.DO" xmlns:actionsDO="clr-namespace:ProPresenter.DO.Actions;assembly=ProPresenter.DO" xmlns:commonConverters="clr-namespace:Pro.UI.Converters;assembly=Pro.UI" xmlns:commonUtility="clr-namespace:Pro.Common.Utility;assembly=Pro.Common" xmlns:media="clr-namespace:ProPresenter.DO.Media;assembly=ProPresenter.DO" xmlns:theming="clr-namespace:ProPresenter.UI.Theming" xmlns:ui="clr-namespace:Pro.UI;assembly=Pro.UI" x:Name="self" Width="95" Background="#00FFFFFF" xmlns:actionpalette="clr-namespace:ProPresenter.UI.ActionPalette" Foreground="{Binding PANELCONTENT, Source={x:Static theming:AppTheme.Active}}">
  <FrameworkElement.Resources>
    <ui:SharedResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:SharedResourceDictionary Source="../ActionPalette/ActionPaletteItemStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <commonUtility:BindingProxy x:Key="selfProxy" Data="{Binding ElementName=self}" />
      <commonConverters:EnumToContentConverter x:Key="ClearActionEnumToContentConverter" />
      <commonConverters:EnumToContentConverter x:Key="ActionEnumToContentConverter" />
      <commonConverters:EnumToContentConverter x:Key="MediaActionEnumToContentConverter" />
      <commonConverters:TypeOfConverter x:Key="TypeOfConverter" />
    </ui:SharedResourceDictionary>
  </FrameworkElement.Resources>
  <Border>
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{Binding LISTITEM_HOVER_BACKGROUND, Source={x:Static theming:AppTheme.Active}}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <StackPanel Margin="5,15,5,5">
      <Image Width="25" Height="25" RenderOptions.BitmapScalingMode="Fant" Style="{StaticResource ActionPaletteItemStyle}" />
      <TextBlock Height="22" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="{x:Type actionsDO:ClearType}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
                <Setter Property="Text" Value="{Binding Converter={StaticResource ClearActionEnumToContentConverter}}" />
              </DataTrigger>
              <DataTrigger Value="{x:Type actions:ActionType}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
                <Setter Property="Text" Value="{Binding Converter={StaticResource ActionEnumToContentConverter}}" />
              </DataTrigger>
              <DataTrigger Value="{x:Type media:MediaType}" Binding="{Binding Converter={StaticResource TypeOfConverter}}">
                <Setter Property="Text" Value="{Binding Converter={StaticResource MediaActionEnumToContentConverter}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>